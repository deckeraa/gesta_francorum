        <PAGEOBJECT XPOS="136.001" YPOS="86584.3139999998" OwnPage="207" ItemID="460984949" PTYPE="4" WIDTH="522" HEIGHT="327.02357961802" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 327.024 L0 327.024 L0 0 Z" copath="M0 0 L522 0 L522 327.024 L0 327.024 L0 0 Z" gXpos="136.001" gYpos="86584.3139999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tum Curbaram, māterna"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" audiēns monita, ferōcī respondit sermōne: &quot;Quid est hoc, māter, quod mihi refers? Putō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" quod īnsānīs aut furiīs es plēna. Enimvērō"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" mēcum habeō plūrēs ammiralīōs, quam Chrīstiānī sint sīve maiōrēs sīve minōrēs.&quot;"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Respondit eī māter sua: &quot;Ō dulcissime fīlī, Chrīstiānī nequeunt vōbīscum bellāre, sciō namque, quod nōn valent nōbīs pugnam īnferre, sed Deus eōrum prō ipsīs cotīdiē pugnat, eōsque diū"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" noctūque suā prōtēctiōne dēfendit et vigilat super eōs, sīcut pāstor vigilat super gregem suam; et nōn permittit eōs laedī nec conturbārī ab ūllā gente, et quīcunque volunt eīs obstāre, īdem eōrum Deus conturbat illōs, sīcut ipse ait per ōs Dāvīd prophētae: 'Dissipā gentēs quae bella volunt.' Et alibī: 'Effunde īram tuam in gentēs quae tē nōn nōvērunt, et in rēgna quae nōmen tuum nōn invocāvērunt.'"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="86910.8789808917" OwnPage="207" ItemID="461324261" PTYPE="4" WIDTH="522" HEIGHT="84.8407643312094" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 84.8408 L0 84.8408 L0 0 Z" copath="M0 0 L522 0 L522 84.8408 L0 84.8408 L0 0 Z" gXpos="136.001" gYpos="86910.8789808917" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Hearing the maternal warnings."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I think that you are full of insanities and furies."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For I have with me many emirs, more (numerous) than the Christians might be, (counting) either chiefs or non-chiefs."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And he defends them with his protection day and night."/>
                <ITEXT CH=" When "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="diū"/>
                <ITEXT CH=" is placed alongside "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="noctū"/>
                <ITEXT CH=" it can mean "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="by day"/>
                <ITEXT CH="."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="86584.3139999998" OwnPage="208" ItemID="465952805" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="86584.3139999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

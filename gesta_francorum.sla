        <PAGEOBJECT XPOS="136.001" YPOS="7544.029" OwnPage="17" ItemID="78252805" PTYPE="4" WIDTH="522" HEIGHT="262.238515923569" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 262.239 L0 262.239 L0 0 Z" copath="M0 0 L522 0 L522 262.239 L0 262.239 L0 0 Z" gXpos="136.001" gYpos="7544.029" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Audientēs dēnique Turcī quod Petrus Heremīta et Guualterius sine"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" habēre fuissent in Cyuītō, quae suprā Nicēnam urbem est, vēnērunt illūc cum magnō gaudiō ut occīderent"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" illōs et eōs quī cum ipsīs erant. Cumque vēnissent obviāvērunt"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" Guualtēriō cum suīs, quōs Turcī mox occīdērunt. Petrus vērō Heremita paulō ante ierat Cōnstantīnopolim, eō quod nequībat"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" refrēnāre illam dīversam gentem, quae nec illum nec verba eius audīre volēbat. Irruentēs vērō Turcī super eōs occīdērunt multōs ex eīs; aliōs invēnērunt dormientēs, aliōs nūdōs, quōs omnēs necāvērunt, cum quibus quemdam"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" sacerdōtem invēnērunt missam celebrantem, quem statim super altāre martirizāvērunt."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="7806.26751592357" OwnPage="17" ItemID="74392405" PTYPE="4" WIDTH="522" HEIGHT="155.464968152864" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 155.465 L0 155.465 L0 0 Z" copath="M0 0 L522 0 L522 155.465 L0 155.465 L0 0 Z" gXpos="136.001" gYpos="7806.26751592357" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The Turks finally hearing that Peter the Hermit and Walter Sans Avoir were in Civetot."/>
                <ITEXT CH=" Guualterius sine habēre, or Walter Sans Avoir, literally translates to &quot;Walter without to have&quot;, which comes from his family's motto: Sans avoir Peur (&quot;Without having Fear&quot;)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They (the Turks) came there with great gladness that they might kill them (Peter the Hermit and Walter Sans Avoir) and those who were with them."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And having come (to Civetot) they fought against Walter with his (comrades), whom the Turks soon killed."/>
                <ITEXT CH=" Guualtēriō is in the dative rather than accusative because obviāre takes the dative."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Paul the Hermit a little before had come to Constantinople, in which he was not able to restrain that varied people (who had come with him on crusade), who neither him nor his words were willing to hear."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="With whom they found a certain priest celebrating Mass, whom they immediately martyred on the altar."/>
                <para PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="7544.029" OwnPage="18" ItemID="78380181" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="7544.029" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="aliōs: others; plural masculine accusative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>

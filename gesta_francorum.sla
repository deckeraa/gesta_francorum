                <para PARENT="Vocab"/>
                <ITEXT CH="īnfirmitātēs: infirmities, weaknesses; plural feminine accusative from īnfirmitās, īnfirmitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="larga: large; singular feminine nominative from largus, larga, largum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="loquī: to speak, to say; present active infinitive"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="manū: by (His) hand; singular feminine ablative from manus, manūs"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="meō: my; singular neuter ablative from meus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="miseriās: misfortunes, suffering; plural feminine accusative from miseria, miseriae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="multa: much; plural neuter accusative from multus, multa -um, -, plūrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="namque: for and in fact, on the other hand"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōlīte: don't! be unwilling! imperative plural of nōlō, nōlle, nōluī (irr.)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōmine: name; singular neuter ablative from nōmen, nōminis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nūditātēs: nudity, nakedness; plural feminine accusative from nūditās, nūditātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="oportet: oportet vōs = it is necessary for you"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ōs: speech, mouth; singular neuter accusative from ōs, ōris"/>
                <para PARENT="Vocab"/>

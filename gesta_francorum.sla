        <PAGEOBJECT XPOS="136.001" YPOS="43320.158" OwnPage="103" ItemID="238242117" PTYPE="4" WIDTH="522" HEIGHT="203.154101910848" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 203.154 L0 203.154 L0 0 Z" copath="M0 0 L522 0 L522 203.154 L0 203.154 L0 0 Z" gXpos="136.001" gYpos="43320.158" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Maior"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vērō exercitūs, scīlicet Raimundus, comes dē Sānctō Egidīō, et doctissimus Boamundus, duxque Godefridus, et aliī principes in Hermeniōrum intrāvērunt terram, sitientēs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" atque aestuantēs Turcōrum sanguinem. Tandem pervēnērunt ad quoddam castrum, quod tam forte erat, ut nihil eī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" possent facere. Erat autem ibi homō quīdam, nōmine Simeon, quī"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" in illā ortūs fuit regiōne, quīque hanc petiit terram, quō"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" eam dē manibus dēfenderet inimīcōrum Turcōrum, cui sponte illī dedērunt terram, quīque remānsit ibi cum suā gente."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="43523.3121019108" OwnPage="103" ItemID="238958213" PTYPE="4" WIDTH="522" HEIGHT="113.732484076434" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 113.732 L0 113.732 L0 0 Z" copath="M0 0 L522 0 L522 113.732 L0 113.732 L0 0 Z" gXpos="136.001" gYpos="43523.3121019108" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And the prince of the army, namely Raymond of Saint-Gilles."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Thirsting and simmering (with fervor) for the blood of the Turks."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that no one could make it his."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who was born in that region."/>
                <ITEXT CH=" Presumably Simeon was an Armenian soldier."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="In which he had defended it from the hands of the Turkish enemies, to whom they had freely given the land."/>
                <ITEXT CH=" Perhaps the "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="illī"/>
                <ITEXT CH=" refers to the Crusaders, and after seizing the land they had given it over to Simeon, because he had fought against the Turks prior to the arrival of the crusaders and hadn't been conquered."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="43320.158" OwnPage="104" ItemID="243147749" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="43320.158" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>

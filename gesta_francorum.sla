                <para PARENT="Vocab"/>
                <ITEXT CH="ideō: for that reason"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="igitur: therefore"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illī: that; plural masculine nominative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illōrum: of those; plural masculine or neuter genitive from ille, illa, illud"/>
                <para PARENT="Vocab"/>

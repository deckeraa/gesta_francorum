                <para PARENT="Vocab"/>
                <ITEXT CH="sunt: they are; 3rd person plural present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="super: above, on top of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trīstēs: sad; plural common nominative from trīstis, trīstis, trīste"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcī: the Turks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ubī: where, when if"/>
                <para PARENT="Vocab"/>

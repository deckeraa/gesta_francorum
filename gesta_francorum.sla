            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="81592.2959999998" OwnPage="195" ItemID="432394325" PTYPE="4" WIDTH="522" HEIGHT="331.780433121196" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 331.78 L0 331.78 L0 0 Z" copath="M0 0 L522 0 L522 331.78 L0 331.78 L0 0 Z" gXpos="136.001" gYpos="81592.2959999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Cui ait ille: &quot;Sī vīs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" ut ex tōtō corde in tuō sim prōficuō tibique fidēliter in hōc succurram perīculō, illud oppidum in meam trāde manum et tunc vidēbis, quāliter in tuō erō prōficuō, idque faciam cūstōdīre meīs hominibus.&quot; Ait illī Sensadolus: &quot;Sī potes omnēs Francōs occīdere, mihique capita eōrum trādere, tibi dabō oppidum, tibique faciam"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" hominium et in tuā fidēlitāte cūstōdiam illud oppidum.&quot; Cui Curbaram: &quot;Nōn ita&quot; inquit &quot;erit; sed continuō in meam manum committe castrum.&quot; Tandem volēns"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" nōlēnsque commīsit illī castrum."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Tertiā vērō diē postquam intrāvimus cīvitātem, eōrum praecursōrēs ante urbem praecurrērunt. Exercitus autem illōrum ad Pontem Farreum castramētātus est, et expugāvērunt turrim, et occīdērunt omnēs quōs illīc invēnērunt; et nēmō ēvāsit vīvus nisi dominus illōrum, quem invēnimus ligātum in vinculīs ferreīs, factō"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" maiōre bellō."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="81923.6178343949" OwnPage="195" ItemID="432771141" PTYPE="4" WIDTH="522" HEIGHT="112.968152866248" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 112.968 L0 112.968 L0 0 Z" copath="M0 0 L522 0 L522 112.968 L0 112.968 L0 0 Z" gXpos="136.001" gYpos="81923.6178343949" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="If you want, out of your whole heart, that I would be to your benefit and would faithfully bring aid to you in this danger, give that city into my hand and then you will see how I will be to your benefit, and I will make it (the city) to be guarded with my men."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I will make homage to you and will guard that city in your fidelity."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Nevertheless, willing or unwilling, he handed over the castle to that one."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Having been made a leader during the war."/>
                <ITEXT CH=" The precise meaning of this phrase seems uncertain to me. Perhaps this particular man got a battlefield commission."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="81592.2959999998" OwnPage="196" ItemID="437115973" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="81592.2959999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="āit: he said; 3rd person singular present active from aio, -, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ante: before, in front, forwards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bellō: battle, war; singular neuter ablative from bellum, bellī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="capita: heads; plural neuter accusative from caput, capitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="castramētātus: castramētātus est = they encamped; singular masculine nominative perfect participle from castramētor, castramētārī, castramētātus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="castrum: fort; singular neuter accusative from castrum, castrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cīvitātem: city; singular feminine accusative from cīvitās, cīvitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="commīsit: he committed, handed over; 3rd person singular perfect active from committō, committere, commīsī, commissus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="committe: commit! Hand over!; 2nd person singular present active imperative from committō, committere, commīsī, commissus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="continuō: immediately; singular masculine ablative from continuus, continua, continuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="corde: heart; singular neuter ablative from cor, cordis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cui: to whom; singular dative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Curbaram: Qiwam al-Dawla Kerbogha, Turkish leader of Mosul"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="custōdiam: protection; 1st person singular future active or present subjunctive from custōdiō, custōdīre, custōdīvī, custōdītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="custōdīre: to guard, to watch over; present active infinitive from custōdiō, custōdīre, custōdīvī, custōdītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dabō: I will give; 1st person singular future active from dō, dare, dedī, datus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="diē: day; singular common ablative from diēs, diēī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dominus: lord, master; singular masculine nominative from dominus, dominī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eōrum: their; plural masculine or neuter genitive"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erit: it will be; 3rd person singular future active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erō: I will be; 1st person singular future active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ēvāsit: he escaped; 3rd person singular perfect active from ēvādō, ēvādere, ēvāsī, ēvāsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ex: out of, from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="exercitus: army; singular masculine nominative from exercitus, exercitūs"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="expugāvērunt: they killed; 3rd person plural perfect from expugnō, expugnāre, expugnāvī, expugnātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="faciam: I will make, I (might) make; 1st person singular future active or present subjunctive from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="factō: having been made; singular masculine ablative perfect passive participle from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Farreum: The Pōns Farreus extended over the Orontes River, colloquially called the Far. The name is not related to ferreum (iron), although several manuscripts spell it that way."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ferreīs: made of iron; plural ablative from ferreus, ferrea, ferreum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fidēlitāte: faithfulness, fidelity; singular feminine ablative from fidēlitās, fidēlitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fidēliter: faithfully"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Francōs: the Franks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hōc: this; singular neuter ablative from hic, haec, hoc"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hominibus: persons, men; plural masculine ablative from homō, hominis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hominium: homage; variant spelling from homāgium or homināticum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="id: it"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ille: that; singular masculine nominative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illī: to him; singular dative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illīc: there"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illōrum: of those; plural masculine or neuter genitive from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illud: that; singular neuter accusative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="inquit: he says, he said; 3rd person singular present active from inquiam, -, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="intrāvimus: we entered; 1st person plural perfect active from intrō, intrāre, intrāvī, intrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invēnērunt: they found; 3rd person plural perfect active from inveniō, invenīre, invēnī, inventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invēnimus: we found; 1st person plural perfect active from inveniō, invenīre, invēnī, inventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ita: yes"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ligātum: having been tied, bound; singular masculine accusative perfect passive participle from ligō, ligāre, ligāvī, ligātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="maiōre: leader; singular ablative from māgnus, māgna -um, major -or -us, maximus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="manum: hand; singular feminine accusative from manus, manūs"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="meam: my; singular feminine accusative from meus, mea, meum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="meīs: our; plural ablative from meus, mea, meum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mihique: and to me"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nēmō: no one; singular common nominative from nēmō, nēminis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nisi: except"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōlēns: not wanting; singular nominative present participle from nōlō, nōlle, nōluī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōn: not"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="occīdērunt: they killed; 3rd person plural perfect from occīdō, occīdere, occīdī, occīsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnēs: all, every; plural common accusative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="oppidum: town; singular neuter accusative from oppidum, oppidī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="perīculō: danger; singular neuter ablative from perīculum, perīculī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pontem: bridge; singular masculine accusative from pōns, pontis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="postquam: since, since then, after"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="potes: you can; 2nd person singular present active from possum, posse, potuī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="praecurrērunt: they ran before; 3rd person plural perfect active from praecurrō, praecurrere, praecurrī, praecursus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="praecursōrēs: forerunners, vanguards, spies; plural masculine nominative from praecursor, praecursōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prōficuō: beneficial, advantageous; singular masculine ablative from prōficuus, prōficua, prōficuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quāliter: of what kind"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quem: what, singular masculine accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quōs: whom; plural masculine accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sed: but"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Sensadolus: Shams al-Dawla, the son of Yağısıyan, governor of Antioch"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sī: if"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sim: I might be; 1st person singular present active subjunctive from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="succurram: I might bring aid; 1st person singular present active subjunctive from succurro, succurrere, succucurri, succursus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tandem: finally"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tertiā: third; singular feminine ablative from trēs -es -ia, tertius -a -um, terni -ae -a, ter"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tibi: to you, singular dative of tu"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tōtō: whole, total; singular ablative from tōtus, tōta, tōtum (gen -ius)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trāde: hand over!; 2nd person singular present active imperative from trādō, trādere, trādidī, trāditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trādere: to hand over; present active infinitive from trādō, trādere, trādidī, trāditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tuā: you; singular feminine ablative from tuus, tua, tuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tunc: then"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tuō: your; singular masculine ablative from tuus, tua, tuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="turrim: tower; singular feminine accusative from turris, turris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="urbem: city; singular feminine accusative from urbs, urbis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vērō: and, truly, even so, still"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vidēbis: you will see; 2nd person singular future active from videō, vidēre, vīdī, vīsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vinculīs: chains; plural neuter ablative from vinculum, vinculī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vīs: you want; 2nd person singular present active from volō, velle, voluī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vīvus: alive; singular masculine nominative from vīvus, vīva, vīvum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="volens: wanting; singular nominative present participle from volō, velle, voluī, -"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="82424.2989999998" OwnPage="197" ItemID="437313573" PTYPE="4" WIDTH="522" HEIGHT="357.357050955587" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 357.357 L0 357.357 L0 0 Z" copath="M0 0 L522 0 L522 357.357 L0 357.357 L0 0 Z" gXpos="136.001" gYpos="82424.2989999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Crāstinā vērō diē, mōtō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" exercitū pāgānōrum, appropinquāvērunt urbī et castramētātī sunt inter duo flūmina, stetēruntque ibi per duōs diēs. Receptō itaque castrō, Curbaram convocāvit ūnum ammiralium ex suīs, quem sciēbat vērācem, mītem et pācificum, et ait illī: &quot;Volō ut intrēs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" in fidēlitātem meam cūstōdīre hoc castrum, quoniam ex longissimō tempore sciō tē fidēlissimum, ideōque precor tē, ut summā"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" cautēlā hoc servēs oppidum, adhūc namque quod sciō tē in opere prūdentissimum, nūllum magis vērācem et fortissimum hīc modo reperīre possum.&quot; Cui ait ammirālius: &quot;Tibi unquam"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" dē tālī nōllem obēdīre officiō; sed priusquam mē tuō arguās stimulō, hoc faciam illō tenore ut, sī Francī ēiēcerint vōs dē mortālī proeliō et vīcerint, eīs continuō trādam hoc castrum.&quot; Dīxitque illī Curbaram: &quot;Tam honestum et prūdentem tē cognōscō, ut omne quicquid bonī vīs agere ego cōnsentiam.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="82781.6560509554" OwnPage="197" ItemID="437641573" PTYPE="4" WIDTH="522" HEIGHT="114.649681528652" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 114.65 L0 114.65 L0 0 Z" copath="M0 0 L522 0 L522 114.65 L0 114.65 L0 0 Z" gXpos="136.001" gYpos="82781.6560509554" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The army of the pagans (Muslims) having been set in motion."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I want you to enter into faith with me to guard this castle."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That with highest caution you might guard this city, because up to now I know you to be in labor most prudent, and I can now find here no one more truthful and strong (than you)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I might never wish to obey you in such a duty, but before you might compel me with your goad, I will do it on the following condition: if the Franks will have cast you out in mortal conflict and will have conquered, I will immediately hand over this castle to them."/>
                <para PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="82424.2989999998" OwnPage="198" ItemID="441448421" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="82424.2989999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="adhūc: until now"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="agere: to conduct, to act; present active infinitive from agō, agere, ēgī, āctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="āit: he said; 3rd person singular present active from aio, -, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ammiralium: emir, leader, admiral; loanword from Arabic (accusative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ammiralius: emir, leader, admiral; loanword from Arabic"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="appropinquāvērunt: they approached; 3rd person plural perfect active from appropinquō, appropinquāre, appropinquāvī, appropinquātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="arguās: you might argue, charge; 2nd person singular present active subjunctive from arguō, arguere, arguī, argūtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bonī: good; singular neuter genitive from bonum, boni"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="castramētātī: castramētātī sunt = they encamped; plural masculine nominative perfect participle from castramētor, castramētārī, castramētātus sum"/>
                <para PARENT="Vocab"/>

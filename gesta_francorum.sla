        <PAGEOBJECT XPOS="136.001" YPOS="155640.563" OwnPage="373" ItemID="809974549" PTYPE="4" WIDTH="522" HEIGHT="420.5834968157" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 420.583 L0 420.583 L0 0 Z" copath="M0 0 L522 0 L522 420.583 L0 420.583 L0 0 Z" gXpos="136.001" gYpos="155640.563" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Superātī sunt itaque inimīcī nostrī, Deō annuente. Omnēs nāvēs terrārum pāgānōrum ibi aderant; hominēs vērō, quī intus erant, videntēs ammiravissum fugientem cum suō exercitū, statim suspendērunt vēla et impulērunt sē in alta maria."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Reversī sunt nostrī ad tentōria eōrum, accēpēruntque innumera spolia aurī, argentī omniumque bonōrum cumulī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", equōs et mūlōs, asinōs et camēlōs, innumerābilēs ovēs et bovēs et īnstrūmenta. Omnēs namque montēs et collēs et omnia plāna stābant cooperta dē multitūdine illōrum animālium, et invēnērunt armōrum cumulum"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=", quae voluērunt dēportāvērunt, reliqua īgne cōnsūmpsērunt. Reversī sunt nostrī cum gaudiō Hierūsalēm, dēferentēs sēcum omnia bona, scīlicet camēlōs et asinōs onustōs pāne, biscoctō et farīnā et frūmentō et cāseō et pāne et oleō et omnibus bonīs, quae illīs erant necessāria."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Hoc bellum factum est prīdiē īdūs Augustī, largiente hoc dominō nostrō Iēsū Chrīstō, cui est honor et glōria nunc et semper et in saecula"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" saeculōrum. Dīcat omnis spīritus: Āmēn."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="156061.146496815" OwnPage="373" ItemID="810211157" PTYPE="4" WIDTH="522" HEIGHT="76.4331210191303" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 76.4331 L0 76.4331 L0 0 Z" copath="M0 0 L522 0 L522 76.4331 L0 76.4331 L0 0 Z" gXpos="136.001" gYpos="156061.146496815" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And of a pile of all good things."/>
                <ITEXT CH=" This reads "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="cumula"/>
                <ITEXT CH=" in the critical text, but Hagenmeyer states (p. 499, note 90) that the words stands in for "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="cumulī"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="This reads "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="cumula"/>
                <ITEXT CH=" in the critical text."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And forever."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="155640.563" OwnPage="374" ItemID="814247141" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="155640.563" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="accēpēruntque: they took, received; 3rd person plural perfect from accipiō, accipere, accēpī, acceptum; -que adds 'and' in front of a word"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aderant: they were present; 3rd person plural imperfect from adsum, adesse, adfuī, adfutūrum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="alta: high; plural neuter accusative from altus, alta, altum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="āmēn: amen, let it be so"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ammiravissum: emir, leader, admiral; loanword from Arabic; singular masculine accusative from ammiravissus, ammiravissī"/>

        <PAGEOBJECT XPOS="136.001" YPOS="35000.128" OwnPage="83" ItemID="203203061" PTYPE="4" WIDTH="522" HEIGHT="171.642700636934" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 171.643 L0 171.643 L0 0 Z" copath="M0 0 L522 0 L522 171.643 L0 171.643 L0 0 Z" gXpos="136.001" gYpos="35000.128" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Quis"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" unquam tam sapiēns aut doctus audēbit dēscrībere prūdentiam, mīlitiam, et fortitūdinem Turcōrum? Quī putābant terrēre gentem Francōrum minīs suārum sagittārum, sīcut terruērunt Ārabēs, Saracēnōs et Hermēniōs, Suranīōs et Graecōs. Sed sī Deō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" placet, nunquam tantum valēbunt quantum nostrī. Vērumtamen"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" dīcunt sē esse dē Francōrum generātiōne, et quia nūllus homō nātūrāliter dēbet esse mīles nisi Francī et illī."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="35171.7707006369" OwnPage="83" ItemID="203369461" PTYPE="4" WIDTH="522" HEIGHT="92.1783439490391" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 92.1783 L0 92.1783 L0 0 Z" copath="M0 0 L522 0 L522 92.1783 L0 92.1783 L0 0 Z" gXpos="136.001" gYpos="35171.7707006369" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who ever is so wise or learned to dare to describe the compentence, militancy, and strength of the Turks? "/>
                <ITEXT CH="The author is impressed with how well the Turks conduct themselves in battle."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="But if it pleases God, they never would have been as strong as us."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Certainly they (presumably the Frankish crusaders) say themselves to be of Frankish origin, and that no person should, by nature, be a soldier, except the Franks and them (the Turks)."/>
                <ITEXT CH=" The author is communicating that two races are natural-born soldiers: the Franks and the Turks."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="35000.128" OwnPage="84" ItemID="207120229" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="35000.128" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Arabēs: Arabs; plural masculine nominative from Arabs, Arabis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="audēbit: he will dare; 3rd person singular future active from audeō, audēre, ausus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aut: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dē: of, from, away from, down from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēbet: he should; 3rd person singular present active from dēbeō, dēbēre, dēbuī, dēbitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Deō: God; singular masculine dative from Deus, Dei"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēscrībere: to describe; present active infinitive from dēscrībō, dēscrībere, dēscrīpsī, dēscrīptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīcunt: they say; 3rd person plural present active from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="doctus: learned, knowledgeable; singular masculine nominative perfect passive participle from doceō, docēre, docuī, doctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="esse: to be"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fortitūdinem: strength, fortitude; singular feminine accusative from fortitūdō, fortitūdinis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Francī: the Franks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Francōrum: of the Franks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="generātiōne: generation; singular feminine ablative from generātiō, generātiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gentem: people, clan, nation; singular feminine accusative from gēns, gentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Graecōs: Greeks; plural masculine accusative from Graecus, Graecī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Hermēniōs: Armenians"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="homō: person; singular masculine nominative from homō, hominis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illī: them; plural masculine nominative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīles: soldier; singular masculine nominative from mīles, mīlitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīlitiam: military; singular feminine accusative from mīlitia, mīlitiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="minīs: ambushes; plural feminine ablative from mina, minae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nātūrāliter: naturally, normally, inherently, by nature"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nisī: if not, unless"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrī: our (soldiers);  plural masculine nominative from noster"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nūllus: no, none, not any; singular masculine nominative from nūllus, nūlla, nūllum (gen -ius)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nunquam: never"/>
                <para PARENT="Vocab"/>

                <para PARENT="Vocab"/>
                <ITEXT CH="revertere: return!; plural imperative from revertor, revertī, reversus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sciās: you might know; 2nd person singular present active subjunctive from sciō, scīre, scīvī, scītus"/>

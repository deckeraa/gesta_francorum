                <para PARENT="Vocab"/>
                <ITEXT CH="Novembris: of November; singular feminine nominative from November, Novembris, Novembre"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="obsēdimus: we besieged; 1st person plural perfect active from obsideō, obsidēre, obsēdī, obsessus"/>

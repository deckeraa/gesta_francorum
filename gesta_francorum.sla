                <para PARENT="Vocab"/>
                <ITEXT CH="praeparāvērunt: they prepared; 3rd person plural perfect active from praeparō, praeparāre, praeparāvī, praeparātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prīmus: first; singular masculine nominative adjective used as an adverb from prīmus, prīma, prīmum"/>
                <para PARENT="Vocab"/>

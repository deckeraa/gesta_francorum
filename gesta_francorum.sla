        <PAGEOBJECT XPOS="136.001" YPOS="94072.3409999998" OwnPage="225" ItemID="501391781" PTYPE="4" WIDTH="522" HEIGHT="358.181292993846" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 358.181 L0 358.181 L0 0 Z" copath="M0 0 L522 0 L522 358.181 L0 358.181 L0 0 Z" gXpos="136.001" gYpos="94072.3409999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tunc alma Virgō et beātus Petrus cecidērunt ad pedēs eius, rogantēs eum et dēprecantēs, ut suum in hāc trībulātiōne adiuvāret populum. Dīxitque beātus Petrus: &quot;Domine, per tot"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" tempora tenuit pāgānōrum gēns domum meam, in quā multa et ineffābilia mala fēcērunt. Modo"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" vērō expulsīs inimīcīs inde, Domine, laetantur angelī in caelīs.&quot; Dīxitque mihi Dominus: &quot;Vāde ergō et dīc populō meō, ut revertātur ad mē, et ego revertar ad illum et īnfrā quīnque diēs mittam eī magnum adiūtōrium, et cotīdiē dēcantet"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" respōnsōrium: 'Congregātī sunt', tōtum cum versū."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Seniōrēs, sī hoc nōn crēditis esse vērum, sinite modo mē in hanc scandere turrim, mittamque mē deorsum; sī vērō fuerō incolumis, crēdātis hoc esse vērum, sīn autem ūllam laesiōnem fuerō passūs, dēcollāte mē aut in īgnem prōicite mē.&quot; Tunc Podiēnsis epīscopus iussit ut adferrentur Ēvangelia"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" et crux, quātinus iūrāret ille hoc esse vērum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="94430.5222929936" OwnPage="225" ItemID="501657317" PTYPE="4" WIDTH="522" HEIGHT="174.267515923566" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 174.268 L0 174.268 L0 0 Z" copath="M0 0 L522 0 L522 174.268 L0 174.268 L0 0 Z" gXpos="136.001" gYpos="94430.5222929936" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Lord, for such (a length of) time a pagan people held my house."/>
                <ITEXT CH=" According to tradition, Antioch was considered as belonging to Saint Peter."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And now, with the enemies having been expelled from it, Lord, the angels in heaven are gladdened. "/>
                <ITEXT CH="The deponent "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="laetārī"/>
                <ITEXT CH=" exists, so this could also be translated as "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="the angels in heaven rejoice"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Let it (God's people, the Crusaders) everyday sing the whole responsory 'they gathered' with verse."/>
                <ITEXT CH=" The site gregorien.info gave the following text for this responsory: "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Congregātī sunt inimīcī nostrī, // et glōriantur in virtūte suā; // contere fortitūdinem illōrum, Domine, // et disperge illōs, ut cognōscant // Quia nōn est alius quī pugnet prō nōbīs, // nisi tū Deus noster"/>
                <ITEXT CH=", which translates to: Our enemies have gathered // and they glory in their strength. Exhaust their strength, Lord, and scatter them, that they might know // that there is no other who might fight for us // except You our God."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Ēvangelia"/>
                <ITEXT CH=" here means written copies of the Gospels (Matthew, Mark, Luke, and John) for the priest to swear on."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="94072.3409999998" OwnPage="226" ItemID="505274709" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="94072.3409999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adferrentur: they might be brought; 3rd person plural imperfect passive subjunctive from adferō, adferre, adtulī, adlātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adiūtōrium: adiūtōrium: help, support; singular neuter accusative from adiūtōrium, adiūtōriī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adiuvāret: he might help; 3rd person singular imperfect active subjunctive from adiuvō, adiuvāre, adiūvī, adiūtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="alma: nourishing; singular feminine nominative from almus, alma, almum"/>
                <para PARENT="Vocab"/>

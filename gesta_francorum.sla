                <para PARENT="Vocab"/>
                <ITEXT CH="suscipere: to undertake, receive; present active infinitive from suscipiō, suscipere, suscēpī, susceptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Tancredum: Tancred, Prince of Galilee (1075–1112) (accusative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Tancredus: Tancred, Prince of Galilee (1075–1112) (nominative case)"/>
                <para PARENT="Vocab"/>

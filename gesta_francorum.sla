        <PAGEOBJECT XPOS="136.001" YPOS="69112.2509999999" OwnPage="165" ItemID="367567253" PTYPE="4" WIDTH="522" HEIGHT="389.303140127508" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 389.303 L0 389.303 L0 0 Z" copath="M0 0 L522 0 L522 389.303 L0 389.303 L0 0 Z" gXpos="136.001" gYpos="69112.2509999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Crāstinā vērō diē, summō dīlūculō, exiērunt aliī Turcī dē cīvitāte et colligērunt omnia cadāvera fētentia Turcōrum mortuōrum, quae reperīre potuērunt super rīpam flūminis, exceptīs illīs, quae in alveō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" latēbant eiusdem flūminis; et sepeliērunt ad Machumāriam, quae est ultrā pontem ante portam urbis, simulque illīs cōnsepeliērunt pallia, bisantēōs aureōs, arcūs, sagittās, et alia plūrima īnstrūmenta, quae nōmināre nequīmus. Audientēs itaque nostrī quod humāssent mortuōs suōs Turcī, omnēs sēsē praeparāvērunt, et vēnērunt festīnantēs ad diabolicum ātrium et iussērunt dēsepelīrī et frangī tumbās eōrum et trahī eōs extrā sepulchra. Et ēiēcērunt omnia cadāvera eōrum in quandam foveam et dēportāvērunt caesa capita ad tentōria nostra, quātinus"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" perfectē scīrētur eōrum numerus, exceptō"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" quod onerāverant quattuor equōs nūnciīs Ammiraliī Babylōniae et miserant ad mare. Quod videntēs Turcī doluērunt nimis fuēruntque trīstēs usque ad necem; nam cotīdiē dolentēs, nihil aliud agēbant nisi flēre et ululāre."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="69501.5541401274" OwnPage="165" ItemID="367713461" PTYPE="4" WIDTH="522" HEIGHT="116.178343949039" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 116.178 L0 116.178 L0 0 Z" copath="M0 0 L522 0 L522 116.178 L0 116.178 L0 0 Z" gXpos="136.001" gYpos="69501.5541401274" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which were laying in the trough of the same river."/>
                <ITEXT CH=" They couldn't pull out bodies that were in the river because they were underwater."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that their number might be rightly known."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Except that they had loaded four horses with (the heads of) messengers of the Emir of Cairo and had sent them to sea"/>
                <ITEXT CH=". Presumably, the heads were being shipped somewhere for dramatic effect rather than just thrown into the sea."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="69112.2509999999" OwnPage="166" ItemID="370884389" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="69112.2509999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ad: to, towards, at, according to"/>

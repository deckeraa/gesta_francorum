                <para PARENT="Vocab"/>
                <ITEXT CH="quem: whom, singular masculine accusative of qui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quia: because"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quid: what; singular neuter nominative of quis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quīndecim: fifteen; from quīndecim, quīndecimus -a -um, quīndeci -ae -a, quīndecie (n)s"/>

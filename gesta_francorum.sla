        <PAGEOBJECT XPOS="136.001" YPOS="74104.2689999999" OwnPage="177" ItemID="393456421" PTYPE="4" WIDTH="522" HEIGHT="244.673675159371" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 244.674 L0 244.674 L0 0 Z" copath="M0 0 L522 0 L522 244.674 L0 244.674 L0 0 Z" gXpos="136.001" gYpos="74104.2689999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Nōn multō post audīvimus nūntiōs dē exercitū hostium nostrōrum, Turcōrum, Pūblicānōrum, Angulānōrum, Azimītārum, et aliārum plūrimārum nātiōnum gentīlium, quās numerāre neque nōmināre nesciō. Statimque adūnāvērunt sē omnēs maiōrēs nostrī simul, tenuēruntque concilium, dīcentēs: &quot;Quoniam sī Boamundus potuerit adquīrere cīvitātem aut per sē aut per aliōs, nōs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" ūnā libentī corde ultrō eī dōnāmus, eō tenōre ut sī imperātor vēnerit nōbīs in adiūtōrium et omnem conventiōnem nōbīs, sīcut prōmīsit et iūrāvit attendere voluerit, nōs eī eam iūre reddēmus; sīn autem, Boamundus eam in suam habeat potestātem.&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="74348.9426751592" OwnPage="177" ItemID="393757349" PTYPE="4" WIDTH="522" HEIGHT="208.203821656047" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 208.204 L0 208.204 L0 0 Z" copath="M0 0 L522 0 L522 208.204 L0 208.204 L0 0 Z" gXpos="136.001" gYpos="74348.9426751592" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Moreover, we give (it) to him, with a willing heart, with this land entitlement: that if the emperor will come to our aid and (fulfill) the whole agreement to us, like he promised and swore he wanted to attend to, we will return it (Antioch) to him by right; however, if not, let Bohemond have it (Antioch) in his power."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="74104.2689999999" OwnPage="178" ItemID="397611029" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="74104.2689999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="adiūtōrium: adiūtōrium: help, support; plural neuter nominative or accusative from adiūtōrium, adiūtōriī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adquīrere: to obtain; alternative spelling from acquirō; present active infinitive from adquiro, adquirere, adquisivi, adquisitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adūnāvērunt: they came together, united, brought together; 3rd person plural perfect active from adūnō, adūnāre, adūnāvī, adūnātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliārum: of others; plural feminine genitive from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliōs: others; plural masculine accusative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Angulānōrum: of Aghlabids (North African muslims)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="attendere: to attend, preserve; present active infinitive from attendō, attendere, attendī, attentus. Hagenmeyer (p. 298, note 25) gives servāre as a homonym."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="audīvimus: we heard; 1st person plural perfect active from audio, audire, audivi, auditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aut: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Azimītārum: of the Armenians (according to Hagenmeyer (p. 297, note 19)). The name stems from the Greek άζυμος, which means unleavened, and refers to the Armenian's practice of using unleavened bread in the Eucharist."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundus: Bohemond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cīvitātem: city; singular feminine accusative from cīvitās, cīvitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="concilium: council, assembly; singular neuter accusative from concilium, conciliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="conventiōnem: agreement; singular feminine accusative from conventiō, conventiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="corde: heart; singular neuter ablative from cor, cordis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dē: of, about"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīcentēs: saying; plural common nominative present participle from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dōnāmus: we are giving; 1st person plural present active from dōnō, dōnāre, dōnāvī, dōnātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eam: it; singular feminine accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eī: to him; singular dative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eō: it; singular masculine ablative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="exercitū: army; singular neuter ablative from exercitus, exercitūs"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gentīlium: of heathens, pagans; plural masculine genitive from gentīlis, gentīlis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="habeat: let him have; 3rd person singular present active subjunctive from habeō, habēre, habuī, habitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hostium: of enemies; plural feminine genitive from hostia, hostiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="imperātor: emperor; singular masculine nominative from imperātor, imperātōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iūrāvit: he swore; 3rd person singular perfect active from juro, jurare, juravi, juratus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iūre: by right; singular neuter ablative from iūs, iūris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="libentī: willing, cheerful, glad; singular ablative from libēns, libentis (gen.), libentior -or -us, libentissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="maiōrēs: elders; plural common nominative from māgnus, māgna -um, major -or -us, maximus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="multō: many; singular masculine ablative from multus, multa -um, -, plūrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nātiōnum: of races, tribes, nations; plural feminine genitive from nātiō, nātiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="neque: not, not either"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nesciō: I don't know; 1st person singular present active from nesciō, nescīre, nescīvī, nescītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōbīs: us; singular dative or ablative from ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōmināre: to name; present active infinitive from nōminō, nōmināre, nōmināvī, nōminātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōn: not"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōs: we, us; plural nominative or accusative of ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrī: our; plural masculine nominative from noster"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrōrum: our"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="numerāre: to number, count; present active infinitive from numerō, numerāre, numerāvī, numerātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nūntiōs: messengers; plural masculine accusative from nuntius, nuntiī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnem: all, every; singular common accusative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnēs: all, every; plural common nominative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="plūrimārum: of very many; plural feminine genitive from multus, multa -um, -, plūrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="post: behind, after, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="potestātem: power; singular feminine accusative from potestās, potestātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="potuerit: he will have been able to; 3rd person singular perfect active subjunctive from possum, posse, potuī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prōmīsit: he promised; 3rd person singular perfect active from prōmittō, prōmittere, prōmīsī, prōmissus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Pūblicānōrum: of Paulicans, a Armenian sect considered heretical by the Catholic Church"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quās: whom; plural feminine accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quoniam: inasmuch as, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="reddēmus: we will return; 1st person plural future active from reddō, reddere, reddidī, redditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sē: himself or themselves"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sī: if"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sīcut: as, same as, like"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="simul: at the same time as"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sīn: but if, if on the contrary"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="statim: immediately"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suam: his; singular feminine accusative from suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tenōre: land entitlement (a Medieval Latin use of the words), course, tenor; singular masculine ablative from tenor, tenōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tenuērunt: they held; 3rd person plural perfect active from teneō, tenēre, tenuī, tentus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcōrum: of the Turks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ultrō: moreover, besides"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnā: one; singular feminine ablative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnerit: he will have come; 3rd person singular perfect active subjunctive from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="voluerit: he will have wanted, intended; 3rd person singular perfect active subjunctive from volō, velle, voluī, -"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="74936.2719999999" OwnPage="179" ItemID="398086069" PTYPE="4" WIDTH="522" HEIGHT="334.912713375947" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 334.913 L0 334.913 L0 0 Z" copath="M0 0 L522 0 L522 334.913 L0 334.913 L0 0 Z" gXpos="136.001" gYpos="74936.2719999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Mox itaque Boamundus coepit humiliter amīcum suum cotīdiānā dēprecārī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" petītiōne, prōmittendō humillimā, maximā et dulciā, in hunc modum: &quot;Ecce vērē"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" tempus modo habēmus idōneum, in quō possumus operārī quicquid bonī volumus; ergō adiuvet mē nunc amīcus meus Pirus.&quot; Quī satis gāvīsus"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" dē nūntiō, ait sē illum adiuvāre omnīnō sīcut agere dēbēret. Nocte itaque veniente proximā, mīsit cautē fīlium suum pignus"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" Boamundō, ut sēcūrior fieret dē introitū urbis. Mīsit quoque eī verba in hunc modum: &quot;ut"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" in crāstinum omnem Francōrum gentem praeconiāre atque summovēre faciat, quod in Saracēnōrum terram depredārī vadat, dissimulāns ac deinde celeriter revertātur per dextram montāneam: &quot;Ego vērō,&quot; ait, &quot;ērō"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" intentiōne ērēctā praestōlāns illa agmina, eaque recipiam in turrēs, quās in meā habeō potestāte ac custōdiā.&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="75271.1847133758" OwnPage="179" ItemID="398289733" PTYPE="4" WIDTH="522" HEIGHT="184.203821656061" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 184.204 L0 184.204 L0 0 Z" copath="M0 0 L522 0 L522 184.204 L0 184.204 L0 0 Z" gXpos="136.001" gYpos="75271.1847133758" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Soon therefore Bohemond began to humbly beseech his friend (Pirus) with daily petition, with very humble promising, very great and sweet, in this way."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Behold, truly now we have a suitable time, in which we can do whatever good (things) we want."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who, having been sufficiently gladdened by this message, said that he would help him entirely, as he ought to do."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And thus with the next night coming, he (Pirus) cautiously sent his son (as a pledge/surety) to Bohemond, so that he (Bohemond) might be more secure/sure regarding entry to the city."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That tomorrow you might publicly summon and send forth the whole Frankish people, that they might advance to plunder in the Saracene lands, pretending (to go forth) and then let it quickly returning through the right-hand mountain."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I will with upright intention be standing ready for those bands and will receive them into the towers."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="74936.2719999999" OwnPage="180" ItemID="401207621" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="74936.2719999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adiuvāre: to help; present active infinitive from adiuvō, adiuvāre, adiūvī, adiūtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adiuvet: may he help; 3rd person singular present active subjunctive from adiuvō, adiuvāre, adiūvī, adiūtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="agere: to do, conduct, act; present active infinitive from agō, agere, ēgī, āctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="agmina: marching armies; plural neuter accusative from agmen, agminis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="āit: he said; 3rd person singular present active from aio, -, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="amīcum: friend; singular masculine accusative from amīcus, amīcī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="amīcus: friend; singular masculine nominative from amīcus, amīcī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="atque: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundō: Bohemond (dative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundus: Bohemond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bonī: of good; singular neuter genitive from bonum, bonī."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cautē: cautiously"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="celeriter: quickly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="coepit: he started; 3rd person singular present active from coepio, coepere, coepi, coeptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cotīdiānā: daily; singular feminine ablative from cōtīdiānus, cōtīdiāna, cōtīdiānum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="crāstinum: tomorrow; singular neuter accusative from crāstinus, crāstina, crāstinum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="custōdiā: protection; singular feminine ablative from custōdia, custōdiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dē: of, about, concerning"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēbēret: he should; 3rd person singular imperfect active subjunctive from dēbeō, dēbēre, dēbuī, dēbitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="deinde: after"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēpraedārī: to plunder, pillage; present active infinitive from the deponent dēpraedor, dēpraedārī, dēpraedātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēprecārī: to request; present active infinitive from the deponent dēprecor, dēprecārī, dēprecātus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dextram: right hand, right side; singular feminine accusative from dexter, dextra -um, dexterior -or -us, dextimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dissimulāns: concealing, disguising, hiding; singular nominative present participle from dissimulō, dissimulāre, dissimulāvī, dissimulātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dulciā: pleasant, charming, flattering; singular feminine ablative from dulcis, dulce, dulcior -or -us, dulcissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eaque: and them; plural neuter accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ecce: Look! Behold!"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ego: I"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eī: to him; singular dative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ērēctā: having been raised; singular feminine ablative from erectus, erecta -um, erectior -or -us, erectissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ergō: therefore"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erō: I will be; 1st person singular future active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="faciat: he (might) do/make; 3rd person singular present active subjunctive from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fieret: he might be made; 3rd person singular imperfect active subjunctive from fīō, fierī, factus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fīlium: son; singular masculine accusative from fīlius, fīlī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Francōrum: of the Franks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gavīsus: having been gladdened; singular masculine nominative perfect passive participle from gaudeō, gaudēre, gavīsus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gentem: people, clan, nation; singular feminine accusative from gēns, gentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="habēmus: we have; 1st person plural present active from habeō, habēre, habuī, habitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="habeō: I have; 1st person singular present active from habeō, habēre, habuī, habitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="humiliter: humbly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="humillimā: very humble; singular feminine ablative from humilis, humile, humilior -or -us, humillimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hunc: this; singular masculine accusative of hic, haec, hoc"/>
                <para PARENT="Vocab"/>

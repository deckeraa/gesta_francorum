                <para PARENT="Vocab"/>
                <ITEXT CH="inīrent: they entered into (flight); 3rd person plural imperfect active subjunctive from ineō, inīre, inivī(iī), initus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invāsērunt: they attacked; 3rd person plural perfect active from invādō, invādere, invāsī, invāsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="laetantēs: rejoicing; plural masculine nominatives from laetor, laetārī, laetātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="magnificantēs: esteeming greatly; plural common nominative present participle from magnificō, magnificāre, magnificāvī, magnificātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="martyriī: of martyrdom; singular neuter genitive from martyrium, martyriī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="martyrīzātī: fuerunt martyrīzātī = they had been martyred; plural masculine nominative pluperfect passive participle from martyrizō"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="maximam: very tall; singular feminine accusative from māgnus, māgna -um, major -or -us, maximus -a -um"/>

                <ITEXT CH="praeparāret: it might prepare; 3rd person singular imperfect active subjunctive from praeparō, praeparāre, praeparāvī, praeparātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prope: near, close"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quās: which; plural feminine accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quasi: as, like"/>
                <para PARENT="Vocab"/>

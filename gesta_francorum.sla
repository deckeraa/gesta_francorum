                <para PARENT="Vocab"/>
                <ITEXT CH="seorsum: separately, apart"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sī: if"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sīcut: as, same as, like"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sunt: they are; 3rd person plural present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tē: you, accusative from tu"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="timōre: fear; singular masculine ablative from timor, timōris"/>

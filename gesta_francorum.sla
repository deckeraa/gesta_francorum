        <PAGEOBJECT XPOS="136.001" YPOS="87416.3169999998" OwnPage="209" ItemID="466518917" PTYPE="4" WIDTH="522" HEIGHT="266.84223566897" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 266.842 L0 266.842 L0 0 Z" copath="M0 0 L522 0 L522 266.842 L0 266.842 L0 0 Z" gXpos="136.001" gYpos="87416.3169999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Antequam"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vērō praeparātī sint ad incipiendum bellum, eōrum Deus omnipotēns et bellipotēns simul cum sānctīs suīs omnēs inimīcōs iam habet dēvictōs; quantō magis modo faciet circā vōs, quī eius estis inimīcī et quī praeparāstis vōs obsistere eīs tōtā virtūte?"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Hoc autem, cārissime, in reī vēritāte sciās, quoniam istī Chrīstiānī 'fīliī Chrīstī' vocātī sunt et prophētārum ōre 'fīliī adoptiōnis et prōmissiōnis', et secundum apostolum 'hērēdēs Chrīstī' sunt, quibus"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" Chrīstus hērēditātēs reprōmissās iam dōnāvit, dīcendō per prophētās: 'Ā sōlis ortū ūsque ad occāsum erunt terminī vestrī, et nēmō stābit contrā vōs.' Et quī potest hīs dictīs contrādīcere vel obstāre?"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="87683.1592356688" OwnPage="209" ItemID="466733973" PTYPE="4" WIDTH="522" HEIGHT="74.7515923566971" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 74.7516 L0 74.7516 L0 0 Z" copath="M0 0 L522 0 L522 74.7516 L0 74.7516 L0 0 Z" gXpos="136.001" gYpos="87683.1592356688" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And before they had prepared for the coming battle, their God omnipotent and strong-in-war together with his holy one has all their enemies entirely conquered; how much more now will he do regarding you, who are his enemies and who you prepare to resist with all your might?"/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="To whom he already gave the promised inheritances of Christ."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="87416.3169999998" OwnPage="210" ItemID="470499845" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="87416.3169999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

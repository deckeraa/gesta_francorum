        <PAGEOBJECT XPOS="136.001" YPOS="114040.413" OwnPage="273" ItemID="609627109" PTYPE="4" WIDTH="522" HEIGHT="387" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 387 L0 387 L0 0 Z" copath="M0 0 L522 0 L522 387 L0 387 L0 0 Z" gXpos="136.001" gYpos="114040.413" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Chapter Heading"/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Liber 10"/>
                <para PARENT="Chapter Heading"/>
                <para PARENT="Chapter Heading"/>
                <tab/>
                <ITEXT CH="Et cum iam essent omnēs inimīcī nostrī (Deō trīnō et ūnō summōque dīgnās referimus"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" grātēs) per omnia dēvictī, hūc illūcque fugientēs, aliī sēmivīvī, aliī vulnerātī, in vallibus et in nemoribus et in arvīs et in viīs dēficiēbant mortuī. Populus vērō Chrīstī victōrēs scīlicet peregrīnī, reversī sunt gaudentēs fēlīcī triumphō dēvictīs hostibus in cīvitātem."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Statim omnēs nostrī seniōrēs, vidēlicet dux Godefridus, comes Sānctī Egidīī Raimundus, Boamundus,  comes Nortmanniae dominus Rotbertus, comesque Flandrēnsis, et aliī omnēs mīsērunt nōbilissimum mīlitem Hugōnem Magnum imperātōrī Cōnstantīnopolim, ut ad recipiendam"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" cīvitātem venīret, et conventiōnēs quās ergā illōs habēbat explēret. Īvit"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=", nec posteā rediit."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="114427.413" OwnPage="273" ItemID="609950085" PTYPE="4" WIDTH="522" HEIGHT="103.491458599019" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 103.491 L0 103.491 L0 0 Z" copath="M0 0 L522 0 L522 103.491 L0 103.491 L0 0 Z" gXpos="136.001" gYpos="114427.413" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="We give worthy thanks to the highest God, three and one."/>
                <ITEXT CH=" The phrase "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="trīnō et ūnō"/>
                <ITEXT CH=" refers to the Triune nature of God: one in essence, three in person."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that he (Alexios) might come to receive the city, and fulfill the commitments that he had towards them."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He went, but he never returned."/>
                <ITEXT CH=" Apparently, Hugh's report was not acted upon by Alexios, so Hugh went back to France. He would return during the Crusade of 1101 and be killed by the Turks in Tarsus."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

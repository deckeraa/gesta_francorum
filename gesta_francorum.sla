        <PAGEOBJECT XPOS="136.001" YPOS="99064.3589999998" OwnPage="237" ItemID="529352245" PTYPE="4" WIDTH="522" HEIGHT="149.806605095771" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 149.807 L0 149.807 L0 0 Z" copath="M0 0 L522 0 L522 149.807 L0 149.807 L0 0 Z" gXpos="136.001" gYpos="99064.3589999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Itaque Turcī habitantēs in castellō intrā urbem bellābant nōbīscum diē noctūque, et nihil aliud dissēparābat nōs nisi arma. Videntēs hōc nostrī, quod nōn possent diū haec patī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", quoniam quī habēbat pānem nōn licēbat"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" eī mandūcāre, et quī habēbat aquam nōn licēbat bibere, fēcērunt mūrum inter nōs et ipsōs petrā et calce, et aedificāvērunt castellum et māchinās, ut sēcūrī essent."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="99214.1656050955" OwnPage="237" ItemID="529551029" PTYPE="4" WIDTH="522" HEIGHT="73.3757961783413" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 73.3758 L0 73.3758 L0 0 Z" copath="M0 0 L522 0 L522 73.3758 L0 73.3758 L0 0 Z" gXpos="136.001" gYpos="99214.1656050955" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Our (soldiers) seeing this, that they were not able to long endure these (things)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Because the one having bread was not allowed to eat it."/>
                <ITEXT CH=" Because of the Turks within the citadel in Antioch, the Crusaders in Antioch could never relax and eat food. Therefore they built a wall around the citadel within the city."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

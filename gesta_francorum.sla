        <PAGEOBJECT XPOS="136.001" YPOS="15864.059" OwnPage="37" ItemID="116255589" PTYPE="4" WIDTH="522" HEIGHT="231.380490445858" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 231.38 L0 231.38 L0 0 Z" copath="M0 0 L522 0 L522 231.38 L0 231.38 L0 0 Z" gXpos="136.001" gYpos="15864.059" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Deinde vēnimus ad quamdam urbem quae dīcitur Serra, ubi nostra fīximus tentōria, et sat"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" habuimus mercātum, illīs diēbus conveniēns. Ibique doctus Boamundus optimē concordātus est cum duōbus corpalatīīs, et prō amīcitiā eōrum ac prō iūstitiā terrae iussit reddī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" omnia animālia quae nostrī depredāta tenēbant; et Corpalātius illī prōmīserat missōs retrō mandāre et hominibus illīs animālia per ōrdinem reddī. Deinde pervēnimus ad Rūsam cīvitātem. Graecōrum autem gēns exībat et veniēbat gaudēns in occursum dominī Boamundī, nōbīs dēferēns maximum mercātum, ibique nostrōs tetendimus pāpiliōnēs in quārtā fēriā ante Cēnam Dominī."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="16095.4394904459" OwnPage="37" ItemID="116784981" PTYPE="4" WIDTH="522" HEIGHT="93.0955414012715" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 93.0955 L0 93.0955 L0 0 Z" copath="M0 0 L522 0 L522 93.0955 L0 93.0955 L0 0 Z" gXpos="136.001" gYpos="16095.4394904459" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="We had a sufficient market (for purchasing food and other necessities), befitting those days (that were spent camped outside Serres)."/>
                <ITEXT CH=" Serres is about 330 miles from Constantinople."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He (Bohemond) ordered to be returned all the animals which, having been plundered, we were holding; and the palace minister had promised to him to entrust (the animals to) those sent back and the animals to be returned to those people though the route (that the crusaders had taken)."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="15864.059" OwnPage="38" ItemID="120947509" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="15864.059" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>

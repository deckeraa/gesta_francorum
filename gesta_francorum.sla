                <para PARENT="Vocab"/>
                <ITEXT CH="itaque: so then, therefore"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="itūra: goings, travels; plural neuter accusative gerund from eō, īre, ivī(iī), itus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iussit: he commanded; 3rd person singular perfect from iubeō, iubēre, iussī, iussus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="malam: evil, bad; singular feminine accusative from malus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="maximam: biggest; singular feminine accusative from māgnus, māgna -um, major -or -us, maximus -a -um"/>

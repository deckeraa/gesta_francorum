            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="59960.2179999999" OwnPage="143" ItemID="324210037" PTYPE="4" WIDTH="522" HEIGHT="207.934866242125" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 207.935 L0 207.935 L0 0 Z" copath="M0 0 L522 0 L522 207.935 L0 207.935 L0 0 Z" gXpos="136.001" gYpos="59960.2179999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tunc Boamundus iussit, ut ūnusquisque"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" prīncipum per sē dīrigeret aciem suam ōrdinātim. Fēcēruntque ita; et ōrdinātae sunt sex aciēs. Quīnque vērō ex eīs iērunt adūnātim invādere illōs. Boamundus itaque paulātim gradiēbātur retrō cum suā aciē. Iūnctīs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" igitur prosperē nostrīs, ūnus cōminus percutiēbat alium. Clāmor vērō resonābat ad caelum. Omnēs proeliābantur īnsimul. Imbrēs tēlōrum obnūbilābant āerem. Postquam vēnit maxima virtūs illōrum, quae erat retrō, ācriter invāsit nostrōs, ita"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" ut nostrī paululum iam cēderent retrō."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="60168.6114649682" OwnPage="143" ItemID="324418069" PTYPE="4" WIDTH="522" HEIGHT="58.7006369426817" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 58.7006 L0 58.7006 L0 0 Z" copath="M0 0 L522 0 L522 58.7006 L0 58.7006 L0 0 Z" gXpos="136.001" gYpos="60168.6114649682" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That each of the princes might direct his battle line in succession."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Having been joined been joined together favorably, one was fighting another in close quarters."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that we might fall back a little."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="59960.2179999999" OwnPage="144" ItemID="328814949" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="59960.2179999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

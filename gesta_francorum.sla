        <PAGEOBJECT XPOS="136.001" YPOS="62456.2269999999" OwnPage="149" ItemID="336757045" PTYPE="4" WIDTH="522" HEIGHT="209.913127388623" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 209.913 L0 209.913 L0 0 Z" copath="M0 0 L522 0 L522 209.913 L0 209.913 L0 0 Z" gXpos="136.001" gYpos="62456.2269999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Satis vērō recuperātī sunt nostrī dē equīs et dē aliīs multīs, quae erant illīs valdē necessāria. Et centum capita mortuōrum dētulērunt ante portam cīvitātis, ubi lēgātī ammirātī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Babylōniae castramētātī fuerant, quī mittēbantur seniōribus. Illī quī remānserant in tentōriīs, tōtā diē proeliātī sunt cum illīs quī erant in cīvitāte, ante trēs portās cīvitātis. Factum est hoc bellum in diē"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" Mārtis ante caput ieiūniī, quīntō īdūs Februāriī, favente Dominō nostrō Iēsu Chrīstō, quī cum Patre et Spīritū Sānctō vīvit et rēgnat, Deus per immortālia saecula saeculōrum, Āmēn."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="62666.1401273885" OwnPage="149" ItemID="336862917" PTYPE="4" WIDTH="522" HEIGHT="67.8726114649689" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 67.8726 L0 67.8726 L0 0 Z" copath="M0 0 L522 0 L522 67.8726 L0 67.8726 L0 0 Z" gXpos="136.001" gYpos="62666.1401273885" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Where the legates of the emir of Babylon had camped, who were sent by the elders."/>
                <ITEXT CH=" Hagenmeyer (p. 274, note 44) notes that Babylon here refers to Cairo, Egypt."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="February 9th 1098."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="62456.2269999999" OwnPage="150" ItemID="339906149" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="62456.2269999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="aliīs: others; plural ablative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="amen: amen, truly, verily"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ammirātī: of the emir; singular genitive loanword from Arabic"/>

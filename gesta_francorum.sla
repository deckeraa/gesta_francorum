                <para PARENT="Vocab"/>
                <ITEXT CH="sūrsum: on top, upward"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tantā: so much, so great; singular feminine ablative from tantus, tanta, tantum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trīstibus: sad; plural ablative from trīstis, trīstis, trīste"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnā: one; singular feminine ablative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnit: he came; 3rd person singular perfect active from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vērō: and, truly, even so, still"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vīdī: I saw; 1st person singular perfect active from videō, vidēre, vīdī, vīsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vīsiōne: vision; singular feminine ablative from vīsiō, vīsiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vōbīs: you; plural dative or ablative from tu"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="93240.3379999998" OwnPage="223" ItemID="497525525" PTYPE="4" WIDTH="522" HEIGHT="328.935885350525" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 328.936 L0 328.936 L0 0 Z" copath="M0 0 L522 0 L522 328.936 L0 328.936 L0 0 Z" gXpos="136.001" gYpos="93240.3379999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Cui respondī: &quot;Nōn&quot;. Hīs dictīs, ecce appāruit integra crux in capite eius. Iterum ergō interrogāvit mē Dominus dīcēns: &quot;Āgnōscis mē&quot;? Cui dīxī: &quot;Tē aliō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" modō nōn āgnōscō, nisi quia crucem in capite tuī cernō sīcut Salvātōris nostrī&quot;. Quī dīxit: &quot;Ego sum&quot;. Statim cecidī ad pedēs eius, rogāns humiliter ut subvenīret nōbīs in oppressiōne illā, quae super nōs erat."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Respondit Dominus: &quot;Bene adiūvī vōs, et āmodo adiuvābō. Ego permīsī vōs habēre Nīcēam cīvitātem, et omnia dēvincere bella, et condūxī vōs hūc ūsque, et condoluī vestrae miseriae, quam passī fuistis in obsidiōne Antiochīae. Ecce in auxiliō oportūnō mīsī vōs sānōs et incolumēs in cīvitātem; et ecce, multam prāvam dīlēctiōnem operantēs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" cum Chrīstiānīs et prāvīs pāgānīs mulieribus, unde immēnsus fētor ascendit in caelum.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="93569.2738853503" OwnPage="223" ItemID="497550789" PTYPE="4" WIDTH="522" HEIGHT="100.433121019116" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 100.433 L0 100.433 L0 0 Z" copath="M0 0 L522 0 L522 100.433 L0 100.433 L0 0 Z" gXpos="136.001" gYpos="93569.2738853503" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I didn't recognize you in any other way, except that I see a cross on your head like our Lord."/>
                <ITEXT CH=" This incident, of a Christian not being able to recognize Christ right away, is reminiscent of the incident on the road to Emmaus in Luke 24:13-25."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="(You are) working much wicked love with Christians and wicked pagan women, from whence an immense stench ascends into heaven."/>
                <ITEXT CH=" Some of the Crusaders, after entering Antioch, had committed fornication or adultery with the inhabitants."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="93240.3379999998" OwnPage="224" ItemID="500773765" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="93240.3379999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

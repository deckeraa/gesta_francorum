                <para PARENT="Vocab"/>
                <ITEXT CH="Saracēnōrum: of Saracenes, Muslims"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sē: himself or themselves"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="servientem: a servant; singular masculine accusative, the word derives from a perfect passive participle of servīre"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suum: his; singular masculine accusative from suus, sui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tenuērunt: they held; 3rd person plural perfect active from teneō, tenēre, tenuī, tentus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terram: land; singular feminine accusative from terra, terrae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tōtā: whole; singular feminine ablative from tōtus, tōta, tōtum (gen -ius)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trādētur: it will be handed over; 3rd person singular future passive from trādō, trādere, trādidī, trāditus"/>

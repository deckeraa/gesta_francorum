        <PAGEOBJECT XPOS="136.001" YPOS="15032.056" OwnPage="35" ItemID="111379141" PTYPE="4" WIDTH="522" HEIGHT="419.510878980889" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 419.511 L0 419.511 L0 0 Z" copath="M0 0 L522 0 L522 419.511 L0 419.511 L0 0 Z" gXpos="136.001" gYpos="15032.056" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Liber 2"/>
                <para PARENT="Chapter Heading"/>
                <para PARENT="Chapter Heading"/>
                <tab/>
                <ITEXT CH="Mandāvit īnfēlīx imperātor simul cum nostrīs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" nūntiīs ūnī ex suīs, quem valdē dīligēbat, quem et Corpalatium vocant, ut nōs sēcūrē dēdūceret per terram suam, dōnec venīrēmus Cōnstantīnopolim. Cumque trānsīrēmus ante illōrum cīvitātēs, iubēbat habitātōribus terrae ut nōbīs asportārent mercātum, sīcut faciēbant et illī quōs dīximus. Certē tantum timēbant fortissimam gentem dominī Boamundī, ut nūllum nostrōrum sinerent intrāre mūrōs cīvitātum. Voluēruntque nostrī quoddam castrum aggredī et apprehendere, eō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" quod erat plēnum omnibus bonīs. Sed vir prūdēns Boamundus nōluit cōnsentīre, tantum"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" prō iūstitiā terrae quantum prō fīdūciā imperātōris. Unde"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" valdē īrātus est cum Tancredō et aliīs omnibus. Hoc factum est vespere. Māne"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" vērō factō, exiērunt habitātōrēs castrī, et cum prōcessiōne dēferentēs in manibus crucēs, vēnērunt in praesentiam Boamundī. Ipse vērō gaudēns recēpit eōs, et cum laetitia abīre permīsit illōs."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="15451.5668789809" OwnPage="35" ItemID="111726949" PTYPE="4" WIDTH="522" HEIGHT="171.974522292987" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 171.975 L0 171.975 L0 0 Z" copath="M0 0 L522 0 L522 171.975 L0 171.975 L0 0 Z" gXpos="136.001" gYpos="15451.5668789809" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The unhappy emperor commanded (to join) with us one of his (people), whom he greatly loved, and whom they call the Cūropalātius"/>
                <ITEXT CH=". Cūropalātius is a title for a palace minister that derives from "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="cūrātor palātiī"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="In which there was plenty of every good (thing)."/>
                <ITEXT CH=" The phrase "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="eō quod"/>
                <ITEXT CH=" could also be translated as meaning "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="because"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="But the prudent man Bohemond didn't want to consent (to seizing the castle), as much for justice for the land as for faithfulness to the emperor."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="On account of which (Bohemond) was very angry with Tancred and all the others."/>
                <ITEXT CH=" Tancred and the others wanted to attack the castle, but Bohemond prevented them from doing so."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="It having become morning, the inhabitants of the castle came out, and with a procession bearing in their hands crosses, they came into the presence of Bohemond."/>
                <ITEXT CH=" Presumably after the inhabitants came out and were happily received by Bohemond, they agreed to sell/give the crusaders the foodstuffs they required."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="15032.056" OwnPage="36" ItemID="115586149" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="15032.056" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

        <PAGEOBJECT XPOS="136.001" YPOS="128184.464" OwnPage="307" ItemID="683212229" PTYPE="4" WIDTH="522" HEIGHT="353.879949044931" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 353.88 L0 353.88 L0 0 Z" copath="M0 0 L522 0 L522 353.88 L0 353.88 L0 0 Z" gXpos="136.001" gYpos="128184.464" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Boamundus autem nōn potuit apud comitem Sānctī Egidiī concordārī super id quod petēbat, īrātusque reversus est Antiochīam. Comes igitur Raimundus nōn diū morātus mandāvit per suōs lēgātōs Antiochīae ducī Godefridō et Flandrensī comitī ac Rotbertō Nortmannō et Boamundō, ut ipsī venīrent ad Rugiam cīvitātem loquī cum eō. Vēnēruntque illūc omnēs seniōrēs et fēcērunt concilium, quōmodo honestē possent tenēre viam Sānctī Sepulchrī, prō quā mōtī sunt et ūsque hūc perventum sit"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=". Nequīvērunt concordāre cum Raimundō Boamundum, nisi Raimundus comes redderet Antiochīam eī. Nōluit comes ad hoc assentīre prō fīdūciā quam fēcerat imperātōrī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Comitēs dēnique et dux reversī sunt in Antiochīam ūnā cum Boamundō. Comes vērō Raimundus reversus est ad Marram, ubi peregrīnī erant. Mandāvit quoque suīs mīlitibus honestāre palātium et castellum quod erat suprā portam pontis cīvitātis."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="128538.343949045" OwnPage="307" ItemID="680986165" PTYPE="4" WIDTH="522" HEIGHT="51.120050955069" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 51.1201 L0 51.1201 L0 0 Z" copath="M0 0 L522 0 L522 51.1201 L0 51.1201 L0 0 Z" gXpos="136.001" gYpos="128538.343949045" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH="Presumably "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="sit"/>
                <ITEXT CH=" is singular to refer to the group of Crusaders as a singular whole. The critical text lists the plural "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="fuerant"/>
                <ITEXT CH=" as a variant in a single manuscript."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

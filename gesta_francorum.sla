        <PAGEOBJECT XPOS="136.001" YPOS="21688.08" OwnPage="51" ItemID="140228773" PTYPE="4" WIDTH="522" HEIGHT="199.461401273878" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 199.461 L0 199.461 L0 0 Z" copath="M0 0 L522 0 L522 199.461 L0 199.461 L0 0 Z" gXpos="136.001" gYpos="21688.08" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tancredus vērō et Richardus dē Prīncipātū propter iūsiūrandum imperātōris latenter trānsfretāvērunt Brāchium, et ferē omnis gēns Boamundī iuxtā illōs. Et mox exercitus comitis Sānctī Egidiī appropinquāvit Cōnstantīnopolī. Comes vērō remānsit ibi cum ipsā suā gente. Vir itaque prūdēns"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Boamundus remānsit cum imperātōre, ut cum eō cōnsilium acciperet, quōmodo mandārent mercātum gentibus quae erant ultrā Nicēnam cīvitātem. Dux itaque Godefridus īvit prius Nīcomēdīam simul cum Tancredō, et aliīs omnibus, fuēruntque ibi per trēs diēs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="21887.5414012739" OwnPage="51" ItemID="140968213" PTYPE="4" WIDTH="522" HEIGHT="43.1082802547753" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 43.1083 L0 43.1083 L0 0 Z" copath="M0 0 L522 0 L522 43.1083 L0 43.1083 L0 0 Z" gXpos="136.001" gYpos="21887.5414012739" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH="Bohemond's decision to remain with the emperor and create a plan to send food to the crusaders in Nicea turned out to be very wise because the crusaders faced an acute food shortage at the beginning of the seige of Nicea."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

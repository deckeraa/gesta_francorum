                <para PARENT="Vocab"/>
                <ITEXT CH="pavēre: to be frightened; present active infinitive from paveō, pavēre, pāvī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pervēnērunt: they arrived; 3rd person plural perfect active from perveniō, pervenīre, pervēnī, perventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Pirus: A soldier charged with keeping watch over three towers during the siege of Antioch."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="placet: it pleases; 3rd person singular present active from placeō, placēre, placuī, placitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="praecēpit: he ordered; 3rd person singular perfect active from praecipiō, praecipere, praecēpī, praeceptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prūdēns: prudent, competent; singular nominative from prūdēns, prūdentis (gen.), prūdentior -or -us, prūdentissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quae: which; singular feminine nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quam: which; singular feminine accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quamobrem: why, for what reason? Derived from quam ob rem."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quantōcius: as quickly as possible (adverb)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quās: which; plural feminine accusative from quī"/>

                <para PARENT="Vocab"/>
                <ITEXT CH="retrō: behind, backwards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Rusam: Ρούσιον, modern-day Keşan, Turkey, which lies about 140 miles from Constantinople"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sat: enough"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Serra: Serres, a city in Macedonia."/>
                <para PARENT="Vocab"/>

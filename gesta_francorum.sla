        <PAGEOBJECT XPOS="136.001" YPOS="58296.2119999999" OwnPage="139" ItemID="313475589" PTYPE="4" WIDTH="522" HEIGHT="387.915388535112" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 387.915 L0 387.915 L0 0 Z" copath="M0 0 L522 0 L522 387.915 L0 387.915 L0 0 Z" gXpos="136.001" gYpos="58296.2119999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Itaque tālī modō inerat nōbīs maxima necessitās, quia Turcī undique constringēbant nōs, ita ut nūllus nostrōrum audēret iam exīre extrā tentōria. Nam illī cōnstringēbant nōs ex ūnā parte"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", et famēs cruciābat ex aliā. Succursus vērō et adiūtōrium nōbīs dēerat. Gēns"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" minūta et pauperrima fugiēbat Cyprum, Romāniam, et in montāneās. Ad mare utique nōn audēbāmus īre propter timōrem pessimōrum Turcōrum; nusquam erat nōbīs via patefacta."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Itaque audiēns dominus Boamundus innumerābilem gentem Turcōrum venientem super nōs, cautē vēnit ad aliōs, dīcēns: &quot;Seniōrēs et prūdentissimī mīlitēs, quid factūrī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" erimus? Nōs namque tantī"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" nōn sumus, ut in duābus partibus pugnāre valeāmus. Sed scītis quid faciēmus? Faciāmus ex nōbīs duās partēs"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=". Pars peditum remaneat iūgiter cūstōdīre pāpiliōnēs, et quībit nimis obsistere hīs, quī in cīvitāte sunt. Alia vērō pars mīlitum nōbīscum veniat obviam inimīcīs nostrīs, quī hīc hospitātī sunt prope nōs, in castellō Areg, ultrā pontem Farreum.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="58684.127388535" OwnPage="139" ItemID="313754341" PTYPE="4" WIDTH="522" HEIGHT="173.350318471334" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 173.35 L0 173.35 L0 0 Z" copath="M0 0 L522 0 L522 173.35 L0 173.35 L0 0 Z" gXpos="136.001" gYpos="58684.127388535" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For they, the Turks, were pressing upon us on the one hand, and hunger was torturing (us) on the other hand."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="A small, very poor, (group of) people fled to Cyprus, Byzantine Asia Minor, and into the mountains."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="What should we do?"/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For we are not so numerous, that we can fight on two fronts."/>
                <ITEXT CH=" Bohemond's advice two lines from this that they split the army into two groups seems to contradict this statement; the following options come to mind: (1) the 'two fronts' could refer to hunger and the Turks, and that Bohemond suggests fighting rather than starving, (2) the 'two fronts' refers to the siege on Antioch and the approaching Turkish army, so Bohemond is suggesting that they attack the Turkish army before it arrives at Antioch, (3) Bohemond suggests that they cannot win using a traditional battle formation, so his approach of taking just the elite knights as an attack force and leaving the rest to maintain the siege is not a contradiction of his statement."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Let's make two parties out of ourselves."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="58296.2119999999" OwnPage="140" ItemID="317936741" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="58296.2119999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

                <para PARENT="Vocab"/>
                <ITEXT CH="illō: that; singular masculine ablative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illōs: them; plural masculine accusative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="inimīcī: enemies; plural masculine nominative from inimicus, inimica -um, inimicior -or -us, inimicissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invāsērunt: they attacked; 3rd person plural perfect active from invādō, invādere, invāsī, invāsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="itaque: so then, therefore"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="loca: places; plural neuter accusative from locum, locī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīsērunt: they sent, set on fire (in context); 3rd person plural perfect active from mittō, mittere, mīsī, missus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="multōs: many; plural masculine accusative from multus, multa -um, -, plūrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrī: our; plural masculine nominative from noster"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="occīdērunt: they killed; 3rd person plural perfect from occīdō, occīdere, occīdī, occīsus: to kill"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnēs: all, every; plural common nominative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnia: all; plural neuter accusative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnīnō: entirely, altogether"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="perdidisse: to have lost; perfect active infinitive from perdō, perdere, perdidī, perditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="persecūtī: persecūtī sunt = they pursued; plural masculine nominative perfect participle from persequor, persequī, persecūtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pontem: bridge; singular masculine accusative from pōns, pontis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="potuērunt: they were able to; 3rd person plural perfect active from possum, posse, potuī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quae: which; plural neuter accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; plural masculine nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quod: that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rediērunt: they returned; 3rd person plural perfect active from redeō, redīre, redivī(iī), reditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="reperīre: to discover, find out; present active infinitive from reperiō, reperīre, repperī, repertus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="retrōrsum: behind, backwards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="reversī: reversī sunt = they returned; plural masculine nominative perfect participle from revertor, revertī, reversus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="scientēs: knowing; plural common nominative present participle from sciō, scīre, scīvī, scītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="spoliāvērunt: they plundered; 3rd person plural perfect active from spoliō, spoliāre, spoliāvī, spoliātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="stupefactī: having been made senseless, stupified; plural masculine nominative perfect passive participle from stupefaciō, stupefacere, stupefēcī, stupefactus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="superātī: superātī sunt = they were overcome; plural masculine nominative perfect passive participle from superō, superāre, superāvī, superātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Surānī: Syrians"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suum: his; singular masculine accusative from suus, sui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tam: so"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tōtumque: and the whole; singular neuter accusative from tōtus, tōta, tōtum (gen -ius)"/>
                <para PARENT="Vocab"/>

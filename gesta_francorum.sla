                <para PARENT="Vocab"/>
                <ITEXT CH="quoniam: since, insofar"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quoque: also"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="reditūrus: erō reditūrus = I will return; singular masculine nominative future participle from redeō, redīre, rediī, reditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rēgālem: royal; singular common accusative from rēgālis, rēgālis, rēgāle"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Romaniā: Byzantine Asia Minor (ablative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Romaniam: Byzantine Asia Minor (accusative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sciant: they may know; 3rd person plural subjunctive present from sciō, scīre, scīvī, scītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sententiam: judgement; singular feminine accusative from sententia, sententiae"/>

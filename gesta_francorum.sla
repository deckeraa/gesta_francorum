        <PAGEOBJECT XPOS="136.001" YPOS="79096.2869999999" OwnPage="189" ItemID="420682933" PTYPE="4" WIDTH="522" HEIGHT="119.305356688055" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 119.305 L0 119.305 L0 0 Z" copath="M0 0 L522 0 L522 119.305 L0 119.305 L0 0 Z" gXpos="136.001" gYpos="79096.2869999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Haec omnia gesta sunt tertiā"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" diē intrante mēnsē Iūniō, quīntā fēriā, III nōnās Iūniī. Omnēs namque platēae cīvitātis iam undique erant plēnae cadāveribus mortuōrum, ita"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" ut nēmō posset sufferre ibi esse prae nimiīs fetōribus. Nūllus vērō poterat īre per sēmitam cīvitātis, nisī super cadāvera mortuōrum."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="79215.5923566879" OwnPage="189" ItemID="421188357" PTYPE="4" WIDTH="522" HEIGHT="46.3184713375813" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 46.3185 L0 46.3185 L0 0 Z" copath="M0 0 L522 0 L522 46.3185 L0 46.3185 L0 0 Z" gXpos="136.001" gYpos="79215.5923566879" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH="June 3, 1098"/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that no one could endure to be there because of the excessive stenches."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="79096.2869999999" OwnPage="190" ItemID="425276037" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="79096.2869999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

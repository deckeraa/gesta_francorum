                <para PARENT="Vocab"/>
                <ITEXT CH="Godefridō: Godfrey of Bouillon (~1060-1100 AD), first ruler of the Kingdom of Jerusalem (dative or ablative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="grātiā: grace; singular feminine ablative from grātia, grātiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hāc: this; singular feminine ablative of hic, haec, hoc"/>

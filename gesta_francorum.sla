        <PAGEOBJECT XPOS="136.001" YPOS="154808.56" OwnPage="371" ItemID="806222069" PTYPE="4" WIDTH="522" HEIGHT="305.427261146921" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 305.427 L0 305.427 L0 0 Z" copath="M0 0 L522 0 L522 305.427 L0 305.427 L0 0 Z" gXpos="136.001" gYpos="154808.56" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Hūc condūxī ad conventiōnem ducenta mīlia mīlitum, et videō ipsōs laxīs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" frēnīs fugientēs per viam Babylōnicam, et nōn audent revertī adversus gentem Francigēnam. Iūrō per Machumet et per omnia deōrum nūmina, quod ulterius nōn retinēbō mīlitēs conventiōne aliquā, quia expulsus sum ā gente advenā. Condūxī omnia armōrum genera et omnia īnstrūmenta sīve māchināmenta, ut eōs obsīderem in Hierūsalēm, et ipsī praevēnērunt mē ad bellum itinere diērum duōrum. Heu mihi! Quid amplius dīcam? Inhonōrātus erō semper in terrā Babylōnicā.&quot;"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Nostrī autem accēpērunt eius stantarum, quod comparāvit comes dē Nortmanniā vīgintī marchās argentī et dedit patriarchae in Deī honōrem et Sānctīque Sepulchrī; ēnsem vērō ēmit quīdam"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" sexāgintā bisanteīs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="155114.56" OwnPage="371" ItemID="806714725" PTYPE="4" WIDTH="522" HEIGHT="66.6884076437273" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 66.6884 L0 66.6884 L0 0 Z" copath="M0 0 L522 0 L522 66.6884 L0 66.6884 L0 0 Z" gXpos="136.001" gYpos="155114.56" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="With lax bridles"/>
                <ITEXT CH=" or "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="with loose reins"/>
                <ITEXT CH=" means that the horseman is not steering but is merely letting the horse run as quickly as possible."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="A certain (person) bought the sword (plundered from the emir by the Count of Normandy) for 60 bezants."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="154808.56" OwnPage="372" ItemID="809451781" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="154808.56" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

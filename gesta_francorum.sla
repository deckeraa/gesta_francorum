        <PAGEOBJECT XPOS="136.001" YPOS="11704.044" OwnPage="27" ItemID="95273365" PTYPE="4" WIDTH="522" HEIGHT="354.809503184713" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 354.81 L0 354.81 L0 0 Z" copath="M0 0 L522 0 L522 354.81 L0 354.81 L0 0 Z" gXpos="136.001" gYpos="11704.044" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="At bellipotēns Boamundus quī erat in obsidiōne"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Malfī, Scafardī pontīs, audiēns vēnisse"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" innumerābilem gentem Chrīstiānōrum dē Francīs, itūram ad Dominī Sepulchrum, et parātam ad proelium contrā gentem pāgānōrum, coepit dīligenter inquīrere quae arma pugnandī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" haec gēns dēferat, et quam ostēnsiōnem Chrīstī in viā portet, vel quod signum in certāmine sonet"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=". Cui per ōrdinem haec dicta sunt: 'Dēferunt arma ad bellum congrua, in dextrā vel inter utrāsque"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" scapulās crucem Chrīstī baiulant; signum vērō &quot;Deus vult"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=", Deus vult, Deus vult!&quot; ūnā vōce conclāmant. Mox Sānctō commōtus"/>
                <ITEXT FEATURES="inherit superscript" CH="7"/>
                <ITEXT CH=" Spīritū, iussit pretiosissimum pallium quod apud sē habēbat incīdī, tōtumque statim in crucēs expendit. Coepit tunc ad eum vehementer concurrere maxima pars mīlitum quī erant in obsidiōne illā, adeō ut Rogerius"/>
                <ITEXT FEATURES="inherit superscript" CH="8"/>
                <ITEXT CH=" comes paene sōlus remānserit, reversusque Siciliam dolēbat et maerēbat quandōque gentem āmittere suam."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="12059.3121019108" OwnPage="27" ItemID="95424597" PTYPE="4" WIDTH="522" HEIGHT="336.152866242068" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 336.153 L0 336.153 L0 0 Z" copath="M0 0 L522 0 L522 336.153 L0 336.153 L0 0 Z" gXpos="136.001" gYpos="12059.3121019108" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And Bohemond, powerful at war, who was in the siege of Amalfi on Gulf of Salerno."/>
                <ITEXT CH=" Bohemond was already involved in an siege when he heard of the crusade, which he became interested in joining. For more information on Malfi, see footnote 3 on page 149 of Hagenmeyer."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Hearing an innumerable Christian people to have come from Frankish lands, to journey to the Lord's Sepulchre, and prepared to battle against the pagan people."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which weapons for fighting this people was carrying."/>
                <ITEXT CH=" "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Quae"/>
                <ITEXT CH=" here is neuter plural accusative and refers to "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="arma"/>
                <ITEXT CH=", which is the direct object of the relative clause."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Or what war-cry (or sound or sign) sounded forth in battle."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They bear the cross of Christ on the right (shoulder) or between either shoulder."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And the war-cry (or sign) they exclaimed with one voice: &quot;God wills (it, the conquest of the pilgrimage route to the Holy Sepulchre), God wills (it), God wills (it)&quot;"/>
                <ITEXT CH=". Some manuscripts read 'Deus le vult', which is a version closer to French than &quot;Deus vult&quot;."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="7"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Soon, having been moved by the Holy Spirit, he ordered his most precious palliam (cloak) which he had with him to be cut up, and immediately wholly made into crosses."/>
                <ITEXT CH=" After hearing about the crusade, Bohemond wanted to join, and cut up a cloak into crosses for his soldiers to stitch onto their clothes."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="8"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that Count Roger had remained almost alone, and returned to Sicily and was pained and sorrowful because his people (army) had left him (to go on crusade)."/>
                <ITEXT CH=" The appeal of going on crusade was so popular that Roger I of Sicily, Bohemond's uncle, had to call off the siege because too many of his soldiers went with Bohemond on Crusade. Bohemond, the son of Robert Guiscard, was declared illegitimate after Robert's marriage with Bohemond's mother was annulled due to consanguinity; this disinheritance may have contributed to Bohemond choosing to go on crusade to seek out a new kingdom. He was successful at this and became the Prince of Antioch from 1098 to 1111."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="11704.044" OwnPage="28" ItemID="98795733" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="11704.044" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adeō: thus far"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="āmittere: to lose; present active infinitive from āmittō, āmittere, āmīsī, āmissus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="apud: at, by, near"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="arma: weapons; plural neuter accusative from armum, armī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="at: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="audiēns: hearing; singular nominative present participle from audiō, audīre, audīvī, audītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="baiulant: they bear, carry; 3rd person plural present active from bāiulō, bāiulāre, bāiulāvī, bāiulātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bellipotēns: mighty in war; singular nominative from bellipotēns, (gen.), bellipotentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bellum: battle, war; singular neuter accusative from bellum, bellī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundus: Bohemond I of Antioch"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="certāmine: contest, struggle; singular neuter ablative from certāmen, certāminis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstī: of Christ; singular masculine genitive from Chrīstus, Chrīstī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstiānōrum: of Christians; plural masculine genitive from Chrīstiānus, Chrīstiānī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="coepit: he started; 3rd person singular present active from coepio, coepere, coepi, coeptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="comes: comrade; singular common nominative from comes, comitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="commōtus: having been moved; singular masculine nominative perfect passive participle from commoveō, commovēre, commōvī, commōtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="conclāmant: they cry out; 3rd person plural present active from conclāmō, conclāmāre, conclāmāvī, conclāmātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="concurrere: to run together, concur; present active infinitive from concurro, concurrere, concucurri, concursus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="congrua: suitable, fit; plural neuter accusative from congruus, congrua, congruum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="contrā: against, away from, facing"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="crucem: cross; singular feminine accusative from crux, crucis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="crucēs: crosses; plural feminine accusative from crux, crucis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cui: to whom; singular dative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dē: of, from, away from, down from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēferat: it (the people) transfers; 3rd person singular present active subjunctive from dēferō, dēferre, dētulī, dēlātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēferunt: they transfer; 3rd person plural present active from dēferō, dēferre, dētulī, dēlātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Deus: god; singular masculine nominative from Deus, Dei"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dextrā: right side; singular feminine ablative from dexter, dextra -um, dexterior -or -us, dextimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dicta: dicta sunt = were said; plural neuter nominative perfect passive participle from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīligenter: diligently"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dolēbat: he was sorrying, grieving, feeling pain; 3rd person singular imperfect active from doleō, dolēre, doluī, dolitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Dominī: of the Lord; singular masculine genitive from dominus, dominī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erant: they were; 3rd person plural imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erat: he was; 3rd person singular imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eum: to him; singular masculine accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="expendit: he gave out; 3rd person singular perfect active from expendō, expendere, expendī, expēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Francīs: the Franks (ablative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gēns: people, clan, nation; singular feminine nominative from gēns, gentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gentem: people, clan, nation; singular feminine accusative from gēns, gentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="habēbat: he had; 3rd person singular imperfect active from habeō, habēre, habuī, habitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="haec: these; plural neuter nominative from hic, haec, hoc"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illā: that; singular feminine ablative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="incīdī: to be cut; present passive infinitive from incīdō, incīdere, incīdī, incīsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="innumerābilem: countless; singular common accusative from innumerābilis, innumerābilis, innumerābile"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="inquīrere: to inquire; present active infinitive from inquīrō, inquīrere, inquīsīvī, inquīsītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="inter: between, among, during"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="itūram: going; singular feminine accusative future participle from eō, īre, ivī(iī), itus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iussit: he commanded; 3rd person singular perfect from iubeō, iubēre, iussī, iussus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="maerēbat: he was mourning; 3rd person singular imperfect active from maereō, maerēre, -, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Malfi: Amalfi, a city on the Gulf of Salerno"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="maxima: very large; singular feminine nominative from māgnus, māgna -um, major -or -us, maximus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīlitum: of soldiers; plural masculine genitive from mīles, mīlitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mox: soon"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="obsidiōne: seige; singular feminine ablative from obsidiō, obsidiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ōrdinem: order; singular masculine accusative from ōrdō, ōrdinis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ostensiōnem: battle standard (literally: presenting, showing, exhibiting); singular feminine accusative from ostensiō, ostensiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="paene: almost"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pāgānōrum: of pagans; plural masculine genitive from pāgānus, pāgānī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pallium: cloak; singular neuter accusative from pallium, palliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="parātam: having been prepared; singular feminine accusative perfect passive participle from parō, parāre, parāvī, parātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pars: part; singular feminine nominative from pars, partis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pontis: of the bridge; singular masculine genitive from pōns, pontis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="portet: it might carry; 3rd person singular present active subjunctive from portō, portāre, portāvī, portātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pretiosissimum: most precious; singular neuter accusative from pretiōsus, pretiōsa -um, pretiōsior -or -us, pretiōsissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="proelium: battle, conflict; singular neuter accusative from proelium, proeliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pugnandī: of fighting; singular masculine genitive future passive participle from pugnō, pugnāre, pugnāvī, pugnātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quae: which; plural neuter accusative of quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quam: which: singular feminine accusative"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quandō: when, because"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; singular masculine nominative of quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quod: which; singular neuter accusative of quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="remānserit: they remained; 3rd person singular perfect active subjunctive from remaneō, remanēre, remānsī, remānsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="reversus: reversus + est = he returned"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Rogerius: Roger Guiscard, a Norman prince in southern Italy and Sicily, c. 1015 – 17 July 1085, father of Bohemond I of Antioch"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Sānctō: holy (ablative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Scafardī: this appears to refer to Sicard, Prince of Benevento from 832-839 AD, and is to do communicate when Amalfi is referred to: it is the one near the Duchy of Benevento. For more information, see footnote 3 on page 149 of Hagenmeyer."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="scapulās: shoulders, back; plural feminine accusative from scapula, scapulae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sē: himself"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Sepulchrum: grave; singular neuter accusative from sepulchrum, sepulchrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Siciliam: Sicily; singular feminine accusative from Sicilia, Siciliae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="signum: sign, battle-cry (in context); singular neuter nominative from signum, signī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sōlus: alone; singular masculine nominative from sōlus, sōla, sōlum (gen -ius)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sonet: it sounds; 3rd person singular present active subjunctive from sonō, sonāre, sonāvī, sonatus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sonum: sound; singular masculine accusative from sonus, sonī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Spīritū: spirit; singular masculine ablative from spīritus, spīritūs"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="statim: immediately"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suam: her; singular feminine acc. from suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tōtum: whole, total; singular neuter accusative from tōtus, tōta, tōtum (gen -ius)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tunc: then"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnā: one; singular feminine ablative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="utrās: either, both; plural feminine accusative from uterque"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vehementer: vehemently"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vel: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnisse: to have come; perfect active infinitive from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vērō: and, truly, even so, still"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="viā: road; singular feminine ablative from via, viae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vōce: voice; singular feminine ablative from vōx, vōcis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vult: he wants; singular 3rd person present from volō, velle, voluī (irr.)"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="12536.047" OwnPage="29" ItemID="99302965" PTYPE="4" WIDTH="522" HEIGHT="442.755547770701" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 442.756 L0 442.756 L0 0 Z" copath="M0 0 L522 0 L522 442.756 L0 442.756 L0 0 Z" gXpos="136.001" gYpos="12536.047" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Dēnique reversus iterum in terram suam dominus Boamundus dīligenter honestāvit sēsē ad incipiendum Sānctī Sepulchrī iter. Tandem trānsfretāvit mare cum suō exercitū, et cum eō Tancredus"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Marchīsī fīlius, et Richardus prīnceps, ac Rainulfus frāter eius, et Rotbertus dē Ānsā, et Hermannus dē Cannī, et Rotbertus dē Surdā Valle, et Robertus fīlius Tostānī, et Hunfredus fīlius Radulfī, et Ricardus fīlius comitis Rainulfī, et comes dē Russignōlō cum frātribus suīs, et Boellō Carnotēnsis, et Alberedus dē Cagnānō, et Hunfredus dē Monte Scabiōsō. Hī omnēs trānsfretāvērunt ad Boamundī famulātum, et applicuērunt Bulgāriae partibus; ubi invēnērunt nimiam abundantiam frūmentī et vīnī et alimentōrum corporis. Deinde dēscendentēs in vallem dē Andronopōlī; exspectāvērunt gentem suam, dōnec omnēs pariter trānsfretāssent. Tunc sapiēns Boamundus ōrdināvit concilium cum gente suā, cōnfortāns et monēns omnēs, dīcēns: 'Seniōrēs, cavēte omnēs vōs, quia sumus peregrīnī Deī. Oportet igitur esse magis bonōs et humilēs quam ante fuimus, et nōlīte depredārentur terram istam, quia Chrīstiānōrum est, et nēmō accipiat plūs, nisi quod eī sufficeret ad edendum prō benedictiōne.'"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="12978.8025477707" OwnPage="29" ItemID="100642677" PTYPE="4" WIDTH="522" HEIGHT="50.9044585987249" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 50.9045 L0 50.9045 L0 0 Z" copath="M0 0 L522 0 L522 50.9045 L0 50.9045 L0 0 Z" gXpos="136.001" gYpos="12978.8025477707" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH="TODO list out the people"/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="12536.047" OwnPage="30" ItemID="104809269" PTYPE="4" WIDTH="522" HEIGHT="372.589942675158" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 372.59 L0 372.59 L0 0 Z" copath="M0 0 L522 0 L522 372.59 L0 372.59 L0 0 Z" gXpos="766.001" gYpos="12536.047" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="TODO 01_orig_13.txt"/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="13368.05" OwnPage="31" ItemID="105835781" PTYPE="4" WIDTH="522" HEIGHT="388.790764331201" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 388.791 L0 388.791 L0 0 Z" copath="M0 0 L522 0 L522 388.791 L0 388.791 L0 0 Z" gXpos="136.001" gYpos="13368.05" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tunc exeuntēs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" inde, vēnērunt per nimiam plēnitūdinem dē vīllā in vīllam, dē cīvitāte in cīvitātem, dē castellō in castellum, quousque pervēnimus Castōriam; ibique Nātīvitātem Dominī sollemniter celebrāvimus; fuimusque ibi per plūrēs diēs, et quaesivimus"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" mercātum, sed ipsī nōluērunt nōbīs assentīre, eō quod valdē timēbant nōs, nōn putantēs nōs esse peregrīnōs, sed velle populārī terram et occīdere illōs. Quāpropter"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" apprehendēbāmus bovēs, equōs et asinōs, et omnia quae inveniēbāmus. Ēgressī dē Castōriā, intrāvimus Palagōniam, in quā erat quoddam hereticōrum castrum. Quod undique aggressī"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" sumus, moxque nostrō succubuit imperiō; accēnsō itaque īgne, combussimus castrum cum habitātōribus suīs. Posteā pervēnimus ad flūmen Bardārum. Dēnique perrēxit dominus Boamundus ultrā"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" cum suā gente, sed nōn tōtā. Remānsit enim ibi comes dē Russignōlō, cum frātribus suīs. Vēnit exercitus"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" imperātōris, et invāsit comitem cum frātribus suīs, et omnēs quī erant cum eīs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="13756.8407643312" OwnPage="31" ItemID="105822005" PTYPE="4" WIDTH="522" HEIGHT="227.439490445871" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 227.439 L0 227.439 L0 0 Z" copath="M0 0 L522 0 L522 227.439 L0 227.439 L0 0 Z" gXpos="136.001" gYpos="13756.8407643312" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Then going out from there, they came through a great multitude (of places) from villa to villa, from city to city, from castle to castle, until we came to Kastoria."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And we sought a market (in which to buy food and other provisions), but they themselves (the residents of Kastoria) didn't want to agree with us (to give us a market), the reason being that they were greatly fearing us, not thinking us to be pilgrims, but (rather) wanting to ravage the land and kill them."/>
                <ITEXT CH=" The phrase "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="eō quod "/>
                <ITEXT CH="is an idiom for 'because' or 'for this reason'."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="On account of which we took cows, horses, and asses, and everything that we were finding."/>
                <ITEXT CH=" Since they couldn't buy provisions, they simply took them."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which we attacked on all sides, and soon it fell under our control"/>
                <ITEXT CH=". "/>
                <ITEXT FONT="DejaVu Serif Book" CH="The verb phrase "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="aggressī sumus"/>
                <ITEXT CH=" has an active meaning because "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="aggredior"/>
                <ITEXT CH=" is deponent."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Finally the lord Bohemond proceeded beyond (the river) with his people, but not with all (his people)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The emperor's army came and attacked the count with his brothers, and everyone who was with them."/>
                <ITEXT CH=" As seen on the next page, according to this account the Byzantine emperor sent Turcopoles and Pechenegs to attack a crusader garrison."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

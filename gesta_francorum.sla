        <PAGEOBJECT XPOS="136.001" YPOS="16696.062" OwnPage="39" ItemID="121494933" PTYPE="4" WIDTH="522" HEIGHT="205.173668789805" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 205.174 L0 205.174 L0 0 Z" copath="M0 0 L522 0 L522 205.174 L0 205.174 L0 0 Z" gXpos="136.001" gYpos="16696.062" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Ibi etiam doctus Boamundus tōtam gentem suam dīmīsit, perrēxitque"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" loquī cum imperātōre Cōnstantīnopolim, suīsque"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" hominibus imperāvit, dīcēns: 'Modeste"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" appropinquante cīvitātem, ego autem ībō prius,' quī et dūxit sēcum paucōs mīlitēs. Tancredus remānsit caput mīlitiae Chrīstī, vidēnsque"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" peregrīnōs cibōs emere, ait intrā sē, quod exīret extrā viam, et tunc populum condūceret ubi fēlīciter vīveret. Dēnique intrāvit in vallem quamdam plēnam omnibus bonīs, quae corporālibus nūtrīmentīs sunt congrua; in quā Pascha Dominī dēvōtissimē celebrāvimus."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="16901.2356687898" OwnPage="39" ItemID="121760373" PTYPE="4" WIDTH="522" HEIGHT="81.6305732484107" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 81.6306 L0 81.6306 L0 0 Z" copath="M0 0 L522 0 L522 81.6306 L0 81.6306 L0 0 Z" gXpos="136.001" gYpos="16901.2356687898" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And he left to speak with the emperor in Constantinople."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And he commanded his men."/>
                <ITEXT CH=" The verb "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="imperāre"/>
                <ITEXT CH=" takes the dative rather than the accusative."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="'When we are, in a disciplined manner, approaching the city, I will go first,' and who led with him a few soldiers."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And seeing the pilgrims (the crusaders) to buy food, he talked amongst them, that they might leave from the road, and then might conduct the people to where they might more happily live."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="16696.062" OwnPage="40" ItemID="124536597" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="16696.062" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="āit: he said; 3rd person singular present active from aio, -, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="appropinquante: approaching; singular ablative present participle from appropinquō, appropinquāre, appropinquāvī, appropinquātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundus: Bohemond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bonīs: good; plural neuter ablative from bonum, boni"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="caput: head; singular neuter nominative from caput, capitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="celebrāvimus: we celebrated; 1st person plural perfect active from celebrō, celebrāre, celebrāvī, celebrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstī: of Christ; singular masculine genitive from Chrīstus, Chrīstī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cibōs: food; plural masculine accusative from cibus, cibī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cīvitātem: city; singular feminine accusative from cīvitās, cīvitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="condūceret: they might assemble; 3rd person singular imperfect active subjunctive from condūcō, condūcere, condūxī, conductus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="congrua: suitable, fit; plural neuter nominative from congruus, congrua, congruum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Cōnstantīnopolim: Constantinople; singular feminine accusative from Constantinopolis, Constantinopolis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="corporālibus: physical, corporeal; plural ablative from corporālis, corporālis, corporāle"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēnique: finally"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēvōtissimē: very faithfully, devoutedly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīcēns: saying; singular nominative present participle from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīmīsit: he left; 3rd person singular perfect active from dīmittō, dīmittere, dīmīsī, dīmissus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="doctus: learned, knowledgeable; singular masculine nominative from doctus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dominī: of the lord; singular masculine genitive from dominus, dominī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dūxit: he led; 3rd person singular perfect from dūcō, dūcere, dūxī, ductus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ego: I;(pronoun)"/>

        <PAGEOBJECT XPOS="136.001" YPOS="17528.065" OwnPage="41" ItemID="124930005" PTYPE="4" WIDTH="522" HEIGHT="203.654745222924" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 203.655 L0 203.655 L0 0 Z" copath="M0 0 L522 0 L522 203.655 L0 203.655 L0 0 Z" gXpos="136.001" gYpos="17528.065" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Cum imperātor audīsset honestissimum virum Boamundum ad sē vēnisse, iussit eum honōrābiliter recipī, et cautē hospitārī extrā urbem. Quō hospitātō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", malignus imperātor mīsit prō eō, ut venīret loquī simul sēcrētō sēcum. Illūc quoque vēnit dux Godefridus cum frātre suō; ac deinde comes Sānctī Egidiī appropinquāvit cīvitātī. Tunc imperātor ānxiens et bulliēns īrā, cōgitābat quemadmodum callidē fraudulenterque comprehenderet hōs Chrīstī mīlitēs. Sed dīvīnā grātiā revēlante, neque locus neque nocendī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" spatium ab eō vel ā suīs inventa sunt."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="17731.7197452229" OwnPage="41" ItemID="125192197" PTYPE="4" WIDTH="522" HEIGHT="108.687898089174" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 108.688 L0 108.688 L0 0 Z" copath="M0 0 L522 0 L522 108.688 L0 108.688 L0 0 Z" gXpos="136.001" gYpos="17731.7197452229" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="In which (Bohemond) having been lodged, the wicked emperor sent for him, that he might secretly speak together with him."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Neither place nor space (of time) for being harmed by him or by his comrades was found."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="17528.065" OwnPage="42" ItemID="127913717" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="17528.065" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

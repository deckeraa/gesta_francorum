        <PAGEOBJECT XPOS="136.001" YPOS="32504.119" OwnPage="77" ItemID="191263413" PTYPE="4" WIDTH="522" HEIGHT="204.498834394893" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 204.499 L0 204.499 L0 0 Z" copath="M0 0 L522 0 L522 204.499 L0 204.499 L0 0 Z" gXpos="136.001" gYpos="32504.119" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Mīrābantur ergō nostrī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" valdē, unde esset exorta tanta multitūdō Turcōrum et Arabum et Saracēnōrum et aliōrum quōs ēnumerāre ignōrō; quia paene omnēs montēs et collēs et vallēs et omnia plāna loca intus et extrā undique erant cooperta dē illā excommūnicātā"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" generātiōne. Factus est itaque sermō sēcrētus inter nōs laudantēs et cōnsulentēs atque dīcentēs: &quot;Ēstote omnimodō ūnanimēs in fide Chrīstī et Sānctae Crucis vexillī victōriā, quia hodiē omnēs dīvitēs, sī Deō placet, effectī eritis.&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="32708.6178343949" OwnPage="77" ItemID="191715173" PTYPE="4" WIDTH="522" HEIGHT="107.331210191074" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 107.331 L0 107.331 L0 0 Z" copath="M0 0 L522 0 L522 107.331 L0 107.331 L0 0 Z" gXpos="136.001" gYpos="32708.6178343949" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Therefore our (soldiers) marveled greatly, from whence had arisen such a multitude of Turks and Arabs and Saracenes and others whom I do not know how to enumerate."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="Here 'excommunicate generation' is likely used in a non-technical sense, and the author just means that the peoples were non-Christian."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="There was made therefore a secret word (or conversation) amongst us, praising (God) and consulting (together) and saying 'Be altogether of one spirit in the faith of Christ and in the victory of the flag of the Holy Cross, because today you will all be made rich, if it pleases God."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="32504.119" OwnPage="78" ItemID="195127621" PTYPE="4" WIDTH="522" HEIGHT="720.000000000004" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="32504.119" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="aliōrum: of others; plural masculine genitive from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Arabum: of Arabs; plural masculine genitive from Arabs, Arabis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="atque: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstī: of Christ; singular masculine genitive from Chrīstus, Chrīstī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="collēs: hills; plural masculine nominative from collis, collis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōnsulentēs: consulting; plural common nominative present participle from cōnsulō, cōnsulere, cōnsuluī, cōnsultus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cooperta: erant cooperta = had been covered; singular feminine nominative perfect passive participle from cooperiō, cooperīre, cooperuī, coopertus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Crucis: of the Cross; singular feminine genitive from crux, crucis"/>

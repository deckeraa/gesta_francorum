        <PAGEOBJECT XPOS="136.001" YPOS="143160.518" OwnPage="343" ItemID="750611285" PTYPE="4" WIDTH="522" HEIGHT="333" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 333 L0 333 L0 0 Z" copath="M0 0 L522 0 L522 333 L0 333 L0 0 Z" gXpos="136.001" gYpos="143160.518" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tunc seniōrēs nostrī ōrdināvērunt quōmodo ingeniāre possent cīvitātem, ut ad adōrandum nostrī Salvātōris intrārent Sepulchrum. Fēcēruntque duo līgnea castra, et alia plūra māchināmenta. Dux Godefridus suum fēcit castrum cum māchinīs, et Raimundus comes similiter, quibus dē longinquīs terrīs attrahēbant ligna. Saracēnī igitur videntēs nostrōs facientēs hās māchinās, mīrābiliter mūniēbant cīvitātem et turrēs nocte accrēscēbant."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Videntēs autem nostrī seniōrēs ex quā parte esset cīvitās magis languidā, illūc in quādam nocte sabbatī dēportāvērunt nostram māchinam et līgneum castrum in orientālem partem. Summō autem dīlūculō ērēxērunt ea et aptāvērunt et ōrnāvērunt castrum, in prīmā et secundā ac tertiā fēriā. Comes namque Sānctī Egidiī, ā merīdiānā plagā reficiēbat suam māchinam."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="143160.518" OwnPage="344" ItemID="750899221" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="143160.518" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

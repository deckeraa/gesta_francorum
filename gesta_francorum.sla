                <para PARENT="Vocab"/>
                <ITEXT CH="plūs: more, from mūltus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="potuit: he was able; 3rd person singular perfect active from possum, posse, potuī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prō: for, in favor of, before, in place of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quam: plūs quam = more than"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quārē: why"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; singular or plural masculine nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quō: whom; singular ablative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="receptī: received; singular masculine genitive perfect passive participle from recipiō, recipere, recēpī, receptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sanguinem: blood; singular masculine accusative from sanguis, sanguinis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sē: himself"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="seu: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="stolam: robe; singular feminine accusative from stola, stolae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suscēpit: he undertook; 3rd person singular perfect active from suscipiō, suscipere, suscēpī, susceptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tam: as much, as much as"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trīnum: triple; singular masculine accusative from trīnus, trīna, trīnum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="triumphābant: they were celebrating, rejoicing; 3rd person plural imperfect active from triumphō, triumphāre, triumphāvī, triumphātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tuō: your; singular masculine ablative from tuus, tua, tuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ubī: where"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnum: one; singular masculine accusative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>

                <ITEXT CH="vidēlicet: namely"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="84920.3079999998" OwnPage="203" ItemID="455494901" PTYPE="4" WIDTH="522" HEIGHT="359.335312102092" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 359.335 L0 359.335 L0 0 Z" copath="M0 0 L522 0 L522 359.335 L0 359.335 L0 0 Z" gXpos="136.001" gYpos="84920.3079999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="&quot;Adhūc quoque sciant omnēs, quoniam"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" ego cūnctōs Francōs intus in Antiochīā conclūsōs habeō, et castrum in meā līberā teneō voluntāte, illī vērō deorsum sunt in cīvitāte. Habeō etiam omnēs illōs iam in meā manū, eōsque faciam"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" aut capitālem subīre sententiam, aut dēducī in Corrozānam in captīvitātem nimiam, eō quod minantur"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" nōs suīs armīs prōpulsāre et expellere ab omnibus fīnibus nostrīs aut ēiicere ultrā superiōrem Indiam, ceu ēiēcērunt omnēs pārentēs nostrōs ā Romāniā sīve Syriā.&quot;"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="&quot;Āmodo"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" iūrō vōbīs per Machomet et per omnia deōrum nōmina, quoniam ante vestram nōn erō reditūrus praesentiam, dōnec rēgālem urbem Antiochīam et omnem Suriam sīve Romāniam atque Bulgāriam usque in Āpūliam adquīsierō meā fortī dexterā, ad deōrum honōrem et vestrum, et omnium quī sunt ex genere Turcōrum.&quot; Sīc fēcit fīnem dictīs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="85279.1847133758" OwnPage="203" ItemID="451588805" PTYPE="4" WIDTH="522" HEIGHT="168.764331210186" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 168.764 L0 168.764 L0 0 Z" copath="M0 0 L522 0 L522 168.764 L0 168.764 L0 0 Z" gXpos="136.001" gYpos="85279.1847133758" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Because I have shut up inside Antioch all the Franks."/>
                <ITEXT CH=" The Crusaders successfully captured Antioch by means of Bohemond's work with Pirus; however, some Turks remained in the citadel inside the city and Curbaram's relief army forced the Crusaders themselves to enter Antioch and be besieged."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And I will make them to suffer a capital sentence (being put to death)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="In this (way) we will threaten to repulse and expel their armies from all our borders and to cast them (out) past upper India."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="From now on I swear to you by Mohammed and by the names of the Gods."/>
                <ITEXT CH=" This is an odd statement for a Muslim to make since Islam is monotheistic. This leaves two possibilities: the author of this work did not understand Islamic theology and made up the letter being described, or the letter is accurate and the Muslims at the time had a syncretistic system in which they were polytheists."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="84920.3079999998" OwnPage="204" ItemID="455605045" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="84920.3079999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ab: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adquīsierō: I will have acquired, obtained; 1st person singular future-perfect active from acquīrō, acquīrere, acquīsīvī, acquīsītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adhūc: until now"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="āmodo: from now on"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ante: before, in front, forwards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Antiochīā: Antioch (city in Roman Syria/modern Turkey); singular feminine nominative from Antiochīa, Antiochīae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Antiochīam: Antioch (city in Roman Syria/modern Turkey); singular feminine accusative from Antiochīa, Antiochīae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Āpūliam: Apulia, a region in eastern Italy; singular feminine accusative from Āpulia, Āpuliae"/>
                <para PARENT="Vocab"/>

                <ITEXT CH="quod: that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="scālam: ladder; singular feminine accusative from scāla, scālae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sēcūrō: secure, untroubled, carefree; singular masculine ablative from sēcūrus, sēcūra, sēcūrum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="serviens: a servant; derived from the singular nominative present participle from serviō, servīre, servīvī, servītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sexāgintā: sixty"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sī: if"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sibi: to himself; singular dative of se"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="stās: you stand; 2nd person singular present active from stō, stāre, stetī, status"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="statim: immediately"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tam: how (much)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="timēns: fearing; singular nominative present participle from timeō, timēre, timuī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trēs: three; plural common nominative from trēs -es -ia, tertius -a -um, terni -ae -a, ter"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcōrum: of the Turks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="turrēs: towers; plural feminine accusative from turris, turris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ubī: where"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūsque: until, all the way, up until"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnērunt: they came; 3rd person plural perfect active from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnistī: you came; 2nd person singular perfect active from veniō, venīre, vēnī, ventus"/>

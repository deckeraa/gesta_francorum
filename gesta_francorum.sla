        <PAGEOBJECT XPOS="136.001" YPOS="38328.14" OwnPage="91" ItemID="219969317" PTYPE="4" WIDTH="522" HEIGHT="233.133885350326" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 233.134 L0 233.134 L0 0 Z" copath="M0 0 L522 0 L522 233.134 L0 233.134 L0 0 Z" gXpos="136.001" gYpos="38328.14" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tunc veniēbāmus nōs persequentēs inīquissimōs Turcōs, cotīdiē fugientēs ante nōs. At illī venientēs ad cūncta castra sīve urbēs, fingentēs et dēlūdentēs habitātōrēs terrārum illārum dīcēbant: &quot;Nōs dēvīcimus"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Chrīstiānōs omnēs et superāvimus illōs, ita ut nūllus eōrum iam unquam audeat ērigere sē ante nōs; tantum permittite nōs intus.&quot; Quī intrantēs spoliābant ecclēsiās et domōs et alia omnia, et dūcēbant equōs sēcum et asinōs et mūlōs, aurum et argentum et ea quae reperīre poterant. Adhūc"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" quoque fīliōs Chrīstiānōrum sēcum tollēbant, et ārdēbant ac dēvastābant omnia convenientia sīve ūtilia, fugientēs et paventēs valdē ante faciem nostram."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="38561.2738853503" OwnPage="91" ItemID="216354773" PTYPE="4" WIDTH="522" HEIGHT="130.700636942674" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 130.701 L0 130.701 L0 0 Z" copath="M0 0 L522 0 L522 130.701 L0 130.701 L0 0 Z" gXpos="136.001" gYpos="38561.2738853503" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="We conquered entirely all the Christians and overcame them, so that none of them now will ever dare to raise himself up (in battle) before us; only let us in (to your city)."/>
                <ITEXT CH=" The retreating Turks used deception to enter and despoil walled cities as they retreated eastward across Byzantine Asia Minor. A spiritual reading can be drawn from this: even through Christ has already conquered the demons (Turks), the retreating demons come to us (the walled cities) and claim that we cannot be free from sin and that we must therefore invite them into our lives, from whence they proceed to despoil us from many good things and to lead us captive to Hell."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Still, they also were taking Christian children with them (into slavery), and were burning and devastating all supplies and useful things, fleeing and fearing greatly before our face."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

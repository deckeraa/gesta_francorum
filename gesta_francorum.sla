        <PAGEOBJECT XPOS="136.001" YPOS="127352.461" OwnPage="305" ItemID="676292629" PTYPE="4" WIDTH="522" HEIGHT="178.341547771037" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 178.342 L0 178.342 L0 0 Z" copath="M0 0 L522 0 L522 178.342 L0 178.342 L0 0 Z" gXpos="136.001" gYpos="127352.461" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Mora autem Francōrum fuit in illā urbe per ūnum mēnsem et quattuor diēs, in quā fuit mortuus Oriēnsis episcopus. Fuērunt ibi ex nostrīs, quī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" illīc nōn invēnērunt sīcuti opus eīs erat, tantum ex longā morā, quantum ex districtiōne famis, quia forīs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" nequīverant aliquid invenīre ad capiendum, sed scindēbant corpora mortuōrum, eō quod in ventribus"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" eōrum inveniēbant bisanteōs reconditōs; aliī vērō caedēbant"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" carnēs eōrum per frūsta, et coquēbant ad mandūcandum."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="127530.802547771" OwnPage="305" ItemID="676585877" PTYPE="4" WIDTH="522" HEIGHT="142.624203821659" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 142.624 L0 142.624 L0 0 Z" copath="M0 0 L522 0 L522 142.624 L0 142.624 L0 0 Z" gXpos="136.001" gYpos="127530.802547771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who there had not found what was necessary to them (to eat)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Because outside they were unable to find something for taking (for eating)."/>
                <ITEXT CH=" Alternatively, "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="forīs"/>
                <ITEXT CH=" could mean 'in the forums/markets'."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Because in their stomachs they were finding hidden bezants (golden coins)."/>
                <ITEXT CH=" Apparently some of the besieged occupants of the city had swallowed coins in order to hide them, and some of the poorer Crusaders, driven mad by hunger, had started to cut corpses open to find the coins, or even to directly eat the flesh."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And others were chopping their flesh (from the dead bodies) for morsels (of food)."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

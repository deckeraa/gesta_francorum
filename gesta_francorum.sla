                <para PARENT="Vocab"/>
                <ITEXT CH="sē: themselves"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sī: if"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suō: his; singular ablative of suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suum: his; singular masculine accusative from suus, sui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tālī: such"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tam: as much, as much as"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tenēret: he might hold; 3rd person singular imperfect active subjunctive from teneō, tenēre, tenuī, tentus"/>
                <para PARENT="Vocab"/>

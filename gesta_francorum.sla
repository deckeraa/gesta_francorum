                <ITEXT CH="Sānctō: holy"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sē: himself or themselves"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="seniōrēs: elders, chiefs; plural common nominative from senex, senis (gen.), senior -or -us, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="servābō: I will watch over, guard, preserve; 1st person singular future active from servō, servāre, servāvī, servātus"/>

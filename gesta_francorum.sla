        <PAGEOBJECT XPOS="136.001" YPOS="119032.431" OwnPage="285" ItemID="638195669" PTYPE="4" WIDTH="522" HEIGHT="295.874732484386" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 295.875 L0 295.875 L0 0 Z" copath="M0 0 L522 0 L522 295.875 L0 295.875 L0 0 Z" gXpos="136.001" gYpos="119032.431" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Nōn post multum vērō temporis vēnit vir venerābilis Raimundus, comes dē Sānctō Egidiō, et intrāvit in Saracēnōrum terram et pervēnit ad quamdam urbem quae vocātur Albara, quam invāsit ūnā"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" cum suō exercitū, eamque continuō cēpit; et occīdit omnēs Saracēnōs et Saracēnās, maiōrēs et minōrēs, quōs ibi repperit. Quam postquam suō continuit imperiō, ad Chrīstī revocāvit"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" fidem; quaesīvitque cōnsilium ā suīs sapientissimīs virīs, ut"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" epīscopum in hāc urbe dēvōtissimē praeōrdinārī faceret, quī illam ad Chrīstī cultum fidēliter revocāret et dē domō diabolicā templum"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" Deō vīvō et vērō et ōrācula sānctōrum cōnsecrāret. Novissimē ēlēgērunt quemdam honōrābilem ac sapientissimum virum et dūxēre"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" illum in Antiochīam ad cōnsecrandum. Factumque est ita."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="119328.305732484" OwnPage="285" ItemID="635545125" PTYPE="4" WIDTH="522" HEIGHT="129.783439490435" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 129.783 L0 129.783 L0 0 Z" copath="M0 0 L522 0 L522 129.783 L0 129.783 L0 0 Z" gXpos="136.001" gYpos="119328.305732484" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which he invaded together with his army."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He recalled (the city) to the Christian faith."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That they might make a bishop in the city to be most devotedly ordained."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And he might, out of the diabolic house, consecrate a temple to the living and true God and a house of prayer."/>
                <ITEXT CH=" Possibly "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="domō diabolicā"/>
                <ITEXT CH=" refers to a building formerly being used as a mosque; otherwise it refers to the city collectively. Hagenmeyer notes (p. 393, note 6) that "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="oraculum"/>
                <ITEXT CH=" is here a sacred house for prayer ("/>
                <ITEXT FONT="DejaVu Serif Italic" CH="'aedēs sacra, in quā ōrātur' i.e. templum"/>
                <ITEXT CH=")."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They led him (the man they picked to become a bishop) into Antioch for consecration."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="119032.431" OwnPage="286" ItemID="635278949" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="119032.431" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

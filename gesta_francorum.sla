                <para PARENT="Vocab"/>
                <ITEXT CH="illum: that; singular feminine accusative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>

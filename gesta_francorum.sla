        <PAGEOBJECT XPOS="136.001" YPOS="24184.089" OwnPage="57" ItemID="151117797" PTYPE="4" WIDTH="522" HEIGHT="231.707178343939" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 231.707 L0 231.707 L0 0 Z" copath="M0 0 L522 0 L522 231.707 L0 231.707 L0 0 Z" gXpos="136.001" gYpos="24184.089" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="In diē autem Ascēnsiōnis Dominī coepimus urbem circumquāque invādere et aedificāre īnstrūmenta lignōrum atque turrēs ligneās, quō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" possēmus mūrālēs turrēs sternere. Tam fortiter et tam ācriter aggredimur urbem per duōs diēs, ut etiam foderēmus mūrum urbis. Turcī quippe, licet"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" gens barbara, quī erant in urbe, mīsērunt nūntiōs aliīs, quī vēnerant"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" adiūtōrium cīvitātī dare, in hunc modum, quod audācter sēcūrēque approximent et per merīdiānam introeant portam, quoniam ex illā nēmō eīs erit obviam nec contrīstābit. Quae porta ipsa diē ā comite Sānctī Egidiī in diē Sabbatī post Ascēnsiōnem Dominī et epīscopō Podiēnsī hospitāta fuit."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="24415.7961783439" OwnPage="57" ItemID="151146533" PTYPE="4" WIDTH="522" HEIGHT="111.898089172028" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 111.898 L0 111.898 L0 0 Z" copath="M0 0 L522 0 L522 111.898 L0 111.898 L0 0 Z" gXpos="136.001" gYpos="24415.7961783439" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="With which we could knock down the walled towers."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The Turks, however, really a barbaric people."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who came to give help to the city, in this way, that they boldly and in a carefree manner drew forth and entered into the south gate, because out of that (gate) no one was in the road to (fight against them) nor to sadden (them by preventing them from exiting the city)."/>
                <ITEXT CH=" Hagenmeyer (page 180, footnote 7) comments that there was a sally-port on the west side of the city that was unknown to the crusaders."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="24184.089" OwnPage="58" ItemID="153083573" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="24184.089" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

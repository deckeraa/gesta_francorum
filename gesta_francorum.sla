        <PAGEOBJECT XPOS="136.001" YPOS="131512.476" OwnPage="315" ItemID="699263909" PTYPE="4" WIDTH="522" HEIGHT="239.269222930277" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 239.269 L0 239.269 L0 0 Z" copath="M0 0 L522 0 L522 239.269 L0 239.269 L0 0 Z" gXpos="136.001" gYpos="131512.476" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Hīc prope nōs erat quoddam castrum, in quō erat congregāta maxima pāgānōrum multitūdō. Quod castrum aggressī sunt nostrī, idque fortiter superāssent"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", nisi Saracēnī iactāssent forās immēnsās turmās animālium. Reversī sunt nostrī, dēferentēs omnia bona ad sua tentōria. Summō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" autem dīlūculō collēgērunt nostrī suōs pāpiliōnēs et vēnērunt obsīdere idem castrum, ibique putābant extendere"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" tentōria; sed gēns pāgāna omnīnō dedit sē fugae ac dīmīsērunt castrum vacuum. Intrantēs autem nostrī invēnērunt ibi omnem abundantiam frūmentī, vīnī, farīnae, oleī, et quicquid"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" eīs opus erat."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="131751.74522293" OwnPage="315" ItemID="696466117" PTYPE="4" WIDTH="522" HEIGHT="194.904458598729" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 194.904 L0 194.904 L0 0 Z" copath="M0 0 L522 0 L522 194.904 L0 194.904 L0 0 Z" gXpos="136.001" gYpos="131751.74522293" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Our (soldiers) attacked the castle, and would have strongly taken it, except that the Saracenes loosed immense herds of animals outside."/>
                <ITEXT CH=" The Crusader soldiers got distracted from the battle by the Saracene's loose livestock."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="However, at the height of dawn our soldiers collected their tents."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And there they was considering setting up a fortified camp."/>
                <ITEXT CH=" In Medieval Latin, "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="tentōria"/>
                <ITEXT CH=" can refer either to tents or to the fortified encampment in which the tents are contained."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And whatever was necessary for them."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="131512.476" OwnPage="316" ItemID="696420517" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="131512.476" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

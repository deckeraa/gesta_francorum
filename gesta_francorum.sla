                <para PARENT="Vocab"/>
                <ITEXT CH="māgnō: great, large; singular masculine ablative from māgnus, māgna -um, major -or -us, maximus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="martirizāvērunt: they marytred; 3rd person plural perfecte from martyrizō, martyrizāre"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="missam: Mass; singular feminine accusative from missa, missae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mox: soon"/>
                <para PARENT="Vocab"/>

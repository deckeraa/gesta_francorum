                <para PARENT="Vocab"/>
                <ITEXT CH="praecipitābant: they were casting down (themselves into the sea); 3rd person plural imperfect active from praecipitō, praecipitāre, praecipitāvī, praecipitātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prius: before"/>

        <PAGEOBJECT XPOS="136.001" YPOS="88248.3199999998" OwnPage="211" ItemID="474235109" PTYPE="4" WIDTH="522" HEIGHT="390.100382165794" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 390.1 L0 390.1 L0 0 Z" copath="M0 0 L522 0 L522 390.1 L0 390.1 L0 0 Z" gXpos="136.001" gYpos="88248.3199999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Certē sī hoc bellum contrā illōs incēperis, maximum tibi erit damnum ac dēdecus, et multōs fidēlēs tuōs mīlitēs perdēs et ūniversa spoliā quae apud tē habēs āmittēs et nimiō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" pavōre fugiendō ēvertēris. Tū autem in hōc bellō nōn moriēris"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" modo, sed tamen in hōc annō, quoniam ipse Deus nōn statim iūdicat offendentem sē exertā īrā, sed quandō vult pūnit eum manifēstā vindictā; ideōque timeō, nē tē iūdicet poenālī trīstitiā. Nōn moriēris, inquam, modo, vērumtamen perditūrus es in presentiarum habit"/>
                <ITEXT FEATURES="inherit" CH="a"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=".&quot;"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Curbaram dēnique valdē dolēns intimīs vīsceribus, audītīs māternīs sermōnibus, respondit: ’Māter cārissima, quaesō"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" tē, quis dīxit tibi ista dē gente Chrīstiānā, quod Deus eōrum tantum eōs amet et quod ipse pugnandī"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" virtūtem in sē retinet maximam, et quod illī Chrīstiānī vincent nōs in Antiochēnō proeliō et quod ipsī captūrī sunt nostra spolia, nōsque persecūtūrī magnā victōriā, et quod in hōc annō moritūrus"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" sum morte subitāneā?&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="88638.8789808917" OwnPage="211" ItemID="471145733" PTYPE="4" WIDTH="522" HEIGHT="126.114649681535" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 126.115 L0 126.115 L0 0 Z" copath="M0 0 L522 0 L522 126.115 L0 126.115 L0 0 Z" gXpos="136.001" gYpos="88638.8789808917" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And with excessive fear you will be destroyed by fleeing."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="You will not die not, but however (you will die) in this year, because God does not immediately judge the one offending with outstretched anger, but when he wishes he punishes him with manifest judgement."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="You will not die now, I say, but certainly you will lose the things that you possess currently."/>
                <ITEXT CH=" Hagenmeyer (p. 327, note 31) states that "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="habita"/>
                <ITEXT CH=" here means the same as "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="quae habentur"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Mother dearest, I ask you, who said to you these things about the Christian people?"/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He himself (God) retains in himself the greatest power of fighting."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And that in this year I will die with a sudden death?"/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="88248.3199999998" OwnPage="212" ItemID="474408517" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="88248.3199999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>

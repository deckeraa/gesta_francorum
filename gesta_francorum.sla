                <ITEXT CH="aut: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="beātus: happy, blessed; from beātus, beāta -um, beātior -or -us, beātissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bovēs: cows; plural masculine accusative from bōs, bovis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="camēlōs: camels; plural masculine accusative from camēlus, camēlī"/>
                <para PARENT="Vocab"/>

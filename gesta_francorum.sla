                <para PARENT="Vocab"/>
                <ITEXT CH="illī: to him; singular dative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illōrum: their; plural masculine genitive from ille, illa, illud"/>

                <para PARENT="Vocab"/>
                <ITEXT CH="introistis: invaded, entered; 2nd person plural perfect active from introeō, introīre, introivi(iī), introitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ita: thusly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="maiōrēs: elders; plural common nominative from māgnus, māgna -um, major -or -us, maximus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīrantur: they marvel; 3rd person plural present from mīror, mīrārī, mīrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="missa: having been sent; plural neuter accusative perfect passive participle from mittō, mittere, mīsī, missus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mūlōs: mules; plural masculine accusative from mūlus, mūlī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="multumque: and many; singular neuter accusative from multus, multa -um, -, plūrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrī: our; plural masculine nominative from noster"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nūntiī: messangers; plural masculine nominative from nuntius, nuntiī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnēs: all, every; plural common nominative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnia: all, every; plural neuter accusative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ōrnāmenta: equipment; plural neuter accusative from ōrnāmentum, ōrnāmentī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ovēs: sheep; plural feminine accusative from ovis, ovis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pariter: equally, together"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="permittunt: they permit, allow; 3rd person plural present active from permittō, permittere, permīsī, permissus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Petrus: Peter; singular masculine nominative from Petrus, Petrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="praedicandō: preaching; singular masculine ablative gerund from praedicō, praedicāre, praedicāvī, praedicātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="profānum: profane; singular neuter accusative from profānus, profāna, profānum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="proptereā: because of, that's why"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="putāmus: we were thinking; 1st person plural present active from putō, putāre, putāvī, putātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quam: which; singular feminine accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quamobrem: why, for what reason? Derived from quam ob rem."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quia: that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quoque: also"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quōcumque: no matter where"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="recēdātis: you (might) withdraw; 2nd person plural present active subjunctive from recēdō, recēdere, recessī, recessus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="recessērunt: they left; 3rd person plural perfect active from recēdō, recēdere, recessī, recessus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rogant: they ask; 3rd person plural present active from rogō, rogāre, rogāvī, rogātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="satis: enough"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="scīlicet: obviously"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="seniōrēs: elders; plural common nominative from senex, senis (gen.), senior -or -us, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="superbissimē: haughtily"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="temere: without design, thoughtlessly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terrā: land; singular feminine ablative from terra, terrae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terram: land; singular feminine accusative from terra, terrae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēlōciter: quickly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnēruntque: and they came; 3rd person plural perfect active from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnistis: you came; 2nd person plural perfect active from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="verba: words; plural neuter accusative from verbum, verbī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vestra: your"/>
                <para PARENT="Vocab"/>

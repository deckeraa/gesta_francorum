        <PAGEOBJECT XPOS="136.001" YPOS="60792.2209999999" OwnPage="145" ItemID="329224485" PTYPE="4" WIDTH="522" HEIGHT="299.091101910912" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 299.091 L0 299.091 L0 0 Z" copath="M0 0 L522 0 L522 299.091 L0 299.091 L0 0 Z" gXpos="136.001" gYpos="60792.2209999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Quod ut vīdit vir doctissimus Boamundus, ingemuit. Tunc precepit suō conostābilī scīlicet Rotbertō, fīliō Girardī, dīcēns: &quot;Vāde"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" quam citius potes, ut vir fortis, et recordāre prūdentium antīquōrumque nostrōrum fortium parentum et estō ācer in adiūtōrium Deī Sānctīque Sepulchrī. Et rēvērā"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" sciās, quia hoc bellum carnāle nōn est sed spīrituāle. Ēsto igitur fortissimus āthlēta Chrīstī. Vāde in pāce; Dominus sit tēcum ubīque.&quot; Fuit itaque ille, undique signō crucis mūnītus, quāliter leō perpessus famem per trēs aut quattuor diēs, quī exiēns ā suīs cavernīs, rugiēns ac sitiēns sanguinem pecudum sīcut imprōvidē ruit inter agmina gregum, dīlaniāns"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" ovēs fugientēs hūc et illūc; ita agēbat iste inter agmina Turcōrum. Tam vehementer īnstābat illīs, ut linguae"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" honōrābilis vēxillī volitārent super Turcōrum capita."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="61091.3121019108" OwnPage="145" ItemID="329376917" PTYPE="4" WIDTH="522" HEIGHT="106.853503184713" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 106.854 L0 106.854 L0 0 Z" copath="M0 0 L522 0 L522 106.854 L0 106.854 L0 0 Z" gXpos="136.001" gYpos="61091.3121019108" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Go as quickly as you can, as a strong man, and remember the prudence and strength of our ancient parents and be vigorous in (bringing) aid to God and the Holy Sepulchre."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And in fact you might know that this war is not carnal but spiritual."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Tearing apart the sheep fleeing here and there."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So vehemently was he attacking them, that the tongues of his honorable battle-flag might fly over the heads of the Turks."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="60792.2209999999" OwnPage="146" ItemID="331581029" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="60792.2209999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

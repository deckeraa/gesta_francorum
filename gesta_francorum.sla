        <PAGEOBJECT XPOS="136.001" YPOS="37496.137" OwnPage="89" ItemID="213426949" PTYPE="4" WIDTH="522" HEIGHT="293.315229299362" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 293.315 L0 293.315 L0 0 Z" copath="M0 0 L522 0 L522 293.315 L0 293.315 L0 0 Z" gXpos="136.001" gYpos="37496.137" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Quibus Solimānus lacrimābiliter respondit: &quot;Quoniam"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" ōlim cum habuissem omnēs Francōs dēvictōs, eōsque putārem iam in captīvitāte ligātōs, dum paulātim voluissem ligāre adinvicem, tunc respiciēns retrō, vīdī tam innumerābilem gentem eōrum, ut sī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" vōs aut aliquis illīc adesset, putāret quod omnēs montēs et collēs vallēsque et omnia plāna loca plēna essent illōrum multitūdine. Nōs"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" igitur illōs cernentēs statim coepimus capere subitāneum iter, timentēs tam mīrābiliter, ut vix ēvāserīmus dē illōrum manibus, unde adhūc in nimiō terrōre sumus. Et"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" sī mihi et verbīs meīs vellētis crēdere, auferrētis vōs hinc, quia sī et ipsī potuerint vōs sōlummodo scīre, ūnus ex vōbīs vix amplius ēvādet vīvus.&quot; At illī audientēs tālia, retrōrsum vertērunt dorsa, et sē expandērunt per ūniversam Romāniam."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="37788.9936305732" OwnPage="89" ItemID="213865413" PTYPE="4" WIDTH="522" HEIGHT="108.687898089171" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 108.688 L0 108.688 L0 0 Z" copath="M0 0 L522 0 L522 108.688 L0 108.688 L0 0 Z" gXpos="136.001" gYpos="37788.9936305732" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Because at a former time I might have had all the Franks completely defeated, and I reckoned them to already be bound in captivity, when I was, little by little, wanting to bind them together."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That if you or anyone had been there, you would have thought that all the mountains and hills and valleys and all the flat places had been filled with their multitude."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="We therefore seeing them, we at once started to take a sudden journey."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And if you wish to believe me and my words, carry yourselves (away) from this place, because if they themselves (the crusaders) will but know that you (are present), scarcely more than one of you will escape alive."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="37496.137" OwnPage="90" ItemID="215417317" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="37496.137" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>

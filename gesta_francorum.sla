        <PAGEOBJECT XPOS="136.001" YPOS="77432.2809999999" OwnPage="185" ItemID="410680645" PTYPE="4" WIDTH="522" HEIGHT="363.948299363212" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 363.948 L0 363.948 L0 0 Z" copath="M0 0 L522 0 L522 363.948 L0 363.948 L0 0 Z" gXpos="136.001" gYpos="77432.2809999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Videntēs itaque illī quī iam erant in turribus, coepērunt iocundā vōce clāmāre: &quot;Deus vult!&quot; Nōs vērō īdem clāmābāmus. Nunc coepērunt īlicō mīrābiliter ascendere, ascendērunt tamen et cucurrērunt festīnanter in aliās turrēs. Quōs illīc inveniēbant, mortālem"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" eīs continuō dabant sententiam, frātrem quoque Pirī occīdērunt."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Intereā forte rupta est scāla, per quam noster erat ascēnsus, unde inter nōs orta est immēnsa angustia et trīstitia. Quamquam"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" autem scāla fuisset frācta, tamen quaedam porta erat iuxtā nōs clausa in sinistrā parte, quae quibusdam manēbat incognita. Nox namque erat, sed tamen palpandō et inquīrendō invēnimus eam, omnēsque cucurrimus ad illam, et ipsā frāctā intrāvimus per eam. Tunc innumerābilis fragor"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" mīrābiliter resonābat per tōtam urbem. Nōn adquiēvit Boamundus hīs, sed īlicō imperāvit"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" honōrābile vexillum dēferrī sūrsum cōram castellō in quōdam monte. Omnēs vērō pariter strīdēbant in cīvitāte."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="77796.2292993631" OwnPage="185" ItemID="410960181" PTYPE="4" WIDTH="522" HEIGHT="189.401273885349" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 189.401 L0 189.401 L0 0 Z" copath="M0 0 L522 0 L522 189.401 L0 189.401 L0 0 Z" gXpos="136.001" gYpos="77796.2292993631" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Those they were finding there, they were immediately giving the death sentence, and they killed also the brother of Pirus."/>
                <ITEXT CH=" Whether this was intentional or not was not stated; Hagenmeyer (p. 304, note 51) gives some discussion about other sources concerning this."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Although however the ladder had been broken, nevertheless a certain door was next to use, closed on the left side, which had remained unknown to certain (soldiers)."/>
                <ITEXT CH=" Although the ladder broke, the Franks were able to use the soldiers already inside to open a door."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Then an unquantifiable breaking sound was marvelously resonating through the whole city."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Bohemond did not relax with these, but there commanded his honorable flag to be carried in the presence of the castle on a certain mountain."/>
                <ITEXT CH=" This refers to a certain fortification within the walled city of Antioch that was on an elevated position."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="77432.2809999999" OwnPage="186" ItemID="414766837" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="77432.2809999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adquiēvit: he rested, relaxed; 3rd person singular perfect active from adquiēscō, adquiēscere, adquiēvī, adquiētus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliās: others; plural feminine accusative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="angustia: small space, narrow passage, being boxed in; singular feminine nominative from angustia, angustiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ascendere: to ascend; present active infinitive from ascendō, ascendere, ascendī, ascēnsus"/>
                <para PARENT="Vocab"/>

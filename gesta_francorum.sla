                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prō: for, in favor of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="profānī: profane; plural masculine nominative from profānus, profāna, profānum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quās: which; plural feminine accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quīndecim: fifteen; from quīndecim, quīndecimus -a -um, quīndeci -ae -a, quīndecie (n)s"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quoniam: since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quoque: also"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Sānctī: holy"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bisantīō: coins of a type common in the Byzantine Empire called bisanteus (ablative case)"/>

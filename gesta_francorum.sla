            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="106552.386" OwnPage="255" ItemID="566910341" PTYPE="4" WIDTH="522" HEIGHT="297.906993630837" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 297.907 L0 297.907 L0 0 Z" copath="M0 0 L522 0 L522 297.907 L0 297.907 L0 0 Z" gXpos="136.001" gYpos="106552.386" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Hīs dictīs, recessērunt nūntiī vēnēruntque ad profānum collēgium, dīcentēs omnia missa"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" verba Curbaram et aliīs ita: &quot;Satis multumque mīrantur nostrī maiōrēs et seniōrēs, quamobrem temere ac superbissimē in Chrīstiānōrum introistis terram et illōrum. Putāmus"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" forsitan et crēdimus, quia hūc ideō vēnistis, ut per omnia vultis efficī Chrīstiānī; aut proptereā igitur hūc vēnistis, ut per omnia Chrīstiānōs afficiātis? Rogant vōs igitur omnēs pariter nostrī maiōrēs, ut vēlōciter recēdātis ā terrā Deī et Chrīstiānōrum, quam beātus"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" Petrus apostolus iam dūdum praedicandō ad Chrīstī cultūram convertit. At illī permittunt"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" adhūc vōbīscum dēdūcī omnia vestra: scīlicet equōs et mūlōs, et asinōs et camēlōs; ovēs quoque et bovēs, et omnia alia ōrnāmenta permittunt vōbīscum quōcumque voluerītis ferre.&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="106850.751592357" OwnPage="255" ItemID="567135189" PTYPE="4" WIDTH="522" HEIGHT="158.21656050926" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 158.217 L0 158.217 L0 0 Z" copath="M0 0 L522 0 L522 158.217 L0 158.217 L0 0 Z" gXpos="136.001" gYpos="106850.751592357" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Saying all of the sent words (or words that they had been given to relay) to Curbaram and the others thusly."/>
                <ITEXT CH=" "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Curbaram"/>
                <ITEXT CH=" is in the dative case here but is undeclined because it's a foreign name."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="We think, perhaps, and believe, that for this reason you came: that through all of these thing you want to be Christians; or rather for this reason you came here, that you might afflict all the Christians?"/>
                <ITEXT CH=" This appears to be sarcastic wordplay."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which the blessed apostle Peter had now for some time (already) converted to the worship of Christ through preaching."/>
                <ITEXT CH=" St. Peter lived roughly one thousand years before the events of this narrative."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And they will still permit you to take with you (on your retreat out of Christian lands) all of your (things)."/>
                <ITEXT CH=" The Crusaders, knowing that their sally out of Antioch would be decisive in either direction, offered to let the Turkish army retreat in peace."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="106552.386" OwnPage="256" ItemID="571657861" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="106552.386" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adhūc: (even) until now"/>
                <para PARENT="Vocab"/>

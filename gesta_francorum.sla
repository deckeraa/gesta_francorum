        <PAGEOBJECT XPOS="136.001" YPOS="34168.125" OwnPage="81" ItemID="198918965" PTYPE="4" WIDTH="522" HEIGHT="322.167993630559" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 322.168 L0 322.168 L0 0 Z" copath="M0 0 L522 0 L522 322.168 L0 322.168 L0 0 Z" gXpos="136.001" gYpos="34168.125" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Fūgērunt vērō nimis vēlōciter ad sua tentōria"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", ibique eōs diū morārī nōn licuit. Iterum vērō arripuērunt"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" fugam, nōsque illōs persecūtī sumus occidentēs tōtā ūnā diē et accēpimus spolia multa: aurum, argentum, equōs et asinōs, camēlōs, ovēs, et bovēs et plūrima alia, quae ignōrāmus. Et nisi Dominus fuisset nōbīscum in bellō, et aliam"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" cito nōbīs mīsisset aciem, nūllus nostrōrum ēvāsisset, quia ab hōrā tertiā usque in hōram nōnam perdūrāvit haec pugna. Sed omnipotēns Deus, pius et misericors, quī nōn permīsit suōs mīlitēs perīre, nec in manibus inimīcōrum incīdere, festīne nōbīs adiūtōrium mīsit."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Sed fuērunt illīc mortuī duo ex nostrīs mīlitēs honōrābilēs, scīlicet Godefridus dē Monte Scabiōsō, et Willelmus Marchisi fīlius, frāter Tancredī, aliīque mīlitēs et peditēs, quōrum nōmina ignōrō."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="34490.2929936306" OwnPage="81" ItemID="199082709" PTYPE="4" WIDTH="522" HEIGHT="124.738853503186" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 124.739 L0 124.739 L0 0 Z" copath="M0 0 L522 0 L522 124.739 L0 124.739 L0 0 Z" gXpos="136.001" gYpos="34490.2929936306" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They (the Turks) fled very quickly to their camp, and there they were not allowed to delay long."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For again they took to flight, and we pursued them, killing (them), for a whole day."/>
                <ITEXT CH=" "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="persecūtī sumus"/>
                <ITEXT CH=" means 'we followed' and has an active voice because "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="persequor"/>
                <ITEXT CH=" is a deponent verb."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And (unless God) had quickly sent another battle-line to (help us), none of us would have escaped (being killed by the Turks)."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="34168.125" OwnPage="82" ItemID="202702325" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="34168.125" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ab: from, out of, by, since"/>
                <para PARENT="Vocab"/>

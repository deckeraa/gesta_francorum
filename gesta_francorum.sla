                <para PARENT="Vocab"/>
                <ITEXT CH="venientēs: coming; plural common nominative present participle from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnit: he came; 3rd person singular perfect active from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vērō: and, truly, even so, still"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vigilāre: to wake up; present active infinitive from vigilō, vigilāre, vigilāvī, vigilātus"/>
                <para PARENT="Vocab"/>

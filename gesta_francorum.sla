        <PAGEOBJECT XPOS="136.001" YPOS="42488.155" OwnPage="101" ItemID="236424165" PTYPE="4" WIDTH="522" HEIGHT="351.3864012739" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 351.386 L0 351.386 L0 0 Z" copath="M0 0 L522 0 L522 351.386 L0 351.386 L0 0 Z" gXpos="136.001" gYpos="42488.155" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Ortā"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" autem diē, vēnērunt maiōrēs cīvitātis, et reddidērunt sponte cīvitātem, dīcentēs illīs, quī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" super hoc lītigābant adinvicem: &quot;Sinite"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" modo, seniōrēs, sinite, quia volumus et petimus dominārī et rēgnāre super nōs illum, quī heri tam virīliter pugnāvit cum Turcīs.&quot; Balduīnus itaque, mīrificus comes, altercābātur et lītigābat cum Tancredō dīcēns: &quot;Intrēmus"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" simul et spoliēmus cīvitātem: et quī plūs potuerit habēre, habeat, et quī poterit capere, capiat.&quot; Cui obstāns fortissimus Tancredus dīxit: &quot;Absit hoc ā mē; ego namque Chrīstiānōs nōlō expoliāre; hominēs huius cīvitātis ēlēgērunt mē dominum super sē, mēque"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" habēre dēsīderant.&quot;"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Tandem nequīvit vir fortis Tancredus diū luctārī cum Balduīnō, doctissimō comite, quia illī"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" magnus erat exercitus; tamen volēns"/>
                <ITEXT FEATURES="inherit superscript" CH="7"/>
                <ITEXT CH=" nōlēnsque dīmīsit eam et virīliter recessit cum suō exercitū; fuēruntque eī statim trāditae duae optimae cīvitātēs, vidēlicet Athēna et Manustra, et plūrima castra."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="42839.5414012739" OwnPage="101" ItemID="235106853" PTYPE="4" WIDTH="522" HEIGHT="213.707006369426" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 213.707 L0 213.707 L0 0 Z" copath="M0 0 L522 0 L522 213.707 L0 213.707 L0 0 Z" gXpos="136.001" gYpos="42839.5414012739" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The day having arisen, the elders of the city came out, and freely returned the city (from Turkish rule back to Christian rule), saying to them."/>
                <ITEXT CH=" The word "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="reddidērunt"/>
                <ITEXT CH=" could also be glossed as "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="they handed over"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who were disputing over this together."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Now settle down, princes, settle down, because we wish and we ask to be mastered and ruled by that one (Tancred), who yesterday so manfully fought with the Turks."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Let us enter (Tarsus) together and plunder the city: and the one who is able to have more, let him have it, and the one who can seize more, let him seize it."/>
                <ITEXT CH=" The iussive subjunctive (let him have, let him seize) is used here to good effect."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And they desire to have me (as ruler over them)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He had a large army."/>
                <ITEXT CH=" The dative of possession is used; literally this would read: to him was a large army."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="7"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="However, willing or unwilling, he left him and withdrew with his army. There were handed over to him two very good cities."/>
                <ITEXT CH=" Although Tancred wanted Tarsus, he must have come to a deal with Baldwin where Baldwin got Tarsus and Tancred got two fine cities, so that the two crusader princes would not need to settle their dispute violently. "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="volēns nōlēnsque"/>
                <ITEXT CH=" is a Latin idiom meaning 'willing or unwilling'."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

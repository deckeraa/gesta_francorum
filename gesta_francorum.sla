                <para PARENT="Vocab"/>
                <ITEXT CH="quaesō: I seek, ask for; 1st person singular present active from quaeso, quaesere, -, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quandō: when, because"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quis: who"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quod: that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quoniam: since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="respondit: he responded; 3rd person singular perfect active from respondeō, respondēre, respondī, respōnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="retinet: they hold back, retain; 3rd person singular present active from retineō, retinēre, retinuī, retentus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sē: himself or themselves"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sed: but"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sermōnibus: conversation, speech; plural masculine ablative from sermō, sermōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sī: if"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="spolia: spoil, booty; plural neuter accusative from spolium, spoliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="statim: immediately"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="subitāneā: sudden; singular feminine ablative from subitāneus, subitānea, subitāneum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tamen: however"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tantum: so much, so great, this many; singular neuter nominative from tantus, tanta, tantum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tē: you, accusative from tu"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tibi: to you, singular dative of tu"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="timeō: I fear; 1st person singular present active from timeō, timēre, timuī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trīstitiā: sadness; singular feminine ablative from trīstitia, trīstitiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tu: you;(pronoun)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tuōs: your; plural masculine accusative from tuus, tua, tuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūniversa: whole, entire; plural neuter accusative from ūniversus, ūniversa, ūniversum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="valdē: very"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vērumtamen: but certainly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="victōriā: victory; singular feminine ablative from victōria, victōriae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vincent: they will conquer; 3rd person plural future active from vincō, vincere, vīcī, victus"/>
                <para PARENT="Vocab"/>

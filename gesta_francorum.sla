        <PAGEOBJECT XPOS="136.001" YPOS="75768.2749999999" OwnPage="181" ItemID="401792437" PTYPE="4" WIDTH="522" HEIGHT="268.310987261284" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 268.311 L0 268.311 L0 0 Z" copath="M0 0 L522 0 L522 268.311 L0 268.311 L0 0 Z" gXpos="136.001" gYpos="75768.2749999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Dein Boamundus iussit celeriter ad sē vocārī quendam servientem suum vidēlicet Malam"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Corōnam, eīque praecepit, ut quasi praecō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" commonēret Francōrum maximam gentem, quātinus fidēliter praeparāret sē in Saracēnōrum itūra terram. Factumque est ita. Crēdidit"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" itaque Boamundus hoc cōnsilium dūcī Godefridō, et Flandrēnsī comitī, comitī quoque dē Sānctō Egidīō atque Podiensi epīscopō, dīcēns: &quot;Quia, Deī favente grātiā, hāc nocte trādētur nōbīs Antiochīa&quot;."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Ōrdināta sunt dēnique haec omnia: mīlitēs tenuērunt plāna et peditēs montāneam. Tōtā nocte equitāvērunt et ambulāvērunt usque prope aurōram, ac deinceps coepērunt appropinquāre ad turrēs quās ille vigil cūstōdiēbat."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="76036.5859872611" OwnPage="181" ItemID="402278197" PTYPE="4" WIDTH="522" HEIGHT="116.94267515924" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 116.943 L0 116.943 L0 0 Z" copath="M0 0 L522 0 L522 116.943 L0 116.943 L0 0 Z" gXpos="136.001" gYpos="76036.5859872611" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH="Mala Corōna was the name, probably a nickname, of the man sent as a herald."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That as a herald he might give a warning order to the very large Frankish people."/>
                <ITEXT CH=" A warning order is an order given in the military that tells soldiers about an upcoming operation; such a phrase seems to fit the context here well."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Bohemond confided this plan to Duke Godfrey, and the Count of Flanders, and to the Count of Saint-Gilles and to the Bishop of Le Puy."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="75768.2749999999" OwnPage="182" ItemID="406583061" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="75768.2749999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>

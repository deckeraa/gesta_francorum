        <PAGEOBJECT XPOS="136.001" YPOS="149816.542" OwnPage="359" ItemID="782161461" PTYPE="4" WIDTH="522" HEIGHT="276.706407643709" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 276.706 L0 276.706 L0 0 Z" copath="M0 0 L522 0 L522 276.706 L0 276.706 L0 0 Z" gXpos="136.001" gYpos="149816.542" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Comes vērō Sānctī Egidiī ac Rotbertus Nortmannus dīxērunt"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" 'sē nōn exitūrōs, nisi certum bellum scīrent.' Iussērunt ergō mīlitibus suīs, ut pergerent vidēre sī bellum vērē esset, et reverterentur quantōcius, quī ipsī mox essent"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" parātī īre. Iērunt illī, et vīdērunt bellum et cito renūntiāvērunt sē vīdisse oculīs suīs. Continuō dux, apprehēnsō Marturanensī episcopō, mandāvit"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" Hierūsalēm, quō mīlitēs, quī ibi erant praeparent sē et veniant ad bellum. Quārtā vērō fēriā illī prīncipēs exiērunt, et mīlitāvērunt ad bellum. Episcopus vērō Marturanēnsis rediit, reportāns verba missa patriarchae et ducī, exiēruntque"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" Saracēnī obviam eī et apprehēnsum sēcum dūxērunt."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="150093.248407643" OwnPage="359" ItemID="782273205" PTYPE="4" WIDTH="522" HEIGHT="111.898089171969" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 111.898 L0 111.898 L0 0 Z" copath="M0 0 L522 0 L522 111.898 L0 111.898 L0 0 Z" gXpos="136.001" gYpos="150093.248407643" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They said that they wouldn't go out, unless the battle (was) certain (to take place)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who themselves soon would be ready to go."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Immediately the Duke, with the bishop of Martirano having been joined (to his party), he sent word (to) Jerusalem, that the soldiers who were in it should prepare themselves and come to the battle."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And the Saracenes went out in the way (of the bishop, who apparently was not accompanied by a military guard), and they led away the apprehended (bishop) with them."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="149816.542" OwnPage="360" ItemID="786021845" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="149816.542" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

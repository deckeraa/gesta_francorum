        <PAGEOBJECT XPOS="136.001" YPOS="56632.2059999999" OwnPage="135" ItemID="305510869" PTYPE="4" WIDTH="522" HEIGHT="303.284445859943" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 303.284 L0 303.284 L0 0 Z" copath="M0 0 L522 0 L522 303.284 L0 303.284 L0 0 Z" gXpos="136.001" gYpos="56632.2059999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Adūnāvērunt sēsē omnēs ferē Francigenae"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", rogāvēruntque humiliter nē dēterius eī facere permitteret. Annuit ille"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" serēnō vultū, et ait: &quot;Hoc prō vestrī amōre libenter cōnsentiam, sī mihi tōtō corde et mente iurāverit quod nunquam recēdet ab Hierosolimītānō itinere sīve bonō sīve malō; et Tancredus neque per sē neque per suōs aliquid contrāriī eī cōnsentiet fierī.&quot; Quī audītīs hīs verbīs voluntāriē concessit"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=". Ipse vērō prōtinus dīmīsit eum. Postmodum vērō Carpentārius, maximā captus turpitūdine, nōn diū morāns fūrtim recessit."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Hanc paupertātem et miseriam prō nostrīs dēlictīs concessit"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" nōs habēre Deus. In tōtā namque hoste nōn valēbat aliquis invenīre mīlle mīlitēs, quī equōs habērent optimōs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="56935.4904458599" OwnPage="135" ItemID="305728085" PTYPE="4" WIDTH="522" HEIGHT="162.343949044589" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 162.344 L0 162.344 L0 0 Z" copath="M0 0 L522 0 L522 162.344 L0 162.344 L0 0 Z" gXpos="136.001" gYpos="56935.4904458599" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They brought to themselves nearly all the Frankish-born (soldiers), and they asked humbly that nothing worse be permitted to happen to him."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He (Bohemond) agreed, with a serene face, and said &quot;This, because of your (the Frankish-born soldiers') love, freely agreed, if you will swear to me with (your) whole heart and mind that you will never recede from the journey to Jerusalem, either (on account of) good or bad; and Tancred, neither through himself nor through others, will allow things to be done against you."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The one (Wilhelm the Cartwright), having heard these words, agreed willingly."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="God allowed us to have this poverty and misery because of our offenses."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="56632.2059999999" OwnPage="136" ItemID="308907381" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="56632.2059999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

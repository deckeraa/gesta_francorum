                <para PARENT="Vocab"/>
                <ITEXT CH="ascēnsus: erat ascēnsus = it had been ascended; singular masculine nominative perfect passive participle from ascendō, ascendere, ascendī, ascēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundus: Bohemond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="castellō: castle, stronghold; singular neuter ablative from castellum, castellī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cīvitāte: city; singular feminine ablative from cīvitās, cīvitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="clāmābāmus: we were shouting; 1st person plural imperfect active from clāmō, clāmāre, clāmāvī, clāmātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="clāmāre: to shout; present active infinitive from clāmō, clāmāre, clāmāvī, clāmātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="clausa: closed, having been closed; singular feminine nominative perfect passive participle from claudō, claudere, clausī, clausus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="coepērunt: they started; from coepī, coepisse, coepī, coeptum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="continuō: immediately; singular masculine ablative from continuus, continua, continuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōram: in the presence of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cucurrērunt: they ran; 3rd person plural perfect active from currō, currere, cucurrī, cursus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cucurrimus: we ran; 1st person plural perfect active from currō, currere, cucurrī, cursus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dabant: they were giving; 3rd person plural imperfect active from dō, dare, dedī, datus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēferrī: to be transferred; present passive infinitive from dēferō, dēferre, dētulī, dēlātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Deus: God; singular masculine nominative from Deus, Dei"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eam: it; singular feminine accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eīs: to them; plural dative or ablative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erant: they were; 3rd person plural imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erat: it was; 3rd person singular imperfect active from sum, esse, fuī, futūrus"/>

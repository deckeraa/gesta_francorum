                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="persecūtiōnēs: pursuits; plural feminine accusative from persecūtiō, persecūtiōnis"/>

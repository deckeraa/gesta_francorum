        <PAGEOBJECT XPOS="136.001" YPOS="54968.1999999999" OwnPage="131" ItemID="296483733" PTYPE="4" WIDTH="522" HEIGHT="299.825477707076" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 299.825 L0 299.825 L0 0 Z" copath="M0 0 L522 0 L522 299.825 L0 299.825 L0 0 Z" gXpos="136.001" gYpos="54968.1999999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Videntēs autem Hermēniī et Surānī quod nostrī penitus vacuī rediissent, cōnsiliātī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" in ūnum abībant per montāneās et praescīta loca, subtīliter inquīrentēs et ementēs frūmentum et corporea alimenta, quae ad hostem"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" dēferēbant in quā erat famēs immēnsa, et vēndēbant onus"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" ūnīus asinī octo purpurātīs, quī appreciābantur centum vīgintī solidīs dēnāriōrum. Ibi quidem sunt mortuī multī ex nostrīs, nōn habentēs pretium unde tam carum emere potuissent."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Willelmus igitur Carpentārius et Petrus Heremīta, prō immēnsā īnfēlīcitāte ac miseriā ipsā, latenter recessērunt. Quōs Tancredus persequēns apprehendit, sēcumque redūxit cum dēdecore; quī dextram"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" et fidem illī dedērunt, quia libenter ad hostem redīrent et satisfactiōnem seniōribus facerent."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="55268.025477707" OwnPage="131" ItemID="296681989" PTYPE="4" WIDTH="522" HEIGHT="123.821656050954" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 123.822 L0 123.822 L0 0 Z" copath="M0 0 L522 0 L522 123.822 L0 123.822 L0 0 Z" gXpos="136.001" gYpos="55268.025477707" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Having agreed on a plan, they were going away through the mountains and locations that were already known to them."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="Here "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="hostem"/>
                <ITEXT CH=" must refer to the crusader army, not the enemy army, otherwise the next sentence wouldn't make sense."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They were selling the supplies of one donkey (that one donkey could carry) for eight purpurati, which were valued at 120 denarii."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who gave their right hand and faith to that one (Tancred), that freely they might return to the army and make satisfaction to the elders."/>
                <ITEXT CH=" The deserters surrendered to Tancred."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="54968.1999999999" OwnPage="132" ItemID="300555765" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="54968.1999999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="abībant: they were departing; 3rd person plural imperfect active from abeō, abīre, abiī, abitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="alimenta: food, nourishment, sustenance; plural neuter accusative from alimentum, alimentī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="appreciābantur: they were valuing, purchasing; 3rd person plural imperfect passive from appreciō, appreciāre, appreciāvī, appreciātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="apprehendit: he seized; 3rd person singular perfect active from apprehendō, apprehendere, apprehendī, apprehēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="asinī: of an ass; singular masculine genitive from asinus, asinī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Carpentārius: Willelmus Carpentārius = Wilhelm the Cartwright; carpentārius = coachman, cartwright; singular masculine nominative from carpentārius, carpentāriī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cārum: expensive; singular neuter accusative from cārus, cāra -um, cārior -or -us, cārissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="centum: hundred; from centum, centesimus -a -um, centeni -ae -a, centie (n)s"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōnsiliātī: having been consulted; plural masculine nominative perfect participle from cōnsilior, cōnsiliārī, cōnsiliātus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="corporea: physical, corporeal; plural neuter accusative from corporeus, corporea, corporeum"/>
                <para PARENT="Vocab"/>

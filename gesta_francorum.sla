                <ITEXT CH="nōbīs: us; singular dative from ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nocte: night; singular feminine ablative from nox, noctis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnia: all, every; plural neuter nominative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ōrdināta: ōrdināta sunt = they were set in order; plural neuter nominative perfect passive participle from ōrdinō, ōrdināre, ōrdināvī, ōrdinātus"/>
                <para PARENT="Vocab"/>

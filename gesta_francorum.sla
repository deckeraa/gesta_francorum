                <para PARENT="Vocab"/>
                <ITEXT CH="ūnum: one; singular neuter nominative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="usquequo: until"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vacuī: empty, vacant; plural masculine nominative from vacuus, vacua, vacuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vacuīs: empty, vacant; plural ablative from vacuus, vacua, vacuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="valēret: he might have been able; 3rd person singular imperfect active subjunctive from valeo, valere, valui, valitus"/>
                <para PARENT="Vocab"/>

        </MASTEROBJECT>
        <MASTEROBJECT XPOS="154.001" YPOS="776.002" OwnPage="3" ItemID="49808213" PTYPE="4" WIDTH="522" HEIGHT="18" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 18 L0 18 L0 0 Z" copath="M0 0 L522 0 L522 18 L0 18 L0 0 Z" OnMasterPage="Vocab right" gXpos="28068607810.001" gYpos="2152784654987.15" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <var name="pgno" FONTSIZE="12"/>
                <trail ALIGN="1"/>
            </StoryText>
        </MASTEROBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="2552.011" OwnPage="5" ItemID="49937445" PTYPE="4" WIDTH="522" HEIGHT="390.817025477707" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 390.817 L0 390.817 L0 0 Z" copath="M0 0 L522 0 L522 390.817 L0 390.817 L0 0 Z" gXpos="136.001" gYpos="2552.011" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Liber 1"/>
                <para PARENT="Chapter Heading"/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Cum iam appropinquāsset"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" ille terminus quem dominus Iēsus cotīdiē suīs dēmōnstrat fidēlibus, speciāliter in ēvangeliō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" dīcēns: &quot;Sī quis vult post mē venīre, abneget sēmetipsum et tollat crucem suam et sequātur mē&quot; facta"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" est igitur mōtiō valida per ūniversās Galliārum regiōnēs, ut sī"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" aliquis Deum studiōsē pūrōque corde et mente sequī dēsīderāret, atque post ipsum crucem fidēliter baiulāre vellet"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=", nōn pigritārētur"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" Sānctī Sepulchrī viam celerius arripere. Apostolicus namque Rōmānae sēdis ultrā montānās"/>
                <ITEXT FEATURES="inherit superscript" CH="7"/>
                <ITEXT CH=" partēs quantōcius profectus est cum suīs archiepiscopīs, epīscopīs, abbātibus, et presbytērīs, coepitque subtīliter sermōcinārī et praedīcāre, dīcēns, ut sī quis animam suam salvam facere vellet, nōn dubitāret humiliter viam incipere Dominī, ac sī dēnāriōrum eī dēesset"/>
                <ITEXT FEATURES="inherit superscript" CH="8"/>
                <ITEXT CH=" cōpia, dīvīna eī satis daret misericordia."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="2942.82802547771" OwnPage="5" ItemID="49992981" PTYPE="4" WIDTH="522" HEIGHT="236.427121019113" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 236.427 L0 236.427 L0 0 Z" copath="M0 0 L522 0 L522 236.427 L0 236.427 L0 0 Z" gXpos="136.001" gYpos="2942.82802547771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That manner (of life) having drawn near, which Jesus every day pointed out to his faithful (disciples)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="The verse referenced is Matthew 16:24."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Therefore a strong movement occured through every region of Gallia."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That if anyone was eagerly desiring to follow God with pure heart and min"/>
                <ITEXT CH="d."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And wanted to faithfully carry his cross after him (Jesus)."/>
                <ITEXT CH=" The subjunctive "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="vellet"/>
                <ITEXT CH=" is used because the statement is conditional. "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Ipsum"/>
                <ITEXT CH=" is used as a more intense version of "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="illum"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He should not tarry (delay) to more quickly seize the road of the Holy Sepulchre."/>
                <ITEXT CH=" The Church of the Holy Sepulchre is located in Jerusalem and claims to be located on the spot where Christ was buried and resurrected. It was a popular pilgrimage destination, but the pilgrimage had been made very dangerous due to Muslim occupation."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="7"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Indeed the Apostle of the Roman seat (the Pope) across the mountains as quickly as possible set out with his archbishops, bishops, abbots, and elders, and began to precisely (eloquently, cleverly) converse and to preach."/>
                <ITEXT CH=" The montains mentioned are the Alps, which separate Gallia from Italy. This may be referring to the Council of Clermont, which took place November 17-27 1095, in which Pope Urban II set forth the idea of Crusade."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="8"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And if supply of money might be lacking to him, the divine mercy would give enough (sustenance) to him."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="2552.011" OwnPage="6" ItemID="49873941" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="2552.011" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="abbātibus: abbots; plural masculine ablative from abbās, abbātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="abneget: let him deny; 3rd person singular present active subjunctive from abnegō, abnegāre, abnegāvī, abnegātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliquis: someone"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="animam: soul, mind, life; singular feminine accusative from anima, animae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="apostolicus: the Pope (medieval usage), bishop, apostle; singular masculine nominative from apostolicus, apostolica, apostolicum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="appropinquāvisset: it (might) have had approached; 3rd person singular pluperfect active subjunctive from appropinquō, appropinquāre, appropinquāvī, appropinquātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="archiepiscopīs: archbishops; plural masculine ablative from archiepiscopus, archiepiscopī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="arripere: to take hold of, to snatch, to seize; present active infinitive from arripiō, arripere, arripuī, arreptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="atque: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bāiulāre: to carry, to bear; present active infinitive from bāiulō, bāiulāre, bāiulāvī, bāiulātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="celerius: more quickly; comparative adverb from celer, celeris -e, celerior -or -us, celerrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="coepit: he started; 3rd person singular present active from coepio, coepere, coepi, coeptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōpia: supply; singular feminine nominative from cōpia, cōpiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="corde: heart; singular neuter ablative from cor, cordis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cotīdiē: daily"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="crucem: cross; singular feminine accusative from crux, crucis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="daret: it may give; 3rd person singular imperfect active subjunctive from dō, dare, dedī, datus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēesset: it may lack; 3rd person singular imperfect active subjunctive from dēsum, dēesse, dēfuī, dēfutūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēmōnstrat: he shows, points out; 3rd person singular present active from dēmōnstrō, dēmōnstrāre, dēmōnstrāvī, dēmōnstrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēnāriōrum: of denariī (a denarius is a type of coin)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēsīderāret: he may desire; 3rd person singular imperfect active subjunctive from dēsīderō, dēsīderāre, dēsīderāvī, dēsīderātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Deum: God; singular masculine accusative from Deus, Dei"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīcēns: saying; singular nominative present participle from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīvīna: divine; singular feminine nominative from dīvīnus, dīvīna -um, dīvīnior -or -us, dīvīnissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Dominī: of the lord; singular masculine genitive from dominus, dominī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Dominus: lord, master; singular masculine nominative from dominus, dominī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dubitāret: let him hesitate, doubt; 3rd person singular imperfect active subjunctive from dubitō, dubitāre, dubitāvī, dubitātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eī: to him, her, or it; singular dative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="episcopīs: bishops; plural masculine ablative from episcopus, episcopī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ēvangeliō: Gospel (in this case, specifically the Gospel of Matthew); singular neuter ablative from Ēvangelium, Ēvangeliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="facere: to make, to do; present active infinitive from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="facta: facta est = it occurred; singular feminine nominative perfect passive (deponent) participle from fīō, fierī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fidēlibus: faithful persons, confidants; plural dative from fidēlis, fidēle, fidēlior -or -us, fidēlissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fidēliter: faithfully"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Galliārum: of Gaul; plural feminine genitive from Gallia, Galliae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="humiliter: humbly (adverb)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iam: already, now, soon"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Iēsūs: Jesus; singular masculine nominative from Iēsūs, Iēsū"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="igitur: therefore"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ille: that; singular masculine nominative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="incipere: to start, begin; present active infinitive from incipiō, incipere, incēpī, inceptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ipsum: himself; singular masculine acc. or neuter nom. or acc. from ipse, ipsa, ipsum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mē: to me, accusative from ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mente: mind; singular feminine ablative from mēns, mentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="misericordia: pity, compassion, mercy; singular feminine nominative from misericordia, misericordiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="montānās: mountainous; plural feminine accusative from montānus, montāna, montānum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mōtiō: movement, motion; singular feminine nominative from mōtiō, mōtiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="namque: indeed"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōn: not"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="partēs: parts; plural feminine accusative from pars, partis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pigritārētur: he tarried, was slothful; 3rd person singular subjunctive imperfect from pigritor"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="post: behind, after, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="praedicāre: to preach; present active infinitive from praedicō, praedicāre, praedicāvī, praedicātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="presbyterīs: elders, presbyters; plural masculine ablative from presbyter, presbyterī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="profectus: profectus est = he set out; singular masculine nominative perfect participle from proficīscor, proficīscī, profectus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pūrō: clean, pure; singular masculine ablative from pūrus, pūra -um, pūrior -or -us, pūrissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quantōcius: as quickly as possible"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quem: whom, singular masculine accusative of qui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quis: someone"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="regiōnēs: regions; plural feminine accusative from regiō, regiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Rōmānae: Roman; singular feminine genitive from Rōmānus, Rōmāna, Rōmānum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="salvam: safe, saved; singular feminine accusative from salvus, salva, salvum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Sānctī: Holy"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="satis: enough"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sēdis: seat; singular feminine genitive from sēdēs, sēdis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sēmetipsum: himself"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sepulchrī: sepulchre; singular neuter genitive from sepulchrum, sepulchrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sequātur: let him follow; 3rd person singular passive present from sequor, sequī, sēcūtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sequī: to follow; present active infinitive from sequor, sequī, sēcūtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sermōcinārī: to converse, discuss; present active infinitive from sermōcinor, sermōcinārī, sermōcinātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sī: if"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="speciāliter: especially, specifically, individually; adverb from speciālis, speciāle"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="studiōse: eagerly; adverb from studiōsus, studiōsa -um, studiōsior -or -us, studiōsissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suam: his; singular feminine accusative from suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="subtīliter: finely, precisely, subtly, eloquently; adverb from subtīlis, subtīle"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suīs: their; plural dative or ablative of suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terminus: manner, fashion, end, boundary, limit; singular masculine nominative from terminus, terminī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tollat: he (might) take up, lift up; 3rd person singular present active subjunctive from tollō, tollere, sustulī, sublātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ultrā: beyond, further"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūniversās: whole, entire; plural feminine accusative from ūniversus, ūniversa, ūniversum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="valida: strong, healthy; singular feminine nominative from validus, valida, validum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vellet: he might want; 3rd person singular future active from velle"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="venīre: to come; present active infintive from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="viam: road; singular feminine accusative from via, viae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vult: he wants; singular 3rd person present from volō, velle, voluī (irr.)"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="3384.014" OwnPage="7" ItemID="50474133" PTYPE="4" WIDTH="522" HEIGHT="262.361426751592" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 262.361 L0 262.361 L0 0 Z" copath="M0 0 L522 0 L522 262.361 L0 262.361 L0 0 Z" gXpos="136.001" gYpos="3384.014" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ait namque domnus"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" apostolicus 'Frātrēs, vōs oportet multa patī prō nōmine Chrīstī, vidēlicet miseriās, paupertātēs, nūditātēs, persecūtiōnēs, egestātēs, īnfirmitātēs, famēs, sitēs et alia huiusmodī, sīcuti Dominus ait suīs discipulīs: &quot;Oportet"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" vōs patī multa prō nōmine meō&quot;, et: &quot;Nōlīte"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" ērubēscere loquī ante faciēs hominum; ego vērō dabō vōbīs ōs et ēloquium&quot;, ac deinceps: &quot;Persequētur"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" vōs larga retribūtiō&quot;. Cumque iam hic sermō paulātim per ūniversās regiōnēs ac Galliārum patriās coepisset crebrēscere, Francī audientēs tālia"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" prōtinus in dextrā crucem suēre scapulā, dīcentēs sēsē Chrīstī ūnanimiter sequī vestīgia, quibus dē manū erant redēmptī Tartareā. Iamiamque"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" Galliae suīs remōtae sunt domibus."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="3646.37542675159" OwnPage="7" ItemID="51377813" PTYPE="4" WIDTH="522" HEIGHT="181.299363057327" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 181.299 L0 181.299 L0 0 Z" copath="M0 0 L522 0 L522 181.299 L0 181.299 L0 0 Z" gXpos="136.001" gYpos="3646.37542675159" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit" CH="And the apostolic lord said."/>
                <ITEXT CH=" The "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="domnus apostolicus"/>
                <ITEXT CH=" refers to Pope Urban II."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="You must suffer many things for my name."/>
                <ITEXT CH=" This is a paraphrase from Acts 9:16."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH="This is a quote from 2 Timothy 1:8."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="A large recompense (reward) will follow you"/>
                <ITEXT CH=". This is not a direct quote from the Bible."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The Franks, hearing such things, straightaway sewed crosses onto their right shoulders, saying themselves to be in one spirit (unanimously) following the footsteps of Christ, whom were redeemed from Tarturus by (His) hand."/>
                <ITEXT CH=" The crusaders sewed a closs onto their clothing as a marker with which to identify each other and to show that they had taken a vow to go on Crusade. The footsteps they were following refers to how Christ also walked to the Holy Sepulchre. Tarturus refers to the place of the dead; for more information on this, see the Apostles' Creed ("/>
                <ITEXT FONT="DejaVu Serif Italic" CH="descendit ad inferōs"/>
                <ITEXT CH=") and the Harrowing of Hell."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="At this very moment the Franks are far away from their homes."/>
                <ITEXT CH=" They are far away because they have journeyed on Crusade."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="3384.014" OwnPage="8" ItemID="55078245" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="3384.014" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>

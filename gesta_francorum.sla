        <PAGEOBJECT XPOS="136.001" YPOS="68280.2479999999" OwnPage="163" ItemID="362580693" PTYPE="4" WIDTH="522" HEIGHT="297.229707006496" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 297.23 L0 297.23 L0 0 Z" copath="M0 0 L522 0 L522 297.23 L0 297.23 L0 0 Z" gXpos="136.001" gYpos="68280.2479999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Mortuī sunt etiam in animā et corpore duodecim ammiralīī dē Turcōrum agmine in proeliō illō, et aliī prūdentissimōrum et fortiōrum mīlitum, quī melius"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" cīvitātem pugnandō dēfendēbant; numerus quōrum fuit mīlle et quīngentī. Aliī quī remānserant vīvī, iam amplius nōn audēbant clāmitāre vel garrīre in diē sīve in nocte, sīcut ante solēbant. Omnēs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" itaque nōs vel illōs sōlummodo sēparāvit nox, noxque dīvīsit utrōsque in proeliandō, iaculandō, spīculandō, sagittandō. Sīc superātī sunt inimīcī nostrī virtūte Deī et Sānctī Sepulchrī, et ulterius nōn valuērunt tālem virtūtem habēre, neque in vōce neque in opere sīcuti prius."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Nōs itaque valdē fuimus refectī in illā diē dē illōrum equīs et dē aliīs multīs rēbus, quae satis erant nōbīs necessāriae."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="68577.4777070064" OwnPage="163" ItemID="362815893" PTYPE="4" WIDTH="522" HEIGHT="70.1656050955353" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 70.1656 L0 70.1656 L0 0 Z" copath="M0 0 L522 0 L522 70.1656 L0 70.1656 L0 0 Z" gXpos="136.001" gYpos="68577.4777070064" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who were defending the city better by fighting."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Then only night separated all, (both) us and them, and night divided both of us from battling, throwing (spears), throwing darts, and shooting arrows."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="68280.2479999999" OwnPage="164" ItemID="367011765" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="68280.2479999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

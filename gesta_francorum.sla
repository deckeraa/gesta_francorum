        <PAGEOBJECT XPOS="136.001" YPOS="148984.539" OwnPage="357" ItemID="781462933" PTYPE="4" WIDTH="522" HEIGHT="337.652082802961" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 337.652 L0 337.652 L0 0 Z" copath="M0 0 L522 0 L522 337.652 L0 337.652 L0 0 Z" gXpos="136.001" gYpos="148984.539" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Illī autem festīnandō intrāvērunt montāneam, quaerentēs Saracēnōrum bella, et vēnērunt Caesarēam. Itaque venientēs illī iuxtā mare ad urbem Ramore, illīc invēnērunt multōs Arabēs, quī praecursōrēs erant bellī. Quōs nostrī persequentēs, apprehendērunt plūrēs ex eīs, quī dīxērunt omnia bellī nova, ubi essent et quot essent, aut ubi bellāre dispōnerent contrā Chrīstiānōs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Quod audiēns Tancredus, statim mīsit nūntium Hierūsalēm ducī Godefridō et patriarchae omnibusque prīncipibus dīcēns: &quot;Sciātis"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", quod nōbīs parātum est bellum Scalōnae; venīte ergō festīnanter cum omnī virtūte quam habēre poteritis!&quot; Tunc iussit dux submonērī omnēs, ut fidēliter īrent"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" praeparātī Scalōnam obviam inimīcīs nostrīs. Ipse vērō cum patriarchā et Rotbertō, Flandrensī comite, exīvit dē urbe in fēriā tertiā, et Marturanensis episcopus cum eīs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="149322.802547771" OwnPage="357" ItemID="778483301" PTYPE="4" WIDTH="522" HEIGHT="68.4840764331166" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 68.4841 L0 68.4841 L0 0 Z" copath="M0 0 L522 0 L522 68.4841 L0 68.4841 L0 0 Z" gXpos="136.001" gYpos="149322.802547771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="You know that war is prepared against us in Ascalon."/>
                <ITEXT CH=" Tancred had learned of Muslims preparations, taking place at Ascalon, for a counter-attack against the Crusaders."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That faithfully they might go to Ascalon, having been prepared, against our enemies."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="148984.539" OwnPage="358" ItemID="781540501" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="148984.539" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

                <para PARENT="Vocab"/>
                <ITEXT CH="vītīs: vines; plural feminine ablative from vīta, vītae"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="101560.368" OwnPage="243" ItemID="540263157" PTYPE="4" WIDTH="522" HEIGHT="298.07785987285" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 298.078 L0 298.078 L0 0 Z" copath="M0 0 L522 0 L522 298.078 L0 298.078 L0 0 Z" gXpos="136.001" gYpos="101560.368" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Imprūdēns itaque Stephanus, Carnotensis comes, quem omnēs nostrī maiōrēs ēlēgerant ut esset ductor nostrōrum, maximā sē fīnxit"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" dēprimī īnfirmitāte, priusquam Antiochīa esset capta, turpiterque recessit in aliud castrum, quod vocātur Alexandrēta. Nōs itaque cotīdiē praestōlābāmur eum, quātinus subvenīret nōbīs in adiūtōriō, quī erāmus inclūsī in urbe, salūtiferō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" cārentēs auxiliō. At ille, postquam audīvit gentem Turcōrum circumcingentem et obsīdentem nōs, latenter ascendit super proximam montaneam quae stābat prope Antiochīam, vīditque innumerābilia tentōria, vehementīque captus"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" timōre recessit, fugitque festīnanter cum suō exercitū. Veniēns autem in suum castrum, exspoliāvit illud, et celerī cursū retrovertitur."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="101858.445859873" OwnPage="243" ItemID="540366101" PTYPE="4" WIDTH="522" HEIGHT="92.6369426751626" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 92.6369 L0 92.6369 L0 0 Z" copath="M0 0 L522 0 L522 92.6369 L0 92.6369 L0 0 Z" gXpos="136.001" gYpos="101858.445859873" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Feigning himself to be oppressed with great sickness."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Lacking health-bringing help."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Having been captured by vehement fear, he withdrew and fled hastily with his army."/>
                <ITEXT CH=" Stephan Henry returned home in disgrace, having failed his Crusader vow. However, he did embark again on the crusade of 1101, in which he was captured and killed."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

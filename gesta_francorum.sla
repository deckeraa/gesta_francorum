        <PAGEOBJECT XPOS="136.001" YPOS="117368.425" OwnPage="281" ItemID="627387541" PTYPE="4" WIDTH="522" HEIGHT="241.052707006675" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 241.053 L0 241.053 L0 0 Z" copath="M0 0 L522 0 L522 241.053 L0 241.053 L0 0 Z" gXpos="136.001" gYpos="117368.425" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Haec occīsiō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" facta est quīntō diē in mēnse Iūliō. Reversī sunt autem Francī illī quī remānserant in suum castrum; et fuit ibi Raimundus cum suā gente per plūrēs diēs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Aliī vērō, quī in Antiochiā remānserant, stetērunt in eā cum gaudiō et laetitiā magnā, quōrum"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" rēctor et pāstor extitit Podiēnsis epīscopus, quī nūtū Deī gravī aegritūdine captus est; et, ut Deī voluntās fuit, migrāvit ab hōc saeculō et in pāce requiēscēns obdormīvit in Dominō, in sōlemnitāte scīlicet sānctī Petrī quae dīcitur Ad Vincula"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH="."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="117609.477707006" OwnPage="281" ItemID="627799893" PTYPE="4" WIDTH="522" HEIGHT="82.0891719749197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 82.0892 L0 82.0892 L0 0 Z" copath="M0 0 L522 0 L522 82.0892 L0 82.0892 L0 0 Z" gXpos="136.001" gYpos="117609.477707006" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="This slaughter occurred on the fifth day of the month of July (1098)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Of whom the Bishop of Le Puy stood as leader and pastor, who by the will of God was seized with a great sickness."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Ad Vincula"/>
                <ITEXT CH=" refers to the feast celebrating the miraculous escape of St. Peter from prison in Acts 12. This feast took place on August 1st, 1098."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="117368.425" OwnPage="282" ItemID="631985413" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="117368.425" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

        <PAGEOBJECT XPOS="136.001" YPOS="31672.116" OwnPage="75" ItemID="188519541" PTYPE="4" WIDTH="522" HEIGHT="295.883999999987" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 295.884 L0 295.884 L0 0 Z" copath="M0 0 L522 0 L522 295.884 L0 295.884 L0 0 Z" gXpos="136.001" gYpos="31672.116" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Vir itaque sapiēns Boamundus prōtinus mandāvit aliīs, scīlicet ēgregiō comitī dē Sānctō Egidīō, et inclitō dūcī Godefridō, et Hugōnī Magnō, atque honestissimō Podiēnsī epīscopō, aliīsque omnibus Chrīstī mīlitibus, quō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" festīnent, et ad bellum citius approximent, dīcēns: &quot;Et sī hodiē luctārī volunt, virīliter veniant.&quot; Quī omnimodō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" prohibentēs, dēlūdentēs illōs et dīcentēs: 'Vērumtamen hoc fallācium est tōtum'. Nam nōs nōn crēdēbāmus iam illōs esse tam pudentēs"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=", quod amplius audērent sē ērigere et proeliārī nōbīscum. Dux itaque Godefridus audāx et fortis, ac Hugō Magnus simul vēnērunt prius cum suīs exercitibus; epīscopus quoque Podiēnsis prōsecūtus est illōs, ūna cum suō exercitū, et comes dē Sānctō Egidīō iuxtā illōs cum magnā gente."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="31968" OwnPage="75" ItemID="188639573" PTYPE="4" WIDTH="522" HEIGHT="145.834394904461" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 145.834 L0 145.834 L0 0 Z" copath="M0 0 L522 0 L522 145.834 L0 145.834 L0 0 Z" gXpos="136.001" gYpos="31968" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="To where they might hasten, and to quickly draw near to the battle, saying: 'If today you wish to fight, let them (the soldiers) come manfully'."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who (the military leadership to whom the couriers from Bohemond talked) were by all means refusing them, mocking them and saying: 'Certainly this (the couriers' message about the crusader vanguard being surrounded in battle) is entirely false'."/>
                <ITEXT CH=" The military leadership at first disbelieved that the Turks would so audaciously attack them so soon after the crusader victory at Nicea. However, several of the princes (Godfrey, etc.) changed their mind and came to Bohemond's aid just in time."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For we did not believe them (the Turks) to be so bold, that they might dare to raise themselves up again and to fight with us."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="31672.116" OwnPage="76" ItemID="190714277" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="31672.116" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

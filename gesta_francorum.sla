        <PAGEOBJECT XPOS="136.001" YPOS="108216.392" OwnPage="259" ItemID="576475829" PTYPE="4" WIDTH="522" HEIGHT="244.041121019371" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 244.041 L0 244.041 L0 0 Z" copath="M0 0 L522 0 L522 244.041 L0 244.041 L0 0 Z" gXpos="136.001" gYpos="108216.392" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Nūntiī vērō nostrī vēlōciter reversī sunt retrōrsum, referentēs omnia quae respondisset eīs gēns crūdēlissima. Fertur"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Herluīnus utramque scīsse linguam fuitque interpres Petrō Heremitae. Intereā"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" exercitus noster in utrāque tremefactus parte ignōrābat quid faceret: ex ūnā enim parte coangustābat eōs cruciābilis famēs, in aliā cōnstringēbat timor Turcōrum."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Tandem trīduānīs explētīs ieiūniīs, et prōcessiōnibus celebrātīs ab ūnā ecclēsiā in aliam, dē peccātīs suīs cōnfessī sunt et absolūtī, fidēliterque corporī et sanguinī Chrīstī commūnicāvērunt"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=": datīsque eleēmosynīs fēcērunt celebrārī missās."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="108460.433121019" OwnPage="259" ItemID="576917653" PTYPE="4" WIDTH="522" HEIGHT="90.343949044589" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 90.3439 L0 90.3439 L0 0 Z" copath="M0 0 L522 0 L522 90.3439 L0 90.3439 L0 0 Z" gXpos="136.001" gYpos="108460.433121019" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Herluinus is reported to have known both languages (presumably Turkish and Latin) and was interpreter to Peter the Hermit."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Meanwhile our army, having been made to tremble in two parts/ways, didn't know what it should do."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And they faithfully partook (in) the body and blood of Christ."/>
                <ITEXT CH=" They celebrated the Eucharist. "/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="108216.392" OwnPage="260" ItemID="581305973" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="108216.392" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

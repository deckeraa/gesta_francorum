                <para PARENT="Vocab"/>
                <ITEXT CH="prōtinus: forward, onward"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quibus: whom; plural ablative of qui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="redēmptī: redēmptī erant = they had been redeemed; plural masculine nominative perfect passive participle from redimō, redimere, redēmī, redēmptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="regiōnēs: regions; plural feminine accusative from regiō, regiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="remōtae: far away, remote; plural feminine nominative from remōtus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="retribūtiō: retribution, recompense; singular feminine nominative from retribūtiō, retribūtiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="scapulā: shoulder, back; singular feminine ablative from scapula, scapulae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sequī: to follow; present active infinitive"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sermō: speech, idea; singular masculine nominative from sermō, sermōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sēsē: themselves"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sīcutī: just as, like"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sitēs: thirsts; plural feminine accusative from sitis, sitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suēvēre: they sewed; 3rd person plural perfect active variant spelling of suērunt from suō, suere, suī, sūtum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suīs: their; plural ablative of suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tālia: such (things); plural neuter accusative from tālis, tālis, tāle"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Tartareā: Hades/Tartarus, of or belonging to the underworld; Tartarean; singular feminine ablative from Tartareus, Tartarea, Tartareum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnanimiter: unanimously, harmoniously"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūniversās: whole, entire; plural feminine accusative from ūniversus, ūniversa, ūniversum"/>

                <para PARENT="Vocab"/>
                <ITEXT CH="praeteriret: it might pass away; 3rd person singular imperfect active subjunctive from praetereō, praeterīre, praeterivī(iī), praeteritus"/>
                <para PARENT="Vocab"/>

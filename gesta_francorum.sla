                <para PARENT="Vocab"/>
                <ITEXT CH="Hermeniī: Armenians"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="honestē: honestly, distinguishedly, worthily; adverb from honestus, honesta -um, honestior -or -us, honestissimus -a -um"/>
                <para PARENT="Vocab"/>

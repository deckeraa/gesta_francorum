        <PAGEOBJECT XPOS="136.001" YPOS="151480.548" OwnPage="363" ItemID="790289301" PTYPE="4" WIDTH="522" HEIGHT="360.878751592769" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 360.879 L0 360.879 L0 0 Z" copath="M0 0 L522 0 L522 360.879 L0 360.879 L0 0 Z" gXpos="136.001" gYpos="151480.548" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Sērō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" autem factō patriarcha fēcit praeconārī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" per omnem hostem, ut in summō māne crās essent omnēs parātī ad bellum, excommūnicāns"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=", nē ūllus homō intenderet ad ūlla spolia, dōnec bellum esset factum; sed eō factō reverterentur cum fēlīcī gaudiō ad capiendum quicquid eīs praedēstinātum esset ā Dominō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Summō vērō dīlūculō, in sextā fēriā, intrāvērunt in vallem nimis pulchram secus lītus maris, in quā suās ōrdināvērunt aciēs. Dux īnstrūxit suam aciem et comes Nortmanniae suam, comes Sānctī Egidiī suam, comes Flandrensis suam, comes Eustachius suam, Tancredus et Gaston suam; ōrdināvērunt quoque peditēs et sagittāriōs, quī praecēderent mīlitēs, et sīc ōrdināvērunt omnia; statimque coepērunt mīlitāre in nōmine Dominī Iēsū Chrīstī. In sinistrā vērō parte fuit dux Godefridus cum suā aciē; comesque Sānctī Egidiī equitāvit iuxtā mare in dexterā parte. Comes Nortmanniae et comes Flandrensis et Tancredus omnēsque aliī equitābant in mediō."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="151841.426751592" OwnPage="363" ItemID="790310997" PTYPE="4" WIDTH="522" HEIGHT="108.840764331224" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 108.841 L0 108.841 L0 0 Z" copath="M0 0 L522 0 L522 108.841 L0 108.841 L0 0 Z" gXpos="136.001" gYpos="151841.426751592" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="However, it having become late."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="Even though "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="praeconārī"/>
                <ITEXT CH=" is deponent, I've glossed it with a passive meaning, based on the context."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Excommunicating, if any man should intend himself to any spoils before the battle was complete, but that, with this done, they should return with happy gladness to seize whatever was predestined to them by the Lord."/>
                <ITEXT CH=" Soldiers abandoning attack to begin plundering was a military risk, so the patriarch threatened to excommunicate anyone who did so."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="151480.548" OwnPage="364" ItemID="793803733" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="151480.548" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>

                <para PARENT="Vocab"/>
                <ITEXT CH="sine: without"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sinite: allow! permit!; 2nd person plural present active imperative from sinō, sinere, sīvī, situs"/>

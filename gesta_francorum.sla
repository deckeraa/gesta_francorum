        <PAGEOBJECT XPOS="136.001" YPOS="126520.458" OwnPage="303" ItemID="671983877" PTYPE="4" WIDTH="522" HEIGHT="327.491044586321" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 327.491 L0 327.491 L0 0 Z" copath="M0 0 L522 0 L522 327.491 L0 327.491 L0 0 Z" gXpos="136.001" gYpos="126520.458" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Boamundus igitur fēcit per interpretem loquī Saracēnīs maiōribus, ut ipsī cum suīs mulieribus et īnfantibus aliīsque substantiīs mitterent sē in ūnum palātium quod est suprā portam, ipseque"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" dēfenderet eōs dē mortālī sententiā. Intrāvērunt vērō omnēs nostrī in cīvitātem et quicquid"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" bonī invēnērunt in domibus et in foveīs, hoc ūnusquisque ad suum continēbat proprium. Factō"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" autem diē, ubicunque reperiēbant quemquam illōrum, sīve masculum sīve fēminam, occīdēbant. Nūllus angulus"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" cīvitātis dēerat vacuus Saracēnōrum cadāveribus, vixque poterat aliquis per viās īre cīvitātis, nisi calcandō super Saracēnōrum cadāvera. Boamundus dēnique illōs, quōs iusserat in palātium intrāre, apprehendit, illīsque abstulit omnia quae habēbant, vidēlicet aurum, argentum, aliaque ōrnāmenta; aliōs vērō fēcit occīdī, aliōs autem iussit condūcī ad vēndendum Antiochīae."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="126847.949044586" OwnPage="303" ItemID="672178245" PTYPE="4" WIDTH="522" HEIGHT="88.9681528662477" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 88.9682 L0 88.9682 L0 0 Z" copath="M0 0 L522 0 L522 88.9682 L0 88.9682 L0 0 Z" gXpos="136.001" gYpos="126847.949044586" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that he himself might defend them from a death sentence."/>
                <ITEXT CH=" Here Bohemond expends extra effort to protect human life, even amongst his enemies. Later on he kills some of them, presumably with just cause."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Whatever good (things) they found in homes or in holes, this each one was keeping as his own property."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="It having become daytime."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="No empty corner of the city was lacking corpses of the Muslims."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

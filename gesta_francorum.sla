                <para PARENT="Vocab"/>
                <ITEXT CH="cotīdiē: daily"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="crucis: of the cross; singular feminine genitive from crux, crucis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="deum: God; singular masculine accusative from Deus, Dei"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ēgregius: excellent, honorable; singular masculine nominative from ēgregius, ēgregia, ēgregium"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eōrum: their; plural masc. or neuter. genitive"/>

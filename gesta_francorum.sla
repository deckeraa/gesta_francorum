                <ITEXT CH="pārentēs: parents; plural masculine nominative or accusative from pārentēs, pārentium (which only has plural forms)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pauperibus: poor; plural ablative from pauper, pauperis (gen.), pauperior -or -us, pauperrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="peregrīnīs: travelers; plural ablative from peregrinus, peregrina, peregrinum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prōpulērunt: they drove, defeated; 3rd person plural perfect active from prōpellō, prōpellere, prōpulī, prōpulsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prōtinus: immediately"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pugnam: fight; singular feminine accusative from pugna, pugnae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="putant: they think; 3rd person plural present active from putō, putāre, putāvī, putātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quae: who; singular feminine nominative or plural neuter nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quemdam: a certain; singular masculine accusative from quīdam"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; plural masculine nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quibus: which; plural ablative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rēgiā: royal palace, court; singular feminine ablative from rēgius, rēgia, rēgium"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="reversus: reversus + est = he returned"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Romāniā: Byzantine Asia Minor (ablative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rūbīgine: rust; singular feminine ablative from rūbīgō, rūbīginis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="subrīdēre: to smile; present active infinitive from subrīdeō, subrīdēre, subrīsī, subrīsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sunt: they are; 3rd person plural present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="super: above, on top of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suum: his; singular masculine accusative from suus, sui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Syriae: of Syria"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tēctum: having been covered; singular neuter nominative perfect passive participle from tegō, tegere, tēxī, tēctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tēterrimum: very foul, ugly; singular masculine accusative from tēter, tētra -um, tētrior -or -us, tēterrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tōtius: of the whole; singular genitive from tōtus, tōta, tōtum (gen -ius)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tunc: then"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcī: the Turks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ultrā: beyond, further"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="urbe: city; singular feminine ablative from urbs, urbis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vīlissimum: most cheap, worthless; singular masculine accusative from vīlis, vīlis, vīle"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="84088.3049999998" OwnPage="201" ItemID="447169269" PTYPE="4" WIDTH="522" HEIGHT="334.675891719919" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 334.676 L0 334.676 L0 0 Z" copath="M0 0 L522 0 L522 334.676 L0 334.676 L0 0 Z" gXpos="136.001" gYpos="84088.3049999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Mox convocāvit suum notārium, et ait: &quot;Scrībe cito plūrēs chartās, quae in Corrozāniā sint"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" legendae, vidēlicet: &quot;Caliphae"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" nostrō Apostolicō, ac nostrī rēgī, dominō Soldānō, mīlitī fortissimō, atque omnibus prūdentissimīs mīlitibus Corrozānae, salūs et immēnsus honor. Satis sint"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" laetī et gāvīsī iocundā concordiā et satisfaciant ventribus, imperent et sermōcinent per ūniversam regiōnem illam, ut omnīnō dent"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" sēsē ad petulantiam et ad luxuriam, multōsque fīliōs patrāre congaudeant, quī contrā Chrīstiānōs fortiter pugnāre praevaleant et libenter suscipiant haec tria arma, quae ōlim abstulimus ā Francōrum turmā, et discant modo quae arma attulērunt super nōs gēns Francigēna, quāliter"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" optima et perfecta sunt, heu! Certāre"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" contrā nostra arma, quae bis aut ter sīve quattuor sunt cōlāta aut pūrgāta cue argentum aut aurum pūrissimum.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="84422.9808917198" OwnPage="201" ItemID="447517061" PTYPE="4" WIDTH="522" HEIGHT="144.917197452218" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 144.917 L0 144.917 L0 0 Z" copath="M0 0 L522 0 L522 144.917 L0 144.917 L0 0 Z" gXpos="136.001" gYpos="84422.9808917198" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which are to be read in Khorasan."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="To the Caliph our Pope, and to our king, the Lord Sultan, most mighty soldier, and to all the very prudent soldiers of Khorasan, (be) health and great honor."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="May they be gladdened and happy enough."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That they may entirely give themselves to carelessness and luxury."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="How optimal and perfect they are, ha! "/>
                <ITEXT CH="The writer is employing sarcasm here."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="(How futile it is) to fight against our weapons, which two or three or four times are strained or purged like silver or most pure gold. "/>
                <ITEXT CH="The idea here is that the Turkish weapons are finely made, like purified gold, not that they are made out of silver or gold."/>
                <para PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="84088.3049999998" OwnPage="202" ItemID="450659349" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="84088.3049999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="abstulimus: we carried away; 1st person plural perfect active from auferō, auferre, abstulī, ablātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="āit: he said; 3rd person singular present active from aio, -, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Apostolicō: the Pope (medieval usage), bishop, apostle; singular masculine dative from apostolicus, apostolica, apostolicum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="argentum: silver; singular neuter nominative from argentum, argentī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="arma: weapons; plural neuter accusative from armum, armī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="atque: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="attulērunt: they had carried; 3rd person plural perfect active from afferō, afferre, attulī, allātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aurum: gold; singular neuter nominative from aurum, aurī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aut: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bis: twice"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Calīphae: to the Caliph, loanword from Arabic; singular masculine dative from calipha, caliphae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="certāre: to fight; present active infinitive from certō, certāre, certāvī, certātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ceu: as, like"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="chartās: sheets of papyrus; plural feminine accusative from charta, chartae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstiānōs: Christians; plural masculine accusative from Chrīstiānus, Chrīstiānī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="citō: quickly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōlāta: having been filtered, strained; plural neuter accusative perfect passive participle from cōlō, cōlāre, cōlāvī, cōlātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="concordiā: union, agreement, harmony; singular feminine ablative from concordia, concordiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="congaudeant: they might rejoice together; 3rd person plural present active subjunctive from congaudeō, congaudēre, congavīsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="contrā: against, away from, facing"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="convocāvit: he called together, assembled; 3rd person singular perfect active from convocō, convocāre, convocāvī, convocātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Corrozānae: of Khorasan, a region in modern-day Iran (dative, genitive, or locative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Corrozāniā: Khorasan, a region in modern-day Iran (ablative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dent: they might give; 3rd person plural present active subjunctive from dō, dare, dedī, datus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīscant: they might learn; 3rd person plural present active subjunctive from dīscō, dīscere, didicī, dīscitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dominō: lord; singular masculine dative from dominus, dominī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fīliōs: sons; plural masculine accusative from fīlius, fīlī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fortissimō: very strong; singular masculine dative from fortis, forte, fortior -or -us, fortissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fortiter: strongly (adverb from fortis, forte)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Francigena: those born of the Franks, Frankish-born"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Francōrum: of the Franks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gavīsī: having been rejoiced; plural masculine nominative perfect passive participle from gaudeō, gaudēre, gavīsus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gēns: people, clan, nation; singular feminine nominative from gēns, gentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="haec: this, these; plural neuter accusative from hic, haec, hoc"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="heu: Hey! oh! (interjection)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="honor: honor; singular masculine nominative from honor, honōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illam: that; singular feminine accusative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="immēnsus: immense, boundless; singular masculine nominative from immēnsus, immēnsa, immēnsum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="imperent: they might command; 3rd person plural present active subjunctive from imperō, imperāre, imperāvī, imperātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>

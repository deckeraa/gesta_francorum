        <PAGEOBJECT XPOS="136.001" YPOS="10040.038" OwnPage="23" ItemID="86991621" PTYPE="4" WIDTH="522" HEIGHT="262.382382165606" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 262.382 L0 262.382 L0 0 Z" copath="M0 0 L522 0 L522 262.382 L0 262.382 L0 0 Z" gXpos="136.001" gYpos="10040.038" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Dux dēnique Godefridus prīmus omnium seniōrum Cōnstantīnopolim vēnit cum magnō exercitū, duōbus"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" diēbus ante Dominī nostrī Nātāle, et hospitātus est extrā urbem, dōnec inīquus imperātor iussit eum hospitārī in burgō urbis. Cumque"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" fuisset hospitātus dux, sēcūrē mittēbat armigerōs suōs per singulōs diēs, ut paleās et alia equīs necessāria asportārent. Et cum putārent"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" exīre fīdūciāliter quō vellent, inīquus imperātor Alexius sagāciter faciēbat eōs excubāre, suīsque Turcopōlīs et Pincinātīs imperābat eōs invādere et occīdere. Balduīnus"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" itaque frāter ducis haec audiēns mīsit sē in īnsidiīs; tandemque invenit eōs occīdentēs gentem suam, eōsque invāsit fortī animō, ac Deō iuvante superāvit eōs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="10302.4203821656" OwnPage="23" ItemID="87208965" PTYPE="4" WIDTH="522" HEIGHT="191.235668789808" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 191.236 L0 191.236 L0 0 Z" copath="M0 0 L522 0 L522 191.236 L0 191.236 L0 0 Z" gXpos="136.001" gYpos="10302.4203821656" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Two days before Christmas (the Birth of our Lord)."/>
                <ITEXT CH=" The ablative of time is used here."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And when the leader (Godfrey) had been lodged, he was securely sending his squires (into Constantinople) every day, that they might carry straw and other necessities for the horses."/>
                <ITEXT CH=" The emperor limited how many Crusader soldiers could be inside the city at once, fearing that they might overthrow him."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And when they (Godfrey's forces) thought they could go out carelessly to where they might want, the iniquitous emperor Alexius cleverly was making them to sleep outside, and commanded his Turcopoles and Pechenegs to set upon and kill them."/>
                <ITEXT CH=" Alexius waited for Godfrey's troops to become carefree and then sent people to kill them while they slept outside. Turcopoles and Pechenegs were both Turkic groups who were under the emperor's command. His use of them specifically might have been an attempt to avoid getting blamed for the violence."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Baldwin therefore the brother of the leader (Godfrey), hearing these things, set himself in ambush, and finally he found them killing his people, and set upon them with a mighty spirit, and, God helping, he overcame them."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="10040.038" OwnPage="24" ItemID="90242949" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="10040.038" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Alexius: Alexius I Comnenus, Byzantine emperor from 1081-1118."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="alia: other; plural neuter accusative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="animō: soul, mind, live; singular masculine ablative from animus, animi"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ante: before, in front, forwards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="armigerōs: squires, armor-bearers; plural masculine accusative from armiger, armigerī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="asportārent: they might carry away; 3rd person plural imperfect active subjunctive from asportō, asportāre, asportāvī, asportātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="audiēns: hearing; singular nominative present participle from audiō, audīre, audīvī, audītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Balduīnus: Baldwin"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="burgō: suburb; singular masculine ablative from burgus, burgī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Cōnstantīnopolim: Constantinople; singular feminine accusative from Constantinopolis, Constantinopolis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēnique: finally"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Deō: god; singular masculine ablative from Deus, Dei"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="diēbus: days; plural common ablative from diēs, diēī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="diēs: days; plural accusative from diēs, diēī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Dominī: of the lord; singular masculine genitive from Dominus, Dominī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dōnec: while, as long as, until"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ducis: of the leader; singular masculine genitive from dux, ducis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="duōbus: two; plural masculine ablative from duo -ae o, secundus -a -um, bīnī -ae -a, bis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dux: leader; singular masculine nominative from dux, ducis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eōs: to them; plural masculine accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="equīs: horses; plural masculine ablative from equus, equī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eum: to him; singular masculine accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="excubāre: to lie in the open; present active infinitive from excubō, excubāre, excubuī, excubitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="exercitū: army; singular neuter ablative from exercitus, exercitūs"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="exīre: to go out; present active infinitive from exeō, exīre, exivī(iī), exitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="extrā: outside of, beyond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="faciēbat: he was doing; 3rd person singular imperfect active from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fīdūciāliter: confidently"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fortī: strong; singular ablative from fortis, forte, fortior -or -us, fortissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="frāter: brother; singular masculine nominative from frāter, frātris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fuisset: he had been; 3rd person singular pluperfect active subjunctive from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gentem: people; singular feminine accusative from gēns, gentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Godefridus: Godfrey of Bouillon (~1060-1100 AD), first ruler of the Kingdom of Jerusalem"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="haec: these things; plural neuter acccusative from hic, haec, hoc"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hospitātus: hospitātus est = he was lodged, hospitātus fuisset = he had been lodged; singular masculine nominative perfect participle from hospitō, hospitāre, hospitāvī, hospitātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hospitārī: to be lodged; passive infinitive from hospitō, hospitāre, hospitāvī, hospitātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="imperābat: he was commanding; 3rd person singular imperfect active from imperō, imperāre, imperāvī, imperātus. imperābat takes the dative instead of the accusative"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="imperātor: emperor; singular masculine nominative from imperātor, imperātōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="inīquus: unjust; singular masculine nominative from inīquus, inīqua -um, inīquior -or -us, inīquissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="īnsidiīs: ambushes, plots; plural feminine ablative from īnsidia, īnsidiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invādere: to invade; present active infinitive from invādō, invādere, invāsī, invāsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invāsit: he invaded; 3rd person singular perfect active from invādō, invādere, invāsī, invāsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invēnit: he found; 3rd person singular present active from inveniō, invenīre, invēnī, inventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="itaque: so then, therefore"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iussit: he commanded; 3rd person singular perfect from iubeō, iubēre, iussī, iussus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iuvante: helping; singular ablative present participle from iuvō, iuvāre, iūvī, iūtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="māgnō: large; singular masculine ablative from māgnus, māgna -um, major -or -us, maximus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīsit: he sent; 3rd person singular perfect active from mittō, mittere, mīsī, missus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mittēbat: he was sending; 3rd person singular imperfect active from mittō, mittere, mīsī, missus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nātāle: birthday; singular neuter accusative from natalis, natalis, natale"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="necessāria: necessities; plural neuter accusative from necessāria, necessāriōrum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrī: our; singular masculine genitive noster"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="occīdere: to kill; present active infinitive from occīdō, occīdere, occīdī, occīsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnium: of all; plural genitive from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="paleās: straw; plural feminine accusative from palea, paleae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Pincinātīs: Pechenegs (dative case): a semi-nomadic Turkic people allied with Byzantium since the 9th century."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prīmus: first; singular masculine nominative from prīmus, prīma, prīmum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="putārent: they might think; 3rd person plural imperfect active subjunctive from putō, putāre, putāvī, putātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quō: to where; singular ablative of quis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sagāciter: cleverly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sē: himself"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sēcūrē: carefreely (adverb)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="seniōrum: of the chiefs; plural genitive from senex, senis (gen.), senior -or -us, -"/>
                <para PARENT="Vocab"/>

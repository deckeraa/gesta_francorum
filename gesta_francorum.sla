                <para PARENT="Vocab"/>
                <ITEXT CH="arcum: bow; singular masculine accusative from arcus, arcūs"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="arma: weapons; plural neuter nominative from armum, armī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Asiam: Asia (Roman province formed from Pergamene); Asia Minor; the East; singular feminine accusative from Asia, Asiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="attulērunt: they had carried; 3rd person plural perfect active from afferō, afferre, attulī, allātus"/>

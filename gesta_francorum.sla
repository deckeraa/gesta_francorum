        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="6712.026" OwnPage="15" ItemID="69478949" PTYPE="4" WIDTH="522" HEIGHT="322.419859872613" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 322.42 L0 322.42 L0 0 Z" copath="M0 0 L522 0 L522 322.42 L0 322.42 L0 0 Z" gXpos="136.001" gYpos="6712.026" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Epīscopī vērō et presbitērī cōnfortābant nostrōs et commonēbant nē dēficerent, dīcentēs: &quot;Ēstote ubīque fortēs in fidē Chrīstī et nōlīte eōs timēre quī vōs persequuntur, sīcut Dominus dīcit: 'Nōlīte"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" timēre eōs quī corpus occīdunt; animam vērō nōn possunt occīdere.'&quot; Haec trībulātiō fuit per octo diēs. Dēnique dominus Alamannōrum Reinaldus concordātus"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" est cum Turcīs, ut trāderet sociōs illīs, et fingēns sē exīre ad bellum, fūgit ad illōs et multī cum eō. Illī autem quī Deum negāre nōluērunt, capitālem"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" sententiam suscēpērunt; aliōs quōs cēpērunt vīvōs adinvicem dīvīsērunt quasi"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" ovēs; aliōs mīsērunt ad signum"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" et sagittābant eōs; aliōs vēndēbant et dōnābant quasi animalia. Quīdam condūcēbant suōs in domum suam, aliōs in Corosānum, aliōs in Antiochīam, aliōs in Aleph, aut ubi ipsī manēbant. Istī prīmō fēlīx"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" accēpērunt martirium prō nōmine Dominī Iēsu."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="7034.44585987261" OwnPage="15" ItemID="69884517" PTYPE="4" WIDTH="522" HEIGHT="168.764331210191" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 168.764 L0 168.764 L0 0 Z" copath="M0 0 L522 0 L522 168.764 L0 168.764 L0 0 Z" gXpos="136.001" gYpos="7034.44585987261" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH="Matthew 10:28"/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Finally the master of Alamannī, Reinaldus, came to an agreement with the Turks, that he might betray his comrades to them, and feigning to go out to battle, he fled to them and many with him."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Those, however, who did not want to deny God received a capital sentence. "/>
                <ITEXT CH="The Turks told the captives to deny the faith and killed all who would not."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Others which they took alive they divided among themselves like sheep."/>
                <ITEXT CH=" The Turks divided up the captured crusaders who did not deny the faith and sent them to various fates."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Others they sent to archery targets and shot arrows at them."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="These first received the blessed martydom for the name of the Lord Jesus."/>
                <ITEXT CH=" Here "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="prīmō"/>
                <ITEXT CH=" may refer to them being the first martyrs in the Crusades, or it may be used to distinguish those who died confessing the faith from those who denied Christ and were sent to various fates."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="6712.026" OwnPage="16" ItemID="73395877" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="6712.026" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

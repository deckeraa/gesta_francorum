        <PAGEOBJECT XPOS="136.001" YPOS="121528.44" OwnPage="291" ItemID="648536693" PTYPE="4" WIDTH="522" HEIGHT="387" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 387 L0 387 L0 0 Z" copath="M0 0 L522 0 L522 387 L0 387 L0 0 Z" gXpos="136.001" gYpos="121528.44" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Haec urbs Antiochīa scīlicet valdē est pulchra et honōrābilis, quia īnfrā mūrōs eius sunt quattuor montāneae maximae et nimis altae. In altiōrī quoque est castellum aedificātum, mīrābile et nimis forte. Dē deorsum est cīvitās honōrābilis et conveniēns"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" omnibusque ōrnāta honōribus, quoniam multae ecclēsiae sunt in eā aedificātae; trecenta et sexāgintā monastēria in sē continet. Sub suō iugō continet patriarcha centum quīnquāgintā trēs episcopōs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Clauditur cīvitās duōbus mūrīs, maior quoque valdē est altus et mīrābiliter lātus magnīsque lapidibus compositus, in quō sunt ōrdinātae quattuor centum et quīnquāgintā turrēs; modīsque"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" omnibus est cīvitās fōrmōsa; ab oriente clauditur quattuor magnīs montāneīs; ab occidente secus mūrōs urbis fluit quoddam flūmen, cui nōmen Farfar: et ita nōluērunt stultē neque inānē dīmittere rēgālem cīvitātem Antiochīam, quae tantae auctōritātis fuit, quod eam prius 75 rēgēs cōnstituērunt, quōrum fuit caput Antiochus rēx, ā quō dīcitur Antiochīa."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="121916.178343949" OwnPage="291" ItemID="648694597" PTYPE="4" WIDTH="522" HEIGHT="88.5095541401242" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 88.5096 L0 88.5096 L0 0 Z" copath="M0 0 L522 0 L522 88.5096 L0 88.5096 L0 0 Z" gXpos="136.001" gYpos="121916.178343949" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And befittingly adorned with all honors."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And the city is beautiful in every way."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

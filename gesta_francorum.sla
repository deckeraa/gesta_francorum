                <ITEXT CH="morārī: to stay, delay; present active infinitive from the deponent moror, morārī, morātum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mortuī: fuērunt mortuī = they had died; plural masculine nominative perfect participle from morior, morī, mortuus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="multa: many; plural neuter accusative from multus, multa -um, -, plūrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nec: nor, not either"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nimis: too much, extremely"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nisī: if not, unless"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōbīs: us; singular dative or ablative from ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōmina: names; plural neuter accusative from nōmen, nōminis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōn: not"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōnam: the 9th"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōs: us; plural nominative or accusative of ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrīs: our"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrōrum: our"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nūllus: no, none, not any; singular masculine nominative from nūllus, nūlla, nūllum (gen -ius)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="occidentēs: killing; plural masculine nominative present participle from occīdō, occīdere, occīdī, occīsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnipotēns: all-powerful; singular masculine nominative from omnipotēns, (gen.), omnipotentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ovēs: sheep; plural feminine accusative from ovis, ovis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="peditēs: foot soldiers; plural masculine nominative from pedes, peditis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="perdūrāvit: it carried on, endured; 3rd person singular perfect active from perdūrō, perdūrāre, perdūrāvī, perdūrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="perīre: to perish; present active infinitive from pereō, perīre, perivī(iī), peritus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="permīsit: he allowed, permitted; 3rd person singular perfect active from permittō, permittere, permīsī, permissus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="persecūtī: persecūtī sumus = we followed; plural masculine nominative perfect participle from persequor, persequī, persecūtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pius: upright, pious; singular masculine nominative from pius, pia -um, -, piissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="plūrima: very many; plural neuter accusative from multus, multa -um, -, plūrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pugna: fight; singular feminine nominative from pugna, pugnae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quae: who; plural neuter accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; singular masculine nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quia: because"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quōrum: whose; plural neuter genitive from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Scabiōsō: Godefridus dē Monte Scabiōsō = Godfrey of Montescaglioso (a town in Italy)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="scīlicet: namely"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sed: but"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="spolia: spoils, booty; plural neuter accusative from spolium, spoliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sua: their; plural neuter accusative from suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suōs: his; plural accusative of suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Tancredī: of Tancred, Prince of Galilee (1075–1112) (genitive case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tentōria: tents; plural neuter accusative from tentorium, tentoriī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tertiā: third; singular feminine ablative from trēs -es -ia, tertius -a -um, terni -ae -a, ter"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tōtā: whole, total; singular feminine ablative from tōtus, tōta, tōtum (gen -ius)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnā: one; singular feminine ablative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>

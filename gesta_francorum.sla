        <PAGEOBJECT XPOS="136.001" YPOS="18360.068" OwnPage="43" ItemID="128288213" PTYPE="4" WIDTH="522" HEIGHT="170.072127388532" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 170.072 L0 170.072 L0 0 Z" copath="M0 0 L522 0 L522 170.072 L0 170.072 L0 0 Z" gXpos="136.001" gYpos="18360.068" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Novissimē vērō congregātī omnēs maiōrēs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" nātū, quī Cōnstantīnopolī erant, timentēs, nē suā prīvārentur patriā, reperērunt"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" in suīs cōnsiliīs atque ingeniōsīs schemātibus, quod nostrōrum ducēs, comitēs, seu omnēs maiōrēs imperātōrī sacrāmentum fidēliter facere dēbērent, quī omnīnō prohibuērunt, dīxēruntque: 'Certē indignī sumus, atque iniūstum nōbīs vidētur ullātenus eī sacrāmentum iūrāre.' Forsitan"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" adhūc ā nostrīs maiōribus saepe dēlūsī erimus."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="18530.1401273885" OwnPage="43" ItemID="128442837" PTYPE="4" WIDTH="522" HEIGHT="120.611464968151" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 120.611 L0 120.611 L0 0 Z" copath="M0 0 L522 0 L522 120.611 L0 120.611 L0 0 Z" gXpos="136.001" gYpos="18530.1401273885" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Finally, all the elders by birth (noble-men) having been gathered, who were in Constantinople, fearing, lest they should be deprived of their fatherland."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They found, in their plans and ingenious schemes, that our dukes, counts, or all (our) elders should be made to faithfully make an oath to the emperor, which they (the Crusader elders) entirely prohibited."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Maybe we are yet often deluded by our elders."/>
                <ITEXT CH=" Here the writer appears to be expressing distrust at his own leaders."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="18360.068" OwnPage="44" ItemID="130967813" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="18360.068" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adhūc: until now"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="atque: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="certe: certainly; adverb from certus, certa -um, certior -or -us, certissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="comitēs: counts; plural common nominative from comes, comitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="congregātī: having been gathered; plural masculine nominative perfect passive participle from congregō, congregāre, congregāvī, congregātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōnsiliīs: plans, advice, councils; plural neuter ablative from consilium, consiliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Cōnstantīnopolī: in or of Constantinople (genitive or locative case); singular feminine  from Constantinopolis, Constantinopolis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēbērent: they should; 3rd person plural imperfect active subjunctive from dēbeō, dēbēre, dēbuī, dēbitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēlūsī: dēlūsī erimus = we will have been deluded; plural masculine nominative past passive participle from dēlūdō, dēlūdere, dēlūsī, dēlūsus"/>
                <para PARENT="Vocab"/>

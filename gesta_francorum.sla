                <para PARENT="Vocab"/>
                <ITEXT CH="obscūritāte: darkness; singular feminine ablative from obscūritās, obscūritātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnēs: all, every; plural common nominative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>

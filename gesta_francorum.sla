                <para PARENT="Vocab"/>
                <ITEXT CH="fīlius: son; singular masculine nominative from fīlius, fīlī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fuērunt: they were; 3rd person plural perfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>

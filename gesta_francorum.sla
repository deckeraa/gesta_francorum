                <para PARENT="Vocab"/>
                <ITEXT CH="sīve: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="subīre: to undergo, endure; present active infinitive from subeō, subīre, subivī(iī), subitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suīs: their; plural dative or ablative of suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sunt: they are; 3rd person plural present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="superiōrem: upper, higher; singular common accusative from superus, supera -um, superior -or -us, suprēmus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Suriam: Syria; singular feminine accusative from Suria, Suriae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Syria: Syria; singular feminine nominative from Syria, Syriae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="teneō: I hold, keep; 1st person singular present active from teneō, tenēre, tenuī, tentus"/>
                <para PARENT="Vocab"/>

                <ITEXT CH="redierant: they had returned; 3rd person plural pluperfect active from redeō, redīre, redivī(iī), reditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rediit: he returned; 3rd person singular perfect active from redeō, redīre, redivī(iī), reditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sapiēns: wise; singular nominative from sapiēns, sapientis (gen.), sapientior -or -us, sapientissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Saracēnōrum: of Saracenes, Muslims"/>

        <PAGEOBJECT XPOS="136.001" YPOS="36664.134" OwnPage="87" ItemID="209905477" PTYPE="4" WIDTH="522" HEIGHT="185.649439490444" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 185.649 L0 185.649 L0 0 Z" copath="M0 0 L522 0 L522 185.649 L0 185.649 L0 0 Z" gXpos="136.001" gYpos="36664.134" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Liber 4"/>
                <para PARENT="Chapter Heading"/>
                <para PARENT="Chapter Heading"/>
                <tab/>
                <ITEXT CH="Postquam vērō Turcī, inimīcī Deī et sānctae Chrīstiānitātis, omnīnō fuērunt dēvictī, per quāttuor diēs et noctēs fugientēs hūc et illūc, contigit"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" ut Solimānus dux illōrum, fīlius Solimānī veteris, fugeret dē Nīcēa, quī invēnit decem mīlia Arabum, quī dīxērunt eī: &quot;Ō īnfēlīx et īnfēlīcior"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" omnibus gentīlibus! Cūr tremefactus fugis?&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="36849.7834394904" OwnPage="87" ItemID="210175157" PTYPE="4" WIDTH="522" HEIGHT="101.656050955462" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 101.656 L0 101.656 L0 0 Z" copath="M0 0 L522 0 L522 101.656 L0 101.656 L0 0 Z" gXpos="136.001" gYpos="36849.7834394904" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="It happened that Kilij Arslan (Suleiman II) the leader of them (the Turks), the son of the old Suleiman (Suleiman I), had fled from Nicea, who found 10,000 Arabs, who said to him. "/>
                <ITEXT FONT="DejaVu Serif Book" CH="Kilij Arslan fled from the Siege of Nicea but was not inside the city."/>
                <ITEXT CH=" When the siege began, he was further east fighting the Danishmend Emirate (no relation to the Danes or Denmark), and returned from that campaign to fight against the crusaders outside Nicea. Thus it was not difficult for him to escape from Nicea, since he was outside the city walls, and outside of the Crusader's siege line, from the start."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Unhappier than all the (other) pagans."/>
                <ITEXT CH=" The ablative of comparison is used here."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="36664.134" OwnPage="88" ItemID="213129605" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="36664.134" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Arabum: of Arabs; plural masculine genitive from Arabs, Arabis"/>
                <para PARENT="Vocab"/>

                <para PARENT="Vocab"/>
                <ITEXT CH="ex: out of, from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="excubavērunt: they laid in wait, kept watch; 3rd person plural perfect from excubō, excubāre, excubuī, excubitus"/>

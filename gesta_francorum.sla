            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="119864.434" OwnPage="287" ItemID="638772837" PTYPE="4" WIDTH="522" HEIGHT="359.056445860188" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 359.056 L0 359.056 L0 0 Z" copath="M0 0 L522 0 L522 359.056 L0 359.056 L0 0 Z" gXpos="136.001" gYpos="119864.434" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Aliī autem quī in Antiochīā remānserant, fuērunt ibīdem cum gaudiō et laetitiā. Appropinquante"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vērō terminō, vidēlicet fēstō Omnium Sānctōrum, regressī sunt omnēs maiōrēs nostrī in ūnum in Antiochīam, omnēsque simul coepērunt quaerere, quāliter"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" iter Sānctī Sepulchrī valērent peragere, dīcentēs: &quot;Quoniam appropinquāverat eundī terminus, nūlla erat hōra conturbandī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" amplius.&quot;"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Boamundus autem quaerēbat cotīdiē conventiōnem, quam omnēs seniōrēs ōlim habuerant eī in reddendam"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" cīvitātem; sed comes Sānctī Egidiī ad nūllam conventiōnem volēbat sē ēmollīre ergā Boamundum, eō quod timēbat sē peierāre ergā imperātōrem; Tamen saepe fuērunt congregātī in ecclēsiā Sānctī Petrī ad faciendum quod iūstum erat. Boamundus recitāvit suam conventiōnem suumque ostendit compotum. Comes Sānctī Egidīī similiter sua patefēcit verba, et iūsiūrandum, quod fēcerat imperātōrī per cōnsilium Boamundī."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="120223.49044586" OwnPage="287" ItemID="639057589" PTYPE="4" WIDTH="522" HEIGHT="166.471337579613" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 166.471 L0 166.471 L0 0 Z" copath="M0 0 L522 0 L522 166.471 L0 166.471 L0 0 Z" gXpos="136.001" gYpos="120223.49044586" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Having approached that date, namely the feast of All Saints."/>
                <ITEXT CH=" The Crusaders had picked November 1, 1098 for regrouping to begin the final push towards Jerusalem."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="How they might be able to carry out the journey of the Holy Sepulchre."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Because the time of traveling has arrived, there was no time for arguing further."/>
                <ITEXT CH=" The ongoing argument between Bohemond and Raymond of Saint-Gilles is the topic of the next paragraph."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="However Bohemond was daily seeking that agreement, which all the chiefs had once made to him, that they should return the city (of Antioch to him). "/>
                <ITEXT CH="The disagreement arose between Raymond, who had sworn to Alexios to return Byzantine control, and Bohemond, whom the rest of the chiefs had agreed to give Antioch to on condition that he quickly capture the city, which he did. As a further factor in the disagreement was the fact that Alexios had turned his relief army back due to the false report from the deserters, leaving the Crusaders unaided during the latter part of the siege."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="119864.434" OwnPage="288" ItemID="643026437" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="119864.434" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliī: others; plural masculine from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="amplius: ampler, larger; singular neuter nominative from amplus, ampla -um, amplior -or -us, amplissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Antiochīā: Antioch (city in Roman Syria/modern Turkey); singular feminine ablative from Antiochīa, Antiochīae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Antiochīam: Antioch (city in Roman Syria/modern Turkey); singular feminine accusative from Antiochīa, Antiochīae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="appropinquante: approaching; singular ablative present participle from appropinquō, appropinquāre, appropinquāvī, appropinquātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="appropinquāverat: it had approached; 3rd person singular pluperfect active from appropinquō, appropinquāre, appropinquāvī, appropinquātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundī: of Bohemond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundum: Bohemond (accusative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundus: Bohemond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cīvitātem: city; singular feminine accusative from cīvitās, cīvitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="coepērunt: they started; from coepī, coepisse, coepī, coeptum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="comes: count; singular common nominative from comes, comitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="compotum: account; singular masculine accusative variant spelling from computus, computī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="congregātī: fuērunt congregātī = they had been gathered; plural masculine nominative perfect passive participle from congregō, congregāre, congregāvī, congregātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōnsilium: plan, advice, council; singular neuter accusative from consilium, consiliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="conturbandī: disputing, confusing; singular masculine genitive gerund from conturbō, conturbāre, conturbāvī, conturbātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="conventiōnem: agreement; singular feminine accusative from conventiō, conventiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cotīdiē: daily"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīcentēs: saying; plural common nominative present participle from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ecclēsiā: church; singular feminine ablative from ecclēsia, ecclēsiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Egidīī: Egidīī: comes dē Sānctō Egidīō = Raymond of Saint-Gilles"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eī: to him; singular dative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ēmollīre: to soften, mellow; present active infinitive from ēmolliō, ēmollīre, ēmollīvī, ēmollītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eō: in that, eō quod = because; singular masculine ablative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erat: he was; 3rd person singular imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ergā: towards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eundī: of going; singular masculine genitive gerund from eō, īre, iī, itus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="faciendum: doing; singular neuter accusative gerund from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fēcerat: he had made; 3rd person singular pluperfect active from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fēstō: festival; singular masculine ablative from fēstus, fēsta, fēstum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fuērunt: they were; 3rd person plural perfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gaudiō: joy, delight; singular neuter ablative from gaudium, gaudiī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="habuerant: they had had; 3rd person plural pluperfect active from habeō, habēre, habuī, habitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hōra: time; singular feminine nominative from hōra, hōrae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ibīdem: in the same place"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="imperātōrem: emperor; singular masculine accusative from imperātor, imperātōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="imperātōrī: emperor; singular masculine dative from imperātor, imperātōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iter: journey, trip; singular neuter accusative from iter, itineris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iūsiūrandum: oath; singular neuter accusative from iūsiūrandum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iūstum: iust, righteous; singular neuter nominative from iūstus, iūsta -um, iūstior -or -us, iūstissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="laetitiā: joy, gladness, fruitfulness; singular feminine ablative from laetitia, laetitiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="maiōrēs: bigger; plural common nominative from magnus, magna -um, major -or -us, maximus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrī: our (soldiers); plural masculine nominative from noster"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nūlla: no, none, not any; singular feminine nominative from nūllus, nūlla, nūllum (gen -ius)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nūllam: no, none, not any; singular feminine accusative from nūllus, nūlla, nūllum (gen -ius)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ōlim: one time"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnēs: all, every; plural common nominative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnium: of all; plural genitive from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ostendit: he showed; 3rd person singular perfect active from ostendō, ostendere, ostendī, ostentus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="patefēcit: he laid out; 3rd person singular perfect active from patefacio, patefacere, patefeci, patefactus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pēierāre: to perjure, break an oath; present active infinitive from pejero, pejerare, pejeravi, pejeratus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="peragere: to carry through, to complete; present active infinitive from peragō, peragere, perēgī, perāctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Petrī: of Peter; singular masculine genitive from Petrus, Petrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quaerēbat: he was seeking; 3rd person singular imperfect active from quaerō, quaerere, quaesīvī, quaesītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quaerere: to seek; present infinitive from quaerō, quaerere, quaesīvī, quaesītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quāliter: how"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quam: which; singular feminine accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; plural masculine nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quod: what, that; singular neuter nominative or accusative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quoniam: since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="recitāvit: he recited; 3rd person singular perfect active from recitō, recitāre, recitāvī, recitātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="reddendam: returning; singular feminine accusative gerund from reddō, reddere, reddidī, redditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="regressī: regressī sunt = they returned; plural masculine nominative perfect participle from regredior, regredī, regressus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="remānserant: they had remained; 3rd person plural pluperfect active from remaneō, remanēre, remānsī, remānsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="saepe: often"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sānctī: holy, saint"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sānctōrum: of the saints; plural masculine gentive from sānctus, sānctī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sē: himself"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sed: but"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="seniōrēs: elders; plural common nominative from senex, senis (gen.), senior -or -us, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Sepulchrī: Sepulchre; singular neuter genitive from sepulchrum, sepulchrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="similiter: similarly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="simul: at the same time as"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sua: his; plural neuter accusative from suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suam: his; singular feminine accusative from suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sunt: they are; 3rd person plural present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suumque: and his; singular masculine accusative from suus, sui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tamen: however"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terminō: appointed time; singular masculine ablative from terminus, terminī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terminus: appointed time; singular masculine nominative from terminus, terminī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="timēbat: he was fearing; 3rd person singular imperfect active from timeō, timēre, timuī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnum: in ūnum = together; singular masculine accusative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="valērent: they were able; 3rd person plural imperfect active subjunctive from valeō, valēre, valuī, valitūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="verba: word; plural neuter accusative from verbum, verbī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vērō: and, truly, even so, still"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vidēlicet: namely"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="volēbat: he was wanting; 3rd person singular imperfect active from volō, velle, voluī, -"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="120696.437" OwnPage="289" ItemID="643309237" PTYPE="4" WIDTH="522" HEIGHT="412.607585987571" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 412.608 L0 412.608 L0 0 Z" copath="M0 0 L522 0 L522 412.608 L0 412.608 L0 0 Z" gXpos="136.001" gYpos="120696.437" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Epīscopī, et dux Godefridus, Flandrēnsisque comes et comes dē Nortmannīā aliīque seniōrēs dīvīsī sunt ab aliīs, et intrāvērunt ubi est cathedra Sānctī Petrī, ut ibi iūdicium inter utrumque discernerent. Posteā"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vērō timentēs, nē Sānctī Sepulchrī via prōturbārētur, nōluērunt apertē iūdicium dīcere. Ait dēnique comes Sānctī Egidiī: &quot;Priusquam"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" via Sānctī Sepulchrī remaneat, sī Boamundus nōbīscum venīre voluerit, quicquid nostrī parēs"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=", vidēlicet dux Godefridus et Flandrēnsis comes et Rotbertus Nortmannus aliīque seniōrēs laudāverint, ego fidēliter cōnsentiam"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" salvā fidēlitāte imperātōris.&quot; Hoc tōtum laudāvit Boamundus, et prōmīsērunt ambō in manibus epīscopōrum, quod nūllō modō per sē via Sānctī Sepulchrī dēturbārētur."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Tunc accēpit Boamundus cōnsilium cum suīs hominibus, quōmodo mūnīret castrum dē alta montānea hominibus et vīctū. Similiter comes Sānctī Egidīī accēpit cōnsilium cum suīs, quōmodo mūnīret palātium Cassiānī admiraliī et turrim, quae est super portam pontis, quī est ex parte Portus Sānctī Simeōnis, mūnīret, inquam, hominibus et vīctū, quī nōn dēficeret longō tempore."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="121109.044585987" OwnPage="289" ItemID="644020565" PTYPE="4" WIDTH="522" HEIGHT="104.101910828031" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 104.102 L0 104.102 L0 0 Z" copath="M0 0 L522 0 L522 104.102 L0 104.102 L0 0 Z" gXpos="136.001" gYpos="121109.044585987" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And afterwards fearing, lest the journey to the Holy Sepulchre be disturbed, they didn't want to openly proclaim a judgment."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Before/while the journey of the Holy Sepulchre remains."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Whatever our peers, namely Duke Godfrey and the Count of Flanders and Robert the Norman and the other chiefs will have praised."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I faithfully will consent, my fidelity to the emperor having been safe-guarded."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="120696.437" OwnPage="290" ItemID="648155237" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="120696.437" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ab: from, out of, by"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="accēpit: he took, received; 3rd person singular perfect from accipiō, accipere, accēpī, acceptum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="admiraliī: of the emirs, leaders, admirals; loanword from Arabic; singular masculine genitive from admiralīus, admiralīī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ait: he says; 3rd person singular present from aiō, aiere"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliīque: others; plural masculine nominative from alius, alia, alium; -que adds 'and' in front of a word"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliīs: others; plural masculine ablative from alius, alia, alium"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="altā: high; singular feminine ablative from altus, alta, altum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ambō: both; plural masculine nominative from ambō, ambae, ambō"/>

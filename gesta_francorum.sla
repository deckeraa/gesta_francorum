        <PAGEOBJECT XPOS="136.001" YPOS="39992.146" OwnPage="95" ItemID="226611621" PTYPE="4" WIDTH="522" HEIGHT="323.726611464976" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 323.727 L0 323.727 L0 0 Z" copath="M0 0 L522 0 L522 323.727 L0 323.727 L0 0 Z" gXpos="136.001" gYpos="39992.146" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Intereā coepimus intrāre in terram optimam, plēnam corporālibus alimentīs et dēliciīs omnibusque bonīs, ac deinceps appropinquāvimus Icōniō. Habitātōrēs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vērō terrae illīus suādēbant et ammōnēbant nōs nōbīscum ferre utrēs plēnōs aquā, quia illīc in itinere diēī ūnīus est maxima pēnūria aquae. Nōs vērō ita fēcimus, dōnec pervēnimus ad quoddam flūmen, ibique hospitātī sumus per duōs diēs. Coepērunt autem cursōrēs nostrī ante īre, dōnec pervēnērunt ad Erachiam, in quā erat Turcōrum nimia congregātiō, exspectāns et īnsidiāns, quōmodo posset Chrīstī mīlitēs nocēre et contrīstāre. Quōs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" Turcōs Deī omnipotentīs mīlitēs invenientēs audācter invāsērunt. Superātī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" itaque sunt inimīcī nostrī in diē illā, tamque celeriter fugiēbant, quam sagitta fugit ēmissa ictū validō chordae et arcūs. Nostrī igitur intrāvērunt statim in cīvitātem, ibique mānsimus per quāttuor diēs."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="40316.146" OwnPage="95" ItemID="224301749" PTYPE="4" WIDTH="522" HEIGHT="141.433617834402" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 141.434 L0 141.434 L0 0 Z" copath="M0 0 L522 0 L522 141.434 L0 141.434 L0 0 Z" gXpos="136.001" gYpos="40316.146" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The inhabitants of that land were persuading and admonishing us to carry with us vessels full of water, because there in a day's journey was a very great scarcity of water."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The soldiers of the omnipotent God (i.e. the crusaders) finding those Turks, they (the crusaders) boldly attacked."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Therefore our enemies were overcome in that day, and they were quickly fleeing, like an arrow flees, having been sent forth by the strong shot of a bow and arrow."/>
                <para PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="39992.146" OwnPage="96" ItemID="226561301" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="39992.146" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

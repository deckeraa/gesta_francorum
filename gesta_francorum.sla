        <PAGEOBJECT XPOS="136.001" YPOS="55800.2029999999" OwnPage="133" ItemID="301106261" PTYPE="4" WIDTH="522" HEIGHT="210.249229299428" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 210.249 L0 210.249 L0 0 Z" copath="M0 0 L522 0 L522 210.249 L0 210.249 L0 0 Z" gXpos="136.001" gYpos="55800.2029999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tōtā dēnique nocte Willelmus utī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" mala rēs in tentōriō dominī Boamundī iacuit. Crāstinā vērō diē, summō dīlūculō, veniēns ērubēscendō ante Boamundī presentiam stetit. Quem alloquēns Boamundus dīxit: &quot;Ō īnfēlīx et īnfāmia tōtīus Franciae, dēdecus et scelus Galliārum! Ō nēquissimē omnium quōs terra suffert"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="! Cūr tam turpiter fūgistī? Forsitan"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" ob hōc, quod voluistī trādere hōs mīlitēs et hostem Chrīstī, sīcut trādidistī aliōs in Hispāniā?&quot; Quī omnīnō tacuit, et nūllus sermō ex eius ōre prōcessit."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="56010.4522292994" OwnPage="133" ItemID="301464597" PTYPE="4" WIDTH="522" HEIGHT="92.1783439490464" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 92.1783 L0 92.1783 L0 0 Z" copath="M0 0 L522 0 L522 92.1783 L0 92.1783 L0 0 Z" gXpos="136.001" gYpos="56010.4522292994" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Wilhelm, experiencing bad things, laid in the camp of Lord Bohemond."/>
                <ITEXT CH=" From context its clear that Wilhelm was being held in Bohemond's camp overnight to be judged for his desertion."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="O, most evil one of all whom the earth suffers (to exist)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Perhaps for this reason, that you wanted to betray these soldiers and the army of Christ, like you betrayed others in Hispania?"/>
                <ITEXT FONT="DejaVu Serif Book" CH=" Bohemond appears to be referencing another incident of Wilhelm's behavior that occurred in Hispania before the start of the Crusade."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

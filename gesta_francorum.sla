                <para PARENT="Vocab"/>
                <ITEXT CH="sex: six"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sicca: dry; plural neuter acccusative from siccus, sicca, siccum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="solidīs: gold coins; plural ablative from solidus, solida -um, solidior -or -us, solidissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sumus: we are; 1st person plural present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tālēs: such; plural common nominative from tālis, tālis, tāle"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tantam: so much, so great; singular feminine accusative from tantus, tanta, tantum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tenēbant: they were holding; 3rd person plural imperfect active from teneō, tenēre, tenuī, tentus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="timōrēs: fears; plural masculine accusative from timor, timōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trībulātiōnēs: distresses, troubles, tribulations; plural feminine accusative from trībulātiō, trībulātiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnam: one; singular feminine accusative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnō: one; singular masculine ablative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="urbe: city; singular feminine ablative from urbs, urbis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="valdē: very"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēndēbant: they were selling; 3rd person plural imperfect active from vēndō, vēndere, vēndidī, vēnditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēndēbātur: it was being sold; 3rd person singular imperfect passive from vēndō, vēndere, vēndidī, vēnditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="viā: road; singular feminine ablative from via, viae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vīgintī: 20"/>
                <para PARENT="Vocab"/>

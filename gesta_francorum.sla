                <para PARENT="Vocab"/>
                <ITEXT CH="superāvērunt: they overcame; 3rd person plural perfect active from superō, superāre, superāvī, superātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trēs: three; plural common accusative from trēs -es -ia, tertius -a -um, terni -ae -a, ter"/>
                <para PARENT="Vocab"/>

        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="112376.407" OwnPage="269" ItemID="600673173" PTYPE="4" WIDTH="522" HEIGHT="330.191726114936" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 330.192 L0 330.192 L0 0 Z" copath="M0 0 L522 0 L522 330.192 L0 330.192 L0 0 Z" gXpos="136.001" gYpos="112376.407" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Hermēniī et Surānī, quī habitābant in illīs partibus, audientēs nōs superāsse"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Turcōs, cucurrērunt ad montaneam obviantēs illīs, et quantōs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" comprehendērunt ex illīs interfēcērunt. Nōs autem revertentēs ad cīvitātem cum magnō gaudiō laudāvimus et benedīximus Deum, quī victōriam dedit populō suō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Ammirālius itaque, quī castellum cūstōdiēbat, vidēns Curbaram et omnēs aliōs fugientēs ē campō ante Francōrum exercitum, magis timuit: statim vērō cum magnā festīnātiōne petēbat Francōrum vēxilla"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=". Comes igitur Sānctī Egidīī quī illīc astābat ante castellum, iussit eī portārī suum vēxillum. Ille autem accēpit illud et dīligenter mīsit in turrim. Statim dīxērunt Longobardī, quī illīc stābant: &quot;Hoc vēxillum nōn est Boamundī.&quot; Interrogāvit ille et dīxit: &quot;Cuius est?&quot; Quī dīxērunt: &quot;Sānctī Egidiī cōmitis.&quot; Accessit"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" ille et apprehēnsō vēxillō reddidit comitī."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="112706.598726115" OwnPage="269" ItemID="600718581" PTYPE="4" WIDTH="522" HEIGHT="107.770700636931" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 107.771 L0 107.771 L0 0 Z" copath="M0 0 L522 0 L522 107.771 L0 107.771 L0 0 Z" gXpos="136.001" gYpos="112706.598726115" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Hearing us to have overcome the Turks."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And as many as they seized out of them they killed."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Immediately and with great haste he (the Turkish emir of the citadel within Antioch) was seeking the banners of the Franks."/>
                <ITEXT CH=" He wanted to hoist a Frankish banner over the citadel to indicate surrender."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That one (the emir) approached and, having grabbed the flag, returned it to the Count."/>
                <ITEXT CH=" The emir wanted to surrender to Bohemond instead."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="112376.407" OwnPage="270" ItemID="604948869" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="112376.407" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

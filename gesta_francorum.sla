        <PAGEOBJECT XPOS="136.001" YPOS="61624.2239999999" OwnPage="147" ItemID="332082949" PTYPE="4" WIDTH="522" HEIGHT="268.260076433209" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 268.26 L0 268.26 L0 0 Z" copath="M0 0 L522 0 L522 268.26 L0 268.26 L0 0 Z" gXpos="136.001" gYpos="61624.2239999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Videntēs autem aliae aciēs quod"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vēxillum Boamundī tam honestē esset ante aliōs dēlātum, īlicō rediērunt retrōrsum, nostrīque ūnanimiter invāsērunt Turcōs; quī omnēs stupefactī arripuērunt fugam. Nostrī itaque persecūtī sunt illōs et dētruncāvērunt ūsque ad pontem Farreum. Reversī sunt autem Turcī festīnanter in castrum suum, accēpēruntque omnia quae ibi reperīre potuērunt, tōtumque castrum spoliāvērunt, mīsēruntque ignem et fūgērunt. Hermēniī et Surānī scientēs Turcōs omnīnō perdidisse bellum, exiērunt et excubavērunt per arta loca, et occīdērunt et apprehendērunt multōs ex eīs. Superātī sunt itaque, Deō annuente, in illō diē inimīcī nostrī."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="61892.4840764331" OwnPage="147" ItemID="332379541" PTYPE="4" WIDTH="522" HEIGHT="71.0828025477749" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 71.0828 L0 71.0828 L0 0 Z" copath="M0 0 L522 0 L522 71.0828 L0 71.0828 L0 0 Z" gXpos="136.001" gYpos="61892.4840764331" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That the flag of Bohemond was so worthily carried before them, they returned back to their place."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They took everything that they could find, and plundered the whole castle, lit it on fire, and fled."/>
                <ITEXT CH=" The Turks, knowing that they had lost, as they were fleeing destroyed the castle they had been using."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="61624.2239999999" OwnPage="148" ItemID="336090165" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="61624.2239999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="accēpērunt: they took, received; 3rd person plural perfect active from accipiō, accipere, accēpī, acceptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aciēs: battle line; plural feminine nominative from aciēs, aciēī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliae: other; plural feminine nominative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliōs: others; plural masculine accusative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="annuente: giving approval, agreeing; singular ablative present participle from annuō, annuere, annuī, annūtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ante: before, in front, forwards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="apprehendērunt: they seized; 3rd person plural perfect active from apprehendō, apprehendere, apprehendī, apprehēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="arripuērunt: they took hold of, snatched; 3rd person plural perfect active from arripiō, arripere, arripuī, arreptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="arta: close, narrow; plural neuter accusative from locum, locī"/>
                <para PARENT="Vocab"/>

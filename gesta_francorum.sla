                <para PARENT="Vocab"/>
                <ITEXT CH="vīvus: living; singular masculine nominative from vīvus, vīva, vīvum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="zōnās: belts; plural feminine accusative from zōna, zōnae"/>

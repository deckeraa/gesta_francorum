        <PAGEOBJECT XPOS="136.001" YPOS="29176.107" OwnPage="69" ItemID="176054757" PTYPE="4" WIDTH="522" HEIGHT="327.135038216547" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 327.135 L0 327.135 L0 0 Z" copath="M0 0 L522 0 L522 327.135 L0 327.135 L0 0 Z" gXpos="136.001" gYpos="29176.107" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Liber 3"/>
                <para PARENT="Chapter Heading"/>
                <para PARENT="Chapter Heading"/>
                <tab/>
                <ITEXT CH="Intereā redditā"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" cīvitāte et Turcīs dēductīs Cōnstantīnopolim, unde imperātor magis magisque gāvīsus quod cīvitās reddita sit eius potestātī, iussit maximās elemosīnās ērogārī nostrīs pauperibus. Dēnique prīmā diē, quā recessimus ā cīvitāte, vēnimus ad quemdam pontem, ibique mānsimus per duōs diēs. Tertiā autem diē, priusquam lūx coepisset"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" orīrī, surrēxērunt nostrī et, quia nox erat, nōn vīdērunt tenēre ūnam viam, sed sunt dīvīsī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" per duo agmina, et vēnērunt dīvīsī per duōs diēs. In ūnō agmine fuit vir Boamundus, et Rotbertus Normannus, et prūdēns Tancredus, et aliī plūrēs. In aliō fuit comes Sānctī Egidīī, et dux Godefridus, et Podiēnsis epīscopus, et Hugō Magnus, comesque Flandrēnsis, et aliī plūrēs."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="29508.2420382165" OwnPage="69" ItemID="176320469" PTYPE="4" WIDTH="522" HEIGHT="118.777070063694" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 118.777 L0 118.777 L0 0 Z" copath="M0 0 L522 0 L522 118.777 L0 118.777 L0 0 Z" gXpos="136.001" gYpos="29508.2420382165" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Meanwhile, the city (of Nicea) having been returned (to the Byzantines) and the Turks (who were residing in Nicea) having been lead to Constantinople, from whence the emperor was more and more gladdened, that his city had been returned to his power, he ordered a large amount of alms to be paid out to our poor people."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Before the light (of the sun) had begun to arise."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They (the crusader soldiers) were divided into two divisions."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

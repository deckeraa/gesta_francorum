        <PAGEOBJECT XPOS="136.001" YPOS="67448.2449999999" OwnPage="161" ItemID="358246101" PTYPE="4" WIDTH="522" HEIGHT="360" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 360 L0 360 L0 0 Z" copath="M0 0 L522 0 L522 360 L0 360 L0 0 Z" gXpos="136.001" gYpos="67448.2449999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Illī quī vīvī nequīvērunt trānsīre pontem prae nimiā multitūdine gentium et caballōrum, ibi recēpērunt sempiternum interitum et reddidērunt īnfēlīcēs animās Diabolō et Sathānae"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" ministrīs. Nōs itaque illōs superāvimus, impellentēs in flūmen et dēicientēs. Unda"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" vērō rapidī flūminis undique vidēbātur fluere rubea Turcōrum sanguine. Et sī forte aliquis eōrum voluisset rēptāre"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" super pontis columnās, aut natandō ad terram mōlīrētur exīre, vulnerātus est ā nostrīs, undique stantibus super rīpam flūminis."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Rūmor quoque et clāmor nostrōrum et illōrum resonābat ad caelum. Pluviae tēlōrum et sagittārum tegēbant polum, et clāritātem diēī; altae vōcēs intus et extrā. Mulierēs Chrīstiānae urbis veniēbant ad mūrī fenestrās, spectantēs misera fāta Turcōrum et occultē plaudēbant manibus, sīcut mōs"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" erat illārum. Hermenīī et Surānī iussū"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" maiōrum Turcōrum, invītī seu spontāneī, sagittās iaciēbant forās ad nōs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="67808.2449999999" OwnPage="161" ItemID="358433541" PTYPE="4" WIDTH="522" HEIGHT="123.067101910943" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 123.067 L0 123.067 L0 0 Z" copath="M0 0 L522 0 L522 123.067 L0 123.067 L0 0 Z" gXpos="136.001" gYpos="67808.2449999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="There they received eternal ruin and returned their unhappy souls to the Devil and to the ministers of Satan."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And the wave of the rapid river everywhere was seen to flow red with the blood of the Turks."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And if perhaps anyone of them had wanted to crawl over the columns of the bridge, or by swimming might endeavour to go to land (on the other side of the river)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="As was their custom."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The Armenians and Syrians, by the command of the Turkish chiefs, unwillingly or willingly, were shooting arrows outside (the city) at us."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="67448.2449999999" OwnPage="162" ItemID="362007781" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="67448.2449999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

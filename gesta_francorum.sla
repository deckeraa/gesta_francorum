        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="107384.389" OwnPage="257" ItemID="572188933" PTYPE="4" WIDTH="522" HEIGHT="389.063229299631" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 389.063 L0 389.063 L0 0 Z" copath="M0 0 L522 0 L522 389.063 L0 389.063 L0 0 Z" gXpos="136.001" gYpos="107384.389" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tunc Curbaram prīnceps mīlitiae Soldānī Persīdis, cum omnibus aliīs, plēnī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" superbiā, ferōcī respondērunt sermōne: &quot;Deum vestrum et vestram chrīstiānitātem nec optāmus nec volumus, vōsque cum illīs omnīnō respuimus. Hūc"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" ūsque iam vēnimus, eō quod valdē mīrāmur, quamobrem seniōrēs ac maiōrēs quōs memorātis, cūr terram, quam abstulimus effēminātīs gentibus, illī vocant esse suam. Vultis namque scīre quid vōbīs dīcimus? Revertiminī ergō quantōcius, et dīcite vestrīs seniōribus, quia, sī per omnia cupiunt efficī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" Turcī et Deum vestrum, quem vōs inclīnī colitis, abnegāre volunt et lēgēs vestrās spernere, nōs illīs hanc"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" et satis plūs dabimus dē terrā, et cīvitātēs et castella; adhūc autem quod nēmō vestrōrum remanēbit pedes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=", sed erunt omnēs mīlitēs sīcut et nōs sumus; et habēbimus semper eōs in summā amīcitiā. Sīn autem, sciant sē per omnia capitālem subīre sententiam, aut dēductī in vinculīs Corrozanam in captīvitāte perpetuā servient nōbīs nostrīsque īnfantibus per sempiterna tempora.&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="107773.452229299" OwnPage="257" ItemID="572711605" PTYPE="4" WIDTH="522" HEIGHT="159.936770700748" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 159.937 L0 159.937 L0 0 Z" copath="M0 0 L522 0 L522 159.937 L0 159.937 L0 0 Z" gXpos="136.001" gYpos="107773.452229299" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Full with pride, they responded with ferocious speech."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Now we come up to here (this point in the conversation), in which we greatly marvel, in what way your chiefs and elders, whom you mention, why they call this land to be theirs, which we took from effeminate peoples."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="If through all these things you want to become Turks and wish to deny your God, whom you incline to worship, and to spurn your laws."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="We give to them this (city?) and enough more from the land, both cities and castles."/>
                <ITEXT CH=" The Turks, recognizing the war-like nature and martial prowess of the Franks, offered to give them part of Syria as a fiefdom if they converted themselves and their society to Islam and allied with the Turks."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="No one of your (men) will remain a foot-soldier, but everyone will be soldiers (mounted on horseback) like us."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="107384.389" OwnPage="258" ItemID="575825285" PTYPE="4" WIDTH="522" HEIGHT="719.999999999753" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="107384.389" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="abnegāre: to deny; present active infinitive from abnegō, abnegāre, abnegāvī, abnegātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="abstulimus: we carried away; 1st person plural perfect active from auferō, auferre, abstulī, ablātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adhūc: until now"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliīs: others; plural ablative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="amīcitiā: friendship; singular feminine ablative from amīcitia, amīcitiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aut: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="capitālem: deadly, capital; singular common accusative from capitālis, capitāle, capitālior -or -us, capitālissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="captīvitāte: captivity; singular feminine ablative from captīvitās, captīvitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="castella: castles, strongholds; plural neuter accusative from castellum, castellī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstiānitātem: Christianity, Christendom; singular feminine accusative from Christianitas, Christianitatis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cīvitātēs: cities; plural feminine accusative from cīvitās, cīvitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="colitis: you worship; 2nd person plural present active from colō, colere, coluī, cultus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Corrozānam: Khorasan, a region in modern-day Iran"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cupiunt: they desire; 3rd person plural present active from cupiō, cupere, cupīvī, cupītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cūr: why"/>
                <para PARENT="Vocab"/>

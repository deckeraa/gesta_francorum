        <PAGEOBJECT XPOS="136.001" YPOS="122360.443" OwnPage="293" ItemID="657348405" PTYPE="4" WIDTH="522" HEIGHT="174.385025478026" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 174.385 L0 174.385 L0 0 Z" copath="M0 0 L522 0 L522 174.385 L0 174.385 L0 0 Z" gXpos="136.001" gYpos="122360.443" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Istam cīvitātem tenuērunt Francī obsessam, per octō mēnsēs et ūnum diem. Posteā fuērunt intus inclūsī per trēs ebdomadās ā Turcīs et ab aliīs pāgānīs quōrum numerō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" nunquam fuit maior congregātiō hominum, vel Chrīstiānōrum vel pāgānōrum. Tamen"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" adiūtōriō Deī et Sānctī Sepulchrī dēvictīs illīs ā Chrīstiānīs Deī, requiēvimus cum gaudiō et laetitiā magnā in Antiochīā, per quīnque mēnsēs et octō diēs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="122534.828025478" OwnPage="293" ItemID="653455269" PTYPE="4" WIDTH="522" HEIGHT="96.3057324840775" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 96.3057 L0 96.3057 L0 0 Z" copath="M0 0 L522 0 L522 96.3057 L0 96.3057 L0 0 Z" gXpos="136.001" gYpos="122534.828025478" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Of whom: a congregation/assembly of men was never greater in number."/>
                <ITEXT CH=" A smoother translation: "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="whose number was greater than that of any other assembly of people."/>
                <ITEXT CH=" The statement is clearly hyperbolic."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="However, they (the pagans) having been conquered entirely, by the Christians of God, with the help of God and of the Holy Sepulchre."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

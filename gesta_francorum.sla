        <PAGEOBJECT XPOS="136.001" YPOS="83256.3019999998" OwnPage="199" ItemID="446687237" PTYPE="4" WIDTH="522" HEIGHT="297.634305732659" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 297.634 L0 297.634 L0 0 Z" copath="M0 0 L522 0 L522 297.634 L0 297.634 L0 0 Z" gXpos="136.001" gYpos="83256.3019999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Reversus est itaque Curbaram ad suum exercitum, et prōtinus Turcī, dēlūdentēs Francōrum collēgium, dētulērunt ante cōnspectum Curbaram quemdam vīlissimum ēnsem rūbīgine tēctum et tēterrimum arcum ligneum, et lanceam nimis inūtilem, quae abstulerant nūper"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" pauperibus peregrīnīs; dīxēruntque: &quot;Ecce"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" arma, quae attulērunt Francī obviam nōbīs ad pugnam.&quot; Tunc Curbaram coepit subrīdēre, palam dīcēns omnibus: &quot;Haec"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" sunt arma bellica et nitida, quae attulērunt Chrīstiānī super nōs in Asiam, quibus putant nōs et cōnfīdunt expellere ultrā cōnfīnia Corrozānae, et dēlēre omnia nostra ultrā Amāzonia flūmina; quī prōpulērunt omnēs parentēs nostrōs ā Romāniā, et Antiochīā urbe rēgiā quae est honōrābile caput tōtīus Syriae?&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="83553.9363057325" OwnPage="199" ItemID="442411125" PTYPE="4" WIDTH="522" HEIGHT="105.019108280248" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 105.019 L0 105.019 L0 0 Z" copath="M0 0 L522 0 L522 105.019 L0 105.019 L0 0 Z" gXpos="136.001" gYpos="83553.9363057325" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which they had taken recently from poor pilgrims."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Behold the weapons which the Franks bore against us to fight."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit" CH="These are the war-like and bright weapons, which the Christians brought against us in Asia (minor), in which they thought and entrusted to expel us up to the confines of Khorasan, and to erase all of us up to the Caucasian rivers, whom drove all our parents from Byzantine Asia Minor, and from Antioch, the royal city which is the honorable capital of all of Syria?"/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="83256.3019999998" OwnPage="200" ItemID="442095973" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="83256.3019999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="abstulērant: they had carried away; 3rd person plural pluperfect active from auferō, auferre, abstulī, ablātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Amazonia: Amazonian, likely meaning Caucasian; plural neuter accusative from Amazon, Amazonis"/>

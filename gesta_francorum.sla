                <para PARENT="Vocab"/>
                <ITEXT CH="mihi: to me"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīsērunt: they sent; 3rd person plural perfect active from mittō, mittere, mīsī, missus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mūniam: I will fortify; 1st person singular present active subjunctive from mūniō, mūnīre, mūnīvī, mūnītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mūniant: they might fortify; 3rd person plural present active subjunctive from mūniō, mūnīre, mūnīvī, mūnītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōbīs: us; singular dative or ablative from ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōs: we, us; plural nominative or accusative of ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrī: our; plural masculine nominative from noster"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrīs: our"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrōs: our"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="obviam: in the path"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="occīdērunt: they killed; 3rd person plural perfect from occīdō, occīdere, occīdī, occīsus"/>
                <para PARENT="Vocab"/>

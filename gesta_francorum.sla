        <PAGEOBJECT XPOS="136.001" YPOS="44152.161" OwnPage="105" ItemID="243482485" PTYPE="4" WIDTH="522" HEIGHT="320.909063694293" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 320.909 L0 320.909 L0 0 Z" copath="M0 0 L522 0 L522 320.909 L0 320.909 L0 0 Z" gXpos="136.001" gYpos="44152.161" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Nōs dēnique"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" exeuntēs inde pervēnimus fēlīciter ūsque Cesaream Cappadociae. Ā Cappadociā autem ēgressī, vēnimus ad quamdam cīvitātem pulcherrimam et nimis ūberrimam, quam paululum ante nostrum adventum obsēderant Turcī per trēs ebdomadās, sed nōn superāverant. Mox"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" illūc advenientibus nōbīs, continuō trādidit sē in manū nostrā cum magnā laetitiā. Hanc"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" igitur petiit quīdam mīles, cui nōmen Petrus dē Alpibus, ab omnibus seniōribus, quātinus eam dēfenderet in fidēlitāte Deī et Sānctī Sepulchrī, et seniōrum atque imperātōris, cui cum nimiō amōre grātīs concessērunt eam. Sequentī nocte audīvit Boamundus quod Turcī, quī fuerant in obsessiōne cīvitātis, frequenter praecēderent nōs. Extemplō praeparāvit sē sōlummodo cum mīlitibus, quātinus illōs undique expugnāret, sed eōs invenīre nōn potuit."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="44473.0700636943" OwnPage="105" ItemID="243886597" PTYPE="4" WIDTH="522" HEIGHT="132.993630573248" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 132.994 L0 132.994 L0 0 Z" copath="M0 0 L522 0 L522 132.994 L0 132.994 L0 0 Z" gXpos="136.001" gYpos="44473.0700636943" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="We finally going out from there came happily to Caesarea of Cappadocia."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="With us soon arriving there, presently the handed themselves into our hand with great gladness."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="A certain soldier therefore asked for this (the city), whose name was Peter of the Alps, from all the chiefs, insofar as he might defend it, in faithfulness to God, the Holy Sepulchre, the chiefs, and the emperor; to whom they gave it with great love &amp; thanks."/>
                <ITEXT CH=" Note how this parallels the previous account with Simeon: the crusaders gave control of a town to the local leader who had already successfully repelled Turkish attacks. They prioritized competence and results."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="44152.161" OwnPage="106" ItemID="246050709" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="44152.161" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

        <PAGEOBJECT XPOS="136.001" YPOS="91576.3319999998" OwnPage="219" ItemID="488751813" PTYPE="4" WIDTH="522" HEIGHT="332.355898089372" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 332.356 L0 332.356 L0 0 Z" copath="M0 0 L522 0 L522 332.356 L0 332.356 L0 0 Z" gXpos="136.001" gYpos="91576.3319999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Inter haec Willelmus dē Grentamasnil et Albericus frāter eius et Widō Trursellus et Lambertus Pauper, istī omnēs timōre perterritī dē hesternō bellō, quod dūrāverat ūsque ad vesperam, nocte"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" latenter dēmissī sunt per mūrum, fugientēs pedibus contrā mare, ita ut neque in manibus neque in pedibus remanēret aliquid nisi sōlummodo ossa"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=". Multīque aliī fūgērunt cum illīs, quōs nesciō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Venientēs igitur ad nāvēs, quae erant ad Portum Sānctī Simeonīs, dīxērunt nautīs: &quot;Quid hīc, miserī, stātis? Omnēs nostrī mortuī sunt et nōs mortem vix ēvāsimus, quia exercitus Turcōrum undique obsident aliōs in urbe.&quot; At illī audientēs tālia stābant stupefactī, ac timōre perterritī cucurrērunt ad nāvēs et mīsērunt sē in mare. Deinde supervenientēs"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" Turcī, quōs invēnērunt, occīdērunt, et nāvēs quae in alveō flūminis remānserant, combussērunt īgnī et apprehendērunt spolia eōrum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="91909.3319999998" OwnPage="219" ItemID="489001573" PTYPE="4" WIDTH="522" HEIGHT="86.9482547772786" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 86.9483 L0 86.9483 L0 0 Z" copath="M0 0 L522 0 L522 86.9483 L0 86.9483 L0 0 Z" gXpos="136.001" gYpos="91909.3319999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="At night they silently slipped out through the city wall, fleeing by foot to the sea."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that nothing remained either on their hands or on their feet except only bone. "/>
                <ITEXT FONT="DejaVu Serif Book" CH="The likeliest meaning is that, after running the roughly 12 miles (following the Orontes River) to the sea, their hands and feet were very cut up, that they had 'worked themselves to the bone'."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Thereafter the conquering Turks killed whom they found."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="91576.3319999998" OwnPage="220" ItemID="492438517" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="91576.3319999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Albericus: Aubrey, son of Hugo de Grandmesnil who fled the siege of Antioch."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliī: others; plural masculine nominative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliōs: others; plural masculine accusative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliquid: anything"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="alveō: cavity, trough; singular masculine ablative from alveus, alveī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="apprehendērunt: they seized; 3rd person plural perfect active from apprehendō, apprehendere, apprehendī, apprehēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="at: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="audientēs: hearing; plural common nominative present participle from audio, audire, audivi, auditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bellō: battle; singular neuter ablative from bellum, bellī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="combussērunt: they had burned up; 3rd person plural perfect active from combūrō, combūrere, combussī, combustus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="contrā: against, away from, facing"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cucurrērunt: they ran; 3rd person plural perfect active from currō, currere, cucurrī, cursus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dē: of, from, away from, down from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="deinde: after"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēmissī: dēmissī sunt = they slipped out; plural masculine nominative perfect passive participle from dēmittō, dēmittere, dēmīsī, dēmissus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīxērunt: they said; 3rd person plural perfect active from dīcō, dīcere, dīxī, dictus"/>

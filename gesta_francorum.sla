        <PAGEOBJECT XPOS="136.001" YPOS="123192.446" OwnPage="295" ItemID="659650869" PTYPE="4" WIDTH="522" HEIGHT="300.394764331533" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 300.395 L0 300.395 L0 0 Z" copath="M0 0 L522 0 L522 300.395 L0 300.395 L0 0 Z" gXpos="136.001" gYpos="123192.446" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Quibus"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" explētīs, mēnse Novembriō discessit Raimundus comes Sānctī Egidiī cum suō exercitū ab Antiochīā, vēnitque per ūnam cīvitātem, quae vocātur Rugia, et per aliam, quae dīcitur Albāria. Quārtō vērō diē exeunte Novembriō pervēnit ad Marram cīvitātem, in quā maxima multitūdō Saracēnōrum et Turcōrum et Arabum et aliōrum pāgānōrum erat congregāta, ipseque"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" comes in crāstinum invāsit eam. Nōn post multum vērō temporis Boamundus cum suō exercitū sēcūtus est comitēs, et applicātus est cum eīs in diē dominicā. Secundā vērō fēriā nimis fortiter invāsērunt undique cīvitātem, et tam ācriter tamque fortiter, ut scālae stārent ērēctae ad mūrum. Sed tam maxima erat virtūs pāgānōrum, quod"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" illā diē nihil eōs offendere aut nocēre potuērunt."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="123492.840764331" OwnPage="295" ItemID="657897989" PTYPE="4" WIDTH="522" HEIGHT="73.3757961783413" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 73.3758 L0 73.3758 L0 0 Z" copath="M0 0 L522 0 L522 73.3758 L0 73.3758 L0 0 Z" gXpos="136.001" gYpos="123492.840764331" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which (the days mentioned in the previous paragraph), having been filled out (completed)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And the count himself on the next day attacked it (the city of Marra)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="But so great was the strength of the pagans, that on that day no one was able to offend or hurt them."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="123192.446" OwnPage="296" ItemID="659742789" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="123192.446" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

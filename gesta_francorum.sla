        <PAGEOBJECT XPOS="136.001" YPOS="1720.008" OwnPage="3" ItemID="67835141" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="748.0006" gYpos="888.0046" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Intrōductiō"/>
                <para PARENT="Chapter Heading"/>
                <tab/>
                <para PARENT="Chapter Heading"/>
                <tab/>
                <ITEXT CH="This is a Latin reader edition of the "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Gesta Francōrum"/>
                <ITEXT CH=". TODO"/>
                <para/>
                <para/>
                <tab/>
                <ITEXT CH="A playlist containing read-along videos (with English translation) can be found on the ComprehensibleLatin YouTube channel: https://www.youtube.com/@ComprehensibleLatin."/>
                <para/>
                <para/>
                <ITEXT CH="This reader's edition was produced to meet the following goals:"/>
                <para/>
                <ITEXT CH="    - to make an inexpensive print copy of the "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Gesta Francōrum "/>
                <ITEXT CH="available."/>
                <para/>
                <ITEXT CH="    - to provide a legible (not photo-copied) text with macrons."/>
                <para/>
                <ITEXT CH="    - to provide glossaries so that a Latin learner could read through this work without needing to consult additional books or dictionaries."/>
                <para/>
                <ITEXT CH="    - to provide footnotes and maps."/>
                <para/>
                <para/>
                <para ALIGN="1"/>
                <para/>
                <tab/>
                <ITEXT CH="TODO Approximate statistics regarding the original text:"/>
                <para/>
                <para/>
                <ITEXT CH="1110 unique words, 2900 words total."/>
                <para ALIGN="1"/>
                <ITEXT CH="Average sentence length: 18.6 words."/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <tab/>
                <ITEXT CH="This reader edition of the Gesta Francōrum is not a critical edition of the text; for that, please consult the critical edition TODO which is cited in the bibliography. The glosses provided in the footnotes are intentionally woodenly literal; their purpose is to aid the reader in understanding the Latin, not to provide an idiomatic English translation. The glossaries for each page are created by a computer program that consults a dictionary and then are reviewed and emended line-by-line manually. AI tools are not used in the process. Due to the sheer volume of entries in the glossary, there may be occasional mistakes. If you find one, please consider letting me know at decker49@gmail.com so that I can correct the book."/>
                <para/>
                <tab/>
                <para/>
                <para/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Fīnis intrōductiōnis."/>
                <trail ALIGN="1"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="TOC" Type="none" Value="Intrōductiō" Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="5880.023" OwnPage="13" ItemID="67959397" PTYPE="4" WIDTH="522" HEIGHT="290.881458598727" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 290.881 L0 290.881 L0 0 Z" copath="M0 0 L522 0 L522 290.881 L0 290.881 L0 0 Z" gXpos="136.001" gYpos="5880.023" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Audientēs itaque Turcī quod Chrīstiānī essent in castrō, vēnērunt obsīdere illud. Ante portam castrī erat puteus, et ad pedem castrī fōns"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vīvus, iuxtā quem exiit Rainaldus īnsidiārī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" Turcōs. Venientēs vērō Turcī in fēstō sānctī Michahēlis, invēnērunt Rainaldum et quī cum eō erant, occīdēruntque Turcī multōs ex eīs. Aliī fūgērunt in castrum. Quod cōnfestim Turcī obsēdērunt, eīsque aquam abstulērunt. Fuēruntque nostrī in tantā afflīctiōne sītis, ut flebotomārent suōs equōs et asinōs, quōrum sanguinem bibēbant. Aliī mittēbant zōnās atque panniculōs in piscīnam, et inde exprimēbant aquam in ōs suum. Aliī mingēbant"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" in pugillō alterīus, et bibēbant. Aliī fodiēbant hūmidam terram, et supīnābant sē, terramque sternēbant"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" super pectora sua, prō nimiā āriditāte sītis."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="6170.90445859873" OwnPage="13" ItemID="69118885" PTYPE="4" WIDTH="522" HEIGHT="134.369426751592" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 134.369 L0 134.369 L0 0 Z" copath="M0 0 L522 0 L522 134.369 L0 134.369 L0 0 Z" gXpos="136.001" gYpos="6170.90445859873" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Before the gate of the castle was a well, and at the foot of the castle a living (running) spring."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Next to which Rainaldus went out to ambush the Turks."/>
                <ITEXT CH=" Rainoldus, captain of the Lombards and Langobards, likely saw the Turks coming, knew they would want to seize the spring, and set an ambush. Unfortunately, it appears that the ambush was discovered ("/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Turcī ... invēnērunt Rainaldum"/>
                <ITEXT CH=") and therefore was unsuccessful in protecting the spring from the Turks."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Others were urinating in the hand of another, and drinking."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Others were digging up damp earth, and lying on their backs, and spreading the earth over their chests, because of the excessive dryness of thirst."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="5880.023" OwnPage="14" ItemID="68539797" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="5880.023" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="abstulērunt: they took away; 3rd person plural perfect active from auferō, auferre, abstulī, ablātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="afflictiōne: affliction, pain; singular feminine ablative from afflictiō, afflictiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliī: others; plural masculine nominative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="alterīus: of the other; singular genitive from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ante: before, in front, forwards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aquam: water; singular feminine accusative from aqua, aquae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="āriditāte: dryness, drought; singular feminine ablative from āriditās, āriditātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="asinōs: asses, donkeys; plural masculine accusative from asinus, asinī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="atque: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="audientēs: hearing; plural common nominative present participle from audiō, audīre, audīvī, audītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bibēbant: they were drinking; 3rd person plural imperfect active from bibō, bibere, bibī, pōtus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="castrī: of the castle; singular neuter genitive from castrum, castrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="castrō: in the castle; singular neuter ablative from castrum, castrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="castrum: castle; singular neuter nominative from castrum, castrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstiānī: Christians; plural masculine nominative from Chrīstiānus, Chrīstiānī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōnfestim: immediately"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eīs: from them; plural ablative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eō: with him; singular masculine ablative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="equōs: horses; plural masculine accusative from equus, equī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erant: they were; 3rd person plural imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erat: he was; 3rd person singular imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="essent: they were; 3rd person plural imperfect active subjunctive from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ex: out of, from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="exiit: he came out; 3rd person singular perfect active from exeō, exīre, exivī(iī), exitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="exprimēbant: they were squeezing, pressing out; 3rd person plural imperfect active from exprimō, exprimere, expressī, expressus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fēstō: festival; singular masculine ablative from fēstus, fēsta, fēstum. The feast of Saint Michael, or Michaelmas, is celebrated on September 29th in the West and November 8 in the East."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="flebotomārent: they took blood; 3rd person plural imperfect active subjunctive from variant spelling from phlebotomō, phlebotomāre, phlebotomāvī, phlebotomatus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fodiēbant: they were digging; 3rd person plural imperfect active from fodiō, fodere, fōdī, fossus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fōns: fountain; singular masculine nominative from fōns, fontis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fuērunt: they were; 3rd person plural perfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fūgērunt: they fled; 3rd person plural perfect active from fugiō, fugere, fūgī, fugitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="humidam: humid, wet, moist; singular feminine accusative from humidus, humida, humidum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illud: that; singular neuter accusative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="inde: from there, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="īnsidiārī: lie in wait, lie in ambush; present active infinitive from the deponent īnsidior, īnsidiārī, īnsidiātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invēnērunt: they found; 3rd person plural perfect active from inveniō, invenīre, invēnī, inventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="itaque: so then, therefore"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iuxtā: near, nearly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Michahelis: of Michael. The feast of Saint Michael, or Michaelmas, is celebrated on September 29th in the West and November 8 in the East."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mingēbant: they were urinating; 3rd person plural imperfect active from mingō, mingere, mīnxī, mīnctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mittēbant: they were sending; 3rd person plural imperfect active from mittō, mittere, mīsī, missus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="multōs: many; plural masculine accusative from multus, multa -um, -, plūrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nimia: too much"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrī: we; plural masculine nominative of noster"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="obsēdērunt: they besieged; 3rd person plural perfect active from obsideō, obsidēre, obsēdī, obsessus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="obsidēre: to besiege; present active infinitive from obsideō, obsidēre, obsēdī, obsessus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="occīdērunt: they kill; 3rd person plural perfect from occīdō, occīdere, occīdī, occīsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ōs: mouth; singular neuter accusative from ōs, ōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="panniculōs: bits of cloth, rags; plural masculine accusative from panniculus, panniculī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pectora: chests; plural neuter accusative from pectus, pectoris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pedem: foot; singular masculine accusative from pēs, pedis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="piscīnam: pool, cistern, pond; singular feminine accusative from piscīna, piscīnae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="portam: gate; singular feminine accusative from porta, portae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prō: because of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pugillō: hand; singular masculine ablative from pugillus, pugillī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="puteus: well; singular masculine nominative from puteus, puteī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quem: which, singular masculine accusative of quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; plural masculine nominative of quis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quod: that; singular neuter nom. or acc. of quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quōrum: of whose; plural masculine genitive of quis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Rainaldum: Rainaldus, captain of the Lombards and Longobards (accusative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Rainaldus: Rainaldus, captain of the Lombards and Longobards (nominative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Sānctī: holy. The feast of Saint Michael, or Michaelmas, is celebrated on September 29th in the West and November 8 in the East."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sanguinem: blood; singular masculine accusative from sanguis, sanguinis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sē: themselves"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sitis: thirst; singular feminine nominative or genitive from sitis, sitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sternēbant: they were spreading, laying out; 3rd person plural imperfect active from sternō, sternere, strāvī, strātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sua: their; plural neuter accusative from suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suōs: their; plural accusative of suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="super: above, on top of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="supīnābant: they were laying on the back; 3rd person plural imperfect active from supīnō, supīnāre, supīnāvī, supīnātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suum: his; singular masculine accusative from suus, sui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tantā: so great; singular feminine ablative from tantus, tanta, tantum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terram: land"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcī: of the Turk"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcōs: the Turks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnērunt: they came; 3rd person plural perfect active from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="venientēs: coming; plural common nominative present participle from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>

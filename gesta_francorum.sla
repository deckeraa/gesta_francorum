                <para PARENT="Vocab"/>
                <ITEXT CH="dētruncāvērunt: they cut off, behead; 3rd person plural perfect active from dētruncō, dētruncāre, dētruncāvī, dētruncātus"/>
                <para PARENT="Vocab"/>

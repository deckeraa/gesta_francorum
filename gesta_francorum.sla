        <PAGEOBJECT XPOS="136.001" YPOS="63288.2299999999" OwnPage="151" ItemID="340207845" PTYPE="4" WIDTH="522" HEIGHT="364.814585987355" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 364.815 L0 364.815 L0 0 Z" copath="M0 0 L522 0 L522 364.815 L0 364.815 L0 0 Z" gXpos="136.001" gYpos="63288.2299999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Liber 7"/>
                <para PARENT="Chapter Heading"/>
                <para PARENT="Chapter Heading"/>
                <tab/>
                <ITEXT CH="Reversī sunt nostrī, agente"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Deō, triumphantēs et gaudentēs dē triumphō, quem"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" in diē illō habuērunt dēvictīs inimīcīs, quī sunt per omnia superātī, semper fugientēs, hūc et illūc vagantēs et errantēs, aliī in Corrozānam, aliī vērō in Saracēnōrum introiērunt terram."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Videntēs autem nostrī maiōrēs, quod"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" male tractārent et cōnstringerent nōs inimīcī nostrī, quī erant in cīvitāte, diē ac nocte invigilantēs et īnsidiantēs, quā parte nōs laedere possent, congregātī in ūnum dīxērunt: &quot;Priusquam perdāmus gentem nostram, faciāmus castrum ad Machumāriam"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=", quae est ante portam urbis, ubi pōns est; ibique forsitan poterimus nostrōs cōnstringere inimīcōs.&quot; Cōnsēnsērunt omnēs et laudāvērunt, quod bonum esset ad faciendum"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH="."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="63653.0445859873" OwnPage="151" ItemID="340353797" PTYPE="4" WIDTH="522" HEIGHT="160.050955413979" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 160.051 L0 160.051 L0 0 Z" copath="M0 0 L522 0 L522 160.051 L0 160.051 L0 0 Z" gXpos="136.001" gYpos="63653.0445859873" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Our (soldiers) returned, having been led by God."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which (they) had in that day, having totally defeated the enemies."/>
                <ITEXT CH=" The grammatical antecedent of "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="quem"/>
                <ITEXT CH=" is "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="triumphō"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That our enemies were badly handling and constraining us, who were in the city, day and night keeping watch and plotting, in which part they might be able to fight us."/>
                <ITEXT CH=" Although the Crusaders had won a decisive victory against the Turkish relief army, the other part of the Crusader army maintaining the siege on Antioch had to defend against efforts from the Turks within the city."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH="The Crusaders built at fort near a mosque outside the Bridge Gate of Antioch. This castle is sometime's referred to as Mahomerie's Tower."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Everyone agreed and praised (the idea), that it was good to do."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="63288.2299999999" OwnPage="152" ItemID="342885525" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="63288.2299999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

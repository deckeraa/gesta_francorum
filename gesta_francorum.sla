        <PAGEOBJECT XPOS="136.001" YPOS="136504.494" OwnPage="327" ItemID="710721941" PTYPE="4" WIDTH="522" HEIGHT="390.894535032188" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 390.895 L0 390.895 L0 0 Z" copath="M0 0 L522 0 L522 390.895 L0 390.895 L0 0 Z" gXpos="136.001" gYpos="136504.494" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Obsēdimus vērō castrum suprādictum per trēs mēnsēs minus ūnā diē; ibique pascha Dominī celebrāvimus IV īdūs Aprīlis. Nāvēs quippe nostrae vēnērunt prope nōs in quendam portum, quamdiū fuimus in illā obsidiōne, dēferentēs maximum mercātum, scīlicet frūmentum, vīnum et carnem et cāseum et hordeum et oleum, unde maxima ūbertās fuit in tōtā expedītiōne. In illā dēnique obsidiōne fēlīciter accēpērunt martyrium plūrēs ex nostrīs, vidēlicet Anselmus dē Ribomont, Willelmus Picardus et aliī plūrēs, quōs īgnōrō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Rēx quoque Tripolis saepe nūntiōs mittēbat seniōribus, ut dīmitterent castrum, et cum eō concordārentur. Audientēs itaque nostrī hoc, scīlicet et dux Godefridus et Raimundus, comes Sānctī Egidiī, ac Rotbertus Nortmannus Flandrensisque comes, videntēsque"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" novōs frūctūs properāsse, quia in mediō Mārtiō comedēbāmus novellās fabās, mediō quoque Aprīlī frūmentum, cōnsiliātī sunt nostrī dīcentēs: bonum valdē esse Hierosolymītānum iter explēre cum novīs frūctibus."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="136894.929936306" OwnPage="327" ItemID="717663189" PTYPE="4" WIDTH="522" HEIGHT="58.2420382165583" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 58.242 L0 58.242 L0 0 Z" copath="M0 0 L522 0 L522 58.242 L0 58.242 L0 0 Z" gXpos="136.001" gYpos="136894.929936306" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Seeing the new fruits to have hastened."/>
                <ITEXT CH=" The Crusaders used the progress of the spring crop growth to determine when to make the final push to Jerusalem, since the availability of food along the way was key to success."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

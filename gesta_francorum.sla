        <PAGEOBJECT XPOS="136.001" YPOS="142328.515" OwnPage="341" ItemID="745783909" PTYPE="4" WIDTH="522" HEIGHT="390.160159236053" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 390.16 L0 390.16 L0 0 Z" copath="M0 0 L522 0 L522 390.16 L0 390.16 L0 0 Z" gXpos="136.001" gYpos="142328.515" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Pāgānōrum vērō gēns, vidēns Chrīstī mīlitēs, dīvīsit sē et fēcērunt duo agmina. Nostrī autem, invocātō Chrīstī nōmine, tam ācriter invāsērunt illōs incrēdulōs, ut quisque mīles prosterneret suum"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=". Videntēs vērō illī, quod nōn possent stāre ante Francōrum fortitūdinem, timōre nimiō perterritī, vertērunt scapulās retrō, quōs nostrī persequentēs ferē per spatia quattuor mīlium, occīdērunt multōs ex eīs; ūnumque retinuērunt vīvum, quī nova"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" eīs per ōrdinem dīceret; retinuērunt quoque centum et trēs equōs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="In eādem obsidiōne tantā oppressiōne sitis fuimus gravātī, ut suerēmus coria boum et būfalōrum, in quibus dēferēbāmus aquās ferē per spatium sex mīliāriōrum; ex illīs quippe vāsculīs foetidā ūtēbāmur"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" aquā, et quantum ex olidā aquā et hordeāceō pāne in nimiā districtiōne et afflictiōne erāmus cotīdiē. Saracēnī namque in cūnctīs fontibus et aquīs latentēs īnsidiābantur nostrīs"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" eōsque ubīque occīdēbant et dīlaniābant; animālia quoque sēcum in suās cavernās et spēluncās dēdūcēbant."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="142718.675159236" OwnPage="341" ItemID="745841765" PTYPE="4" WIDTH="522" HEIGHT="135.745222929923" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 135.745 L0 135.745 L0 0 Z" copath="M0 0 L522 0 L522 135.745 L0 135.745 L0 0 Z" gXpos="136.001" gYpos="142718.675159236" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that every soldier struck down his (enemy soldier that he was directly engaged in fighting)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who might tell news to them in order."/>
                <ITEXT CH=" The word "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="nova"/>
                <ITEXT CH=" here indicates military intelligence such as troop strength and plans."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And we were using stinking water out of those vessels."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For the Muslims around every spring and water-source were lurking hidden (to attack) our (people)."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

                <ITEXT CH="expellere: to drive out, to expel; present active infinitive from expellō, expellere, expulī, expulsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="faciam: I will make, I (might) make; 1st person singular present active subjunctive from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fēcit: he did; 3rd person singular perfect active from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fīnem: end; singular common accusative from fīnis, fīnis"/>

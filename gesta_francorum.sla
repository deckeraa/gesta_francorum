            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="90744.3289999998" OwnPage="217" ItemID="484800581" PTYPE="4" WIDTH="522" HEIGHT="301.276095541602" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 301.276 L0 301.276 L0 0 Z" copath="M0 0 L522 0 L522 301.276 L0 301.276 L0 0 Z" gXpos="136.001" gYpos="90744.3289999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Ait fīlius: &quot;Sī ita est causa, cum eīs proeliārī nōn dēsinam.&quot; Itaque audiēns māter eius quod nūllō modō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" acquiēsceret cōnsiliīs suīs, maestissima recessit retrōrsum in Aleph, dēferēns sēcum cūncta spolia quae condūcere potuit."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Tertiā vērō diē armāvit sē Curbaram et maxima pars Turcōrum cum eō, vēnēruntque ad cīvitātem ex illā parte in quā erat castrum. Nōs autem putantēs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" resistere posse illīs, parāvimus bellum contrā eōs. Sed tam magna fuit virtūs illōrum, quod nequīvimus illīs resistere; sīcque coāctī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" intrāvimus in cīvitātem, quibus fuit tam mīrābiliter arta et angusta porta, ut illīc"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" fuerint multī mortuī oppressiōne aliōrum. Intereā aliī pugnābant extrā urbem, aliī intus, in quīntā"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" fēriā per tōtum diem ūsque ad vesperam."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="91045.6050955414" OwnPage="217" ItemID="485003445" PTYPE="4" WIDTH="522" HEIGHT="108.687898089178" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 108.688 L0 108.688 L0 0 Z" copath="M0 0 L522 0 L522 108.688 L0 108.688 L0 0 Z" gXpos="136.001" gYpos="91045.6050955414" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That in no way could she alter/relax his plans."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="We, however, thinking ourselves to be able to resist them."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And thus having been forced, we entered into the city."/>
                <ITEXT CH=" The Crusaders won their siege against Antioch on June 3, 1098 but then, after Curbaram's army arrived, they were forced into the city and were themselves besieged."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that there there were many killed by their pressing."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH="June 10, 1098"/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="90744.3289999998" OwnPage="218" ItemID="488927317" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="90744.3289999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

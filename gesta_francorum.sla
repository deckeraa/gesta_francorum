                <para PARENT="Vocab"/>
                <ITEXT CH="ille: that one, he; singular masculine nominative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>

        <PAGEOBJECT XPOS="136.001" YPOS="78264.2839999999" OwnPage="187" ItemID="415344773" PTYPE="4" WIDTH="522" HEIGHT="421.626828025634" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 421.627 L0 421.627 L0 0 Z" copath="M0 0 L522 0 L522 421.627 L0 421.627 L0 0 Z" gXpos="136.001" gYpos="78264.2839999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Summō autem dīlūculō audientēs illī, quī foris erant in tentōriīs, vehementissimum rūmōrem strepere per cīvitātem, exiērunt festīnantēs et vīdērunt vexillum Boamundī sūrsum in monte, celerīque cursū properantēs vēnērunt omnēs et per portās intrāvērunt in urbem et interfēcērunt Turcōs et Saracēnōs quōs ibi repperērunt, extrā"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" illōs quī fūgerant sūrsum in castrum. Aliī vērō Turcōrum per portās exiērunt, et fugientēs vīvī ēvāsērunt."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Cassiānus vērō, dominus illōrum, timēns valdē gentem Francōrum, dēdit sē omnimodō fugae cum aliīs multīs quī erant cum eō; et fugiendō pervēnit in Tancredī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" terram nōn longē ā cīvitāte. Fatīgātī vērō erant equī eōrum, mīsēruntque sē in quoddam casāle et mersī sunt in ūnam domum. Cognōvērunt"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" ergō eum habitātōrēs illīus montāneae, scīlicet Surānī et Hermenīī, et cōnfestim apprehendērunt eum truncāvēruntque caput illīus et tulērunt ante Boamundī praesentiam, ut inde merērentur lībertātem accipere. Balteum quoque eius et vāgīnam appretiāvērunt sexāgintā bizantēīs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="78685.9108280255" OwnPage="187" ItemID="415774277" PTYPE="4" WIDTH="522" HEIGHT="146.292993630574" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 146.293 L0 146.293 L0 0 Z" copath="M0 0 L522 0 L522 146.293 L0 146.293 L0 0 Z" gXpos="136.001" gYpos="78685.9108280255" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Except for those who had fled upwards into the castle (which was an fortified area within the walled city of Antioch)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And by fleeing arrived into Tancred's land, not far from the city."/>
                <ITEXT CH=" Tancred had already established control over an area of land near Antioch."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Therefore the inhabitants of that mountain, namely Syrians and Armenians, recognized him and immediately apprehended him and cut off his head an brought it before the presence of Bohemond, that from this they might have merited to receive liberty."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They appraised also his belt and scabbard at 60 golden coins."/>
                <ITEXT CH=" The Turkish leader's belt, probably adorned with precious metals or jewels, had significant monetary value."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="78264.2839999999" OwnPage="188" ItemID="420357557" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="78264.2839999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

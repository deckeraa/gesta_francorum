        <PAGEOBJECT XPOS="136.001" YPOS="4216.017" OwnPage="9" ItemID="59187333" PTYPE="4" WIDTH="522" HEIGHT="286.409382165605" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 286.409 L0 286.409 L0 0 Z" copath="M0 0 L522 0 L522 286.409 L0 286.409 L0 0 Z" gXpos="136.001" gYpos="4216.017" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Fēcērunt dēnique Gallī trēs partēs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=". Ūna pars Francōrum in Hungāriae intrāvit regiōnem, scīlicet Petrus Heremīta, et dux Godefridus, et Balduīnus frāter eius, et Balduīnus comes dē Monte. Istī potentissimī mīlitēs et aliī plūrēs quōs ignōrō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" vēnērunt per viam quam iamdūdum Karolus Magnus mīrificus rēx Franciae aptārī fēcit usque Cōnstantīnopolim."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Petrus vērō suprādictus prīmus vēnit Cōnstantīnopolim in kalendīs Augustī et cum eō maxima gēns Alamannōrum. Illīc invēnit Lombardōs et Longobardōs et aliōs plūrēs congregātōs, quibus imperātor iusserat darī mercātum, sīcuti erat in cīvitāte, dīxitque illīs 'Nōlīte"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" trānsmeāre Brāchium, dōnec veniat maxima Chrīstiānōrum virtūs, quoniam vōs tantī nōn estis, ut cum Turcīs praeliārī valeātis.'"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="4502.42638216561" OwnPage="9" ItemID="56170773" PTYPE="4" WIDTH="522" HEIGHT="118.59061783439" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 118.591 L0 118.591 L0 0 Z" copath="M0 0 L522 0 L522 118.591 L0 118.591 L0 0 Z" gXpos="136.001" gYpos="4502.42638216561" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Finally the Gauls made three parties. The three parties are three groups of crusaders who all took the same path to Constantinople. TODO identify the parties."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="These very powerful solides and many others whom I do not know came through the road which long ago Charlemagne, the wonderful king of France, had made to be prepared all the way to Constantinople."/>
                <ITEXT CH=" The first person "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="ignōrō"/>
                <ITEXT CH=" is used because this text is a first-hand account from a crusader. TODO include a map of this road, maybe https://en.wikipedia.org/wiki/File:Map_of_First_Crusade.png"/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Don't cross over the Bosporus, until the full (maximum) strength of Christian (soldiers) comes, because you are not so great, that you can prevail in battle with the Turks. "/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="4216.017" OwnPage="10" ItemID="59563317" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="4216.017" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Alamannōrum: Of the Alamanni, a confederation of Germanic tribes"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliī: others; plural nominative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliōs: others; plural masculine accusative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aptārī: to be prepared; present passive infinitive from aptō, aptāre, aptāvī, aptātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Augustī: of August"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Balduīnus: Baldwin"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Brāchium: the Bosporus; from Brāchium Sānctī Georgīī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstiānōrum: of Christians; plural masculine genitive from Chrīstiānus, Chrīstiānī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cīvitāte: city; singular feminine ablative from cīvitās, cīvitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="comes: count, earl; singular common nominative from comes, comitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="congregātōs: having been gathered; plural masculine accusative perfect passive participle from congregō, congregāre, congregāvī, congregātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Cōnstantīnopolim: Constantinople; singular feminine accusative from Constantinopolis, Constantinopolis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="darī: to be given; present passive infinitive from dō, dare, dedī, datus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dē: of, from, away from, down from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēnique: finally"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīxit: he said; 3rd person singular perfect active from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dōnec: until"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dux: duke, leader; singular masculine nominative from dux, ducis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eius: his/her/its"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eō: with him; singular masculine ablative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erat: he was; 3rd person singular imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="estis: you (all) are; 2nd person plural present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fēcērunt: they did, they made; 3rd person plural perfect active from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fēcit: he did; 3rd person singular perfect active from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Franciae: of the Frankish Kingdom"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Francōrum: of the Franks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="frāter: brother; singular masculine nominative from frāter, frātris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Gallī: the Gauls/Franks; singular masculine genitive from Gallus, Galli"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gēns: people, clan, nation; singular feminine nominative from gēns, gentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Godefridus: Godfrey of Bouillon (~1060-1100 AD), first ruler of the Kingdom of Jerusalem"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Heremīta: hermit; singular masculine nominative from heremita, heremitae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Hungāriae: Hungary"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iamdūdum: long ago"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="īgnōrō: I do not know; 1st person singular present active from īgnōrō, īgnōrāre, īgnōrāvī, īgnōrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illīc: there"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illīs: to them; plural dative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="imperātor: emperor; singular masculine nominative from imperātor, imperātōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="intrāvit: it entered; 3rd person singular perfect active from intrō, intrāre, intrāvī, intrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invēnit: he found; 3rd person singular perfect active from inveniō, invenīre, invēnī, inventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="istī: those/these; plural nominative masculine from iste"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iusserat: he had ordered; 3rd person singular pluperfect from iubeō, iubēre, iussī, iussus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="kalendīs: calends, first day of the month; plural feminine ablative from Kalenda, Kalendae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Karolus Magnus: Charlemagne, King of the Franks, 748-814 AD"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Lombardōs: the Lombards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Longobardōs: the Lombards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Māgnus: great; singular masculine nominative from māgnus, māgna -um, major -or -us, maximus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="maxima: biggest, very big; singular feminine nominative from māgnus, māgna -um, major -or -us, maximus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mercātum: market; singular masculine accusative from mercātus, mercātūs"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīlitēs: soldiers; plural masculine nominative from mīles, mīlitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīrificus: amazing, wonderful; singular masculine nominative from mīrificus, mīrifica, mīrificum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="monte: mountain; singular masculine ablative from mōns, montis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōlīte: be unwilling! imperative plural of nōlō, nōlle, nōluī (irr.)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōn: not"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pars: party, part; singular feminine nominative from pars, partis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="partēs: parties, parts; plural feminine nominative from pars, partis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Petrus: Peter; singular masculine nominative from Petrus, Petri"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="plūrēs: many, more; plural common accusative from plus, (gen.), pluris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="potentissimī: very mighty; plural masculine nominative from potēns, potentis (gen.), potentior -or -us, potentissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prīmus: first; singular masculine nominative from prīmus, prīma, prīmum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="proeliārī: to fight; present active infinitive from the deponent proelior, proeliārī, proeliātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quam: which, singular feminine accusative from quī, quae, quod"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quibus: to whoem; plural dative of quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quoniam: because"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quōs: whom; plural masculine accusative of quis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="regiōnem: region; singular feminine accusative from regiō, regiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rēx: king; singular masculine nominative from rēx, rēgis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="scīlicet: namely"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sīcutī: as, like"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suprādictus: the above-said; singular masculine nominative perfect passive participle from suprādīcō, suprādīcere, suprādīxī, suprādictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tantī: so much, so great; plural masculine nominative from tantus, tanta, tantum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trānsmeāre: to go across, to pass over; present active infinitive from trānsmeō, trānsmeāre, trānsmeāvī, trānsmeātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trēs: three; plural common nominative from trēs -es -ia, tertius -a -um, terni -ae -a, ter"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcīs: the Turks (plural ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūna: one; singular feminine nominative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūsque: until, all the way, up until"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="valeātis: you are able, strong; 2nd person plural present active subjunctive from valeo, valere, valui, valitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnērunt: they came; 3rd person plural perfect active from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="veniat: it comes; 3rd person singular present active subjunctive from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnit: he came; 3rd person singular present active from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vērō: truly, even so, still"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="viam: road; singular feminine accusative from via, viae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="virtūs: strength, number (in context); singular feminine nominative from virtūs, virtūtis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vōs: you (plural accusative)"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="5048.02" OwnPage="11" ItemID="59717477" PTYPE="4" WIDTH="522" HEIGHT="324.521031847134" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 324.521 L0 324.521 L0 0 Z" copath="M0 0 L522 0 L522 324.521 L0 324.521 L0 0 Z" gXpos="136.001" gYpos="5048.02" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Ipsīque Chrīstiānī nēquiter dēdūcēbant"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" sē, quia palātia urbis sternēbant et ārdēbant, et auferēbant plumbum quō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" ecclēsiae erant coopertae et vēndēbant Graecīs. Unde imperātor īrātus est iussitque eōs trānsmeāre Brāchium."/>
                <para PARENT="Latin"/>
                <ITEXT CH="Postquam trānsfretāvērunt, nōn cessābant agere omnia mala, combūrentēs et dēvastantēs domōs et ecclēsiās. Tandem pervēnērunt Nīcomēdīam, ubi dīvīsī sunt Lombardī et Longobardī, et Alamannī ā Francīs, quia Francī tumēbant superbiā. Ēlēgērunt Lombardī et Longobardī seniōrem super sē, cui"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" nōmen Rainoldus, Alamannī similiter. Et intrāvērunt in Romāniam et per quattuor diēs iērunt ultrā Nicēnam urbem invēnēruntque quoddam castrum cui nōmen Exerogorgō, quod erat vacuum"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" gente. Et apprehendērunt illud, in quā invēnērunt satis frūmentī"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" et vīnī et carnis, et omnium bonōrum abundantiam."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="5372.54103184713" OwnPage="11" ItemID="60206645" PTYPE="4" WIDTH="522" HEIGHT="79.4904458598767" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 79.4904 L0 79.4904 L0 0 Z" copath="M0 0 L522 0 L522 79.4904 L0 79.4904 L0 0 Z" gXpos="136.001" gYpos="5372.54103184713" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The Christians themselves were conducting themselves wickedly."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And they were carrying off the lead with which the churches were covered."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Whose name was Rainoldus."/>
                <ITEXT CH=" The dative of possession is used here."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which was empty of people"/>
                <ITEXT CH=". The ablative of separation is used here."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="In which they found enough grain and wine and meat"/>
                <ITEXT CH=". "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Satis"/>
                <ITEXT CH=" is often used with the genitive."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="5048.02" OwnPage="12" ItemID="63735589" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="5048.02" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="abundantiam: abundance, plentifulness; singular feminine accusative from abundantia, abundantiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="agere: to conduct, to act; present active infinitive from agō, agere, ēgī, āctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Alamannī: the Alamanni, a confederation of Germanic tribes"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="apprehendērunt: they seized; 3rd person plural perfect active from apprehendō, apprehendere, apprehendī, apprehēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ārdēbant: they were burning; 3rd person plural imperfect active from ārdeō, ārdēre, ārsī, ārsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="auferēbant: they were carrying away; 3rd person plural imperfect active from auferō, auferre, abstulī, ablātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bonōrum: of good; plural neuter genitive from bonum, boni"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Brāchium: the Bosporus; from Brāchium Sānctī Georgīī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="carnis: of meat, flesh; singular feminine genitive from carō, carnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="castrum: fort; singular neuter accusative from castrum, castrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cessābant: they ceased; 3rd person plural imperfect active from cessō, cessāre, cessāvī, cessātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstiānī: Christians; plural masculine nominative from Chrīstiānus, Chrīstiānī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="combūrentēs: burning up; plural common nominative present participle from comburo, comburere, combusi, combustus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="coopertae: covered; plural feminine nominative perfect passive participle from cooperiō, cooperīre, cooperuī, coopertus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cui: who; singular dative from quis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēdūcēbant: they conducted; 3rd person plural imperfect active from dēdūcō, dēdūcere, dēdūxī, dēductus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēvāstantēs: devastating, ravaging; plural common nominative present participle from dēvāstō, dēvāstāre, dēvāstāvī, dēvāstātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="diēs: day; singular common accusative from diēs, diēī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīvīsī: dīvīsī sunt = they were divided; plural masculine nominative perfect passive participle from dīvidō, dīvidere, dīvīsī, dīvīsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="domōs: houses; plural feminine accusative from domus, domi"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ecclēsiae: churches; plural feminine nominative from ecclēsia, ecclēsiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ecclēsiās: churches; plural feminine accusative from ecclēsia, ecclēsiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ēlēgērunt: they chose; 3rd person plural perfect active from ēligō, ēligere, ēlēgī, ēlēctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eōs: to them; plural masculine accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erant: they were; 3rd person plural imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erat: he was; 3rd person singular imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Exerogorgō: a castle near Nicea. Also known as Xerigordos, the exact location is unknown."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Francī: the Franks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Francīs: from the Franks (ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="frūmentī: of corn, grain; singular neuter genitive from frūmentum, frūmentī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gente: people; singular feminine ablative from gēns, gentis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Graecīs: to the Greeks; plural masculine dative from Graecus, Graecī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iērunt: they went; 3rd person plural perfect active from eō, īre, ivī(iī), itus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illud: that; singular neuter nominative or accusative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="imperātor: emperor; singular masculine nominative from imperātor, imperātōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="intrāvērunt: they entered; 3rd person plural perfect active from intrō, intrāre, intrāvī, intrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invēnērunt: they found; 3rd person plural perfect active from invenio, invenire, inveni, inventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ipsīque: And themselves; plural masculine nominative from ipse, ipsa, ipsum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="īrātus: angry; singular masculine nominative from īrātus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iussit: he commanded; 3rd person singular perfect from iubeō, iubēre, iussī, iussus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Lombardī: the Lombards. The author of the Gesta Francōrum distinguished between two types of Lombards, even though many dictionaries list these as synonyms."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Longobardī: the Lombards. See above entry."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mala: evil (deeds); plural neuter accusative from malum, malī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nēquiter: wickedly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Nicēnam: Nicea"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Nicomediam: Nicomedia (city), capital of Bithynia; (now Izmid/Izmit Turkey); singular feminine accusative from Nicomedia, Nicomediae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōmen: name; singular neuter nominative from nōmen, nōminis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōn: not"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnia: all; plural neuter accusative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnium: of all; plural genitive from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="palātia: large residences; plural neuter nominative from palātium, palātiī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pervēnērunt: they arrived; 3rd person plural perfect active from perveniō, pervenīre, pervēnī, perventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="plumbum: lead; singular neuter accusative from plumbum, plumbī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="postquam: since, since then, after"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quā: in which; singular feminine ablative of qui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quattuor: 4"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quia: because"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quō: with which; singular ablative of quis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quod: which; singular neuter nominative of quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quoddam: what; singular neuter accusative of quīdam"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Rainoldus: a leader of the Crusaders chosen by the Lombards and Longobards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Romāniam: Byzantine Empire; singular feminine accusative from Rōmānia, Rōmāniae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="satis: enough"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sē: themselves"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="seniōrem: chief, elder; singular common accusative from senior, seniōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="similiter: similarly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sternēbant: they were overthrowing, demolishing; 3rd person plural imperfect active from sternō, sternere, strāvī, strātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="super: above, on top of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="superbiā: pride, haughtiness, arrogance; singular feminine ablative from superbia, superbiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tandem: finally"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trānsfretāvērunt: they passed over, ferried; 3rd person plural perfect active from trānsfretō, trānsfretāre, trānsfretāvī, trānsfretātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trānsmeāre: to go across, to pass over; present active infinitive from trānsmeō, trānsmeāre, trānsmeāvī, trānsmeātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tumēbant: they were swelling up; 3rd person plural imperfect active from tumeō, tumēre, -, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ubī: where, when if"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ultrā: beyond, further"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="unde: from whence"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="urbem: city; singular feminine accusative from urbs, urbis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="urbis: of the city; singular feminine genitive from urbs, urbis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vacuum: empty, vacant; singular neuter nominative from vacuus, vacua, vacuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēndēbant: they were selling; 3rd person plural imperfect active from vēndō, vēndere, vēndidī, vēnditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vīnī: wine; singular neuter genitive from vīnum, vīnī"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>

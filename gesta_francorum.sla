                <para PARENT="Vocab"/>
                <ITEXT CH="mandūcārēmus: we were chewing; 1st person plural imperfect active subjunctive from mandūcō, mandūcāre, mandūcāvī, mandūcātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Marīae: of Mary; singular feminine genitive from Marīa, Marīae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mātris: mother; singular feminine genitive from māter, mātris"/>
                <para PARENT="Vocab"/>

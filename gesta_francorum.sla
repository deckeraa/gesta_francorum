        <PAGEOBJECT XPOS="136.001" YPOS="133176.482" OwnPage="319" ItemID="706937733" PTYPE="4" WIDTH="522" HEIGHT="242.116726114997" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 242.117 L0 242.117 L0 0 Z" copath="M0 0 L522 0 L522 242.117 L0 242.117 L0 0 Z" gXpos="136.001" gYpos="133176.482" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tunc exeuntēs quattuordecim ex nostrīs mīlitibus, iērunt contrā Tripolim urbem, quae erat secus nōs. Istī quattuordecim invēnērunt circā sexāgintā Turcōs et aliōs quōsdam, quī habēbant ante sē collēctōs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" hominēs, et animālia plūs quam mīlle quīngenta. Quī signō crucis mūnītī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" invāsērunt eōs, et Deō iuvante mīrābiliter superāvērunt illōs et occīdērunt sex ex illīs, et apprehendērunt sex equōs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Dē exercitū vērō Raimundī comitis exiērunt Raimundus Pilētus, et Raimundus vicecomes dē Tentōriā, vēnēruntque ante Tortosam cīvitātem et fortiter aggrediuntur illam, quae nimis erat mūnīta multitūdine pāgānōrum."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="133418.598726115" OwnPage="319" ItemID="703384373" PTYPE="4" WIDTH="522" HEIGHT="100.280254777055" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 100.28 L0 100.28 L0 0 Z" copath="M0 0 L522 0 L522 100.28 L0 100.28 L0 0 Z" gXpos="136.001" gYpos="133418.598726115" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who had assembled before themselves men and more than 1,500 animals."/>
                <ITEXT CH=" Presumably the 60 Turks had gathered slaves that they were transporting when the Crusader band attacked them."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who, having been fortified by the sign of the cross, attacked them."/>
                <ITEXT CH=" This either refers to the crosses the Crusaders wore on their uniforms, or to making the sign of the cross."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

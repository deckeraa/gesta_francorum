                <ITEXT CH="eōs: them; plural masculine accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erō: I will be; 1st person singular future active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>

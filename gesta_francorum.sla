                <para PARENT="Vocab"/>
                <ITEXT CH="hoc: this; singular neuter accusative from hic, haec, hoc"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hominēs: persons; plural masculine nominative from homō, hominis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ībō: I will go; 1st person singular future active from eō, īre, ivī(iī), itus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="igitur: therefore"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="īlicō: immediately"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illīc: there"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illō: that; singular neuter ablative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illōs: that; plural masculine accusative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="incipiēbāmus: we were starting (to buildb, in context); 1st person plural imperfect active from incipiō, incipere, incēpī, inceptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="inimīcī: enemy; plural masculine nominative from inimicus, inimica -um, inimicior -or -us, inimicissimus -a -um"/>
                <para PARENT="Vocab"/>

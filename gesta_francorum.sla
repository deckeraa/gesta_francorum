        <PAGEOBJECT XPOS="136.001" YPOS="73272.2659999999" OwnPage="175" ItemID="389017605" PTYPE="4" WIDTH="522" HEIGHT="333.288140127523" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 333.288 L0 333.288 L0 0 Z" copath="M0 0 L522 0 L522 333.288 L0 333.288 L0 0 Z" gXpos="136.001" gYpos="73272.2659999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Erat itaque Boamundus iam sēcūrus"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" dē introitū cīvitātis, et gāvīsus serēnāque mente, placidō vultū vēnit ad omnēs seniōrēs, eīsque iocunda verba intulit, dīcēns: &quot;Virī prūdentissimī mīlitēs, vidēte quōmodo nōs omnēs in nimiā paupertāte et miseriā sumus, maiōrēs sīve minōrēs, et ignōrāmus penitus, quā parte melius succēdat"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" nōbīs. Igitur sī vōbīs bonum et honestum vidētur, ēligat sē ante aliōs ūnus ex nōbīs, et sī aliquō modō vel ingeniō cīvitātem adquīrere vel ingeniāre potuerit, per sē vel per aliōs, concordī vōce eī urbem dōnō concēdāmus.&quot; Quī omnīnō prohibuērunt, et dēnegāvērunt dīcentēs: &quot;Nēminī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" dīmittētur haec cīvitās, sed omnēs aequāliter habēbimus illam, sīcut aequālem habuimus labōrem, sīc inde aequālem habeāmus honōrem.&quot; Itaque Boamundus audītis hīs verbīs, paulomīnus subrīdēns prōtinus recessit."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="73605.5541401274" OwnPage="175" ItemID="389421957" PTYPE="4" WIDTH="522" HEIGHT="112.815286624202" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 112.815 L0 112.815 L0 0 Z" copath="M0 0 L522 0 L522 112.815 L0 112.815 L0 0 Z" gXpos="136.001" gYpos="73605.5541401274" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Therefore Bohemond, now secure about the entry into the city, and having been gladdened with a serene mind."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="With what part (of the invasion attempt) might succeed better."/>
                <ITEXT CH=" Bohemond points out that they have suffered much already, and how the city might be won is uncertain, and thus suggests they should offer the city whole to anyone who can capture it. Bohemond made this suggestion because he had already found someone inside the city to let him in."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="This city will be left to no one, but everyone will equally have it."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="73272.2659999999" OwnPage="176" ItemID="392863253" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="73272.2659999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

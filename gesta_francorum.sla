                <para PARENT="Vocab"/>
                <ITEXT CH="nōbīs: to us; singular dative or ablative from ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nocte: night; singular feminine ablative from nox, noctis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōs: us; plural nominative or accusative of ego"/>
                <para PARENT="Vocab"/>

        <PAGEOBJECT XPOS="136.001" YPOS="116536.422" OwnPage="279" ItemID="622761845" PTYPE="4" WIDTH="522" HEIGHT="388.367808917494" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 388.368 L0 388.368 L0 0 Z" copath="M0 0 L522 0 L522 388.368 L0 388.368 L0 0 Z" gXpos="136.001" gYpos="116536.422" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tertiā vērō diē exiērunt et vēnērunt ad quamdam urbem cui nōmen Marra, quae illīc erat prope illōs. Erant autem ibi multī Turcī congregātī et Saracēnī ab Aleph cīvitāte et ab omnibus urbibus et castrīs quae circā illam sunt. Exiērunt ergō barbarī contrā illōs ad bellum, nostrīque aestimantēs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" luctārī cum illīs proeliandō, coēgērunt eōs in fugam, et tamen reversī per tōtum diem invādēbant nostrōs adinvicem; et ūsque ad vesperam perdūrāvit illa invāsiō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Aestus namque erat immēnsus. Nequībant iam nostrī sufferre tantam sitim, quoniam nūllātenus ad bibendum invenīre ibi aquam poterant; voluērunt tamen ad illōrum castrum sēcūrē redīre. Prō illōrum enim peccātīs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" Suriānī et minūtā gēns nimiō pavōre correptī, mox coepērunt viam carpere retrōrsum. Ut autem Turcī vīdērunt illōs retrōcēdentēs, statim coepērunt illōs persequī, et victōria"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" illīs ministrābat vīrēs. Multī namque ex ipsīs reddidērunt"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" animās Deō, cuius amōre illīc congregātī fuerant."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="116924.789808917" OwnPage="279" ItemID="622917909" PTYPE="4" WIDTH="522" HEIGHT="102.726114649893" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 102.726 L0 102.726 L0 0 Z" copath="M0 0 L522 0 L522 102.726 L0 102.726 L0 0 Z" gXpos="136.001" gYpos="116924.789808917" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And our (soldiers) thinking to struggle with them by battling, forced them into retreat."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="But on account of the sins of the Syrians and our people having been diminished (by) having been seized by excessive fear."/>
                <ITEXT CH=" Hagenmeyer (p. 388, note 28) suggests that the 'sins' of the Syrians was them failing to place themselves under military discipline, leading to their disorderly retreat."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit" CH="The victory was ministering strength to them."/>
                <ITEXT CH=" The Turks were strengthened by seeing the Crusaders retreat."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And many of them returned their souls to God (by martyrdom in battle), on account of whose love they had been gathered (to go on Crusade)."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="116536.422" OwnPage="280" ItemID="626789989" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="116536.422" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

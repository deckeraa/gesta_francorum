                <para PARENT="Vocab"/>
                <ITEXT CH="coepisset: it had started; 3rd person singular pluperfect active subjunctive from coepio, coepere, coepi, coeptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="crēbrēscere: to become widespread, to become frequent; present active infinitive from crēbrēscō, crēbrēscere, crēbruī, -"/>

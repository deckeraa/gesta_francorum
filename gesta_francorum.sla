        <PAGEOBJECT XPOS="136.001" YPOS="44984.164" OwnPage="107" ItemID="246625493" PTYPE="4" WIDTH="522" HEIGHT="322.63854777073" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 322.639 L0 322.639 L0 0 Z" copath="M0 0 L522 0 L522 322.639 L0 322.639 L0 0 Z" gXpos="136.001" gYpos="44984.164" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Deinde vēnimus ad quamdam urbem nōmine Coxōn, in quā erat maxima ūbertās omnium bonōrum, quae nōbīs erant necessāria. Chrīstiānī igitur, vidēlicet alumnī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" urbis illīus, reddidērunt sē statim; nōsque fuimus ibi optimē per trēs diēs, et illīc maximē sunt recuperātī nostrī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Audiēns itaque Raimundus, comes de Sānctō Egidīō, quod Turcī, quī erant in cūstōdiā Antiochīae, discessissent, in suō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" invēnit cōnsiliō, quod mitteret illūc aliquōs ex suīs mīlitibus, quī eam dīligenter cūstōdīrent. Tandem ēlēgit illōs quōs lēgāre volēbat, vidēlicet Petrum dē Castelliōne vicecomitem, Willelmum dē Monte Pislerīō, Petrum dē Roasā, Petrum Raimundum dē Pul, cum quīngentīs mīlitibus. Vēnērunt itaque in vallem prope Antiochīam ad quoddam castrum Pūblicānōrum; illīcque audiērunt Turcōs esse in cīvitāte, eamque fortiter dēfendere praeparābant."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="45306.8025477707" OwnPage="107" ItemID="247050373" PTYPE="4" WIDTH="522" HEIGHT="182.063694267519" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 182.064 L0 182.064 L0 0 Z" copath="M0 0 L522 0 L522 182.064 L0 182.064 L0 0 Z" gXpos="136.001" gYpos="45306.8025477707" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The Christians therefore, namely the inhabitants of that city, gave over themselves (to Crusader control) at once."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He came up with his plan, that he might send there some of his soldiers, that they might diligently guard her (the city of Antioch)."/>
                <ITEXT CH=" Raymond of Saint-Gilles organized an advance party to prepare for the siege of Antioch."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="44984.164" OwnPage="108" ItemID="250377157" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="44984.164" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliquōs: some; plural masculine accusative from aliquī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="alumnī: inhabitants (from context); nursling, pupil, foster-son; plural masculine nominative from alumnus, alumnī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Antiochīae: of Antioch (city in Roman Syria/modern Turkey); singular feminine genitive from Antiochīa, Antiochīae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Antiochīam: Antioch (city in Roman Syria/modern Turkey); singular feminine accusative from Antiochīa, Antiochīae"/>
                <para PARENT="Vocab"/>

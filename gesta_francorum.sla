        <PAGEOBJECT XPOS="136.001" YPOS="109880.398" OwnPage="263" ItemID="585792709" PTYPE="4" WIDTH="522" HEIGHT="362.60836942702" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 362.608 L0 362.608 L0 0 Z" copath="M0 0 L522 0 L522 362.608 L0 362.608 L0 0 Z" gXpos="136.001" gYpos="109880.398" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Postquam Curbaram vīdit Francōrum aciēs tam pulchrē ōrdinātās exīre ūnam post aliam, dīxit: &quot;Sinite"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" eōs exīre, ut melius eōs habeāmus in potestāte nostrā.&quot; Postquam vērō fuērunt foris"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" dē urbe vīditque Curbaram ingentem Francōrum gentem, valdē timuit. Mox mandāvit suō ammiralīō, quī omnia habēbat in cūstōdiā, ut sī ille vidēret"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" ignem accēnsum in capite hostis, prōtinus praecōnārī faceret, omnem exercitum redīre, sciēns Turcōs āmīsisse bellum. Continuō Curbaram coepit paulātim redīre retrō contrā montāneam; nostrīque paulātim persequēbantur illōs. Dēnique dīvīsī sunt Turcī; ūna pars īvit contrā mare, et aliī stetērunt illīc, putantēs nostrōs inclūdere inter sē. Videntēs hoc nostrī, fēcērunt similiter."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Illīc fuit ōrdināta aciēs septēna ex aciē ducis Godefridī et comitis Nortmanniae, et caput illīus fuit comes Reinaldus. Hanc mīsērunt obviam Turcīs quī veniēbant ā marī. Turcī autem proeliātī sunt cum illīs, et sagittandō multōs occīdērunt ex nostrīs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="110243.006369427" OwnPage="263" ItemID="585921285" PTYPE="4" WIDTH="522" HEIGHT="177.39163057298" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 177.392 L0 177.392 L0 0 Z" copath="M0 0 L522 0 L522 177.392 L0 177.392 L0 0 Z" gXpos="136.001" gYpos="110243.006369427" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Allow them to go out, so that we might better have them in our power."/>
                <ITEXT CH=" Curbaram allowed the Crusaders to sally out unharassed, thinking that then he might beat them in pitched battle."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="But after they had gone out from the city and Curbaram saw the massive people of the Franks, he feared greatly."/>
                <ITEXT CH=" The Frankish army is symbolically similar to the Lance: both were hidden away and their power was underestimated until they were brought forth in battle."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That if that one (the emir) saw fire lit at the head of the (Turkish) army, he should immediately announce (that) the whole army should retreat, knowing the Turks to have lost the battle."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

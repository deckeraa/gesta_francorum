        <PAGEOBJECT XPOS="136.001" YPOS="97400.3529999998" OwnPage="233" ItemID="518429589" PTYPE="4" WIDTH="522" HEIGHT="386.653369426975" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 386.653 L0 386.653 L0 0 Z" copath="M0 0 L522 0 L522 386.653 L0 386.653 L0 0 Z" gXpos="136.001" gYpos="97400.3529999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Audientēs itaque, quod inimīcī eōrum ab eīs omnīnō essent"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vincendī, prōtinus coepērunt sēsē vīvificāre et cōnfortābant sē adinvicem dīcentēs: &quot;Expergīsciminī, et estōte ubīque fortēs ac prūdentēs, quoniam in proximō erit nōbīs Deus in adiūtōrium, et erit maximum refugium populō suō, quem respicit"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" in maerōre manentem.&quot;"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Turcī dēnique, quī erant seorsum"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" in castellō, undique tam mīrābiliter coangustābant nōs, ut quādam diē inclūserint"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" trēs mīlitēs ex nostrīs in turrim quae erat ante castellum. Exierant namque gentīlēs et irruerant super illōs tam ācriter, ut nequīrent sufferre pondus eōrum. Duo ex mīlitibus exiērunt dē turrī vulnerātī, et tertius per tōtum diem virīliter dēfendēbat sē dē Turcōrum invāsiōne tam prūdenter ut in ipsā diē duōs Turcōs strāverit"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" super aditum mūrī caesīs hastīs. Nam trēs hastae dētruncātae"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" sunt in illā diē in manibus suīs. Illī vērō accēpērunt capitālem sententiam. Erat nōmen illī Hugō"/>
                <ITEXT FEATURES="inherit superscript" CH="7"/>
                <ITEXT CH=" li Forcenez, dē exercitū Gosfridī dē Monte Scabiōsō."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="97787.0063694268" OwnPage="233" ItemID="518668837" PTYPE="4" WIDTH="522" HEIGHT="170.140127388542" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 170.14 L0 170.14 L0 0 Z" copath="M0 0 L522 0 L522 170.14 L0 170.14 L0 0 Z" gXpos="136.001" gYpos="97787.0063694268" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That our enemies would be entirely conquered by them."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Whom, remaining in sorrow, He looked back upon."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who were separate in the citadel."/>
                <ITEXT CH=" Recall that when the Crusaders took Antioch, there were some Turkish holdouts in a citadel within the confines of the city. When Curbaram's army approached and forced the Crusaders inside the city, they then had Turkish enemies both inside and outside the city."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That on a certain day they pinned down three of our soldiers in a tower that was in front of the citadel."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="In the same day he killed two Turks on the approach of the wall, having killed them with spears."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For three spears were broken that day in his hands."/>
                <ITEXT CH=" We're not told why they broke; perhaps because he was fighting so strenuously that three different spears failed."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="7"/>
                <ITEXT CH="Two manuscripts have a textual variant here that names him as "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Hugō Īnsānus"/>
                <ITEXT CH=", a fitting moniker considering the odds he fought against."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="97400.3529999998" OwnPage="234" ItemID="523183253" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="97400.3529999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

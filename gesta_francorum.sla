                <para PARENT="Vocab"/>
                <ITEXT CH="nōs: we; plural nominative from ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrā: our; singular feminine ablative from noster, nostra, nostrum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrīs: our"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="observābat: he was watching; 3rd person singular imperfect active from observō, observāre, observāvī, observātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnēs: all, every; plural common nominative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnibus: all; plural dative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="paucī: few, little; plural masculine nominative from paucus, pauci"/>
                <para PARENT="Vocab"/>

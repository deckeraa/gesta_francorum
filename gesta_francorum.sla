        <PAGEOBJECT XPOS="136.001" YPOS="96568.3499999998" OwnPage="231" ItemID="513990965" PTYPE="4" WIDTH="522" HEIGHT="360.61815286646" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 360.618 L0 360.618 L0 0 Z" copath="M0 0 L522 0 L522 360.618 L0 360.618 L0 0 Z" gXpos="136.001" gYpos="96568.3499999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Iterum cum essēmus"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" ita ut superius dīximus, vēnit Sānctus Andreās rūrsus dīcēns eī: &quot;Quārē nōn abstulistī lanceam dē terrā ut ego tibi praecēpī? Sciās"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" rēvērā, quia quīcunque hanc lanceam portāverit in bellō, nunquam ab hoste superābitur.&quot; Petrus vērō continuō revēlāvit mystērium apostolī hominibus nostrīs. Populus autem nōn crēdēbat, sed prohibēbat dīcēns: &quot;Quōmodo possumus hoc crēdere?&quot; Omnīnō"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" enim erant paventēs, et prōtinus morī putābant."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Accessit itaque ille et iūrāvit hoc tōtum vērācissimum esse; quoniam eī Sānctus Andreās bis in vīsiōne appāruerat, eīque dīxerat: &quot;Surge, vāde, et dīc populō Deī nē timeat, sed firmiter tōtō corde crēdat in ūnum vērum Deum; eruntque ubīque vīctūrī, et īnfrā quīnque diēs mandābit eīs Dominus tālem rem, unde laetī et gāvīsī manēbunt; et, sī certāre voluerint"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=", mox ut exierint ūnanimiter ad bellum, omnēs inimīcī eōrum vincentur et nēmō stābit contrā illōs.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="96928.9681528662" OwnPage="231" ItemID="514248581" PTYPE="4" WIDTH="522" HEIGHT="116.38184713354" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 116.382 L0 116.382 L0 0 Z" copath="M0 0 L522 0 L522 116.382 L0 116.382 L0 0 Z" gXpos="136.001" gYpos="96928.9681528662" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Again, when we were like we stated above."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="You should know, in fact, that whoever will carry this lance in battle will never be overcome by the enemy."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They were altogether trembling, and were thinking (themselves) to die soon. "/>
                <ITEXT FONT="DejaVu Serif Book" CH="Many of the Crusaders trapped in Antioch were so dispirited that they didn't believe Peter's story about the lance."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="If they are willing to fight, soon they will go out united to battle, all their enemies will be defeated and no one will stand against them."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="96568.3499999998" OwnPage="232" ItemID="517856229" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="96568.3499999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ab: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="abstulistī: you carried away; 2nd person singular perfect active from auferō, auferre, abstulī, ablātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="accessit: he approached; 3rd person singular perfect active from accēdō, accēdere, accessī, accessus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Andreās: Andrew"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="apostolī: apostle; singular masculine genitive from apostolus, apostolī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="appāruerat: he had appeared; 3rd person singular pluperfect active from appāreō, appārēre, appāruī, appāritus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bellō: battle; singular neuter ablative from bellum, bellī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bellum: battle, war; singular neuter accusative from bellum, bellī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bis: twice"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="certāre: to fight; present active infinitive from certō, certāre, certāvī, certātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="continuō: immediately; singular masculine dative from continuus, continua, continuum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="contrā: against"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="corde: heart; singular neuter ablative from cor, cordis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="crēdat: it might believe; 3rd person singular present active subjunctive from crēdō, crēdere, crēdidī, crēditus"/>
                <para PARENT="Vocab"/>

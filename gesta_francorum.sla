                <para PARENT="Vocab"/>
                <ITEXT CH="nimiō: too much"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōn: not"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōs: us; plural accusative of ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostra: our; plural neuter accusative from noster, nostra, nostrum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="offendentem: offending, annoying; singular common accusative present participle from offendō, offendere, offendī, offēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pavōre: fear, trembling; singular masculine ablative from pavor, pavōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="perdēs: you will lose; 2nd person singular future active from perdō, perdere, perdidī, perditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="perditūrus: perditūrus es = you will los; singular masculine nominative future participle from perdō, perdere, perdidī, perditus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="persecūtūrī: persecūtūrī sunt = they will pursue; plural masculine nominative future participle from persequor, persequī, persecūtus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="poenālī: penalty, punishment; singular dative from poenālis, poenāle"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="praesentiarum: of present things; plural feminine genitive from praesentia, praesentiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="proeliō: battle, conflict; singular neuter ablative from proelium, proeliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pugnandī: of fighting; singular masculine genitive future passive participle from pugnō, pugnāre, pugnāvī, pugnātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pūnit: he punishes; 3rd person singular present active from pūniō, pūnīre, pūnīvī, pūnītus"/>
                <para PARENT="Vocab"/>

                <para PARENT="Vocab"/>
                <ITEXT CH="quia: because"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quoniam: since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rīpam: bank, shore; singular feminine accusative from rīpa, rīpae"/>
                <para PARENT="Vocab"/>

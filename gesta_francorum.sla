        <PAGEOBJECT XPOS="136.001" YPOS="103224.374" OwnPage="247" ItemID="548800821" PTYPE="4" WIDTH="522" HEIGHT="297.600522293244" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 297.601 L0 297.601 L0 0 Z" copath="M0 0 L522 0 L522 297.601 L0 297.601 L0 0 Z" gXpos="136.001" gYpos="103224.374" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Cum Wīdō, mīles honestissimus, tālia audīsset fallācia, cum omnibus statim coepit plōrāre atque vehementissimō ululātū plangere, ūnāque vōce omnēs dīcēbant: &quot;Ō Deus vērus, trīnus et ūnus, quamobrem haec fierī permīsistī? Cūr populum sequentem tē in manibus inimīcōrum incidere"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" permīsistī et viam tuī itineris tuīque Sepulchrī līberāre volentēs tam cito dīmīsistī? Certē sī vērum est hoc verbum, quod ab istīs nēquissimīs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" audīvimus, nōs et aliī Chrīstiānī dērelinquēmus tē, nec tē amplius rememorābimur, et ūnus ex nōbīs nōn audēbit ulterius invocāre nōmen tuum.&quot; Et fuit hic sermō maestissimus in tōtā mīlitiā, ita ut nūllus illōrum sīve epīscopus sīve abbās seu clēricus seu lāicus, audēret invocāre Chrīstī nōmen per plūrēs diēs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="103521.974522293" OwnPage="247" ItemID="549039845" PTYPE="4" WIDTH="522" HEIGHT="91.0700636942638" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 91.0701 L0 91.0701 L0 0 Z" copath="M0 0 L522 0 L522 91.0701 L0 91.0701 L0 0 Z" gXpos="136.001" gYpos="103521.974522293" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Why did you permit the people following you to fall into the hands of the enemies and (why did) you so quickly abandon the ones wanted to liberate the path of your pilgrimage and of the Sepulchre?"/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Certainly if this word is true, which we heard from these good-for-nothing (deserters), we and the other Christians will abandon you, nor will we remember you more, and one of use will not dare to again invoke your name."/>
                <ITEXT FONT="DejaVu Serif Book" CH=" This was not a wise thing to say; it illustrates how some of the Crusaders had a crises of faith, having encountered much suffering and apparent defeat."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="103224.374" OwnPage="248" ItemID="552707685" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="103224.374" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

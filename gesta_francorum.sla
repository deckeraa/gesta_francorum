                <para PARENT="Vocab"/>
                <ITEXT CH="onustīs: laden; plural ablative from onustus, onusta, onustum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ovēs: sheep; plural feminine nominative from ovis, ovis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pāstōrem: shepherd, pastor; singular masculine accusative from pāstor, pāstōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="plūs: more, from mūltus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="potuisset: he (might) have had been able; 3rd person singular pluperfect active subjunctive from possum, posse, potuī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prūdēns: prudent, competent; singular nominative from prūdēns, prūdentis (gen.), prūdentior -or -us, prūdentissimus -a -um"/>
                <para PARENT="Vocab"/>

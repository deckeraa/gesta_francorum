                <para PARENT="Vocab"/>
                <ITEXT CH="atque: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aut: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Bulgāriam: Bulgaria (accusative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="capitālem: deadly; singular common accusative from capitālis, capitāle, capitālior -or -us, capitālissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="captīvitātem: captivity; singular feminine accusative from captīvitās, captīvitātis"/>
                <para PARENT="Vocab"/>

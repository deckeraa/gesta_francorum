                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ambulāvērunt: they walked; 3rd person plural perfect active from ambulō, ambulāre, ambulāvī, ambulātus"/>

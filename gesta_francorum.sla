        <PAGEOBJECT XPOS="136.001" YPOS="45816.167" OwnPage="109" ItemID="250949013" PTYPE="4" WIDTH="522" HEIGHT="142.762936305764" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 142.763 L0 142.763 L0 0 Z" copath="M0 0 L522 0 L522 142.763 L0 142.763 L0 0 Z" gXpos="136.001" gYpos="45816.167" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Petrus dē Roasā dīvīsit sē ibi ab aliīs, et proximā nocte trānsīvit prope Antiochīam, intrāvitque vallem dē Rugīā et invēnit Turcōs et Saracēnōs, et praeliātus est cum eīs et occīdit multōs ex eīs, et aliōs persecūtus est valdē. Videntēs hoc Hermēniī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" habitātōrēs terrae illīus, illum fortiter superāsse pāgānōs, continuō reddidērunt sē. Ipse vērō statim coepit Rūsam cīvitātem et plūrima castra."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="45958.4713375796" OwnPage="109" ItemID="251141077" PTYPE="4" WIDTH="522" HEIGHT="66.0382165605115" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 66.0382 L0 66.0382 L0 0 Z" copath="M0 0 L522 0 L522 66.0382 L0 66.0382 L0 0 Z" gXpos="136.001" gYpos="45958.4713375796" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The Armenians, the inhabitants of that land, seeing that, (how) that one (Petrus dē Roasā) had strongly overcome the pagans (the Turks), they immediately gave themselves to him (to his rule)"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He himself immediately started (to rule) the city of Rusa and many castles."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

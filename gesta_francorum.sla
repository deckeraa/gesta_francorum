        <PAGEOBJECT XPOS="136.001" YPOS="113208.41" OwnPage="271" ItemID="605539797" PTYPE="4" WIDTH="522" HEIGHT="330.545414013031" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 330.545 L0 330.545 L0 0 Z" copath="M0 0 L522 0 L522 330.545 L0 330.545 L0 0 Z" gXpos="136.001" gYpos="113208.41" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Ipsā vērō hōrā vēnit vir venerābilis Boamundus deditque illī suum vexillum; ille autem illud accēpit cum magnō gaudiō; et iniit pactum cum dominō Boamundō, ut"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" pāgānī, quī vellent Chrīstiānitātem recipere, essent cum eō, et quī vellent abīre, sānōs et absque ūllā laesiōne abīre permitteret. Cōnsēnsit"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" ille quicquid ammiralius postulāvit, et continuō mīsit suōs servientēs in castellum. Nōn post multōs diēs baptīzātus est ammirālius cum illīs, quī Chrīstum"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" recognōscere māluērunt. Illōs vērō, quī suās voluērunt"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" tenēre lēgēs, fēcit dominus Boamundus condūcī in Saracēnōrum terram."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Hoc bellum factum est in IV kalendās"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" Iūliī, in vigiliā apostolōrum Petrī et Paulī; rēgnante dominō nostrō Iēsu Chrīstō, cui est honor et glōria in sempiterna saecula. Āmēn."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="113538.955414013" OwnPage="271" ItemID="605684869" PTYPE="4" WIDTH="522" HEIGHT="112.815286623954" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 112.815 L0 112.815 L0 0 Z" copath="M0 0 L522 0 L522 112.815 L0 112.815 L0 0 Z" gXpos="136.001" gYpos="113538.955414013" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that the pagans, who might want to receive Christianity, would be with him (the emir) and those who might want to leave, he (Bohemond) would permit to leave healthy and without any injury."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That one (Bohemond) agreed with whatever the emir requested."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who rather wanted to recognize Christ (as his Lord by becoming Christian)."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And those, who wanted to hold onto their laws, lord Bohemond made to be led into the land of the Saracenes."/>
                <ITEXT CH=" Here "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="lēgēs"/>
                <ITEXT CH=" is referring to their Muslim customs."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH="June 28, 1098"/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="113208.41" OwnPage="272" ItemID="609922821" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="113208.41" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="abīre: to depart; present active infinitive from abeo, abire, abiī, abitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="abs: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="accēpit: he received, he grasped; 3rd person singular perfect active from accipiō, accipere, accēpī, acceptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="āmēn: amen, truly, verily"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ammiralius: emir, leader, admiral; loanword from Arabic"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="apostolōrum: of the apostles; plural masculine genitive from apostolus, apostolī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="baptīzātus: baptīzātus est = he was baptized; singular masculine nominative perfect passive participle from baptīzō, baptīzāre, baptīzāvī, baptīzātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bellum: battle, war; singular neuter nominative from bellum, bellī"/>

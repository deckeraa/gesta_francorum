        <PAGEOBJECT XPOS="136.001" YPOS="79928.2899999998" OwnPage="191" ItemID="425579637" PTYPE="4" WIDTH="522" HEIGHT="398.487070063857" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 398.487 L0 398.487 L0 0 Z" copath="M0 0 L522 0 L522 398.487 L0 398.487 L0 0 Z" gXpos="136.001" gYpos="79928.2899999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Liber 9"/>
                <para PARENT="Chapter Heading"/>
                <para PARENT="Chapter Heading"/>
                <tab/>
                <ITEXT CH="Curbaram, prīnceps mīlitiae Soldānī Persiae, dum adhūc esset Corrozānum, quotiēns"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Cassiānus ammiralius Antiochīae lēgātiōnem eī mīsit, quō sibi succurreret in tempore opportūnō, quoniam gēns fortissima Francōrum eum impedītum graviter obsīdēbat in Antiochīā; et, sī adiūtōrium eī impendēret"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=", urbem Antiochēnam illī trāderet, aut eum maximō mūnere dītāret; cumque iam habuisset maximum exercitum Turcōrum, ex longō collēctum tempore, et licentiam Chrīstiānōs occīdendī accēpisset ā Caliphā, illōrum Apostolicō"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=", īlicō inchoāvit iter longae viae Antiochīae. Hierosolymītānus ammirālius in adiūtōrium cum suō exercitū vēnit; rēx Damascī illūc vēnit, cum maximā gente. Īdem vērō Curbaram congregāvit innumerās gentēs pāgānōrum, vidēlicet Turcōs, Arabās, Saracēnōs, Pūblicānōs, Azimītās, Curtōs, Persās, Agulānōs, et aliās multās gentēs innumerābilēs."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="80327.2356687898" OwnPage="191" ItemID="425539765" PTYPE="4" WIDTH="522" HEIGHT="131.159235668791" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 131.159 L0 131.159 L0 0 Z" copath="M0 0 L522 0 L522 131.159 L0 131.159 L0 0 Z" gXpos="136.001" gYpos="80327.2356687898" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For many times Cassiānus the emir of Antioch had sent legates to him, by means of which he (Curbaram) might send aid to him (Cassiānus) in an opportune time, because the very strong nation of Franks was besieging him, burdened greatly, in Antioch."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="If he would expend (resources to send) help to him, he would give the city of Antioch to him."/>
                <ITEXT CH=" The emir of Antioch, realizing his dangerous position, offered to give up his city to another Muslim leader on the condition that he would send an army to defeat the Crusaders."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And he had received license for killing Christians from the Caliph, their Pope."/>
                <ITEXT CH=" The author likens the Caliph to the Pope because both, at this period in time, had political power to grant license for war."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="79928.2899999998" OwnPage="192" ItemID="426999669" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="79928.2899999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="accēpisset: he had received; 3rd person singular pluperfect active subjunctive from accipiō, accipere, accēpī, acceptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adhūc: until now"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="adiūtōrium: adiūtōrium: help, support; singular neuter accusative from adiūtōrium, adiūtōriī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Agulānōs: Aghlabids (North African muslims)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliās: others; plural feminine accusative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ammiralius: emir, leader, admiral; loanword from Arabic"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Antiochēnam: Antiochian; singular feminine accusative from Antiochēnus, Antiochēna, Antiochēnum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Antiochīa: Antioch (city in Roman Syria/modern Turkey); singular feminine nominative from Antiochīa, Antiochīae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Antiochīae: of Antioch (city in Roman Syria/modern Turkey); singular feminine genitive from Antiochīa, Antiochīae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Apostolicō: the Pope (medieval usage), bishop, apostle; singular masculine ablative from apostolicus, apostolica, apostolicum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Arabās: Arabs"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aut: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Azimītās: Armenians (according to Hagenmeyer (p. 297, note 19)). The name stems from the Greek άζυμος, which means unleavened, and refers to the Armenian's practice of using unleavened bread in the Eucharist."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Calīphā: caliph, loanword from Arabic; singular masculine ablative from calīpha, calīphae"/>
                <para PARENT="Vocab"/>

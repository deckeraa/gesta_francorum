                <para PARENT="Vocab"/>
                <ITEXT CH="minantur: they threaten; 3rd person plural present active from the deponent minor, minārī, minātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nimiam: too much, superabundance; singular feminine accusative from nimius, nimia, nimium"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōmina: names; plural neuter accusative from nōmen, nōminis"/>
                <para PARENT="Vocab"/>

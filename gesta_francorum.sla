        <PAGEOBJECT XPOS="136.001" YPOS="20856.077" OwnPage="49" ItemID="137679573" PTYPE="4" WIDTH="522" HEIGHT="320.636375796174" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 320.636 L0 320.636 L0 0 Z" copath="M0 0 L522 0 L522 320.636 L0 320.636 L0 0 Z" gXpos="136.001" gYpos="20856.077" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Comes autem Sānctī Egidiī erat hospitātus extrā cīvitātem in burgō, gēnsque sua remānserat retrō. Mandāvit itaque imperātor comitī, 'ut faceret eī hominium"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" et fīdūciam sīcut aliī fēcerant'. Et dum imperātor haec mandābat, comes meditābātur"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" quāliter vindictam dē imperātōris exercitū habēre posset. Sed dux Godefridus et Rotbertus comes Flandrēnsis aliīque prīncipēs dīxērunt eī, 'iniūstum fore, contrā Chrīstiānōs pugnāre'. Vir quoque sapiēns Boamundus dīxit, 'quia"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" sī aliquid iniūstum imperātōrī faceret, et fīdūciam eī facere prohibēret, ipse ex imperātōris parte fieret'. Igitur comes, acceptō cōnsiliō ā suīs, Alexīō vītam et honōrem iūrāvit, quod nec per sē nec per alium eī auferre cōnsentiat"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=". Cumque dē homīniō appellārētur"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=", nōn sē prō capitis perīculō id factūrum respondit. Tunc gēns domini Boamundī appropinquāvit Cōnstantīnopolī."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="21176.7133757962" OwnPage="49" ItemID="138282837" PTYPE="4" WIDTH="522" HEIGHT="233.732484076412" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 233.732 L0 233.732 L0 0 Z" copath="M0 0 L522 0 L522 233.732 L0 233.732 L0 0 Z" gXpos="136.001" gYpos="21176.7133757962" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And the emperor commanded the count, that he (the count) might make to him an oath of vassalage and faithfulness like the others had made."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And the count was considering what type of vengeance on the emperor's army he might have."/>
                <ITEXT CH=" Raymond of Saint-Gilles was considering an attack on Alexius's forces, but is prevented from doing so by his friends' counsel in the next sentence."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Because if anything make injustice to the emperor, and prevents faithfulness from being performed to him, it itself will be on the part of the emperor (it will be the emperor's fault)."/>
                <ITEXT CH=" Hagenmeyer appears to take a different interpretation, in which Bohemond says that if anyone does injustice to the emperor, then Bohemond would be on the emperor's side (Hagenmeyer, p. 174, footnote 32). Given that Bohemond would later keep Antioch, claiming that the oath had been broken by the emperor, I have kept the former interpretation."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He to Alexius life and honor, that he would consent them (Alexius's honor and life) to be taken away either by him or by others."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And when he was asked of (the oath of vassalage), he responded that he wouldn't make it (even) for capital risk. "/>
                <ITEXT CH="Though the Raymond of Saint-Gilles swore an oath to not harm Alexius, he wouldn't swear the oath of vassalage, even on pain of death."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="20856.077" OwnPage="50" ItemID="139774501" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="20856.077" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

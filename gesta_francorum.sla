                <para PARENT="Vocab"/>
                <ITEXT CH="venīrent: they might come; 3rd person plural imperfect subjunctive from veniō, venīre, vēnī, ventum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vērō: and, but"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="viam: road, path; singular feminine accusative from via, viae"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="129016.467" OwnPage="309" ItemID="683820805" PTYPE="4" WIDTH="522" HEIGHT="398.717713376143" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 398.718 L0 398.718 L0 0 Z" copath="M0 0 L522 0 L522 398.718 L0 398.718 L0 0 Z" gXpos="136.001" gYpos="129016.467" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Vidēns autem Raimundus, quod nūllus seniōrum voluisset causā eius īre in viam Sānctī Sepulchrī, exīvit nūdīs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" pedibus dē Marrā decimā tertiā diē intrante Iānuāriō, et pervēnit ūsque Capharda, fuitque ibi per trēs diēs. Illīc adiūnxit sē comes Normanniae comitī Raimundō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Rēx autem Cesareae multotiēns mandāverat per suōs nūntiōs comitī Marrae et Caphardae, quod cum eō pācem vellet"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" habēre, et dē suō"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" pretium eī daret et Chrīstiānōs peregrīnōs dīligeret fīdūciamque faceret, quia"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" quantum continet eius imperium, peregrīnīs nōn esset offendiculum, et mercātum dē equīs et dē corporālibus alimentīs daret gaudenter."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Exiērunt autem nostrī et vēnērunt hospitārī iuxtā Cesaream, super fluvium Farfar. Cumque vīdisset rēx Cesareae contubernium Francōrum tam prope cīvitātem hospitātum esse, doluit animō, et iussit"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" illīs devetārī mercātum, nisi discēderent ā cīvitātis cōnfīniō."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="129415.643312102" OwnPage="309" ItemID="683883013" PTYPE="4" WIDTH="522" HEIGHT="170.140127388542" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 170.14 L0 170.14 L0 0 Z" copath="M0 0 L522 0 L522 170.14 L0 170.14 L0 0 Z" gXpos="136.001" gYpos="129415.643312102" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He left with bare feet."/>
                <ITEXT CH=" A likely meaning is that Raymond, eager to continue the pilgrimage to Jerusalem, left the city by leading his army walking barefoot, rather than on horse. He would have done this as a symbol of piety and to spur on the other Crusader princes to continue towards Jerusalem rather than staying and consolidating their winnings in Syria."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That he wanted to have peace with him (Raymond)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And that he would give money to him from his (treasury or revenues)."/>
                <ITEXT CH=" The king of Caesarea, not wanting war with the Crusader princes, offered to give to them money."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That, as far as his dominion contained, there would not be hindrance to the pilgrims."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And he ordered supplies to be denied to them, unless they left from the confines of the city."/>
                <ITEXT CH=" The king of Caesarea didn't want the Crusader army next to his city, so he withheld supplies until they left."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="129016.467" OwnPage="310" ItemID="687799797" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="129016.467" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

                <para PARENT="Vocab"/>
                <ITEXT CH="compulsī: having been compelled; plural masculine nominative perfect passive participle from compellō, compellere, compulī, compulsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cūr: why"/>

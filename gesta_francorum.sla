        <PAGEOBJECT XPOS="136.001" YPOS="66616.2419999999" OwnPage="159" ItemID="354544469" PTYPE="4" WIDTH="522" HEIGHT="272.216598726227" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 272.217 L0 272.217 L0 0 Z" copath="M0 0 L522 0 L522 272.217 L0 272.217 L0 0 Z" gXpos="136.001" gYpos="66616.2419999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Itaque Boamundus viam, quam tenuerant"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", nōn tenuit, sed celerius cum paucīs mīlitibus ad nōs vēnit, quī erāmus in ūnum congregātī. Tunc nōs accēnsī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" occīsiōne nostrōrum, Chrīstī nōmine invocātō, et Sānctī Sepulchrī cōnfīdentēs itinere, iūnctī simul pervēnimus contrā eōs ad bellum, eōsque invāsimus ūnō corde et animō. Stābant vērō inimīcī Deī et nostrī undique iam stupefactī et vehementer perterritī, putantēs nostrōs sē dēvincere"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" et occīdere, sīcut fēcerant gentem comitis et Boamundī. Sed Deus omnipotēns hoc illīs nōn permīsit. Mīlitēs igitur vērī Deī undique signō crucis armātī irruērunt ācriter super illōs et fortiter invāsērunt; illī autem celeriter fūgērunt, per medium angustī pontis ad illōrum introitum."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="66888.4585987261" OwnPage="159" ItemID="354847237" PTYPE="4" WIDTH="522" HEIGHT="88.9681528662477" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 88.9682 L0 88.9682 L0 0 Z" copath="M0 0 L522 0 L522 88.9682 L0 88.9682 L0 0 Z" gXpos="136.001" gYpos="66888.4585987261" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Therefore Bohemond didn't stay on the path that he had stayed on, but more quickly with a few soldiers came to us, who had been gathered together."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Then having been aroused by our killing, and the name of Christ having been invoked, and confident in the journey of the Holy Sepulchre."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Thinking us to be conquered and killed."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="66616.2419999999" OwnPage="160" ItemID="357816981" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="66616.2419999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="accēnsī: having been enkindled, stirred up; plural masculine nominative perfect passive participle from accendō, accendere, accendī, accēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ācriter: sharply"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="angustī: narrow; singular masculine genitive from angustus, angusta -um, angustior -or -us, angustissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="animō: soul, mind, live; singular masculine ablative from animus, animi"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="armātī: having been armed; plural masculine nominative perfect passive participle from armō, armāre, armāvī, armātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bellum: battle; singular neuter accusative from bellum, bellī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundī: of Bohemond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundus: Bohemond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="celeriter: quickly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="celerius: quicker; singular neuter nominative from celer, celeris -e, celerior -or -us, celerrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstī: of Christ; singular masculine genitive from Chrīstus, Chrīstī"/>
                <para PARENT="Vocab"/>

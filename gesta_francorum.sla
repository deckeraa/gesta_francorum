        <PAGEOBJECT XPOS="136.001" YPOS="19192.071" OwnPage="45" ItemID="131293461" PTYPE="4" WIDTH="522" HEIGHT="229.126452229295" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 229.126 L0 229.126 L0 0 Z" copath="M0 0 L522 0 L522 229.126 L0 229.126 L0 0 Z" gXpos="136.001" gYpos="19192.071" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Ad ultimum quid factūrī erunt? Dīcent quoniam necessitāte compulsī, nōlentēs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" volentēsque, humiliāvērunt sē ad nēquissimī imperātōris voluntātem. Fortissimō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" autem virō Boamundō, quem valdē timēbat, quia ōlim"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" eum saepe cum suō exercitū ēiēcerat dē campō, dīxit, &quot;Quoniam"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" sī libenter eī iūrāret, quīndecim diēs eundī terrae in extēnsiōne ab Antiochīā retrō daret, et octo in lātitūdine; eīque tālī modō iūrāvit, ut, sī ille fidēliter tenēret illud sacrāmentum, iste suum nunquam preterīret.&quot; Tam fortēs et tam dūrī mīlitēs, cūr hoc fēcērunt? Proptereā igitur, quia multa coāctī erant necessitāte."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="19422.1146496815" OwnPage="45" ItemID="131533413" PTYPE="4" WIDTH="522" HEIGHT="156.956350318476" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 156.956 L0 156.956 L0 0 Z" copath="M0 0 L522 0 L522 156.956 L0 156.956 L0 0 Z" gXpos="136.001" gYpos="19422.1146496815" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They will say after (that they) were compelled by necessity, unwillingly or willingly, they humbled themselves to the very wicked emperor's will."/>
                <ITEXT CH=" "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="nōlēns volēnsque"/>
                <ITEXT CH=" is a Latin idiom meaning 'willing or unwilling'."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="To the very strong man Bohemond (... he said)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Because some time ago he had oftern thrown him with his army out of the field."/>
                <ITEXT CH=" This refers to Bohemond's military victories over the Byzantine emperor Alexius during campaigns in Albania 1081-1084."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Book" FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For now, if he (Bohemond) would freely swear and oath to him (the Byzantine Emperor Alexius), he (Alexius) would give (to Bohemond) 15 days' journey in breadth from Antioch and 8 (days' journey) in latitude; an he swore such an oath to him, that if he faithfully held to his oath, this (land) would never pass away from him."/>
                <ITEXT CH=" This is an indirect quote in which Alexius promises Bohemond a fief of considerable size around Antioch; however, Hagenmeyer in his footnotes doubts the veracity of this."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="19192.071" OwnPage="46" ItemID="133592149" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="19192.071" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ab: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>

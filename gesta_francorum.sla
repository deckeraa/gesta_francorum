                <ITEXT CH="ēiēcērunt: they cast out; 3rd person plural perfect active from ēiciō, ēicere, ēiēcī, ēiectus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eiicere: to cast out; present active infinitive from ejicio, ejicere, ejeci, ejectus"/>
                <para PARENT="Vocab"/>

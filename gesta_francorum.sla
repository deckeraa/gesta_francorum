                <para PARENT="Vocab"/>
                <ITEXT CH="laetī: happy; plural masculine nominative from laetus, laeta -um, laetior -or -us, laetissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="legendae: reading; plural feminine nominative future passive participle from legō, legere, lēgī, lēctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="libenter: willingly, gladly, freely"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="luxuriam: luxury; singular feminine accusative from luxuria, luxuriae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīlitī: soldier; singular masculine dative from mīles, mīlitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mīlitibus: soldiers; plural masculine dative from mīles, mīlitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="modo: now"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mox: soon"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="multōsque: and many; plural masculine accusative from multus, multa -um, -, plūrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōs: us; plural accusative of ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostra: our; plural feminine accusative from noster, nostra, nostrum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrī: our; singular masculine dative from noster"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrō: our"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="notārium: stenographer, person who writes down another's dictation; singular masculine accusative from notarius, notariī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ōlim: one day, once upon a time"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnibus: all; plural dative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnīnō: entirely, altogether"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="optima: best; plural neuter nominative from bonus, bona -um, melior -or -us, optimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="patrāre: to accomplish; present active infinitive from patrō, patrāre, patrāvī, patrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="perfecta: perfect; plural neuter nominative from perfectus, -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="petulantiam: impudence, freakishness, carelessness; singular feminine accusative from petulantia, petulantiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="plūrēs: more; plural common accusative from plus, (gen.), pluris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="praevaleant: they might prevail; 3rd person plural present active subjunctive from praevaleo, praevalere, praevalui, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prūdentissimīs: very prudent, competent; plural dative from prūdēns, prūdentis (gen.), prūdentior -or -us, prūdentissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pugnāre: to fight; present active infinitive from pugnō, pugnāre, pugnāvī, pugnātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pūrgāta: having been cleansed; plural neuter nominative perfect passive participle from pūrgō, pūrgāre, pūrgāvī, pūrgātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pūrissimum: very clean, pure; singular neuter nominative from pūrus, pūra -um, pūrior -or -us, pūrissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quae: which; plural neuter nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quāliter: how, what kind?"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quattuor: 4"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; plural masculine nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rēgī: king; singular masculine dative from rēx, rēgis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="regiōnem: region; singular feminine accusative from regiō, regiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="salūs: health, soundness; singular feminine nominative from salūs, salūtis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="satis: enough"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="satisfaciant: they might satisfy; 3rd person plural present active subjunctive from satisfaciō, satisfacere, satisfēcī, satisfactus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="scrībe: write!; 2nd person singular present active imperative from scrībō, scrībere, scrīpsī, scrīptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sermōcinent: they might converse, discuss; 3rd person plural subjunctive present variant spelling from sermōcinor, sermōcinārī, sermōcinātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sēsē: themselves"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sint: they (might) be; 3rd person plural present active subjunctive from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sīve: or"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="soldānō: to the Sultan; singular masculine dative variant spelling from soldanus, soldanī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sunt: they are; 3rd person plural present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="super: above, on top of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suscipiant: they might undertake; 3rd person plural present active subjunctive from suscipiō, suscipere, suscēpī, susceptus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suum: his; singular masculine accusative from suus, sui"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ter: three times"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tria: three"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="turmā: troop, group, crowd; singular feminine ablative from turma, turmae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūniversam: whole, entire; singular feminine accusative from ūniversus, ūniversa, ūniversum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ventribus: bellies, abdomens; plural masculine dative from venter, ventris"/>

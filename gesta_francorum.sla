                <para PARENT="Vocab"/>
                <ITEXT CH="nōmine: name; singular neuter ablative from nōmen, nōminis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōn: not"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōs: us; plural accusative of ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nucem: nut; singular feminine accusative from nux, nucis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnia: all, every; plural neuter nominative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnium: of all; plural genitive from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ōvum: egg; singular neuter accusative from ōvum, ōvī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pānis: bread; singular masculine nominative from panis, panis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="parvus: small; singular masculine nominative from parvus, parva -um, minor -or -us, minimus -a -um"/>
                <para PARENT="Vocab"/>

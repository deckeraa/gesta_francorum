        <PAGEOBJECT XPOS="136.001" YPOS="59128.2149999999" OwnPage="141" ItemID="318615573" PTYPE="4" WIDTH="522" HEIGHT="390.562070063774" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 390.562 L0 390.562 L0 0 Z" copath="M0 0 L522 0 L522 390.562 L0 390.562 L0 0 Z" gXpos="136.001" gYpos="59128.2149999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Sērō autem factō, exiit ē tentōriīs vir prūdēns Boamundus cum aliīs prūdentissimīs mīlitibus, īvitque iacēre inter flūmen et lacum. Summō dīlūculō iussit prōtinus explōrātōrēs exīre et vidēre quot"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" sunt Turcōrum turmae, et ubi sint, aut certē quid agant. Exiērunt illī, coepēruntque subtīliter inquīrere, ubi essent"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" aciēs Turcōrum reconditae. Vīdērunt tandem Turcōs innumerābilēs sēgregātōs"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" venīre ex parte flūminis dīvīsōs per duās aciēs; maxima vērō virtūs illōrum veniēbat retrō. Reversī sunt namque celeriter speculātōrēs, dīcentēs: &quot;Ecce, ecce, veniunt! Igitur ēstote omnēs parātī, quia iam prope nōs sunt.&quot;"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Dīxitque vir sapiēns Boamundus aliīs: &quot;Seniōrēs et invictissimī mīlitēs, ōrdinātē adinvicem bellum.&quot; Respondēruntque illī: &quot;Tū sapiēns et prūdēns, tū magnus et magnificus, tū fortis et victor, tū bellōrum arbiter et certāminum iūdex, hoc tōtum fac"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH="; hoc tōtum super tē sit! Omne bonum quod tibi vidētur, nōbīs et tibi operāre et fac!&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="59518.7770700637" OwnPage="141" ItemID="319317253" PTYPE="4" WIDTH="522" HEIGHT="90.343949044589" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 90.3439 L0 90.3439 L0 0 Z" copath="M0 0 L522 0 L522 90.3439 L0 90.3439 L0 0 Z" gXpos="136.001" gYpos="59518.7770700637" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="To see how many were the troops of the Turks, and where they might be, or certainly what they might be doing."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Where the battle lines of the Turks might have been placed/hidden."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Then they saw the innumerable Turks, having been separated to come over the part of the river, having been divided into two battle lines."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Do this all, let all this be regarding you!"/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

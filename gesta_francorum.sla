        <PAGEOBJECT XPOS="136.001" YPOS="118200.428" OwnPage="283" ItemID="632286517" PTYPE="4" WIDTH="522" HEIGHT="206.094292993934" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 206.094 L0 206.094 L0 0 Z" copath="M0 0 L522 0 L522 206.094 L0 206.094 L0 0 Z" gXpos="136.001" gYpos="118200.428" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Unde magna angustia et trībulātiō immēnsusque dolor fuit in tōtā Chrīstī mīlitiā, quia ille erat sustentāmentum"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" pauperum, cōnsilium dīvitum, ipseque ōrdinābat clēricōs, praedicābat et summonēbat mīlitēs dīcēns: &quot;Quia nēmō ex vōbīs salvārī potest, nisi honōrificet"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" pauperēs et reficiat, vōsque nōn potestis salvārī sine illīs, ipsīque"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" vīvere nequeunt sine vōbīs. Oportet igitur ut ipsī cotīdiānā supplicātiōne prō vestrīs ōrent"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" dēlictīs Deum, quem in multīs cotīdiē offenditis. Unde vōs rogō ut prō Deī amōre eōs dīligātis"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" et in quantum potestis eōs sustentētis.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="118406.522292994" OwnPage="283" ItemID="632474213" PTYPE="4" WIDTH="522" HEIGHT="90.9057070057024" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 90.9057 L0 90.9057 L0 0 Z" copath="M0 0 L522 0 L522 90.9057 L0 90.9057 L0 0 Z" gXpos="136.001" gYpos="118406.522292994" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He was (giving) the sustenance of the poor, divine plans, and he himself was ordaining "/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit" CH="clerics."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That no one of you can be saved, unless he might honor and refresh the poor."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And they themselves are not able to live without you."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="They should pray to God for your sins."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="From whence I pray that, for the love of God, you might love them (the poor) and you might sustain them as much as you are able."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="118200.428" OwnPage="284" ItemID="634850629" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="118200.428" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="amōre: with love; singular masculine ablative from amor, amōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="angustia: small space, narrow passage, being boxed in; singular feminine nominative from angustia, angustiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstī: of Christ; singular masculine genitive from Chrīstus, Chrīstī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="clēricōs: clerics; plural masculine accusative from clēricus, clēricī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōnsilium: plan, advice, council; singular neuter accusative from consilium, consiliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cotīdiānā: every day; singular feminine ablative from cōtīdiānus, cōtīdiāna, cōtīdiānum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cotīdiē: daily"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Deī: of God; singular masculine genitive from Deus, Dei"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēlictīs: sins; singular neuter ablative from dēlictum, dēlictī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Deum: god; singular masculine accusative from Deus, Dei"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīcēns: saying; singular nominative present participle from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīligātis: you might love; 2nd person plural present subjunctive from dīligō, dīligere, dīlēxī, dīlēctus"/>

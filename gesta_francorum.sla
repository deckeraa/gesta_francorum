        <PAGEOBJECT XPOS="136.001" YPOS="9208.035" OwnPage="21" ItemID="82563397" PTYPE="4" WIDTH="522" HEIGHT="323.48092356688" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 323.481 L0 323.481 L0 0 Z" copath="M0 0 L522 0 L522 323.481 L0 323.481 L0 0 Z" gXpos="136.001" gYpos="9208.035" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Secunda vērō pars intrāvit in Sclaviniae partēs, scīlicet comes dē Sānctō Egidīō Raimundus et Podiēnsis epīscopus. Tertia autem pars per antīquam Rōmae viam vēnit. In hāc parte fuērunt Boamundus, et Richardus dē Prīncipātū, Rotbertus comes Flandrēnsis, Rotbertus Nortmannus, Hugō Magnus, Eurardus dē Puisātiō, Achardus dē Monte Merloi, Isuardus dē Musōne, et aliī plūrēs. Deinde vēnērunt ad portum Brandosim aut Bārim sīve Otrentum. Hugō dēnique Magnus et Willelmus Marchīsī fīlius intrāvērunt mare ad portum Bārī, et trānsfretantēs vēnērunt Durachium. Audiēns vērō dux"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" illīus locī hōs prūdentissimōs virōs illīc esse applicātōs, mox mala cōgitātiō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" cor eius tetigit, illōsque apprehendit, ac iussit Cōnstantīnopolim imperātōrī cautē dūcī, quō eī fidēlitātem facerent."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="9531.51592356688" OwnPage="21" ItemID="82917237" PTYPE="4" WIDTH="522" HEIGHT="77.9617834394921" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 77.9618 L0 77.9618 L0 0 Z" copath="M0 0 L522 0 L522 77.9618 L0 77.9618 L0 0 Z" gXpos="136.001" gYpos="9531.51592356688" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And the leader of that place hearing these most prudent men to have landed."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Soon an evil thought touched his heart, and he apprehended them, and ordered them to be lead cautiously to the emperor in Constantinople, to whom they might swear (make) fidelity. "/>
                <ITEXT FONT="DejaVu Serif Book" CH="The leader mentioned here was John Komnenos, governor of Dyrrhachium."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

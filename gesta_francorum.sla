        <PAGEOBJECT XPOS="136.001" YPOS="28344.104" OwnPage="67" ItemID="169078069" PTYPE="4" WIDTH="522" HEIGHT="348.125299363048" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 348.125 L0 348.125 L0 0 Z" copath="M0 0 L522 0 L522 348.125 L0 348.125 L0 0 Z" gXpos="136.001" gYpos="28344.104" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Videntēs autem Turcī, quod nullātenus ex suīs exercitibus adiūtōrium habēre possent, lēgātiōnem mandāvērunt imperātōrī, quia cīvitātem sponte"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" redderent, sī eōs omnimodō abīre permitteret cum mulieribus et fīliīs et omnibus substantiīs suīs. Tunc imperātor, plēnus vānā et inīquā cōgitātiōne, iussit illōs impūnītōs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" abīre sine ūllō timōre, ac sibi eōs Cōnstantīnopolim cum magnā fīdūciā addūcī. Quōs studiōsē servābat"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=", ut illōs ad Francōrum nocumenta et obstācula parātōs habēret."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Fuimusque in obsidiōne illā per septem ebdomadās et trēs diēs, et multī ex nostrīs illīc recēpērunt martyrium, et laetantēs gaudentēsque reddidērunt felicēs animās Deō; et ex pauperrimā gente multī mortuī sunt famē prō Chrīstī nōmine, quī in caelum triumphantēs portāvērunt stolam receptī martyriī, ūnā vōce dīcentēs: 'Vindicā, Domine, sanguinem nostrum, quī prō tē effūsus est, quī es benedictus et laudābilis in saecula saeculōrum. Āmēn.'"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="28692.2292993631" OwnPage="67" ItemID="168593269" PTYPE="4" WIDTH="522" HEIGHT="92.8747006369522" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 92.8747 L0 92.8747 L0 0 Z" copath="M0 0 L522 0 L522 92.8747 L0 92.8747 L0 0 Z" gXpos="136.001" gYpos="28692.2292993631" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That they would willingly return the city (to the emperor)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He ordered those (Turks in Nicea) to leave (the city) without any fear, and led them to Constantinople with great confidence."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which he was carefully guarding, that he might be ready with them to the harm and detriment of the Franks. "/>
                <ITEXT CH="The author believed that Alexius had negotiated a peace with the Turks in Nicea behind his back and that the lenient terms of the peace deal would lead to the crusader's harm."/>
                <para PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="28344.104" OwnPage="68" ItemID="175441557" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="28344.104" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>

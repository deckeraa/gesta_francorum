            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="25016.092" OwnPage="59" ItemID="153434805" PTYPE="4" WIDTH="522" HEIGHT="261" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 261 L0 261 L0 0 Z" copath="M0 0 L522 0 L522 261 L0 261 L0 0 Z" gXpos="136.001" gYpos="25016.092" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Quī comes, veniēns ex aliā parte, prōtēctus dīvīnā virtūte ac terrēnīs fulgēbat"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" armīs cum suō fortissimō exercitū. Hic itaque invēnit"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" contrā nōs venientēs Turcōs. Quī undique signō"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" crucis armātus, vehementer irruit super illōs atque superāvit. Dedēruntque fugam, et fuit mortua maxima pars illōrum. Quī"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" rūrsus vēnērunt auxiliō aliōrum gaudentēs et exultantēs ad certum bellum, trahentēs sēcum fūnēs, quibus nōs ligātōs dūcerent Corosānum. Venientēs autem laetantēs, coepērunt ex cacūmine montīs paulātim dēscendere. Quotquot"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" dēscendērunt, illīc caesīs capitibus ā manibus nostrōrum remānsērunt. Prōiciēbant"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" autem nostrī capita occīsōrum fundā in urbem, ut inde Turcī magis terrērentur."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="25277.5031847134" OwnPage="59" ItemID="153768021" PTYPE="4" WIDTH="522" HEIGHT="194.904458598725" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 194.904 L0 194.904 L0 0 Z" copath="M0 0 L522 0 L522 194.904 L0 194.904 L0 0 Z" gXpos="136.001" gYpos="25277.5031847134" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Having been protected by divine virtue and flashing forth with earthly arms with his very strong army."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="This one (the Count) there came in (to battle) against the coming Turks."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who, having been armed all around with the sign of the cross."/>
                <ITEXT CH=" This may refer to the Count having crosses on his military attire, or it may refer to him making the sign of the cross in four different directions. For an instance of the latter, see the "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Nāvigātiō Sānctī Brendānī Abbātis"/>
                <ITEXT CH=", Caput 23 (page 218 in my edition): "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Hīs audītis, venerābilis pater armāvit sē Dominicō trophaeō in quattuor partēs, dīcēns: “Domine Iēsu Chrīste, līberā nōs dē hāc īnsulā!”"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who again came to the aid of the others, being gladd and rejoicing at (what they thought would be the) certain battle, carrying with them ropes, with which they might bring us tied to Khorasan"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="However many descended, they remained there, having been slaughtered by decapitation by our hands"/>
                <ITEXT CH=". That "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="capitibus"/>
                <ITEXT CH=" means decapitation in this context is made clear by the next line."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Our (soldiers) therefore were throwing the heads of the slaughtered (enemies) with a sling into the city, so that from this the Turks might be more terrified."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="25016.092" OwnPage="60" ItemID="156666917" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="25016.092" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliā: other; singular feminine ablative from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliōrum: of others; plural masculine genitive from alius, alia, aliud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="armātus: having been armed; singular masculine nominative perfect passive participle from armō, armāre, armāvī, armātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="armīs: weapons; plural neuter ablative from armum, armī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="atque: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="auxiliō: help, aid; singular neuter dative from auxilium, auxiliī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bellum: battle, war; singular neuter accusative from bellum, bellī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cacūmine: peak, extremity; singular neuter ablative from cacūmen, cacūminis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="caesīs: slaughter; plural ablative perfect passive participle from caedo, caedere, caecidi, caesus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="capita: head; plural neuter accusative from caput, capitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="capitibus: heads; plural neuter ablative from caput, capitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="certum: certain; singular neuter accusative from certus, certa -um, certior -or -us, certissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="coepērunt: they started; 3rd person plural perfect from coepī, coepisse, coepī, coeptum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="comes: Count; singular common nominative from comes, comitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="contrā: against, away from, facing"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Corosānum: Khorasan, a region in modern-day Iran"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="crucis: of the cross; singular feminine genitive from crux, crucis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dedērunt: they gave; 3rd person plural perfect active from dō, dare, dedī, datus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēscendere: to descend; present active infinitive from dēscendō, dēscendere, dēscendī, dēscēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēscendērunt: they descended; 3rd person plural perfect active from dēscendō, dēscendere, dēscendī, dēscēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīvīnā: divine; singular feminine ablative from dīvīnus, dīvīna -um, dīvīnior -or -us, dīvīnissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dūcerent: they might lead; 3rd person plural imperfect active subjunctive from dūcō, dūcere, dūxī, ductus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ex: out of, from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="exercitū: army; singular neuter ablative from exerceo, exercere, exercui, exercitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="exultantēs: exulting; plural common nominative present participle from exultō, exultāre, exultāvī, exultātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fortissimō: very strong; singular masculine ablative from fortis, forte, fortior -or -us, fortissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fugam: flight, escape; singular feminine accusative from fuga, fugae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fuit: fuit mortua: it (the maxima pars) had died; 3rd person singular perfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fulgēbat: it was flashing, shining, glowing; 3rd person singular imperfect active from fulgeō, fulgēre, fulsī, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fundā: by sling; singular feminine ablative from funda, fundae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fūnēs: ropes; plural masculine accusative from fūnis, fūnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gaudentēs: rejoicing; plural common nominative present participle from gaudeō, gaudēre, gavīsus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hic: this; singular masculine nominative of hic, haec, hoc"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illīc: there"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illōrum: of them; plural masculine or neuter genitive from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illōs: those (Turks); plural masculine accusative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="inde: from there, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="invēnit: he came upon; 3rd person singular present active from inveniō, invenīre, invēnī, inventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="irruit: he rushed; 3rd person singular perfect active from irruō, irruere, irruī, irrutus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="itaque: so then, therefore"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="laetantēs: rejoicing; plural masculine accusative present participle from laetō, laetāre, laetāvī, laetātum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ligātōs: having been tied, bound; plural masculine accusative perfect passive participle from ligō, ligāre, ligāvī, ligātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="magis: rather, more"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="manibus: hands; plural feminine ablative from manus, manūs"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="maxima: biggest; singular feminine nominative from māgnus, māgna -um, major -or -us, maximus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="montis: mountains; singular masculine genitive from mōns, montis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="mortua: dead; singular feminine nominative perfect participle from morior, morī, mortuus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nōs: us; plural nominative or accusative of ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrī: our; plural masculine nominative from noster"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrōrum: our"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="occīsōrum: of those having been slain; plural masculine genitive past passive participle from occīdō, occīdere, occīdī, occīsum. Alternatively: of murderers; plural masculine genitive from occīsor, occīsōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pars: part; singular feminine nominative from pars, partis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="parte: part; singular feminine ablative from pars, partis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="paulātim: little by little"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prōiciēbant: they were throwing down; 3rd person plural imperfect active from proicio, proicere, projeci, projectus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prōtēctus: having been covered, protected; singular masculine nominative perfect passive participle from prōtegō, prōtegere, prōtēxī, prōtēctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; singular or plural masculine nominative of quis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quibus: with which; plural ablative of quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quotquot: however many"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="remānsērunt: they remained; 3rd person plural perfect active from remaneō, remanēre, remānsī, remānsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rūrsus: backwards, on the flipside"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sēcum: with oneself"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="signō: sign; singular neuter ablative from signum, signī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suō: his; singular dative or ablative of suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="super: above, on top of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="superāvit: he overcame; 3rd person singular perfect active from superō, superāre, superāvī, superātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terrēnīs: earthly; plural ablative from terrēnus, terrēna, terrēnum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terrērentur: they might be frightened; 3rd person plural imperfect passive subjunctive from terreō, terrēre, terruī, territus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="trahentēs: drawing, dragging; plural common nominative present participle from trahō, trahere, trāxī, tractus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcī: the Turks (nominative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcōs: the Turks (accusative case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="undique: from all sides"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="urbem: city; singular feminine accusative from urbs, urbis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vehementer: vehemently"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="vēnērunt: they came; 3rd person plural perfect active from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="veniēns: coming; singular nominative present participle from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="venientēs: coming; plural common nominative or accusative present participle from veniō, venīre, vēnī, ventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="virtūtē: virtue, power; singular feminine ablative from virtūs, virtūtis"/>
                <trail PARENT="Vocab"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="25848.095" OwnPage="61" ItemID="157149349" PTYPE="4" WIDTH="522" HEIGHT="228.287165605085" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 228.287 L0 228.287 L0 0 Z" copath="M0 0 L522 0 L522 228.287 L0 228.287 L0 0 Z" gXpos="136.001" gYpos="25848.095" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Dēnique comes sānctī Egidīī et epīscopus Podiēnsis cōnsiliātī sunt in ūnum, quāliter facerent suffodī quamdam turrim, quae erat ante tentōria eōrum. Ōrdinātī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" sunt hominēs quī hanc suffodiant, et arbalistae et sagittāriī, quī eōs undique dēfendant. Fōdērunt namque illam usque ad rādīcēs mūrī, submīsēruntque postēs et ligna, ac deinde mīsērunt ignem. Sērō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" autem factō, cecidit turris iam in nocte, sed quia nox erat, nōn potuērunt proelīārī cum illīs. Nocte vērō illa surrēxērunt festīnanter Turcī, et restaurāvērunt"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" mūrum tam fortiter, ut, veniente diē, nēmō posset eōs laedere ex illā parte."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="26077.2993630573" OwnPage="61" ItemID="157861429" PTYPE="4" WIDTH="522" HEIGHT="113.273885350322" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 113.274 L0 113.274 L0 0 Z" copath="M0 0 L522 0 L522 113.274 L0 113.274 L0 0 Z" gXpos="136.001" gYpos="26077.2993630573" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Men were organized that might undermine this (the tower) and crossbowmen and archers, who might defend them from all sides. Hagenmeyer notes that a testudo (tortoise) formation was used, in which shields were placed closely together to protect those digging from enemy attacks, even from above."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="It having become late, however, the tower now fell in the night, but because it was night, (the crusaders) couldn't fight with them (the Turks in Nicea)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH="The Turks repaired the breached part of the wall well enough during the night so that the crusaders could not easily enter the city through it."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="25848.095" OwnPage="62" ItemID="161312917" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="25848.095" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ad: to, towards, at, according to"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ante: before, in front, forwards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="arbalistae: crossbowmen; plural feminine nominative from arbalista, arbalistae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="autem: but, however, moreover"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cecidit: it fell; 3rd person singular perfect active from cadō, cadere, cecidī, cāsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="comes: comes Sānctī Egidīī = of Raymond of Saint-Gilles; singular common nominative from comes, comitis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōnsiliātī: cōnsiliātī sunt = they consulted; plural masculine nominative perfect participle from cōnsilior, cōnsiliārī, cōnsiliātum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēfendant: they might defend; 3rd person plural present active subjunctive from dēfendō, dēfendere, dēfendī, dēfēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="deinde: after"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēnique: finally"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="diē: day; singular common ablative from diēs, diēī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Egidīī: Egidīī: comes dē Sānctō Egidīō = Raymond of Saint-Gilles"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eōrum: their; plural neuter genitive"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eōs: to them; plural masculine accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="episcopus: bishop; singular masculine nominative from episcopus, episcopī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erat: he was; 3rd person singular imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ex: out of, from"/>
                <para PARENT="Vocab"/>

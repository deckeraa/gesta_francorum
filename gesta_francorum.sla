        <PAGEOBJECT XPOS="136.001" YPOS="134008.485" OwnPage="321" ItemID="707523797" PTYPE="4" WIDTH="522" HEIGHT="239.871687898441" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 239.872 L0 239.872 L0 0 Z" copath="M0 0 L522 0 L522 239.872 L0 239.872 L0 0 Z" gXpos="136.001" gYpos="134008.485" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Sērō autem iam factō, sēcessērunt in quemdam angulum ibique hospitātī sunt, fēcēruntque innumerābilēs īgnēs, quasi tōta hostis esset ibi. Pāgānī vērō timōre perterritī nocte latenter fūgērunt, et dīmīsērunt cīvitātem plēnam omnibus bonīs, quae etiam valdē optimum portum secus mare in sē retinet. Crāstinā autem diē vēnērunt nostrī, ut undique invāderent illam, invēnēruntque illam vacuam et intrantēs habitāvērunt in eā ūsque dum obsessiō esset ante urbem Archae."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Est prope istam alia urbs, quae dīcitur Maraclea. Admiralīus, quī eam regēbat, pactus est cum nostrīs, et mīsit nostrōs in cīvitātem nostraque vexilla"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH="."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="134248.356687898" OwnPage="321" ItemID="707694389" PTYPE="4" WIDTH="522" HEIGHT="54.420382165612" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 54.4204 L0 54.4204 L0 0 Z" copath="M0 0 L522 0 L522 54.4204 L0 54.4204 L0 0 Z" gXpos="136.001" gYpos="134248.356687898" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH="The emir put the Crusader flags in the city to show his surrender."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

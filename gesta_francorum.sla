                <para PARENT="Vocab"/>
                <ITEXT CH="ferre: to bring, to bear; present active infinitive from ferō, ferre, tulī, lātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="forsitan: maybe"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hīs: these; plural masculine ablative of hic, haec, hoc"/>
                <para PARENT="Vocab"/>

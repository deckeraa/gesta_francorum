                <para PARENT="Vocab"/>
                <ITEXT CH="nōs: we; plural nominative from ego"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrīs: our"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nostrōs: our"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnem: all, every; singular common accusative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnēs: all, every; plural common nominative or accusative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnia: all, every; plural neuter accusative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnibus: all; plural ablative from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="omnium: of all; plural genitive from omnis, omnis, omne"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="pārentēs: parents; plural masculine accusative from pārentēs, pārentium (which only has plural forms)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="per: through"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="praesentiam: prescence; singular feminine accusative from praesentia, praesentiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prōpulsāre: to drive back, repel, avert; present active infinitive from prōpulsō, prōpulsāre, prōpulsāvī, prōpulsātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; plural masculine nominative from quī"/>

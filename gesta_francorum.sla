        <PAGEOBJECT XPOS="136.001" YPOS="53304.1939999999" OwnPage="127" ItemID="288876357" PTYPE="4" WIDTH="522" HEIGHT="400.009821656109" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 400.01 L0 400.01 L0 0 Z" copath="M0 0 L522 0 L522 400.01 L0 400.01 L0 0 Z" gXpos="136.001" gYpos="53304.1939999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Liber 6"/>
                <para PARENT="Chapter Heading"/>
                <para PARENT="Chapter Heading"/>
                <tab/>
                <ITEXT CH="Turcī dēnique, inimīcī Deī et sānctae Chrīstiānitātis, quī erant intus in cūstōdiā cīvitātis Antiochīae, audientēs dominum Boamundum et Flandrēnsem comitem in obsessiōne nōn esse, exiērunt dē cīvitāte, et audācter veniēbant proeliārī nōbīscum, īnsidiantēs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" undique in quā parte obsidiō esset languidior, scientēs prūdentissimōs mīlitēs forīs esse; invēnēruntque"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" quod in ūnā Martis diē possent obsistere nōbīs et laedere."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Vēnērunt vērō inīquissimī barbarī caute, et irruērunt vehementer super nōs, et incautōs occīdērunt multōs ex nostrīs mīlitibus et peditibus. Epīscopus quoque Podiēnsis in illā amārā diē perdidit suum senescalcum, condūcentem et regentem eius vēxillum. Et nisi esset"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" flūmen quod erat inter nōs et illōs, saepius invāsissent nōs atque maximam lesiōnem fēcissent in nostram gentem."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="53704.2038216561" OwnPage="127" ItemID="289070757" PTYPE="4" WIDTH="522" HEIGHT="72.9171974521887" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 72.9172 L0 72.9172 L0 0 Z" copath="M0 0 L522 0 L522 72.9172 L0 72.9172 L0 0 Z" gXpos="136.001" gYpos="53704.2038216561" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Plotting all around, in which part the siege might be weakest, knowing the most prudent soldiers to be away."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And they found that in a day of March they might be able to resist us and fight."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And if there hadn't been a river between us and them, they would have attacked us more often and have made a great injury to our people."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="53304.1939999999" OwnPage="128" ItemID="291516757" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="53304.1939999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

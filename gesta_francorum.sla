                <para PARENT="Vocab"/>
                <ITEXT CH="explōrārent: they might explore; 3rd person plural imperfect active subjunctive from explōrō, explōrāre, explōrāvī, explōrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fierent: it might be happen; 3rd person plural imperfect active subjunctive from fīō, fierī, factus sum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fortissimī: very strong; plural masculine nominative from fortis, forte, fortior -or -us, fortissimus -a -um"/>
                <para PARENT="Vocab"/>

                <para PARENT="Vocab"/>
                <ITEXT CH="ūnā: one; singular feminine ablative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnum: one; singular neuter nominative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>

                <para PARENT="Vocab"/>
                <ITEXT CH="ipsī: themselves; plural masculine nominative from ipse, ipsa, ipsum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ipsōs: themselves; plural masculine accusative from ipse, ipsa, ipsum"/>

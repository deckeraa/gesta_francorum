        <PAGEOBJECT XPOS="136.001" YPOS="65784.2389999999" OwnPage="157" ItemID="352116869" PTYPE="4" WIDTH="522" HEIGHT="238.385203821759" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 238.385 L0 238.385 L0 0 Z" copath="M0 0 L522 0 L522 238.385 L0 238.385 L0 0 Z" gXpos="136.001" gYpos="65784.2389999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Nam"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" tam ācriter invāsērunt nostrōs, ut illī inīrent"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" fugam per maximam montaneam et ubi via eundī patēbat; quī potuit celerī sē gressū"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" expedīre, ēvāsit vīvus, quī vērō fugere nequīvit, mortem suscēpit. Fuēruntque in illā diē martyrīzātī ex nostrīs mīlitibus seu peditibus plūs quam mīlle, quī, ut crēdimus, in caelum laetantēs ascendērunt atque candidātī ferentēs stolam receptī martyriī, glōrificantēs et magnificantēs Dominum Deum nostrum trīnum et ūnum, in quō fēlīciter triumphābant et dīcēbant"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" concordābilī vōce: &quot;Quārē nōn dēfendis sanguinem nostrum, quī hodiē prō tuō nōmine effūsus est?&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="66022.6242038217" OwnPage="157" ItemID="352221285" PTYPE="4" WIDTH="522" HEIGHT="129.32484076434" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 129.325 L0 129.325 L0 0 Z" copath="M0 0 L522 0 L522 129.325 L0 129.325 L0 0 Z" gXpos="136.001" gYpos="66022.6242038217" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For they attacked us so harshly."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That they (the Crusaders) took to flight through the very tall mountain and where a road of going laid open"/>
                <ITEXT CH=". For a smoother English translation of "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="via eundī"/>
                <ITEXT CH=", consider "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="passable road"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The one who could go out with quick step evaded death."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH="Likely inspired by Rev. 6:10 καὶ ἔκραξαν φωνῇ μεγάλῃ λέγοντες Ἕως πότε, ὁ Δεσπότης ὁ ἅγιος καὶ ἀληθινός, οὐ κρίνεις καὶ ἐκδικεῖς τὸ αἷμα ἡμῶν ἐκ τῶν κατοικούντων ἐπὶ τῆς γῆς; "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And they cried out with a loud voice saying &quot;How long, O Lord holy &amp; true, do you not judge and avenge our blood upon those dwelling upon the earth&quot;"/>
                <ITEXT CH="?"/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="65784.2389999999" OwnPage="158" ItemID="354068741" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="65784.2389999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>

        <PAGEOBJECT XPOS="136.001" YPOS="20024.074" OwnPage="47" ItemID="134150789" PTYPE="4" WIDTH="522" HEIGHT="140.970585987256" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 140.971 L0 140.971 L0 0 Z" copath="M0 0 L522 0 L522 140.971 L0 140.971 L0 0 Z" gXpos="136.001" gYpos="20024.074" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Imperātor quoque omnibus nostrīs fidem et sēcūritātem dedit, iūrāvit etiam 'quia"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" venīret nōbīscum pariter cum suō exercitū per terram et per mare; et nōbīs mercātum"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" terrā marīque fidēliter daret, ac omnia nostra perdita dīligenter restaurāret; īnsuper et nēminem nostrōrum peregrīnōrum conturbārī vel contrīstārī in viā Sānctī Sepulchrī vellet aut permitteret.'"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="20165.0445859873" OwnPage="47" ItemID="134624725" PTYPE="4" WIDTH="522" HEIGHT="156.029414012708" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 156.029 L0 156.029 L0 0 Z" copath="M0 0 L522 0 L522 156.029 L0 156.029 L0 0 Z" gXpos="136.001" gYpos="20165.0445859873" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That he might come with us together with his army through land and through sea; and to us would faithfully give supplies by land and sea, and would diligently restore to use all our lost things; furthermore he would wish or allow none of our pilgrims to be confused or saddened on the road to the Holy Sepulchre."/>
                <para PARENT="footnotes"/>
                <ITEXT CH="2This promise to provide supplies would become a point of contention after the Crusaders took Antioch. During the capture, the Crusaders had taken Antioch but then were immediately besieged by a Turkish relief army. Alexius had a relief army en route to help the Crusaders, but that army turned around after hearing a false report that the Crusaders had already been defeated. Thus, after the Crusaders successfully broke the siege on their own, Bohemond used this as evidence that Alexius had failed to uphold his part of the oath, and that therefore Antioch should stay under Bohemond's control rather than be returned to the emperor."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="20024.074" OwnPage="48" ItemID="137413429" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="20024.074" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>

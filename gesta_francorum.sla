        <PAGEOBJECT XPOS="136.001" YPOS="35832.131" OwnPage="85" ItemID="207479861" PTYPE="4" WIDTH="522" HEIGHT="227.945433121015" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 227.945 L0 227.945 L0 0 Z" copath="M0 0 L522 0 L522 227.945 L0 227.945 L0 0 Z" gXpos="136.001" gYpos="35832.131" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Vēritātem dīcam, quam nēmō audēbit prohibēre: Certē, sī in fidē Chrīstī et Chrīstiānitāte sānctā semper firmī fuissent"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", et ūnum Deum in trīnitāte cōnfitērī voluissent, Deīque Fīlium nātum dē Virgine mātre, passum, et resurgentem ā mortuīs et in caelum"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" suīs cernentibus discipulīs ascendentem, ac deinde cōnsōlātiōnem"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" Sānctī Spīritūs perfectē mittentem et eum in caelō et in terrā rēgnantem rēctā mente et fide crēdidissent, ipsīs"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" potentiōrēs vel fortiōrēs vel bellōrum ingeniōsissimōs nūllus invenīre potuisset: et tamen grātiā Deī vīctī sunt ā nostrīs. Hoc bellum est factum, prīmō"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" diē Iūliī."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="36063.076433121" OwnPage="85" ItemID="207806309" PTYPE="4" WIDTH="522" HEIGHT="111.649681528681" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 111.65 L0 111.65 L0 0 Z" copath="M0 0 L522 0 L522 111.65 L0 111.65 L0 0 Z" gXpos="136.001" gYpos="36063.076433121" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Certainly, if in the faith of Christ and in Holy Christendom they had always been firmly established, and had wanted to confess one God in Trinity."/>
                <ITEXT CH=" The author goes on to list several elements from the Apostle's Creed, the point being that if the Turks had been Christians they would have been the best fighters in the world."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And, having been seen by his disciples, ascending into heaven."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And thereafter finally sending the consolation of the Holy Spirit."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="No one could have found (soldiers) more powerful or stronger or more ingenious in battle than themselves."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH="July 1st, 1097."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

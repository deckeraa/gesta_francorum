        <PAGEOBJECT XPOS="136.001" YPOS="30008.11" OwnPage="71" ItemID="181267861" PTYPE="4" WIDTH="522" HEIGHT="230.055605095531" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 230.056 L0 230.056 L0 0 Z" copath="M0 0 L522 0 L522 230.056 L0 230.056 L0 0 Z" gXpos="136.001" gYpos="30008.11" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tertiā vērō diē irruērunt Turcī vehementer super Boamundum, et eōs quī cum ipsō erant. Continuō Turcī coepērunt strīdere et garrīre ac clāmāre, excelsā vōce dīcentēs diabolicum sonum, nesciō quōmodo, in suā linguā. Sapiēns vir Boamundus vidēns innumerābilēs Turcōs procul, strīdentēs et clāmantēs demoniacā vōce, prōtinus iussit omnēs mīlitēs dēscendere, et tentōria"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" celeriter extendere. Priusquam tentōria fuissent extēnsa, rūrsus dīxit omnibus mīlitibus: &quot;Seniōrēs et fortissimī mīlitēs Chrīstī, ecce modō bellum angustum est undique circā nōs. Igitur omnēs mīlitēs eant"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" virīliter obviam illīs, et peditēs prūdenter et citius extendant tentōria!&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="30238.1656050955" OwnPage="71" ItemID="181512485" PTYPE="4" WIDTH="522" HEIGHT="162.802547770698" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 162.803 L0 162.803 L0 0 Z" copath="M0 0 L522 0 L522 162.803 L0 162.803 L0 0 Z" gXpos="136.001" gYpos="30238.1656050955" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He forthwith ordered all the soldiers to descend (from their horses) and to quick set up camp. "/>
                <ITEXT CH="The phrase "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="extendere tentōria"/>
                <ITEXT CH=" is an idiomatic phrase for setting up a defensive military camp. Literally it means 'to extend the tents' but clearly the soldiers would be doing more important things, like digging ditches &amp; walls around their position."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Therefore let all soldiers go out manfully to them in the road, and let the foot soldiers prudently and quickly extend the tents! "/>
                <ITEXT FONT="DejaVu Serif Book" CH="The reason "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="eant"/>
                <ITEXT FONT="DejaVu Serif Book" CH=" and "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="extendant"/>
                <ITEXT FONT="DejaVu Serif Book" CH=" are subjunctive is that the iussive subjunctive is employed, which brings along the idea of 'let them...'."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="30008.11" OwnPage="72" ItemID="184530661" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="30008.11" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>

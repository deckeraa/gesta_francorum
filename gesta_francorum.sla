        <PAGEOBJECT XPOS="136.001" YPOS="30840.113" OwnPage="73" ItemID="184968949" PTYPE="4" WIDTH="522" HEIGHT="205.186363057328" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 205.186 L0 205.186 L0 0 Z" copath="M0 0 L522 0 L522 205.186 L0 205.186 L0 0 Z" gXpos="136.001" gYpos="30840.113" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Postquam"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vērō hoc tōtum factum est, Turcī undique iam erant circumcingentēs nōs, dīmicandō et iaculandō, ac spīculandō, et mīrābiliter"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" longē lātēque sagittandō. Nōs itaque quamquam nequīvimus"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" resistere illīs, neque sufferre pondus tantōrum hostium, tamen pertulimus illūc ūnanimiter gradum. Fēminae quoque nostrae in illā diē fuērunt nōbīs in maximō refugiō, quae afferēbant ad bibendum aquam nostrīs proeliātōribus, et forsitan semper cōnfortābant illōs, pugnantēs et dēfendentēs."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="31045.2993630573" OwnPage="73" ItemID="185278325" PTYPE="4" WIDTH="522" HEIGHT="62.5796178343953" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 62.5796 L0 62.5796 L0 0 Z" copath="M0 0 L522 0 L522 62.5796 L0 62.5796 L0 0 Z" gXpos="136.001" gYpos="31045.2993630573" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And after all this took place."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And shooting arrows (at us) over an astonishingly long and wide (area)."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="However, although we couldn't resist them, nor bear up the weight of such a numerous enemy, nevertheless we carried on there, unanimously in one position."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="30840.113" OwnPage="74" ItemID="188095429" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="30840.113" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

                <para PARENT="Vocab"/>
                <ITEXT CH="suīs: his (soldiers); plural ablative of suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="suō: his; singular ablative of suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tam: so"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Tancredī: of Tancred, Prince of Galilee (1075–1112) (genitive case)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terra: land; singular feminine nominative from terra, terrae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="terram: land; singular feminine accusative from terra, terrae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tōtam: whole, total; singular feminine accusative from tōtus, tōta, tōtum (gen -ius)"/>
                <para PARENT="Vocab"/>

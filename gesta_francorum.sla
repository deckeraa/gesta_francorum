                <ITEXT CH="suōs: their; plural accusative of suus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="superveniente: overcoming; singular ablative present participle from superveniō, supervenīre, supervēnī, superventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="timuērunt: they feared; 3rd person plural perfect active from timeō, timēre, timuī, -"/>
                <para PARENT="Vocab"/>

        <PAGEOBJECT XPOS="136.001" YPOS="94904.3439999998" OwnPage="227" ItemID="505847685" PTYPE="4" WIDTH="522" HEIGHT="211.324789809136" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 211.325 L0 211.325 L0 0 Z" copath="M0 0 L522 0 L522 211.325 L0 211.325 L0 0 Z" gXpos="136.001" gYpos="94904.3439999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Cōnsiliātī sunt omnēs maiōrēs nostrī in illā hōrā, ut iūrārent omnēs sacrāmentum, quod illōrum nūllus fugeret neque prō morte neque prō vītā, quamdiū vīvī essent. Prīmus dīcitur iūrāsse"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Boamundus, deinde comes Sānctī Egidīī, et Rotbertus Nortmannus ac dux Godefridus et comes Flandrēnsis. Tancredus vērō iūrāvit ac prōmīsit tālī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" modō, quia quamdiū sēcum quadrāgintā mīlitēs habēret, nōn sōlum ex illō bellō sed, etiam ab Hierosolymītānō itinere nōn esset recessūrus. Nimis autem exsultāvit Chrīstiāna congregātiō, hoc audiēns sacrāmentum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="95116.127388535" OwnPage="227" ItemID="506407589" PTYPE="4" WIDTH="522" HEIGHT="59.1592356688343" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 59.1592 L0 59.1592 L0 0 Z" copath="M0 0 L522 0 L522 59.1592 L0 59.1592 L0 0 Z" gXpos="136.001" gYpos="95116.127388535" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="First Bohemond is said to have sworn."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And Tancred swore (an oath) and promised in this manner: that as long as he had 40 soldiers with him, he would not withdraw, not only from this battle, but also from the journey to Jerusalem."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

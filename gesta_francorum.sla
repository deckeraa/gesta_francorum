        <PAGEOBJECT XPOS="136.001" YPOS="22520.083" OwnPage="53" ItemID="145080021" PTYPE="4" WIDTH="522" HEIGHT="203.483878980885" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 203.484 L0 203.484 L0 0 Z" copath="M0 0 L522 0 L522 203.484 L0 203.484 L0 0 Z" gXpos="136.001" gYpos="22520.083" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Vidēns vērō dux quod nūlla via pateret per quam posset condūcere hās gentēs usque Nicēnam cīvitātem, quoniam per illam viam, per quam prius aliī trānsierant, nōn posset modō tanta gens trānsīre, mīsit ante sē tria mīlia hominum cum secūribus et gladiīs, quī incīdissent et aperīrent hanc viam, quae patefacta"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" stāret nostrīs peregrīnīs usque Nicēnam urbem. Quae via fuit aperta per angustam et nimis immēnsam montānam, et faciēbant"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" retrō per viam crucēs ferreās ac ligneās, quās pōnēbant super stīpitēs, ut eās nostrī peregrīnī cognōscerent."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="22723.5668789809" OwnPage="53" ItemID="145180885" PTYPE="4" WIDTH="522" HEIGHT="63.2866242038217" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 63.2866 L0 63.2866 L0 0 Z" copath="M0 0 L522 0 L522 63.2866 L0 63.2866 L0 0 Z" gXpos="136.001" gYpos="22723.5668789809" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Which, having been laid open, might stand (as an easy route) for our pilgrims all the way to the city of Nicea."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And they (the crew of three thousand sent to construct the pathway) on their way back along the road were making iron and wooden crosses, which they were putting on posts, so that our pilgrims might recognize them (the paths to Nicea)."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

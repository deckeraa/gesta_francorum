        <PAGEOBJECT XPOS="136.001" YPOS="50808.185" OwnPage="121" ItemID="274808325" PTYPE="4" WIDTH="522" HEIGHT="411.789522293038" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 411.79 L0 411.79 L0 0 Z" copath="M0 0 L522 0 L522 411.79 L0 411.79 L0 0 Z" gXpos="136.001" gYpos="50808.185" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab FEATURES="inherit superscript"/>
                <ITEXT CH="Congregātī sunt itaque omnēs maiōrēs nostrī et ōrdināvērunt concilium dīcentēs: &quot;Faciāmus castrum in vertice montis Maregart, quī mons est super hostem Boamundi, quō sēcūrī atque tūtī possīmus permanere dē Turcōrum formīdine.&quot; Factō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" itaque castrō atque mūnītō, omnēs maiōrēs illud invicem cūstōdiēbant."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Iamiam coeperant frūmentum et omnia nūtrīmenta corporum nimis esse cāra ante Nātāle Dominī. Forās penitūs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" nōn audēbāmus exīre, nihilque penitus in terrā Chrīstiānōrum invenīre poterāmus ad edendum. In Saracēnōrum namque terrā nēmō intrāre audēbat nisi cum māgnā gente."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Ad ultimum statuērunt nostrī seniōrēs concilium, ōrdinandō"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" quāliter regerent tantās gentēs. Invēnērunt in cōnsiliō, ut ūna pars nostrī īret dīligenter attrahere stīpendium, et ubīque cūstōdīre exercitum; alia quoque pars fīdūciāliter remanēret cūstōdīre hostem. Boamundus dēnique dīxit: &quot;Seniōrēs et prūdentissimī mīlitēs, sī vultis"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" et honestum et bonum vōbīs vidētur, ego erō"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" cum Flandrensī comite, itūrus cum eō.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="50808.185" OwnPage="122" ItemID="275208549" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="50808.185" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">

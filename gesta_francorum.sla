                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstiānōs: Christians; plural masculine accusative from Chrīstiānus, Chrīstiānī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="collēgium: company, brotherhood, guild; singular neuter accusative from collegium, collegiī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="convertit: he converted; 3rd person singular present active from convertō, convertere, convertī, conversus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="crēdimus: we believe; 1st person plural present active from crēdō, crēdere, crēdidī, crēditus"/>
                <para PARENT="Vocab"/>

        <PAGEOBJECT XPOS="136.001" YPOS="49976.182" OwnPage="119" ItemID="270304149" PTYPE="4" WIDTH="522" HEIGHT="383.919910828074" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 383.92 L0 383.92 L0 0 Z" copath="M0 0 L522 0 L522 383.92 L0 383.92 L0 0 Z" gXpos="136.001" gYpos="49976.182" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Erat autem nōn longē castrum cui"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" nōmen Aregh, ubi erant congregātī multī Turcī fortissimī, quī frequenter conturbābant nostrōs. Audientēs itaque nostrī seniōrēs tālia, nimis doluērunt, mīsēruntque ex mīlitibus suīs quī dīligenter explōrārent"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" locum ubi erant Turcī. Repertō igitur locō ubi latēbant, nostrī mīlitēs quī quaerēbant illōs obviant eīs. At nostrīs paulātim retrogredientibus"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=", ubi sciēbant Boamundum esse cum suō exercitū, statim fuērunt illīc mortuī duo ex nostrīs. Hoc audiēns Boamundus surrēxit cum suīs ut fortissimus Chrīstī āthlētā, et barbarī irruērunt contrā illōs, eō quod nostrī erant paucī; tamen simul iūnctī iniērunt bellum. Mortuī sunt vērō multī ex nostrīs inimīcīs, et captī aliī ductī sunt ante portam urbis, ibique dēcollābantur, ut magis trīstēs fierent"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" quī erant in urbe."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Exībant quidem aliī dē cīvitāte et ascendēbant in quamdam portam, et sagittābant nōs, ita"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" ut sagittae eōrum caderent in dominī Boamundī platēam; et ūna mulier occubuit ictū sagittae."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="50360.101910828" OwnPage="119" ItemID="270699365" PTYPE="4" WIDTH="522" HEIGHT="149.044585987263" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 149.045 L0 149.045 L0 0 Z" copath="M0 0 L522 0 L522 149.045 L0 149.045 L0 0 Z" gXpos="136.001" gYpos="50360.101910828" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="There was, however, not afar a castle named Aregh."/>
                <ITEXT CH=" The dative of possession is used here with "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="cui"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who might diligently explore the place."/>
                <ITEXT CH=" The subjunctive is used to express intent."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And our (soldiers) were stepping backwards little by little, when they knew Bohemond to be with his army, suddenly two of our (soldiers) had been killed there."/>
                <ITEXT CH=" The scouting party was likely stepping backwards in a fearful retreat because they knew Bohemond was with his army and not with them."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that those who were in the city might become more sad."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that their arrows might fall into the camp of lord Bohemond; and one woman was slain by the stroke of an arrow."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="49976.182" OwnPage="120" ItemID="274156421" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="49976.182" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>

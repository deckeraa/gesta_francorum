        <PAGEOBJECT XPOS="136.001" YPOS="41656.152" OwnPage="99" ItemID="231758709" PTYPE="4" WIDTH="522" HEIGHT="201.988127388555" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 201.988 L0 201.988 L0 0 Z" copath="M0 0 L522 0 L522 201.988 L0 201.988 L0 0 Z" gXpos="136.001" gYpos="41656.152" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Ex aliā igitur parte vēnit vir inclitus comes Balduīnus cum suō exercitū, postulāns et deprecans Tancredum, acerrimum militem, quātinus"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" eum amīcissimē in societātem cīvitātis dignārētur suscipere. Cui ait Tancredus: &quot;Tē"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" omnimodō in hāc societāte dēnegō.&quot; Nocte itaque superveniente, omnēs Turcī tremefactī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" fugam ūnā arripuērunt. Exiērunt dēnique habitātōrēs cīvitātis sub illā noctis obscūritāte, clāmantēs excelsā vōce: &quot;Currite, invictissimī Francī, currite, quia Turcī"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" expergēfactī vestrō timōre omnēs pariter recēdunt.&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="41858.1401273885" OwnPage="99" ItemID="231950677" PTYPE="4" WIDTH="522" HEIGHT="81.6305732484034" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 81.6306 L0 81.6306 L0 0 Z" copath="M0 0 L522 0 L522 81.6306 L0 81.6306 L0 0 Z" gXpos="136.001" gYpos="41858.1401273885" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="How he (Tancred) might deign to receive him (Baldwin) into the society of the city."/>
                <ITEXT CH=" This line introduces a dispute amongst the Crusader princes about who would control Tarsus."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I refuse you altogether into this society."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="All the Turks, having been made to tremble, took to flight as one."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The Turks have been pushed out (of the city) by means of fear of you, all of them withdrawing together."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="41656.152" OwnPage="100" ItemID="234515925" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="41656.152" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>

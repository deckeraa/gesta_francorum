        <PAGEOBJECT XPOS="136.001" YPOS="72440.2629999999" OwnPage="173" ItemID="384750469" PTYPE="4" WIDTH="522" HEIGHT="276.526808917333" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 276.527 L0 276.527 L0 0 Z" copath="M0 0 L522 0 L522 276.527 L0 276.527 L0 0 Z" gXpos="136.001" gYpos="72440.2629999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Omnia quae ēgimus antequam urbs esset capta nequeō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" ēnārrāre, quia nēmō est in hīs partibus sīve clēricus sīve lāicus, quī omnīnō possit scrībere vel nārrāre, sīcut rēs gesta est. Tamen aliquantulum dīcam."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Erat quīdam ammirātus dē genere Turcōrum cui nōmen Pirus, quī maximam amīcitiam"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" recēperat cum Boamundō. Hunc saepe Boamundus pulsābat"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" nūntiīs adinvicem missīs, quō eum īnfrā cīvitātem amīcissimē reciperet; eīque chrīstiānitātem"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" līberius prōmittēbat et eum sē dīvitem factūrum cum multō honōre mandābat. Cōnsēnsit ille dictīs et prōmissiōnibus dīcēns: &quot;Trēs turrēs cūstōdiō, eīque libenter ipsās prōmittō, et quācunque hōrā voluerit in eās eum recolligam.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="72717.7070063694" OwnPage="173" ItemID="385085285" PTYPE="4" WIDTH="522" HEIGHT="147.668789808929" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 147.669 L0 147.669 L0 0 Z" copath="M0 0 L522 0 L522 147.669 L0 147.669 L0 0 Z" gXpos="136.001" gYpos="72717.7070063694" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I cannot narrate all the things which we did before the city was captured."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Who had received a very great friendship with Bohemond."/>
                <ITEXT CH=" Perhaps "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="alliance"/>
                <ITEXT CH=" might be a better gloss for "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="friendship"/>
                <ITEXT CH=" here in modern English."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Bohemond often came knocking for this one, messengers having been mutually sent."/>
                <ITEXT CH=" Here "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="pulsābat"/>
                <ITEXT CH=" is used in the sense of "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="pulsābat portam"/>
                <ITEXT CH=" ("/>
                <ITEXT FONT="DejaVu Serif Italic" CH="he was knocking on the door"/>
                <ITEXT CH="). Hagenmeyer states (p. 294, note 2) that here "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="pulsāre"/>
                <ITEXT CH=" means the same thing as "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="rogāre"/>
                <ITEXT CH=" or "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="examināre"/>
                <ITEXT CH="."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And to him he promised more free Christendom and he would command him to be made rich with much honor. "/>
                <ITEXT CH="Possibly "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Chrīstiānitātem līberius"/>
                <ITEXT CH=" means that Bohemond was telling Pirus that he would have more liberty under Christian rather than Muslim rule, though Hagenmeyer suggests (p. 294, note 3) that Pirus was converted to the Christian faith."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="72440.2629999999" OwnPage="174" ItemID="388535685" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="72440.2629999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="adinvicem: mutually, each other, reciprocally (Medieval Latin adverb from ad invicem)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aliquantulum: little, small; singular masculine accusative from aliquantulus, aliquantula, aliquantulum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="amīcissimē: friendly"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="amīcitiam: friendship; singular feminine accusative from amīcitia, amīcitiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ammirātus: emir, leader, admiral; loanword from Arabic"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="antequam: before"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundō: Bohemond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Boamundus: Bohemond"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="capta: esset capta = it was seized; singular feminine nominative perfect passive participle from capiō, capere, cēpī, captus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="chrīstiānitātem: Christianity, Christendom; singular feminine accusative from Christianitas, Christianitatis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cīvitātem: city; singular feminine accusative from cīvitās, cīvitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="clēricus: cleric; singular masculine nominative from clēricus, clēricī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cōnsēnsit: he was in agreement; 3rd person singular perfect active from cōnsentiō, cōnsentīre, cōnsēnsī, cōnsēnsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cui: to whom, cui nōmen Pirus = whose name is Pirus; singular dative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cum: with"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="custōdiō: I guard, watch over; 1st person singular present active from custōdiō, custōdīre, custōdīvī, custōdītus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dē: of, from, away from, down from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīcam: I will say; 1st person singular future active from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīcēns: saying; singular nominative present participle from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dictīs: with these saying; plural ablative perfect passive participle from dīcō, dīcere, dīxī, dictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dīvitēm: rich; singular common accusative from dīves, dīvitis (gen.), dīvitior -or -us, dīvitissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eās: them; plural feminine accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ēgimus: we did; 1st person plural perfect active from agō, agere, ēgī, āctus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eīque: to him; singular dative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ēnārrāre: to narrate, describe; present active infinitive from ēnārrō, ēnārrāre, ēnārrāvī, ēnārrātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erat: he was; 3rd person singular imperfect active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="esset: esset capta = it was captured; 3rd person singular imperfect active subjunctive from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="est: he is; 3rd person singular present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eum: to him; singular masculine accusative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="factūrum: making (in the future); singular masculine future gerund from faciō, facere, fēcī, factus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="genere: race, family, type, offspring; singular neuter ablative from genus, generis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="gesta: rēs gesta est = deeds were done"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hīs: these; plural masculine ablative of hic, haec, hoc"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="honore: honor; singular masculine ablative from honor, honōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hōrā: hour, time; singular feminine ablative from hōra, hōrae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="hunc: this; singular masculine accusative of hic, haec, hoc"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ille: that one; singular masculine nominative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="īnfrā: below"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ipsās: they themselves; plural feminine accusative from ipse, ipsa, ipsum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="lāicus: layman; singular masculine nominative from laicus, laici"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="libenter: willingly, gladly, freely"/>
                <para PARENT="Vocab"/>

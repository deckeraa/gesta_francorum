        <PAGEOBJECT XPOS="136.001" YPOS="26680.098" OwnPage="63" ItemID="161698885" PTYPE="4" WIDTH="522" HEIGHT="231.851044585976" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 231.851 L0 231.851 L0 0 Z" copath="M0 0 L522 0 L522 231.851 L0 231.851 L0 0 Z" gXpos="136.001" gYpos="26680.098" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Modō vēnit comes dē Nortmannīā, et comes Stephanus, et aliī plūrēs, ac deinceps Rogērius dē Barnavilla. Boamundus dēnique obsēdit urbem in prīmā fronte, et iuxtā eum Tancredus, et posteā dux Godefridus, ac deinde comes Flandrēnsis, iuxtā quem Rotbertus Nortmannus, et iuxtā eum comes Sānctī Egidīī, iuxtā quem Podiēnsis epīscopus. Ita vērō per terram"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" fuit obsessa, ut nēmō audēret exīre neque intrāre; fuēruntque ibi omnēs congregātī in ūnum. Et quis poterat numerāre tantam Chrīstī mīlitiam? Nūllus, ut putō, tot prūdentissimōs mīlitēs nec anteā vīdit nec ultrā vidēre poterit."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="26911.949044586" OwnPage="63" ItemID="162094117" PTYPE="4" WIDTH="522" HEIGHT="51.3630573248411" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 51.3631 L0 51.3631 L0 0 Z" copath="M0 0 L522 0 L522 51.3631 L0 51.3631 L0 0 Z" gXpos="136.001" gYpos="26911.949044586" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And thus they had been besieged by land, that no one might dare to exit or enter (the city)."/>
                <ITEXT CH=" With the arrival of more crusader princes the land siege was complete; however, as we'll see on the next page, Nicea lay next to a lake that would also need blockaded."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="26680.098" OwnPage="64" ItemID="165082245" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="26680.098" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>

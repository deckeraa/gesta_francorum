        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="89080.3229999998" OwnPage="213" ItemID="474890101" PTYPE="4" WIDTH="522" HEIGHT="270" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 270 L0 270 L0 0 Z" copath="M0 0 L522 0 L522 270 L0 270 L0 0 Z" gXpos="136.001" gYpos="89080.3229999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Tunc respondit eī māter sua dolēns: &quot;Fīlī cārissime, ecce sunt plūs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" quam centum annōrum tempora, dē quibus inventum est in nostrā pāginā et in gentīlium volūminibus, quoniam gēns Chrīstiāna super nōs foret ventūra, et nōs ubīque vīctūra ac super pāgānōs rēgnātūra; et nostra gēns illīs ubīque erit subdita. Sed ignōrō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=", utrum modo, an in futūrō sint haec ēventūra. Ego utique"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" misera sum tē sēcūta ab Aleph, urbe pulcherrimā, in quā speculandō atque ingeniōsē rīmandō respexī in caelōrum astra, et sagāciter scrūtāta sum planētās et duodecim signa, sīve sortēs innumerās. In eīs omnibus repperī, quoniam gēns Chrīstiāna nōs ubīque est dēvictūra, ideōque dē tē valdē timeō, nimis maesta, nē ex tē remaneam"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" orbāta.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="89350.3229999998" OwnPage="213" ItemID="475382661" PTYPE="4" WIDTH="522" HEIGHT="142.466808917394" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 142.467 L0 142.467 L0 0 Z" copath="M0 0 L522 0 L522 142.467 L0 142.467 L0 0 Z" gXpos="136.001" gYpos="89350.3229999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Behold, there are more than 100 years of time in which (this) was found in our literature and in the books of the gentiles, how a Christian people would come upon us and defeat us from all sides and reign over the pagans."/>
                <ITEXT CH=" Hagenmeyer suggests (p. 327, note 31) that the sort of prophecies being referred to here are contained in Godfrey of Viterbo’s Pantheon. TODO"/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="But I do not know whether now or in the future these things will happen."/>
                <para PARENT="footnotes"/>
                <ITEXT FONT="DejaVu Serif Italic" FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And I, miserable, followed you from Aleppo, the beautiful city, in which I considered the stars of the heavens with searching and ingenious explorations, and I sagaciously scrutinized the planets and the twelves signs (of the Zodiac), or (and) innumerable lots (for casting)."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="That I might not remain having been deprived of you (by him being killed in battle)."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="89080.3229999998" OwnPage="214" ItemID="479890325" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="89080.3229999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ab: from, out of, by, since"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Aleph: Aleppo"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="an: or? rather?"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="annōrum: of years; plural masculine genitive from annus, annī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="astra: stars; plural neuter accusative from astrum, astrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="atque: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="caelōrum: of the heavens, skies; plural masculine genitive from caelus, caelī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="cārissime: O beloved; singular masculine vocative from cārus, cāra -um, cārior -or -us, cārissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="centum: hundred; from centum, centesimus -a -um, centeni -ae -a, centie (n)s"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstiāna: Christian; singular feminine nominative from Chrīstiānus, Chrīstiāna -um, Chrīstiānior -or -us, Chrīstiānissimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dē: of, from, away from, down from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dēvictūra: dēvictūra est = it will conquer entirely; singular feminine nominative future participle from dēvincō, dēvincere, dēvīcī, dēvictus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dolēns: sorrying, grieving; singular nominative present participle from doleō, dolēre, doluī, dolitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="duodecim: twelve"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ecce: Look! Behold!"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ego: I"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eī: to him; singular dative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="eīs: them; plural ablative from is, ea, id"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="erit: it will be; 3rd person singular future active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="est: he is; 3rd person singular present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="et: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ēventūra: sint ēventūra = might be happening; plural neuter nominative future participle from ēveniō, ēvenīre, ēvēnī, ēventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ex: out of, from"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fīlī: son; singular masculine vocative from fīlius, fīlī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="foret: foret ventūra = it might come; subjunctive imperfect from esse"/>

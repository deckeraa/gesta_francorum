                <ITEXT CH="frāter: brother; singular masculine nominative from frāter, frātris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fugam: flight, escape; singular feminine accusative from fuga, fugae"/>
                <para PARENT="Vocab"/>

                <para PARENT="Vocab"/>
                <ITEXT CH="exīret: he might go out; 3rd person singular imperfect active subjunctive from exeō, exīre, exivī(iī), exitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Farreum: The Pōns Farreus extended over the Orontes River, colloquially called the Far. The name is not related to ferreum (iron), although several manuscripts spell it that way."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="fēria: festival, holiday; singular feminine ablative from fēria, fēriae"/>

        <PAGEOBJECT XPOS="136.001" YPOS="39160.143" OwnPage="93" ItemID="220483157" PTYPE="4" WIDTH="522" HEIGHT="206.430248407647" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 206.43 L0 206.43 L0 0 Z" copath="M0 0 L522 0 L522 206.43 L0 206.43 L0 0 Z" gXpos="136.001" gYpos="39160.143" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Nōs itaque persequēbāmur eōs per dēserta et inaquōsam et inhabitābilem terram, ex quā"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vix vīvī ēvāsimus vel exīvimus. Famēs vērō et sitis undique coartābant"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" nōs, nihilque penitus"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" nōbīs erat ad edendum, nisi forte vellentēs et fricantēs spīcās manibus nostrīs, tālī cibō quam miserrimē vīvēbāmus. Illīc fuit mortua maxima pars nostrōrum equōrum, eō"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" quod multī ex nostrīs mīlitibus remānsērunt peditēs; et prō pēnūriā equōrum, erant nōbīs bovēs locō caballōrum, et prō nimiā necessitāte succēdēbant nōbīs caprī et multōnēs ac canēs ad portandum."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="39366.5732484076" OwnPage="93" ItemID="221108213" PTYPE="4" WIDTH="522" HEIGHT="155.464968152868" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 155.465 L0 155.465 L0 0 Z" copath="M0 0 L522 0 L522 155.465 L0 155.465 L0 0 Z" gXpos="136.001" gYpos="39366.5732484076" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Out of which we could scarcely escape or get out alive."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For hunger and thirst were hemming us in from all sides."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And nothing at all was there for us to eat."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For which condition many of our soldiers remained (as) foot-soldiers."/>
                <ITEXT CH=" Cavalrymen became infantrymen because their horses died."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

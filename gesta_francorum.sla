        <PAGEOBJECT XPOS="136.001" YPOS="129848.47" OwnPage="311" ItemID="688260373" PTYPE="4" WIDTH="522" HEIGHT="214.256114650023" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 214.256 L0 214.256 L0 0 Z" copath="M0 0 L522 0 L522 214.256 L0 214.256 L0 0 Z" gXpos="136.001" gYpos="129848.47" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Crāstinā vērō diē mīsit cum illīs duōs Turcōs suōs vidēlicet nūntiōs, quī eīs mōnstrārent flūminis vadum eōsque condūcerent ubi invenīre possent ad capiendum"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=". Dēnique vēnērunt in vallem quandam subter quoddam castrum, ibique dēpraedātī sunt plūs quam quīnque animālium mīlia et satis frūmentī atque alia bona, unde valdē fuit refecta tōta Chrīstī mīlitia. Tamen illud castrum reddidit sē comitī eīque dedit equōs et aurum pūrissimum; et iūrāvērunt suā lēge, quod peregrīnīs nīl exinde fieret malī. Fuimusque ibi per quīnque diēs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="130062.72611465" OwnPage="311" ItemID="688908565" PTYPE="4" WIDTH="522" HEIGHT="30.7261146496894" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 30.7261 L0 30.7261 L0 0 Z" copath="M0 0 L522 0 L522 30.7261 L0 30.7261 L0 0 Z" gXpos="136.001" gYpos="130062.72611465" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And they would conduct them to where they might be able to find (fish or other game animals) for catching."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="129848.47" OwnPage="312" ItemID="692970021" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="129848.47" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ad: for"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="alia: others; plural neuter accusative from alius, alia, alium"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="animālium: of animals; plural neuter genitive from animal, animālis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="atque: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aurum: gold; singular neuter accusative from aurum, aurī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="bona: good; plural neuter accusative from bonus, bona, bonum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="capiendum: catching; singular neuter accusative gerund from capiō, capere, cēpī, captum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="castrum: castle; singular neuter accusative or singular neuter nominative from castrum, castrī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Chrīstī: of Christ; singular masculine genitive from Chrīstus, Chrīstī"/>
                <para PARENT="Vocab"/>

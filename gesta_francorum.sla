        <PAGEOBJECT XPOS="136.001" YPOS="124024.449" OwnPage="297" ItemID="660247253" PTYPE="4" WIDTH="522" HEIGHT="323.219789809242" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 323.22 L0 323.22 L0 0 Z" copath="M0 0 L522 0 L522 323.22 L0 323.22 L0 0 Z" gXpos="136.001" gYpos="124024.449" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Videntēs autem seniōrēs, quia nihil agere poterant et frūstrā labōrābant, fēcit Raimundus comes dē Sānctō Egidiō fierī quoddam līgneum castrum forte et altum. Quod castrum ingeniātum et aedificātum erat super quattuor rotās, super quod stābant plūrēs mīlitēs et Evrardus Vēnātor, tubam fortiter sonāns. Subter vērō erant armātī mīlitēs, quī dēdūxērunt castrum ūsque prope urbis mūrum iuxtā turrim quamdam."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Quod vidēns gēns pāgāna, statim fēcērunt īnstrūmentum quō iactābant maximōs lapidēs super castrum, ita ut paene nostrōs mīlitēs occīderent"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=". Iaciēbant quoque Graecōs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" īgnēs  super castrum, putantēs illud ārdēre et dēvāstārī. Sed Deus omnipotēns nōluit"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" ut castrum ārdēret hāc vice. Superēminēbat enim omnēs mūrōs cīvitātis."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="124347.668789809" OwnPage="297" ItemID="660370373" PTYPE="4" WIDTH="522" HEIGHT="80.2547770700621" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 80.2548 L0 80.2548 L0 0 Z" copath="M0 0 L522 0 L522 80.2548 L0 80.2548 L0 0 Z" gXpos="136.001" gYpos="124347.668789809" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that they almost killed our soldiers."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="Greek fire was a flammable liquid compound that could be used like a flamethrower."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="But God Almighty did not want the castle to burn this time (or on this occasion)."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>

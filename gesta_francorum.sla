                <para PARENT="Vocab"/>
                <ITEXT CH="prō: because of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="prope: near, close"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quae: which; plural feminine nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quippe: indeed"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quōrum: of whom; plural masculine genitive from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="remānsit: it remained; 3rd person singular perfect active from remaneō, remanēre, remānsī, remānsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sagittandō: shooting arrows; singular masculine ablative gerund from sagittō, sagittāre, sagittāvī, sagittātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sunt: they are; 3rd person plural present active from sum, esse, fuī, futūrus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="superveniente: overcoming; singular ablative present participle from superveniō, supervenīre, supervēnī, superventus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="timōre: fear; singular masculine ablative from timor, timōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tremefactī: having been caused to tremble; plural masculine nominative perfect passive participle from tremefaciō, tremefacere, tremefēcī, tremefactus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcī: the Turks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Turcōrum: of the Turks"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ūnā: one; singular feminine ablative from ūnus -a -um, prīmus -a -um, singulī -ae -a, semel"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="unde: from where?"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="undique: from all sides"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ut: so that"/>
                <para PARENT="Vocab"/>

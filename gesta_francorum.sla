        <PAGEOBJECT XPOS="136.001" YPOS="153976.557" OwnPage="369" ItemID="803123829" PTYPE="4" WIDTH="522" HEIGHT="245.302872611879" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 245.303 L0 245.303 L0 0 Z" copath="M0 0 L522 0 L522 245.303 L0 245.303 L0 0 Z" gXpos="136.001" gYpos="153976.557" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Veniēns itaque ammiravissus ante cīvitātem, dolēns et maerēns lacrimandō dīxit: &quot;Ō Deōrum spīritus! Quis unquam vīdit vel audīvit tālia? Tanta potestās, tanta virtūs, tanta mīlitia, quae nunquam ab ūllā gente fuit superāta, modo ā tantillā"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" gente Chrīstiānōrum, quod in pugillō potest claudī, est dēvicta! Heu mihi trīstis ac dolēns! Quid amplius dīcam? Superātus sum ā gente mendīcā, inermī"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" et pauperrimā, quae nōn habet nisi saccum et pēram. Ipsa"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" modo persequitur gentem Aegyptiacam, quae illī plērumque suās largita est eleēmosynās, dum ōlim per omnem nostram patriam mendīcārent."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="154221.859872611" OwnPage="369" ItemID="803248885" PTYPE="4" WIDTH="522" HEIGHT="151.643312101922" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 151.643 L0 151.643 L0 0 Z" copath="M0 0 L522 0 L522 151.643 L0 151.643 L0 0 Z" gXpos="136.001" gYpos="154221.859872611" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Such power, such virtue, such a military, which had never been conquered by any people, now has been conquered by such a small group of Christians, which can be held in a hand."/>
                <ITEXT CH=" The phrase "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="quod in pugillō potest claudī"/>
                <ITEXT CH=" could be translated as "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="a handful"/>
                <ITEXT CH=", emphasizing the relatively small size of the Crusader army."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I have been overcome by a beggarly, unarmed, and very poor people."/>
                <ITEXT CH=" The emir's characterization of 'unarmed' is either hyperbole or refers to how many of the non-knight crusaders were relatively poorly equipped."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The same (people, the Franks) now persecutes the Egyptian people, who had bestowed their alms on them, for the most part, when formerly that had begged through all our lands."/>
                <ITEXT CH=" The emir is complaining that previously the Egyptians had allowed pilgrims passage through Egypt to Jerusalem, and had even given alms, but now is defeated by the same kind of people they had once helped."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="153976.557" OwnPage="370" ItemID="805781509" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="153976.557" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ab: from, out of, by"/>

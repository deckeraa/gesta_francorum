        <PAGEOBJECT XPOS="136.001" YPOS="92408.3349999998" OwnPage="221" ItemID="493036789" PTYPE="4" WIDTH="522" HEIGHT="268.505764331421" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 268.506 L0 268.506 L0 0 Z" copath="M0 0 L522 0 L522 268.506 L0 268.506 L0 0 Z" gXpos="136.001" gYpos="92408.3349999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Nōs dēnique, quī remānsimus, nequīvimus"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" sufferre pondus armōrum illōrum; fēcimusque mūrum inter nōs et illōs, quem cūstōdiēbāmus diū noctūque. Intereā tantā oppressiōne fuimus oppressī, ut equōs et asinōs nostrōs mandūcārēmus."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Quōdam vērō diē stantibus nostrīs maiōribus sūrsum ante castellum trīstibus ac dolentibus, vēnit quīdam sacerdōs ad eōs et dīxit: &quot;Seniōrēs, sī vōbīs placet, audītē rem quamdam, quam in vīsiōne vīdī: Cum nocte ūnā"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" iacērem in ecclēsiā Sānctae Mariae, mātris Dominī nostrī Iēsu Chrīstī, appāruit mihi Salvātor mundī cum suā genitrīce et beātō Petrō, apostolōrum prīncipe, stetitque ante mē et dīxit mihi: &quot;Āgnōscis mē?&quot;"/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="92676.8407643312" OwnPage="221" ItemID="493307653" PTYPE="4" WIDTH="522" HEIGHT="43.5668789809133" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 43.5669 L0 43.5669 L0 0 Z" copath="M0 0 L522 0 L522 43.5669 L0 43.5669 L0 0 Z" gXpos="136.001" gYpos="92676.8407643312" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="We were unable to endure the weight of their weapons."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="One night when I was laying in the church of Saint Mary, of the mother of our Lord Jesus Christ."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="92408.3349999998" OwnPage="222" ItemID="497026869" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="92408.3349999998" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>

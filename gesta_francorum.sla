                <para PARENT="Vocab"/>
                <ITEXT CH="quīdam: a certain; singular masculine nominative from quīdam"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="quōdam: on a certain; singular masculine ablative from quīdam; here it matches diē, which in this case is masculine, though usually diēs is feminine. There is a textual variant where manuscripts changed this to quādam."/>
                <para PARENT="Vocab"/>
                <ITEXT CH="rem: thing; singular feminine accusative from rēs, reī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="remānsimus: we remained; 1st person plural perfect active from remaneō, remanēre, remānsī, remānsus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sacerdōs: priest; singular common nominative from sacerdōs, sacerdōtis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Salvātor: Savior; singular masculine nominative from salvātor, salvātōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Sānctae: holy"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="seniōrēs: chiefs, elders; plural common nominative from senex, senis (gen.), senior -or -us, -"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sī: if"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="stantibus: standing; plural ablative present participle from stō, stāre, stetī, status"/>

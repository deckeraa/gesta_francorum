                <para PARENT="Vocab"/>
                <ITEXT CH="multī: many; plural masculine nominative from multus, multa -um, -, plūrimus -a -um"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="namque: for and in fact, on the other hand"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="nequeō: I am unable; 1st person singular present active from nequeō, nequīre, nequivī(iī), nequitus"/>
                <para PARENT="Vocab"/>

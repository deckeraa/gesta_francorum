                <para PARENT="Vocab"/>
                <ITEXT CH="humiliāvērunt: they humiliated; 3rd person plural perfect active from humiliō, humiliāre, humiliāvī, humiliātus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="igitur: therefore"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ille: that; singular masculine nominative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="illud: that; singular neuter accusative from ille, illa, illud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="imperātōris: emperor's; singular masculine genitive from imperātor, imperātōris"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="in: into (with accusative), in (with ablative)"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iste: that; singular masculine nom. from iste, ista, istud"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iūrāret: he might swear; 3rd person singular imperfect active subjunctive from iūrō, iūrāre, iūrāvī, iūrātus"/>
                <para PARENT="Vocab"/>

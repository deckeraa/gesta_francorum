        <PAGEOBJECT XPOS="136.001" YPOS="76600.2779999999" OwnPage="183" ItemID="406685093" PTYPE="4" WIDTH="522" HEIGHT="359.467222930092" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 359.467 L0 359.467 L0 0 Z" copath="M0 0 L522 0 L522 359.467 L0 359.467 L0 0 Z" gXpos="136.001" gYpos="76600.2779999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Cōnfestim dēscendit Boamundus et precēpit omnibus, dīcēns: &quot;Īte sēcūrō animō et fēlīcī concordiā, et ascendite per scālam in Antiochīam, quam statim habēbimus, sī Deō placet, in nostrā custōdiā.&quot; Vēnērunt illī usque ad scālam, quae iam erat ērēcta et fortiter ligāta ad cīvitātis merulas, et ascendērunt per illam hominēs ferē sexāgintā ex nostrīs; ac dīvīsī sunt per turrēs quās ille observābat. Vidēns hoc Pirus quod tam paucī ascendissent ex nostrīs, coepit pavēre, timēns sibi et nostrīs nē in manūs Turcōrum incīderent, dīxitque: &quot;Micró"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Francōs echomé (hoc est: paucōs Francōs habēmus). Ubi est ācerrimus Boamundus? Ubi est ille mīles invictus?&quot; Intertim"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" dēscendit quīdam serviēns Longobardus deorsum et cucurrit quantōcius ad Boamundum, dīcēns: &quot;Quid hīc stās vir prūdēns? Quamobrem hūc vēnistī? Ecce nōs iam trēs turrēs habēmus!&quot; Mōtus est ille cum aliīs, et omnēs gaudentēs pervēnērunt usque ad scālam."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.001" YPOS="76959.74522293" OwnPage="183" ItemID="406971173" PTYPE="4" WIDTH="522" HEIGHT="123.821656050946" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 123.822 L0 123.822 L0 0 Z" copath="M0 0 L522 0 L522 123.822 L0 123.822 L0 0 Z" gXpos="136.001" gYpos="76959.74522293" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH="Hagenmeyer provides the following Greek text in the footnote (p. 303, note 43) for this phrase: Μικρὸς φγάγκους ὲχομεν, "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="we have few Franks"/>
                <ITEXT CH=". It seems likely to me that Pirus uttered a Greek phrase that the presumably Frankish writer of this work transliterated."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Meanwhile a certain Lombard servant descended down (the ladder on the wall) and ran as quickly as he could to Bohemond."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.001" YPOS="76600.2779999999" OwnPage="184" ItemID="410015349" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.001" gYpos="76600.2779999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ac: and"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="ācerrimus: very keen, harsh; singular masculine nominative from ācer, ācris -e, ācrior -or -us, ācerrimus -a -um"/>

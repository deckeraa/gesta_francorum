                <para PARENT="Vocab"/>
                <ITEXT CH="graviter: gravely"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="habuisset: he (might) have had; 3rd person singular pluperfect active subjunctive from habeō, habēre, habuī, habitus"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Hierosolymītānus: Jerusalemite"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="iam: already, now, soon"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="īdem: the same; singular masculine nominative from īdem"/>
                <para PARENT="Vocab"/>

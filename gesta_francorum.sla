                <ITEXT CH="retrō: behind, backwards"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sacrāmentum: oath; singular neuter accusative from sacrāmentum, sacrāmentī"/>
                <para PARENT="Vocab"/>
